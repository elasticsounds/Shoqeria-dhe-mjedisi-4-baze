{
 "texts": {
  "pg063_n0037": "Kosova ka dy regjione.",
  "pg063_n0039": "Kosova ka shtatë qendra regjionale.",
  "pg063_n0041": "Prishtina është kryeqyteti i Kosovës.",
  "pg063_n0043": "Peja dallohet për Grykën e Rugovës dhe për Drinin e Bardhë.",
  "pg063_x0001": "Vlerëso të gjitha pohimet para se të vazhdosh.",
  "pg063_im004": "Harta e Kosovës e ndarë në dy rajone: Rrafshi i Dukagjinit me ngjyrë të gjelbër të errët dhe Fusha e Kosovës me ngjyrë të gjelbër të çelët, me qendrat rajonale Peja, Gjakova, Prizreni, Mitrovica, Prishtina, Gjilani dhe Ferizaj.",
  "pg066_im002": "Harta e Kosovës me qendrat rajonale dhe me emrat e shteteve fqinje përreth: Serbia, Mali i Zi, Shqipëria dhe Maqedonia e Veriut.",
  "pg070_x0001": "Shkruaj në secilën pjesë të diagramit.",
  "pg100_x0001": "Fotografitë",
  "pg126_x0001": "Tërhiq një etiketë",
  "pg126_x0002": "Përgjigje e saktë (2 pikë)",
  "pg126_x0003": "Përgjigje jo e saktë",
  "pg126_x0004": "Radha e lojtarit:",
  "pg126_x0005": "Loja përfundoi.",
  "pg126_x0006": "Fitues:",
  "pg126_x0007": "Barazim!",
  "pg126_x0008": "Loja nuk ka përfunduar ende. Tërhiqni të gjitha etiketat.",
  "pg120_n0007": "Madje kishte dëgjuar dhe për rregullën “3R - ripërdor, riciklo dhe redukto”.",
  "pg120_n0009": "Kur mësuesja filloi të fliste se si mbeturinat nuk duhej të hidheshin të gjitha në të njëjtën shportë, por ato duhej të klasifikoheshin, atij iu kujtua pse ekzistonte rregulla “3R”.",
  "pg086_n0017": "Bjeshkët e Nemuna - Rugovë",
  "pg091_x0001": "Vlerëso të gjitha pohimet para se të vazhdosh.",
  "pg027_x0001": "Fjalët kyçe: mendim ndryshe, respekt reciprok, mospajtim, individ.",
  "pg063_n0037_easy_read": "Kosova ka 2 regjione.",
  "pg063_n0039_easy_read": "Kosova ka 7 qendra regjionale.",
  "pg063_n0041_easy_read": "Prishtina është kryeqyteti i Kosovës.",
  "pg063_n0043_easy_read": "Peja dallohet për Grykën e Rugovës dhe për Drinin e Bardhë.",
  "pg120_n0007_easy_read": "Ai kishte dëgjuar edhe për rregullën “3R - ripërdor, riciklo dhe redukto”."
 },
