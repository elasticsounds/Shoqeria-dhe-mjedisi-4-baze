     "html": "<div class=\"lx-split lx-split--side\">\n<div class=\"lx-box lx-box--note lx-box--green\"><div class=\"lx-box__body\">\n<h2 class=\"lx-note__title\" data-id=\"pg060_n0013\">Kosova</h2>\n<p><span data-id=\"pg060_n0015\">E dua Kosovën e maleve të Sharrit</span><br>\n<span data-id=\"pg060_n0016\">E dua Kosovën e Adem Jasharit.</span><br>\n<span data-id=\"pg060_n0017\">E dua Kosovën, të fortë e trime</span><br>\n<span data-id=\"pg060_n0018\">Të luftëtarëve e nënave heroike.</span><br>\n<span data-id=\"pg060_n0019\">E dua Kosovën e qëndresës</span><br>\n<span data-id=\"pg060_n0020\">Të fjalës e të besës.</span><br>\n<span data-id=\"pg060_n0021\">E dua Kosovën e dashurisë</span><br>\n<span data-id=\"pg060_n0022\">E dua Kosovën e mirësisë.</span><br>\n<span data-id=\"pg060_n0023\">E dua për malet e gjelbëruara,</span><br>\n<span data-id=\"pg060_n0024\">E dua për pasuritë e bekuara.</span><br>\n<span data-id=\"pg060_n0025\">E dua Kosovën e Kushtetutës dhe të ligjit,</span><br>\n<span data-id=\"pg060_n0026\">Të dua ashtu si je</span><br>\n<span data-id=\"pg060_n0027\">Se për mua je më i bukuri ATDHE.</span></p>\n</div></div>\n<figure class=\"lx-figure\"><img src=\"images/pg060_im001_seg001_v1.png\" width=\"1080\" height=\"1240\" data-id=\"pg060_im001_seg001_v1\" alt=\"Djalë nxënës duke mbajtur një libër të hapur dhe duke recituar me buzëqeshje.\"></figure>\n</div>"
    }
   ]
  },
