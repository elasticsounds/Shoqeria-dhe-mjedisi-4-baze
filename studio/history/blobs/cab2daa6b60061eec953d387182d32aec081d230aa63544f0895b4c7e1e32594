<script>
(function(){
'use strict';
const key='shoqeria-dhe-mjedisi-4:pg007_sec001:comparison:v1';
const fields=Array.from(document.querySelectorAll('input[data-activity-item]'));
const status=document.getElementById('pg007-save-status');
const retry=document.querySelector('[data-action="retry-save"]');
const actions=document.querySelector('[data-save-actions]');
let draft={},touched=new Set();
try{const data=JSON.parse(localStorage.getItem(key)||'{}');if(data&&typeof data==='object')draft=data;}catch(e){status.textContent='⚠ Nuk u lexuan përgjigjet e ruajtura.';}
function restore(){fields.forEach(f=>{if(!touched.has(f.id)&&typeof draft[f.id]==='string')f.value=draft[f.id];});}
function save(){fields.forEach(f=>{draft[f.id]=f.value;});try{localStorage.setItem(key,JSON.stringify(draft));status.textContent='✓ U ruajt.';retry.hidden=true;return true;}catch(e){status.textContent='⚠ Nuk u ruajt. Përgjigjet mbeten këtu; provo përsëri.';retry.hidden=false;return false;}}
restore();window.addEventListener('load',()=>{restore();setTimeout(restore,500);});
fields.forEach(f=>{['input','change'].forEach(type=>f.addEventListener(type,()=>{touched.add(f.id);draft[f.id]=f.value;save();},true));});
retry.addEventListener('click',save);
function retainAction(){document.querySelectorAll('button').forEach(button=>{if(button.textContent.trim()==='Dërgo'&&!actions.contains(button)){button.type='button';button.className='bk-btn';button.removeAttribute('style');button.setAttribute('data-pg007-save','');actions.append(button);}});}
new MutationObserver(retainAction).observe(document.body,{childList:true,subtree:true});
document.addEventListener('click',event=>{const button=event.target.closest('button');if(button&&button.hasAttribute('data-pg007-save')){event.preventDefault();event.stopImmediatePropagation();save();}},true);
window.addEventListener('pagehide',()=>{if(touched.size)save();});
retainAction();
})();
</script>
