<script>
(()=>{const prefix='ShoqeriaDheMjedisi4:pg008_sec002:discussion:';
for(const field of document.querySelectorAll('#content textarea')){
const key=prefix+field.dataset.activityItem, box=field.closest('details'), status=box.querySelector('[role=status]'), retry=box.querySelector('button');let dirty=false;
function save(){try{localStorage.setItem(key,JSON.stringify({text:field.value}));dirty=false;status.textContent='✓ U ruajt.';retry.hidden=true;}catch(e){dirty=true;status.textContent='⚠ Nuk u ruajt.';retry.hidden=false;}}
function restore(){try{const value=localStorage.getItem(key);if(value!==null&&!dirty){field.value=JSON.parse(value).text;}}catch(e){status.textContent='⚠ Shënimet e ruajtura nuk u lexuan.';}}
restore();window.addEventListener('load',()=>{if(!dirty){const existing=field.value;restore();if(localStorage.getItem(key)===null&&existing)save();}});
field.addEventListener('input',()=>{dirty=true;save();});retry.addEventListener('click',save);
window.addEventListener('pagehide',()=>{if(dirty)save();});
}})();
</script>
</body>
