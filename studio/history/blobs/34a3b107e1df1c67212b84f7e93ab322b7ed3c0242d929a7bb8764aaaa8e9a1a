<script>
(()=>{
const cards=[...document.querySelectorAll('[data-part]')],host=document.getElementById('question-parts'),store=document.createDocumentFragment();
const prefix='shoqeria-dhe-mjedisi-4:pg010_sec001:',stateKey=prefix+'part';
let part=1;try{part=Math.max(1,Math.min(3,Number(sessionStorage.getItem(stateKey))||1));}catch(e){}
const route=location.hash.match(/^#part-([123])/);if(route)part=Number(route[1]);
for(const card of cards){
 const summary=card.querySelector('summary');summary.id='notes-'+card.dataset.part+'-'+card.querySelector('textarea').id;summary.setAttribute('aria-labelledby',summary.id+' '+card.querySelector('label').id);
 const field=card.querySelector('textarea'),status=card.querySelector('[role=status]'),retry=card.querySelector('button'),key=prefix+field.dataset.activityItem;
 try{const saved=localStorage.getItem(key);if(saved!==null)field.value=saved;}catch(e){status.textContent='⚠ Nuk u lexuan shënimet e ruajtura.';}
 if(field.value)card.querySelector('details').open=true;
 function save(){try{localStorage.setItem(key,field.value);status.textContent='✓ U ruajt në këtë pajisje.';retry.hidden=true;}catch(e){status.textContent='⚠ Nuk u ruajt. Shënimi mbetet këtu; provoni përsëri.';retry.hidden=false;}}
 field.addEventListener('input',save);retry.addEventListener('click',save);
}
function show(){history.replaceState(null,'','#part-'+part);cards.forEach(c=>store.append(c));cards.filter(c=>Number(c.dataset.part)===part).forEach(c=>host.append(c));document.getElementById('part-status').textContent='Pjesa '+part+' / 3';document.getElementById('part-prev').disabled=part===1;document.getElementById('part-next').disabled=part===3;try{sessionStorage.setItem(stateKey,String(part));}catch(e){}}
document.getElementById('parts-nav').hidden=false;
document.getElementById('part-prev').onclick=()=>{part--;show();};document.getElementById('part-next').onclick=()=>{part++;show();};show();
// These PDF tasks are oral discussions. Suppress only the injected generic submit control, not reader navigation.
function removeGenericSubmit(){document.querySelectorAll('body button,body [role="button"]').forEach(b=>{if(b.textContent.trim()==='Dërgo')b.remove();});}
new MutationObserver(removeGenericSubmit).observe(document.body,{childList:true,subtree:true});removeGenericSubmit();
})();
</script>
