  <section data-section-type="boxed_text" data-section-id="pg107_sec002" class="mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-10">
    <div class="rounded-2xl border-2 border-fuchsia-300 bg-white shadow-sm overflow-hidden">
