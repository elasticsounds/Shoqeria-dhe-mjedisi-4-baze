      <li>
        <div class="adt-body text-left"><span data-id="pg037_n0013">Si keni vepruar?</span></div>
        <label for="item-4" class="sr-only">Si keni vepruar?</label>
        <textarea id="item-4" data-activity-item="item-4" aria-label="Si keni vepruar?" class="mt-2 min-h-11 w-full rounded-xl border-2 border-violet-300 bg-white px-4 py-3 outline-none focus:border-violet-500"></textarea>
