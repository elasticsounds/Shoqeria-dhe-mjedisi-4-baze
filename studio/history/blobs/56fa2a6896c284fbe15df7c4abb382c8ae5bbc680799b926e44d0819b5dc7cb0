<script>
(function(){
 var fields=Array.from(document.querySelectorAll('#content input[data-activity-item]'));
 var status=document.getElementById('record-status'), retry=document.getElementById('retry-save');
 var prefix='Shoqeria-dhe-Mjedisi-4:pg081_sec002:';
 function save(){try{fields.forEach(function(f){localStorage.setItem(prefix+f.getAttribute('data-activity-item'),f.value)});status.textContent='✓ U ruajt.';retry.hidden=true}catch(e){status.textContent='⚠ Nuk u ruajt. Provo ruajtjen përsëri.';retry.hidden=false}}
 fields.forEach(function(f){try{var v=localStorage.getItem(prefix+f.getAttribute('data-activity-item'));if(v!==null)f.value=v}catch(e){status.textContent='⚠ Shënimet nuk mund të lexohen në këtë pajisje.';retry.hidden=false}f.addEventListener('input',save)});
 retry.addEventListener('click',save);
})();
</script>
