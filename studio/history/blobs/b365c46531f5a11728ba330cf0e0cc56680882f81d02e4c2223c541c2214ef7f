/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg058_sec001\" class=\"bg-white text-slate-800\">\n    <div class=\"w-full overflow-hidden rounded-3xl bg-purple-500\">\n      <div class=\"mx-auto flex w-full max-w-5xl items-center gap-6 px-8 py-8 max-lg:flex-col max-lg:items-start max-sm:px-5 max-sm:py-6\">\n        <div aria-hidden=\"true\" class=\"flex h-28 w-28 shrink-0 items-center justify-center rounded-2xl bg-purple-400/70 max-sm:h-24 max-sm:w-24\">\n          <div class=\"relative\">\n            <div class=\"h-14 w-14 rounded-full bg-white\"></div>\n            <div class=\"absolute -bottom-2 left-3 h-0 w-0 border-l-[10px] border-r-[2px] border-t-[12px] border-l-transparent border-r-transparent border-t-white\"></div>\n            <div class=\"absolute left-10 top-3 h-12 w-12 rounded-full bg-white\"></div>\n            <div class=\"absolute left-[52px] top-12 h-0 w-0 border-l-[8px] border-r-[2px] border-t-[10px] border-l-transparent border-r-transparent border-t-white\"></div>\n            <div class=\"absolute left-[30px] top-[26px] flex gap-2\">\n              <span class=\"h-2 w-2 rounded-full bg-purple-400\"></span>\n              <span class=\"h-2 w-2 rounded-full bg-purple-400\"></span>\n              <span class=\"h-2 w-2 rounded-full bg-purple-400\"></span>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex-1\">\n          <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg058_n0002\">Mendime t&#xeb; ndryshme, vendime t&#xeb; p&#xeb;rbashk&#xeb;ta</h1>\n          <h2 class=\"adt-h2 mt-4 border-b-4 border-purple-300 pb-3 font-medium text-slate-900\" data-id=\"pg058_n0003\">Veprimtaria 4: &#x201c;Si t&#xeb; marr vendimin e duhur?&#x201d;</h2>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"adt-body mt-10 leading-relaxed text-left text-slate-800\">\n      <span data-id=\"pg058_n0005\">Shikoni me kujdes fotografit&#xeb; e m&#xeb;poshtme.</span>\n      <span data-id=\"pg058_n0006\">Lexoni fjalit&#xeb; e dh&#xeb;na.</span>\n    </p>\n\n    <div class=\"mt-10 grid grid-cols-2 gap-10 max-lg:grid-cols-1\">\n      <figure class=\"rounded-3xl bg-purple-50 p-4 shadow-sm ring-1 ring-purple-100\">\n        <img data-id=\"pg058_im001_seg001_v1\" src=\"images/pg058_im001_seg001_v1.png\" alt=\"Kat&#xeb;r nx&#xeb;n&#xeb;s diskutojn&#xeb; rreth nj&#xeb; tavoline, duke shprehur mendimet e tyre dhe duke krahasuar idet&#xeb; me nj&#xeb;ri-tjetrin.\" class=\"w-full h-auto rounded-2xl\">\n        <figcaption class=\"adt-caption mt-4 leading-relaxed text-left text-slate-800\" data-id=\"pg058_n0008\">T&#xeb; diskutosh do t&#xeb; thot&#xeb; q&#xeb; t&#xeb; shpreh&#xeb;sh mendimin t&#xeb;nd, krahas mendimit t&#xeb; tjetrit.</figcaption>\n      </figure>\n\n      <figure class=\"rounded-3xl bg-purple-50 p-4 shadow-sm ring-1 ring-purple-100\">\n        <img data-id=\"pg058_im001_seg002_v1\" src=\"images/pg058_im001_seg002_v1.png\" alt=\"Nj&#xeb; nx&#xeb;n&#xeb;se shpjegon mendimin e saj para shok&#xeb;ve, nd&#xeb;rsa ata e d&#xeb;gjojn&#xeb; gjat&#xeb; diskutimit.\" class=\"w-full h-auto rounded-2xl\">\n        <figcaption class=\"adt-caption mt-4 leading-relaxed text-left text-slate-800\" data-id=\"pg058_n0010\">Kur jep mendimin t&#xeb;nd, &#xeb;sht&#xeb; mir&#xeb; t&#xeb; shpjegosh arsyen pse mendon ashtu duke dh&#xeb;n&#xeb; shembuj ose fakte q&#xeb; e mb&#xeb;shtesin mendimin t&#xeb;nd.</figcaption>\n      </figure>\n    </div>\n\n    <figure class=\"mt-10 rounded-[2rem] bg-purple-100 p-5 shadow-sm ring-1 ring-purple-200\">\n      <img data-id=\"pg058_im001_seg003_v1_crop_v1\" src=\"images/pg058_im001_seg003_v1_crop_v1.png\" alt=\"Kat&#xeb;r nx&#xeb;n&#xeb;s bisedojn&#xeb;; nj&#xeb;ri ka ngritur dor&#xeb;n p&#xeb;r t&#xeb; folur, nd&#xeb;rsa t&#xeb; tjer&#xeb;t e d&#xeb;gjojn&#xeb; me kujdes.\" class=\"w-full h-auto rounded-3xl\">\n      <figcaption class=\"adt-caption mt-4 text-center leading-relaxed text-slate-800\" data-id=\"pg058_n0012\">D&#xeb;gjo me kujdes edhe t&#xeb; tjer&#xeb;t kur flasin!</figcaption>\n    </figure>\n\n    <aside class=\"mt-12 rounded-3xl border-2 border-purple-300 bg-purple-50 shadow-sm overflow-hidden\">\n      <div class=\"flex max-lg:flex-col\">\n        <div aria-hidden=\"true\" class=\"flex w-28 shrink-0 items-start justify-center bg-purple-500 p-4 max-lg:w-full max-lg:justify-start\">\n          <div class=\"rounded-2xl bg-white/20 p-3\">\n            <div class=\"h-14 w-10 rounded-sm border-4 border-white border-b-[6px] bg-white/10\"></div>\n          </div>\n        </div>\n        <div class=\"flex-1 p-6\">\n          <p class=\"adt-body leading-relaxed text-left italic text-slate-800\">\n            <span data-id=\"pg058_n0015\">N&#xeb; disa raste, ne jemi t&#xeb; p&#xeb;rqendruar tek interesat tan&#xeb; vetjak&#xeb; dhe kjo na b&#xeb;n q&#xeb; t&#xeb; harrojm&#xeb; t&#xeb; mir&#xeb;n ton&#xeb; t&#xeb; p&#xeb;rbashk&#xeb;t.</span>\n            <span data-id=\"pg058_n0016\">P&#xeb;r k&#xeb;t&#xeb;, duhet t&#xeb; dim&#xeb; se si t&#xeb; marrim vendimin e duhur.</span>\n            <span data-id=\"pg058_n0017\">Kjo do t&#xeb; na ndihmoj&#xeb; q&#xeb; t&#xeb; trajtojm&#xeb; nj&#xeb;ri-tjetrin me barazi dhe drejt&#xeb;si, t&#xeb; zgjidhim mosmarr&#xeb;veshjet pa l&#xeb;nduar njeri, t&#xeb; gjejm&#xeb; zgjidhjen m&#xeb; t&#xeb; mir&#xeb; p&#xeb;r t&#xeb; gjith&#xeb;.</span>\n            <span data-id=\"pg058_n0018\">Pra, gjithsecili prej nesh do t&#xeb; ndihet i mir&#xeb;pritur dhe i vler&#xeb;suar.</span>\n            <span data-id=\"pg058_n0019\">Gjat&#xeb; diskutimit, secili duhet t&#xeb; shpreh&#xeb; mendimin e vet.</span>\n            <span data-id=\"pg058_n0020\">Argumentimi i mendimeve &#xeb;sht&#xeb; pik&#xeb; e fort&#xeb; q&#xeb; ndihmon n&#xeb; marrjen e vendimeve t&#xeb; drejta.</span>\n            <span data-id=\"pg058_n0021\">T&#xeb; gjitha mendimet, sado t&#xeb; ndryshme t&#xeb; jen&#xeb;, jan&#xeb; t&#xeb; vlefshme dhe duhen d&#xeb;gjuar.</span>\n            <span data-id=\"pg058_n0022\">N&#xeb;se ndodhesh n&#xeb; situat&#xeb; t&#xeb; v&#xeb;shtir&#xeb; dhe nuk gjen dot zgjidhjen e duhur, k&#xeb;rko ndihm&#xeb;n e shoqeve/shok&#xeb;ve t&#xeb; tu, t&#xeb; m&#xeb;suesit/es apo t&#xeb; prind&#xeb;rve.</span>\n          </p>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"mt-10 border-l-4 border-purple-400 pl-4\">\n      <p class=\"adt-body leading-relaxed text-left text-slate-800\">\n        <span class=\"font-semibold\" data-id=\"pg058_n0025\">Fjal&#xeb;t ky&#xe7;e:</span>\n        <span data-id=\"pg058_n0026\">vendim, argument, mendim, marr.</span>\n      </p>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg059_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg059_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"72\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\"><section data-section-type=\"text_and_images\" data-section-id=\"pg059_sec001\" class=\"mx-auto w-full max-w-5xl bg-white px-8 py-8 text-slate-800 max-sm:px-4\">\n  <div class=\"mb-8\">\n    <div class=\"h-3 w-full bg-purple-400\"></div>\n    <div class=\"pt-4\">\n      <h1 data-id=\"pg059_n0003\" class=\"adt-h2 text-left font-bold text-slate-800\">Vizit&#xeb; n&#xeb; nj&#xeb; studio ligjore</h1>\n      <div aria-hidden=\"true\" class=\"mt-2 h-1 w-80 max-w-full bg-purple-300\"></div>\n    </div>\n  </div>\n\n  <p class=\"adt-body mb-6 text-left leading-relaxed\">\n    <span data-id=\"pg059_n0005\">Shikoni figurat e m&#xeb;poshtme.</span>\n    <span data-id=\"pg059_n0006\" class=\"ml-1\">Lexoni fjalit&#xeb; posht&#xeb; secil&#xeb;s figur&#xeb;.</span>\n  </p>\n\n  <div class=\"mb-6 grid grid-cols-2 gap-3 max-lg:grid-cols-1\">\n    <figure class=\"flex flex-col justify-between border-2 border-amber-300 bg-white p-4\">\n      <img data-id=\"pg059_im001_seg001_v1\" src=\"images/pg059_im001_seg001_v1.png\" alt=\"Gjyqtarja shqyrton dokumentet dhe merr vendimin n&#xeb; gjykat&#xeb;.\" class=\"mx-auto w-full h-auto object-contain\">\n      <figcaption data-id=\"pg059_n0011\" class=\"adt-caption mt-3 text-center leading-snug text-slate-800\">Gjyqtarja shqyrton faktet, d&#xeb;gjon d&#xeb;shmitar&#xeb;t dhe merr vendimin.</figcaption>\n    </figure>\n    <figure class=\"flex flex-col justify-between border-2 border-amber-300 bg-white p-4\">\n      <img data-id=\"pg059_im001_seg002_v1\" src=\"images/pg059_im001_seg002_v1.png\" alt=\"Prokurori paraqet faktet kund&#xeb;r t&#xeb; akuzuarit.\" class=\"mx-auto w-full h-auto object-contain\">\n      <figcaption data-id=\"pg059_n0014\" class=\"adt-caption mt-3 text-center leading-snug text-slate-800\">Prokurori paraqet n&#xeb; gjykat&#xeb; faktet kund&#xeb;r t&#xeb; akuzuarit.</figcaption>\n    </figure>\n    <figure class=\"flex flex-col justify-between border-2 border-amber-300 bg-white p-4\">\n      <img data-id=\"pg059_im001_seg003_v1\" src=\"images/pg059_im001_seg003_v1.png\" alt=\"Noteri v&#xeb;rteton dokumentet n&#xeb; zyr&#xeb;.\" class=\"mx-auto w-full h-auto object-contain\">\n      <figcaption data-id=\"pg059_n0018\" class=\"adt-caption mt-3 text-center leading-snug text-slate-800\">Noteri d&#xeb;shmon p&#xeb;r v&#xeb;rtet&#xeb;sin&#xeb; e dokumenteve.</figcaption>\n    </figure>\n    <figure class=\"flex flex-col justify-between border-2 border-amber-300 bg-white p-4\">\n      <img data-id=\"pg059_im001_seg004_v1\" src=\"images/pg059_im001_seg004_v1.png\" alt=\"Avokatja mbron t&#xeb; akuzuarit duke p&#xeb;rdorur fakte dhe ligje.\" class=\"mx-auto w-full h-auto object-contain\">\n      <figcaption data-id=\"pg059_n0021\" class=\"adt-caption mt-3 text-center leading-snug text-slate-800\">Avokatja mbron t&#xeb; akuzuarit n&#xeb;p&#xeb;rmjet fakteve, duke interpretuar ligjet.</figcaption>\n    </figure>\n  </div>\n\n  <div class=\"mb-5 border border-purple-300 bg-purple-200/80 p-0\">\n    <div class=\"p-3\">\n      <p class=\"adt-body text-left leading-relaxed text-slate-800\">\n        <span data-id=\"pg059_n0023\">- Flisni rreth p&#xeb;rshtypjeve q&#xeb; keni nga vizita e organizuar n&#xeb; studion ligjore.</span>\n      </p>\n    </div>\n    <div class=\"border-t border-purple-300 bg-purple-100/70 p-3\">\n      <label for=\"item-1\" class=\"sr-only\">- Flisni rreth p&#xeb;rshtypjeve q&#xeb; keni nga vizita e organizuar n&#xeb; studion ligjore.</label>\n      <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"- Flisni rreth p&#xeb;rshtypjeve q&#xeb; keni nga vizita e organizuar n&#xeb; studion ligjore.\" class=\"min-h-11 w-full rounded-md border-2 border-purple-300 bg-white px-4 py-3 text-slate-800 outline-none focus:border-purple-500\" rows=\"4\"></textarea>\n    </div>\n  </div>\n\n  <div class=\"mb-8 border-2 border-purple-300 bg-white p-4\">\n    <p class=\"adt-body text-left italic leading-relaxed text-slate-800\">\n      <span data-id=\"pg059_n0026\">Zgjidhja e konflikteve bazohet n&#xeb; ligjet e Kosov&#xeb;s dhe ligjet nd&#xeb;rkomb&#xeb;tare, q&#xeb; mbrojn&#xeb; t&#xeb; drejtat e njeriut.</span>\n      <span data-id=\"pg059_n0027\" class=\"ml-1\">&#xc7;do vend duhet t&#xeb; ket&#xeb; nj&#xeb; sistem t&#xeb; drejt&#xeb;sis&#xeb; q&#xeb; funksionon mir&#xeb;, &#xeb;sht&#xeb; i drejt&#xeb;, i hapur dhe i ndersh&#xeb;m me t&#xeb; gjith&#xeb; qytetar&#xeb;t.</span>\n      <span data-id=\"pg059_n0028\" class=\"ml-1\">Ligjet jan&#xeb; shum&#xeb; t&#xeb; r&#xeb;nd&#xeb;sishme dhe duhen zbatuar p&#xeb;r t&#xeb; mbrojtur njer&#xeb;zit dhe p&#xeb;r t&#xeb; ndihmuar shoq&#xeb;rin&#xeb; t&#xeb; jet&#xeb; e drejt&#xeb; dhe demokratike.</span>\n      <span data-id=\"pg059_n0029\" class=\"ml-1\">Avokat&#xeb;t jan&#xeb; persona q&#xeb; e njohin mir&#xeb; ligjin dhe ndihmojn&#xeb; njer&#xeb;zit kur ata kan&#xeb; probleme.</span>\n      <span data-id=\"pg059_n0030\" class=\"ml-1\">Ata duhet t&#xeb; jen&#xeb; t&#xeb; p&#xeb;rgjegjsh&#xeb;m dhe t&#xeb; sillen me ndershm&#xeb;ri, q&#xeb; drejt&#xeb;sia t&#xeb; funksionoj&#xeb; si duhet.</span>\n      <span data-id=\"pg059_n0031\" class=\"ml-1\">Drejt&#xeb;sia &#xeb;sht&#xeb; p&#xeb;rmir&#xeb;suar me koh&#xeb;n, q&#xeb; t&#xeb; jet&#xeb; m&#xeb; e mir&#xeb; p&#xeb;r t&#xeb; gjith&#xeb;.</span>\n    </p>\n  </div>\n\n  <div class=\"border-t border-slate-200 pt-4\">\n    <p class=\"adt-body text-left leading-relaxed text-slate-800\">\n      <span data-id=\"pg059_n0033\" class=\"font-semibold\">Fjal&#xeb;t ky&#xe7;e:</span>\n      <span data-id=\"pg059_n0034\" class=\"ml-1\">drejt&#xeb;si, studio, prokuror, gjyqtar, avokat, noter, ligj.</span>\n    </p>\n  </div>\n</section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg060_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg060_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"73\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg060_sec001\" class=\"mx-auto w-full max-w-5xl px-8 py-8 max-sm:px-5 bg-white text-slate-800\">\n    <div class=\"mb-10 flex items-center gap-0 max-sm:items-stretch\">\n      <div class=\"flex h-44 w-36 shrink-0 items-center justify-center rounded-l-[1.75rem] bg-purple-500 max-sm:h-auto max-sm:w-24\">\n        <div aria-hidden=\"true\" class=\"h-24 w-24 bg-white [clip-path:polygon(45%_0%,60%_12%,72%_10%,82%_22%,95%_32%,88%_48%,92%_62%,80%_70%,76%_84%,62%_82%,50%_100%,42%_82%,28%_78%,16%_64%,8%_48%,14%_30%,28%_20%,36%_8%)]\"></div>\n      </div>\n      <div class=\"flex-1 pt-12 max-sm:pt-4\">\n        <div class=\"bg-purple-500 px-4 py-3 text-white\">\n          <h1 class=\"adt-h2 font-semibold\" data-id=\"pg060_n0002\">Vendi ku jetoj</h1>\n        </div>\n        <div class=\"max-w-[30rem] border-b-4 border-purple-400 px-4 py-4\">\n          <h3 class=\"adt-h3 font-medium text-slate-800\" data-id=\"pg060_n0003\">Kosova &#x2013; atdheu im</h3>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mb-8\">\n      <div class=\"adt-body leading-relaxed text-left\">\n        <h3 class=\"adt-h3 inline-block mr-4 min-w-[10rem] bg-green-500 px-4 py-1 text-right font-medium text-slate-900 align-top max-sm:mb-2 max-sm:min-w-0 max-sm:text-left\" data-id=\"pg060_n0005\">Situata 1.</h3>\n        <span data-id=\"pg060_n0006\">M&#xeb;suesi k&#xeb;rkoi nga nx&#xeb;n&#xeb;sit t&#xeb; shkruajn&#xeb; &#xe7;far&#xeb; din&#xeb; p&#xeb;r Kosov&#xeb;n.</span>\n        <span data-id=\"pg060_n0007\">Nx&#xeb;n&#xeb;sit me shum&#xeb; d&#xeb;shir&#xeb; thur&#xeb;n vargje, duke zgjedhur fjal&#xeb;t m&#xeb; t&#xeb; bukura p&#xeb;r vendin ton&#xeb;.</span>\n        <span data-id=\"pg060_n0008\">N&#xeb; klas&#xeb; u organizua nj&#xeb; gar&#xeb; p&#xeb;r zgjedhjen e poezis&#xeb; m&#xeb; t&#xeb; bukur.</span>\n        <span data-id=\"pg060_n0009\">Ata i lexuan ato para klas&#xeb;s.</span>\n        <span data-id=\"pg060_n0010\">Poezia m&#xeb; e bukur ishte ajo e Malit, t&#xeb; cil&#xeb;n vendos&#xeb;n ta d&#xeb;rgonin n&#xeb; redaksi p&#xeb;r botim.</span>\n        <span data-id=\"pg060_n0011\">Eja ta lexojm&#xeb; edhe nj&#xeb; her&#xeb; s&#xeb; bashku</span>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-[0.95fr_1.05fr] gap-8 items-start max-lg:grid-cols-1 mb-10\">\n      <div class=\"pt-2\">\n        <img data-id=\"pg060_im001_seg001_v1\" src=\"images/pg060_im001_seg001_v1.png\" alt=\"Djal&#xeb; nx&#xeb;n&#xeb;s duke mbajtur nj&#xeb; lib&#xeb;r t&#xeb; hapur dhe duke recituar me buz&#xeb;qeshje.\" class=\"w-full h-auto rounded-none\">\n      </div>\n      <div class=\"relative min-h-[34rem] pt-8 max-lg:min-h-0 max-lg:pt-2\">\n        <img data-id=\"pg060_im001_seg002_v1\" src=\"images/pg060_im001_seg002_v1.png\" alt=\"Harta e Kosov&#xeb;s e paraqitur me ngjyr&#xeb; t&#xeb; gjelb&#xeb;r t&#xeb; &#xe7;el&#xeb;t.\" class=\"absolute right-0 top-10 z-0 w-[90%] h-auto opacity-25 max-lg:relative max-lg:top-0 max-lg:mb-4 max-lg:w-full\">\n        <div class=\"relative z-10 text-left\">\n          <div class=\"mb-6\">\n            <div class=\"adt-caption font-medium text-slate-800\" data-id=\"pg060_n0013\">Kosova</div>\n          </div>\n          <div class=\"adt-body space-y-1 leading-relaxed text-slate-800 max-sm:bg-white/70 max-sm:p-2\">\n            <div data-id=\"pg060_n0015\">E dua Kosov&#xeb;n e maleve t&#xeb; Sharrit</div>\n            <div data-id=\"pg060_n0016\">E dua Kosov&#xeb;n e Adem Jasharit.</div>\n            <div data-id=\"pg060_n0017\">E dua Kosov&#xeb;n, t&#xeb; fort&#xeb; e trime</div>\n            <div data-id=\"pg060_n0018\">T&#xeb; luft&#xeb;tar&#xeb;ve e n&#xeb;nave heroike.</div>\n            <div data-id=\"pg060_n0019\">E dua Kosov&#xeb;n e q&#xeb;ndres&#xeb;s</div>\n            <div data-id=\"pg060_n0020\">T&#xeb; fjal&#xeb;s e t&#xeb; bes&#xeb;s.</div>\n            <div data-id=\"pg060_n0021\">E dua Kosov&#xeb;n e dashuris&#xeb;</div>\n            <div data-id=\"pg060_n0022\">E dua Kosov&#xeb;n e mir&#xeb;sis&#xeb;.</div>\n            <div data-id=\"pg060_n0023\">E dua p&#xeb;r malet e gjelb&#xeb;ruara,</div>\n            <div data-id=\"pg060_n0024\">E dua p&#xeb;r pasurit&#xeb; e bekuara.</div>\n            <div data-id=\"pg060_n0025\">E dua Kosov&#xeb;n e Kushtetut&#xeb;s dhe t&#xeb; ligjit,</div>\n            <div data-id=\"pg060_n0026\">T&#xeb; dua ashtu si je</div>\n            <div data-id=\"pg060_n0027\">Se p&#xeb;r mua je m&#xeb; i bukuri ATDHE.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mb-12 rounded-[2rem] bg-purple-200/90 px-6 py-5 max-sm:px-3\">\n      <div class=\"flex items-start gap-4 max-sm:flex-col\">\n        <div aria-hidden=\"true\" class=\"flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-purple-500 text-white max-sm:h-14 max-sm:w-14\">?</div>\n        <div class=\"flex-1 space-y-5\">\n          <div>\n            <div class=\"adt-body\" data-id=\"pg060_n0031\">&#xc7;far&#xeb; mendon p&#xeb;r k&#xeb;t&#xeb; poezi?</div>\n            <label for=\"item-1\" class=\"sr-only\">&#xc7;far&#xeb; mendon p&#xeb;r k&#xeb;t&#xeb; poezi?</label>\n            <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"&#xc7;far&#xeb; mendon p&#xeb;r k&#xeb;t&#xeb; poezi?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-purple-300 bg-white px-4 py-3 text-slate-800 outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n          </div>\n          <div>\n            <div class=\"adt-body\" data-id=\"pg060_n0033\">P&#xeb;rse p&#xeb;rmendet luft&#xeb;tari Adem Jashari?</div>\n            <label for=\"item-2\" class=\"sr-only\">P&#xeb;rse p&#xeb;rmendet luft&#xeb;tari Adem Jashari?</label>\n            <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"P&#xeb;rse p&#xeb;rmendet luft&#xeb;tari Adem Jashari?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-purple-300 bg-white px-4 py-3 text-slate-800 outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n          </div>\n          <div>\n            <div class=\"adt-body\" data-id=\"pg060_n0035\">Si e tregon ti dashurin&#xeb; p&#xeb;r vendin t&#xeb;nd?</div>\n            <label for=\"item-3\" class=\"sr-only\">Si e tregon ti dashurin&#xeb; p&#xeb;r vendin t&#xeb;nd?</label>\n            <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Si e tregon ti dashurin&#xeb; p&#xeb;r vendin t&#xeb;nd?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-purple-300 bg-white px-4 py-3 text-slate-800 outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n          </div>\n          <div>\n            <div class=\"adt-body\" data-id=\"pg060_n0037\">P&#xeb;rse ekzistojn&#xeb; kushtetuta dhe ligji n&#xeb; nj&#xeb; shtet?</div>\n            <label for=\"item-4\" class=\"sr-only\">P&#xeb;rse ekzistojn&#xeb; kushtetuta dhe ligji n&#xeb; nj&#xeb; shtet?</label>\n            <textarea id=\"item-4\" data-activity-item=\"item-4\" aria-label=\"P&#xeb;rse ekzistojn&#xeb; kushtetuta dhe ligji n&#xeb; nj&#xeb; shtet?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-purple-300 bg-white px-4 py-3 text-slate-800 outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n          </div>\n          <div>\n            <div class=\"adt-body\" data-id=\"pg060_n0039\">&#xc7;far&#xeb; ndodh n&#xeb;se nj&#xeb; njeri nuk i respekton ligjet?</div>\n            <label for=\"item-5\" class=\"sr-only\">&#xc7;far&#xeb; ndodh n&#xeb;se nj&#xeb; njeri nuk i respekton ligjet?</label>\n            <textarea id=\"item-5\" data-activity-item=\"item-5\" aria-label=\"&#xc7;far&#xeb; ndodh n&#xeb;se nj&#xeb; njeri nuk i respekton ligjet?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-purple-300 bg-white px-4 py-3 text-slate-800 outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mb-8 rounded-[2rem] border-2 border-purple-300 bg-white px-4 py-4\">\n      <div class=\"flex items-start gap-4 max-sm:flex-col\">\n        <div aria-hidden=\"true\" class=\"flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-purple-500 text-white\">&#x1f4d6;</div>\n        <p class=\"adt-body text-left italic leading-relaxed text-slate-800\">\n          <span data-id=\"pg060_n0042\">Atdheu tregon rr&#xeb;nj&#xeb;t tona, vendin ku kemi lindur, tregon traditat dhe zakonet tona.</span>\n          <span data-id=\"pg060_n0043\">Atdheu yn&#xeb; &#xeb;sht&#xeb; Kosova.</span>\n          <span data-id=\"pg060_n0044\">Ne jemi krenar&#xeb; p&#xeb;r vendin ton&#xeb;.</span>\n          <span data-id=\"pg060_n0045\">Kosova ka trash&#xeb;guar shum&#xeb; bukuri natyrore.</span>\n          <span data-id=\"pg060_n0046\">Ne krenohemi me historin&#xeb; e Kosov&#xeb;s, e cila sh&#xeb;rben si nj&#xeb; udh&#xeb;rr&#xeb;fyes p&#xeb;r gjith&#xeb; brezat e rinj.</span>\n          <span data-id=\"pg060_n0047\">Kosova qeveriset me sistem demokratik, i cili p&#xeb;rb&#xeb;het nga tri deg&#xeb; t&#xeb; pavarura t&#xeb; pushtetit: Parlamenti, Qeveria dhe Gjyq&#xeb;sori.</span>\n          <span data-id=\"pg060_n0048\">Q&#xeb; t&#xeb; tria k&#xeb;to, punojn&#xeb; n&#xeb; p&#xeb;rputhje me Kushtetut&#xeb;n dhe ligjet, t&#xeb; cilat nxirren nga Parlamenti.</span>\n        </p>\n      </div>\n    </div>\n\n    <div class=\"border-l-4 border-purple-400 pl-3 pt-2\">\n      <p class=\"adt-body text-left\">\n        <span class=\"font-semibold\" data-id=\"pg060_n0051\">Fjal&#xeb;t ky&#xe7;e:</span>\n        <span data-id=\"pg060_n0052\">Kosov&#xeb;, atdhe, shqiptar, kosovar.</span>\n      </p>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg061_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg061_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"74\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\"><section data-section-type=\"text_and_single_image\" data-section-id=\"pg061_sec001\" class=\"mx-auto w-full max-w-5xl px-8 py-8 max-sm:px-5 bg-white text-slate-800\"><div class=\"w-full mb-8\"><div class=\"bg-purple-500\"><div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-4\"><h1 class=\"adt-h2 font-bold text-white\" data-id=\"pg061_n0002\">Vendi ku jetoj</h1></div></div></div><div class=\"mb-6\"><h3 class=\"adt-h3 font-semibold text-slate-800 border-b-4 border-purple-400 pb-3 inline-block min-w-[32rem] max-lg:min-w-0\" data-id=\"pg061_n0004\">Pavar&#xeb;sia e Kosov&#xeb;s</h3></div><div class=\"mb-5\"><h3 class=\"adt-h3 inline-block bg-green-500 text-slate-900 font-semibold px-4 py-2 rounded-sm\" data-id=\"pg061_n0007\">Situata 1.</h3></div><p class=\"adt-body leading-relaxed mb-4 text-left\"><span data-id=\"pg061_n0009\">N&#xeb; familjen e Kledit po p&#xeb;rgatiten p&#xeb;r udh&#xeb;tim.</span> <span data-id=\"pg061_n0010\">Ata do t&#xeb; shkojn&#xeb; p&#xeb;r pushime n&#xeb; Angli.</span> <span data-id=\"pg061_n0011\">Sa i emocionuar &#xeb;sht&#xeb; Kledi 6-vje&#xe7;ar, sepse &#xeb;sht&#xeb; hera e par&#xeb; q&#xeb; ai do t&#xeb; udh&#xeb;toj&#xeb; me aeroplan.</span> <span data-id=\"pg061_n0012\">T&#xeb; gjith&#xeb; po mblidhnin gj&#xeb;rat e nevojshme dhe po i palosnin n&#xeb; valixhe.</span></p><p class=\"adt-body leading-relaxed mb-4 text-left\"><span data-id=\"pg061_n0014\">Mamaja erdhi me pasaportat n&#xeb; dor&#xeb;.</span> <span data-id=\"pg061_n0015\">K&#xeb;to jan&#xeb; m&#xeb; t&#xeb; r&#xeb;nd&#xeb;sishmet, se pa to nuk mund t&#xeb; hyjm&#xeb; n&#xeb; aeroplan.</span> <span data-id=\"pg061_n0016\">Kledi mori pasaport&#xeb;n n&#xeb; dor&#xeb; dhe po e shikonte me kujdes.</span></p><p class=\"adt-body leading-relaxed mb-4 text-left\"><span data-id=\"pg061_n0018\">- Babi, - pyeti ai.</span> <span data-id=\"pg061_n0019\">- Pse n&#xeb; pasaport&#xeb; &#xeb;sht&#xeb; flamuri yn&#xeb;?</span> <span data-id=\"pg061_n0020\">- Nuk &#xeb;sht&#xeb; flamuri, biri im.</span> <span data-id=\"pg061_n0021\">&#xcb;sht&#xeb; stema e Kosov&#xeb;s, - tha babai.</span> <span data-id=\"pg061_n0022\">- &#xc7;far&#xeb; &#xeb;sht&#xeb; stema?</span> <span data-id=\"pg061_n0023\">- Secili shtet ka flamurin, stem&#xeb;n dhe himnin e tij.</span> <span data-id=\"pg061_n0024\">K&#xeb;to jan&#xeb; simbolet e shtetit.</span> <span data-id=\"pg061_n0025\">Simbolet e p&#xeb;rfaq&#xeb;sojn&#xeb; shtetin ton&#xeb; n&#xeb; t&#xeb; gjith&#xeb; bot&#xeb;n.</span> <span data-id=\"pg061_n0026\">Edhe shteti yn&#xeb;, Kosova jon&#xeb; e dashur, q&#xeb; nga data 17 shkurt 2008, ka fituar Pavar&#xeb;sin&#xeb;, &#xeb;sht&#xeb; shpallur shtet dhe quhet Republika e Kosov&#xeb;s.</span> <span data-id=\"pg061_n0027\">17 Shkurti &#xeb;sht&#xeb; festa jon&#xeb; shtet&#xeb;rore.</span></p><p class=\"adt-body leading-relaxed mb-4 text-left\"><span data-id=\"pg061_n0029\">- Pse n&#xeb; flamur jan&#xeb; gjasht&#xeb; yje? - vazhdoi Kledi.</span> <span data-id=\"pg061_n0030\">- Sepse, p&#xeb;rve&#xe7; shqiptar&#xeb;ve, n&#xeb; Kosov&#xeb; jetojn&#xeb; edhe popuj t&#xeb; tjer&#xeb;.</span> <span data-id=\"pg061_n0031\">- Ua, - nd&#xeb;rhyri mamaja.</span> <span data-id=\"pg061_n0032\">- Vazhdoni nj&#xeb; her&#xeb; tjet&#xeb;r bised&#xeb;n se koha po ik&#xeb;n e ne duhet t&#xeb; nisemi.</span></p><p class=\"adt-body leading-relaxed mb-6 text-left\"><span data-id=\"pg061_n0034\">Kledi p&#xeb;r her&#xeb; t&#xeb; par&#xeb; d&#xeb;gjoi p&#xeb;r simbolet e shtetit dhe iu duk shum&#xeb; interesante.</span></p><div class=\"mt-8\"><img src=\"images/pg061_im001_seg003_v1.png\" alt=\"Babai dhe djali po p&#xeb;rgatisin valixhen p&#xeb;r udh&#xeb;tim; djali mban pasaport&#xeb;n, nd&#xeb;rsa sip&#xeb;r shihen flamuri dhe stema e Kosov&#xeb;s.\" data-id=\"pg061_im001_seg003_v1\" class=\"w-full h-auto rounded-lg\"></div></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg062_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg062_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"75\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">