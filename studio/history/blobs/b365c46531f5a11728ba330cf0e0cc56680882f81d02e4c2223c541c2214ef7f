uar heqja e vizave n&#xeb; jet&#xeb;n e familjeve n&#xeb; Kosov&#xeb;?</label>\n              <textarea id=\"item-5\" data-activity-item=\"item-5\" aria-label=\"Si ka ndikuar heqja e vizave n&#xeb; jet&#xeb;n e familjeve n&#xeb; Kosov&#xeb;?\" class=\"mt-2 w-full min-h-11 rounded-xl border-2 border-purple-300 bg-white px-4 py-3 text-gray-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n            </li>\n            <li>\n              <p class=\"adt-body text-gray-900\"><span data-id=\"pg062_n0017\">D&#xeb;gjojeni Himnin e Kosov&#xeb;s n&#xeb; klas&#xeb;.</span></p>\n              <label for=\"item-6\" class=\"sr-only\">D&#xeb;gjojeni Himnin e Kosov&#xeb;s n&#xeb; klas&#xeb;.</label>\n              <textarea id=\"item-6\" data-activity-item=\"item-6\" aria-label=\"D&#xeb;gjojeni Himnin e Kosov&#xeb;s n&#xeb; klas&#xeb;.\" class=\"mt-2 w-full min-h-11 rounded-xl border-2 border-purple-300 bg-white px-4 py-3 text-gray-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </aside>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg062_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg062_sec002\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not 