face-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg082_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg082_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"104\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\"><section data-section-type=\"text_and_single_image\" data-section-id=\"pg082_sec001\" class=\"mx-auto w-full max-w-5xl bg-white px-8 py-8 text-stone-800 max-sm:px-5\"><div class=\"mb-10 flex items-end gap-0 max-sm:mb-8 max-sm:items-stretch\"><div aria-hidden=\"true\" class=\"flex h-56 w-36 shrink-0 items-center justify-center rounded-l-2xl bg-purple-500 max-sm:h-32 max-sm:w-24\"><div class=\"flex h-28 w-20 items-center justify-center rounded-[1.5rem] border-4 border-white bg-transparent max-sm:h-20 max-sm:w-14\"><div class=\"h-20 w-14 rounded-[1rem] border-4 border-white bg-white max-sm:h-14 max-sm:w-10\"></div></div></div><div class=\"flex flex-1 flex-col pb-5 max-sm:pb-2\"><div class=\"h-12 w-full bg-purple-500 max-sm:h-10\"></div><div class=\"bg-white pt-4\"><h1 data-id=\"pg082_n0003\" class=\"adt-h2 text-left font-semibold text-stone-800\">Ruajm&#xeb; traditat tona</h1><div class=\"mt-2 h-1 w-3/5 bg-purple-400 max-sm:w-4/5\"></div></div></div></div><div class=\"mb-6\"><h3 data-id=\"pg082_n0005\" class=\"adt-h3 inline-block bg-green-400 px-6 py-2 text-left font-semibold text-stone-900\">Situata 1.</h3></div><div class=\"max-w-[68rem]\"><p class=\"adt-body mb-3 text-left leading-relaxed\"><span data-id=\"pg082_n0007\">Mali, bashk&#xeb; me prind&#xeb;rit e tij, u ftuan p&#xeb;r vizit&#xeb; nga disa miq t&#xeb; vjet&#xeb;r n&#xeb; qytetin e Shkodr&#xeb;s, n&#xeb; Shqip&#xeb;ri.</span> <span data-id=\"pg082_n0008\">Gjat&#xeb; vizit&#xeb;s s&#xeb; tyre, Mali provoi nj&#xeb; pjat&#xeb; me ushqime tradicionale q&#xeb; s&#x2019;e kishte ngr&#xeb;n&#xeb; kurr&#xeb; m&#xeb; par&#xeb;.</span></p><p class=\"adt-body mb-3 text-left leading-relaxed\"><span data-id=\"pg082_n0010\">N&#xeb; bashk&#xeb;bisedim me prind&#xeb;rit, ai kishte kuptuar q&#xeb; pothuajse &#xe7;do vend kishte karakteristikat e tij n&#xeb; ushqim, n&#xeb; veshje, n&#xeb; t&#xeb; folur, q&#xeb; e dallonin nga vendet e tjera.</span></p><p class=\"adt-body mb-3 text-left leading-relaxed\"><span data-id=\"pg082_n0012\">P&#xeb;r Malin, ushqimi ishte m&#xeb; i ve&#xe7;ant&#xeb; se ushqimet q&#xeb; ai kishte provuar.</span> <span data-id=\"pg082_n0013\">Ajo q&#xeb; i b&#xeb;ri shum&#xeb; p&#xeb;rshtypje ishte mikpritja q&#xeb; iu b&#xeb; n&#xeb; familjen shkodrane dhe humori q&#xeb; i karakterizonte ata gjat&#xeb; gjith&#xeb; koh&#xeb;s.</span> <span data-id=\"pg082_n0014\">Familja e Malit u prit me shum&#xeb; dashuri.</span> <span data-id=\"pg082_n0015\">Atyre u sh&#xeb;rbyen &#xe7;aj dhe &#xeb;mb&#xeb;lsira, duke kaluar, k&#xeb;shtu, &#xe7;aste shum&#xeb; t&#xeb; bukura.</span></p><p class=\"adt-body mb-3 text-left leading-relaxed\"><span data-id=\"pg082_n0017\">Mali u miq&#xeb;sua shum&#xeb; me Tomorin, djalin e familjes shkodrane dhe s&#xeb; bashku kaluan t&#xeb;r&#xeb; pasditen.</span> <span data-id=\"pg082_n0018\">Tomori i kishte ndar&#xeb; t&#xeb; gjitha lodrat me Malin dhe e kishte b&#xeb;r&#xeb; at&#xeb; q&#xeb; t&#xeb; ndihej si n&#xeb; sht&#xeb;pin&#xeb; e vet.</span></p><p class=\"adt-body mb-10 text-left leading-relaxed\"><span data-id=\"pg082_n0020\">Gjat&#xeb; kthimit p&#xeb;r n&#xeb; sht&#xeb;pi, Mali i tha babait q&#xeb; ishte befasuar nga mikpritja.</span> <span data-id=\"pg082_n0021\">Babai i tha Malit se shqiptar&#xeb;t k&#xeb;t&#xeb; tradit&#xeb; e kan&#xeb; t&#xeb; trash&#xeb;guar nga paraardh&#xeb;sit.</span></p></div><figure><img data-id=\"pg082_im001\" src=\"images/pg082_im001.png\" alt=\"Pamje panoramike e Shkodr&#xeb;s, me muret e kalas&#xeb; n&#xeb; plan t&#xeb; par&#xeb; dhe malet n&#xeb; sfond.\" class=\"w-full h-auto object-cover\"><figcaption data-id=\"pg082_n0023\" class=\"adt-caption mt-4 text-center font-semibold text-stone-800\">Shkodra</figcaption></figure></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg083_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg083_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"105\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 bg-white opacity-0\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg083_sec001\" class=\"py-8 max-sm:py-5 text-left text-neutral-800\">\n    <div class=\"mb-5\">\n      <div class=\"flex items-stretch justify-between gap-0 max-sm:flex-col\">\n        <div class=\"flex-1 bg-gradient-to-r from-purple-500 to-fuchsia-500 text-white px-8 py-6 max-sm:px-4 max-sm:py-4 rounded-l-none rounded-r-none max-sm:rounded-b-3xl\">\n          <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg083_n0002\">Traditat dhe trash&#xeb;gimia jon&#xeb;</h1>\n        </div>\n        <div aria-hidden=\"true\" class=\"w-36 bg-purple-500 rounded-b-2xl rounded-t-md flex items-center justify-center max-sm:w-full max-sm:justify-start max-sm:px-4 max-sm:py-3 max-sm:rounded-t-none max-sm:rounded-b-3xl\">\n          <div class=\"w-20 h-20 rounded-[1.75rem] border-4 border-white/80 bg-transparent max-sm:w-14 max-sm:h-14\"></div>\n        </div>\n      </div>\n    </div>\n\n    <h2 class=\"adt-h2 font-semibold text-neutral-900 mb-8 border-b-4 border-purple-400 inline-block pb-2\" data-id=\"pg083_n0003\">Ruajm&#xeb; traditat tona</h2>\n\n    <div class=\"grid grid-cols-2 gap-4 items-start max-lg:grid-cols-1 mb-3\">\n      <div class=\"flex flex-col gap-2\">\n        <img src=\"images/pg083_im004.png\" alt=\"Tryez&#xeb; me ushqime tradicionale shqiptare, me pite, speca t&#xeb; mbushur, sarma, mish, &#xeb;mb&#xeb;lsira dhe en&#xeb; tradicionale.\" data-id=\"pg083_im004\" class=\"w-full h-auto rounded-sm border-4 border-emerald-300 shadow-md\">\n        <div class=\"adt-caption text-neutral-900\" data-id=\"pg083_n0005\">Ushqim tradicional</div>\n      </div>\n      <div>\n        <img src=\"images/pg083_im005.png\" alt=\"Piktur&#xeb; e nj&#xeb; feste tradicionale me gra, burra dhe f&#xeb;mij&#xeb; me veshje popullore, t&#xeb; mbledhur n&#xeb; oborr pran&#xeb; sht&#xeb;pive t&#xeb; vjetra.\" data-id=\"pg083_im005\" class=\"w-full h-auto rounded-sm border-4 border-emerald-300 shadow-md\">\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-[1fr_1fr_1fr] gap-6 items-end max-lg:grid-cols-1 mb-6\">\n      <div class=\"self-center\">\n        <p class=\"adt-body leading-tight text-neutral-900\">\n          <span data-id=\"pg083_n0007\">Veshjet tona</span><br>\n          <span data-id=\"pg083_n0008\">tradicionale</span>\n        </p>\n      </div>\n      <div>\n        <img src=\"images/pg083_im003.png\" alt=\"Veshje tradicionale e grave, e paraqitur nga p&#xeb;rpara dhe anash, me k&#xeb;mish&#xeb; t&#xeb; q&#xeb;ndisur, jelek, shami dhe p&#xeb;rpar&#xeb;se me thek&#xeb;.\" data-id=\"pg083_im003\" class=\"w-full h-auto rounded-sm border-4 border-emerald-300 bg-white shadow-md\">\n      </div>\n      <div>\n        <img src=\"images/pg083_im002.png\" alt=\"Veshje tradicionale e burrave, e paraqitur nga p&#xeb;rpara dhe anash, me tirq, xhamadan t&#xeb; &#xe7;el&#xeb;t, brez dhe mbules&#xeb; t&#xeb; bardh&#xeb; t&#xeb; kok&#xeb;s.\" data-id=\"pg083_im002\" class=\"w-full h-auto rounded-sm border-4 border-emerald-300 bg-white shadow-md\">\n      </div>\n    </div>\n\n    <p class=\"adt-body mb-6\" data-id=\"pg083_n0009\">Ndahuni n&#xeb; grupe dhe diskutoni p&#xeb;r fotografit&#xeb; e dh&#xeb;na.</p>\n\n    <aside class=\"bg-purple-100 border-l-8 border-purple-400 rounded-2xl p-5 mb-6\">\n      <div class=\"grid grid-cols-[1fr_auto] gap-4 items-start mb-4 max-sm:grid-cols-[1fr_auto]\">\n        <div></div>\n        <div aria-hidden=\"true\" class=\"w-16 h-16 rounded-xl bg-purple-500/85 flex items-center justify-center text-white font-bold leading-none\">?</div>\n      </div>\n      <div class=\"space-y-5\">\n        <div class=\"flex flex-col gap-2\">\n          <p class=\"adt-body\" data-id=\"pg083_n0013\">P&#xeb;rmend tri ushqime tradicionale.</p>\n          <label for=\"item-1\" class=\"sr-only\">P&#xeb;rmend tri ushqime tradicionale.</label>\n          <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"P&#xeb;rmend tri ushqime tradicionale.\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n        </div>\n        <div class=\"flex flex-col gap-2\">\n          <p class=\"adt-body\" data-id=\"pg083_n0015\">Trego tri elemente t&#xeb; tradit&#xeb;s son&#xeb; komb&#xeb;tare.</p>\n          <label for=\"item-2\" class=\"sr-only\">Trego tri elemente t&#xeb; tradit&#xeb;s son&#xeb; komb&#xeb;tare.</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Trego tri elemente t&#xeb; tradit&#xeb;s son&#xeb; komb&#xeb;tare.\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n        </div>\n        <div class=\"flex flex-col gap-2\">\n          <p class=\"adt-body\" data-id=\"pg083_n0017\">Si e kupton fjal&#xeb;n &#x201c;mikpritje&#x201d;?</p>\n          <label for=\"item-3\" class=\"sr-only\">Si e kupton fjal&#xeb;n mikpritje?</label>\n          <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Si e kupton fjal&#xeb;n mikpritje?\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n        </div>\n        <div class=\"flex flex-col gap-2\">\n          <p class=\"adt-body\">\n            <span data-id=\"pg083_n0019\">Shkruaj nj&#xeb; recet&#xeb; t&#xeb; nj&#xeb; ushqimi tradicional q&#xeb; e gatuani n&#xeb; sht&#xeb;pin&#xeb; tuaj.</span>\n            <span data-id=\"pg083_n0020\">Lexoni dhe shk&#xeb;mbeni recetat me shok&#xeb;t tuaj.</span>\n          </p>\n          <label for=\"item-4\" class=\"sr-only\">Shkruaj nj&#xeb; recet&#xeb; t&#xeb; nj&#xeb; ushqimi tradicional q&#xeb; e gatuani n&#xeb; sht&#xeb;pin&#xeb; tuaj.</label>\n          <textarea id=\"item-4\" data-activity-item=\"item-4\" aria-label=\"Shkruaj nj&#xeb; recet&#xeb; t&#xeb; nj&#xeb; ushqimi tradicional q&#xeb; e gatuani n&#xeb; sht&#xeb;pin&#xeb; tuaj.\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\" rows=\"5\"></textarea>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"mb-6 flex items-stretch max-sm:flex-col\">\n      <div class=\"flex-1 border-2 border-purple-300 rounded-l-2xl max-sm:rounded-t-2xl max-sm:rounded-b-none max-sm:rounded-l-2xl p-5 bg-white shadow-sm\">\n        <p class=\"adt-body italic mb-4 leading-relaxed\">\n          <span data-id=\"pg083_n0023\">Kultura ka t&#xeb; b&#xeb;j&#xeb; me m&#xeb;nyr&#xeb;n e jetes&#xeb;s s&#xeb; nj&#xeb; komuniteti a shoq&#xeb;rie.</span>\n          <span data-id=\"pg083_n0024\">Ajo p&#xeb;rfshin shum&#xeb; elemente, si: gjuh&#xeb;n, muzik&#xeb;n, artet, traditat, besimet, doket, zakonet etj.</span>\n        </p>\n        <p class=\"adt-body italic mb-4 leading-relaxed\">\n          <span data-id=\"pg083_n0026\">Tradita &#xeb;sht&#xeb; gjith&#xe7;ka q&#xeb; njer&#xeb;zit e nj&#xeb; populli kan&#xeb; b&#xeb;r&#xeb; dhe ruajtur p&#xeb;r shum&#xeb; koh&#xeb; - si zakonet, festat, k&#xeb;ng&#xeb;t, vallet, veshjet, besimet, virtytet dhe m&#xeb;nyra e jetes&#xeb;s.</span>\n        </p>\n        <p class=\"adt-body italic leading-relaxed\">\n          <span data-id=\"pg083_n0028\">Secili popull e ka tradit&#xeb;n e tij, si: n&#xeb; arkitektur&#xeb;n e qytetit, n&#xeb; nd&#xeb;rtimin dhe rregullimin e sht&#xeb;pive, n&#xeb; organizimin e festave t&#xeb; ndryshme, n&#xeb; m&#xeb;nyr&#xeb;n e gatimit etj.</span>\n          <span data-id=\"pg083_n0029\">Shqiptar&#xeb;t dallohen p&#xeb;r m&#xeb;nyr&#xeb;n e organizimit t&#xeb; dasmave tradicionale.</span>\n          <span data-id=\"pg083_n0030\">K&#xeb;to jan&#xeb; formuar p&#xeb;rgjat&#xeb; historis&#xeb; n&#xeb; jet&#xeb;n e nj&#xeb; populli dhe ruhen e trash&#xeb;gohen.</span>\n          <span data-id=\"pg083_n0031\">Vendi yn&#xeb; ka nj&#xeb; tradit&#xeb; mjaft t&#xeb; pasur, e cila ruhet dhe p&#xeb;rcillet brez pas brezi.</span>\n        </p>\n      </div>\n      <div aria-hidden=\"true\" class=\"w-24 bg-purple-500 rounded-r-2xl flex items-start justify-center pt-4 max-sm:w-full max-sm:h-20 max-sm:rounded-r-none max-sm:rounded-b-2xl max-sm:justify-end max-sm:px-5\">\n        <div class=\"relative w-10 h-12 border-2 border-white rounded-sm mt-1\">\n          <div class=\"absolute inset-x-1 top-2 border-t-2 border-white\"></div>\n          <div class=\"absolute inset-x-1 top-5 border-t-2 border-white\"></div>\n          <div class=\"absolute inset-x-1 top-8 border-t-2 border-white\"></div>\n          <div class=\"absolute -right-2 top-1 w-3 border-t-2 border-white\"></div>\n          <div class=\"absolute -left-1 bottom-0 w-2 h-2 border-l-2 border-b-2 border-white rounded-bl-sm\"></div>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"adt-body font-semibold\" data-id=\"pg083_n0032\">Fjal&#xeb;t ky&#xe7;e: tradit&#xeb;, zakon, ushqim, mikpritje.</p>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg084_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg084_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"106\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\">\n  <section data-section-type=\"text_and_single_image\" data-section-id=\"pg084_sec001\" class=\"mx-auto w-full max-w-5xl px-8 py-8 max-sm:px-5\">\n    <div class=\"mb-10 flex items-start gap-0 max-sm:flex-col max-sm:gap-3\">\n      <div class=\"flex h-56 w-36 shrink-0 items-center justify-center rounded-tl-md rounded-bl-md bg-purple-500 max-sm:h-32 max-sm:w-full max-sm:rounded-md max-sm:justify-start max-sm:px-6\">\n        <div aria-hidden=\"true\" class=\"h-28 w-20 rounded-[2rem] border-4 border-white bg-white shadow-inner\"></div>\n      </div>\n      <div class=\"flex-1 pt-14 max-sm:pt-0\">\n        <div class=\"bg-purple-500 px-6 py-3\">\n          <h1 data-id=\"pg084_n0002\" class=\"adt-h3 font-bold text-white\">Traditat dhe trash&#xeb;gimia jon&#xeb;</h1>\n        </div>\n        <div class=\"bg-white px-6 py-4\">\n          <h2 data-id=\"pg084_n0003\" class=\"adt-h2 font-semibold text-neutral-900\">Institucionet kulturore</h2>\n          <div aria-hidden=\"true\" class=\"mt-3 h-1 w-1/2 max-w-[480px] bg-purple-400\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mb-5 inline-block bg-green-400 px-6 py-2 shadow-sm\">\n      <h3 data-id=\"pg084_n0004\" class=\"adt-h3 font-medium text-neutral-900\">Situata 1.</h3>\n    </div>\n\n    <p class=\"adt-body mb-8 text-left leading-relaxed text-neutral-800\">\n      <span data-id=\"pg084_n0006\">F&#xeb;mij&#xeb;t e klas&#xeb;s s&#xeb; kat&#xeb;rt vizituan kryeqytetin e Kosov&#xeb;s, Prishtin&#xeb;n, s&#xeb; bashku me m&#xeb;suesen e tyre.</span>\n      <span data-id=\"pg084_n0007\">Gjat&#xeb; kthimit p&#xeb;r n&#xeb; qytetin e tyre, f&#xeb;mij&#xeb;t po bashk&#xeb;bisedonin me m&#xeb;suesen p&#xeb;r vendet q&#xeb; vizituan.</span>\n      <span data-id=\"pg084_n0008\">Secili f&#xeb;mij&#xeb; po tregonte se &#xe7;far&#xeb; i kishte b&#xeb;r&#xeb; p&#xeb;rshtypje.</span>\n      <span data-id=\"pg084_n0009\">Rronit i kishte b&#xeb;r&#xeb; p&#xeb;rshtypje Teatri i Kukullave, sepse p&#xeb;r t&#xeb; koha aty ishte &#xe7;lodh&#xeb;se, e k&#xeb;ndshme dhe shum&#xeb; edukative.</span>\n      <span data-id=\"pg084_n0010\">Alban&#xeb;s i kishte b&#xeb;r&#xeb; p&#xeb;rshtypje shum&#xeb; Muzeu i Kosov&#xeb;s.</span>\n      <span data-id=\"pg084_n0011\">Aty ajo kishte m&#xeb;suar m&#xeb; shum&#xeb; p&#xeb;r paraardh&#xeb;sit dhe historin&#xeb; e popullit ton&#xeb;.</span>\n      <span data-id=\"pg084_n0012\">Bora ishte mahnitur nga arkitektura e Bibliotek&#xeb;s Komb&#xeb;tare dhe thoshte se mezi priste q&#xeb; t&#xeb; b&#xeb;hej studente mjek&#xeb;sie e t&#xeb; lexonte aty.</span>\n      <span data-id=\"pg084_n0013\">P&#xeb;rshtypje f&#xeb;mij&#xeb;ve u kishte b&#xeb;r&#xeb; dhe Teatri Komb&#xeb;tar, Galeria e Arteve e vendet e tjera q&#xeb; i kishin vizituar shkurt, por p&#xeb;r secil&#xeb;n prej tyre kishin m&#xeb;suar di&#xe7;ka t&#xeb; ve&#xe7;ant&#xeb;.</span>\n    </p>\n\n    <figure class=\"mx-auto overflow-hidden border-4 border-green-400 bg-white shadow-sm\">\n      <img data-id=\"pg084_im001\" src=\"images/pg084_im001.png\" alt=\"Pamje panoramike e Prishtin&#xeb;s, me rrug&#xeb;, nd&#xeb;rtesa t&#xeb; qytetit, hap&#xeb;sira t&#xeb; gjelbra dhe Bibliotek&#xeb;n Komb&#xeb;tare t&#xeb; Kosov&#xeb;s n&#xeb; an&#xeb;n e djatht&#xeb;.\" class=\"block h-auto w-full\">\n      <figcaption data-id=\"pg084_n0015\" class=\"adt-caption px-4 py-3 text-center font-semibold text-neutral-900\">Kryeqyteti i Kosov&#xeb;s &#x2013; Prishtina</figcaption>\n    </figure>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg084_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg084_sec002\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"107\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <h1 class=\"sr-only\" id=\"page-heading\">Shoqëria dhe Mjedisi 4</h1>\n      <div class=\"container mx-auto max-w-5xl bg-white px-8 max-lg:px-6 max-sm:px-4 pt-10 pb-12 opacity-0\" id=\"content\"><section data-section-type=\"activity_fill_in_the_blank\" data-section-id=\"pg084_sec002\" role=\"region\" class=\"mx-auto max-w-5xl\"><div class=\"flex items-stretch max-sm:flex-col max-sm:gap-0\"><div class=\"flex w-28 shrink-0 items-center justify-center bg-purple-600 text-white max-sm:w-full max-sm:rounded-t-lg max-sm:py-4\" aria-hidden=\"true\"><div class=\"text-6xl font-semibold leading-none\">?</div></div><div class=\"flex-1 bg-purple-100 px-8 py-6 max-sm:rounded-b-lg max-sm:px-4\"><div class=\"space-y-5\"><div><label for=\"activity-answer-1\" class=\"mb-2 block adt-body leading-snug text-gray-900\"><span data-id=\"pg084_n0018\">Cilat jan&#xeb; institucionet kulturore n&#xeb; Kosov&#xeb;?</span></label><textarea id=\"activity-answer-1\" data-activity-item=\"item-1\" aria-label=\"Cilat jan&#xeb; institucionet kulturore n&#xeb; Kosov&#xeb;?\" class=\"min-h-11 w-full rounded-md border border-purple-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea></div><div><label for=\"activity-answer-2\" class=\"mb-2 block adt-body leading-snug text-gray-900\"><span data-id=\"pg084_n0019\">P&#xeb;rmend disa institucione kulturore n&#xeb; qytetin t&#xeb;nd.</span></label><textarea id=\"activity-answer-2\" data-activity-item=\"item-2\" aria-label=\"P&#xeb;rmend disa institucione kulturore n&#xeb; qytetin t&#xeb;nd.\" class=\"min-h-11 w-full rounded-md border border-purple-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea></div><div><label for=\"activity-answer-3\" class=\"mb-2 block adt-body leading-snug text-gray-900\"><span data-id=\"pg084_n0020\">Pse Bor&#xeb;s i b&#xeb;ri p&#xeb;rshtypje Biblioteka Komb&#xeb;tare?</span></label><textarea id=\"activity-answer-3\" data-activity-item=\"item-3\" aria-label=\"Pse Bor&#xeb;s i b&#xeb;ri p&#xeb;rshtypje Biblioteka Komb&#xeb;tare?\" class=\"min-h-11 w-full rounded-md border border-purple-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea></div><div><label for=\"activity-answer-4\" class=\"mb-2 block adt-body leading-snug text-gray-900\"><span data-id=\"pg084_n0021\">&#xc7;far&#xeb; r&#xeb;nd&#xeb;sie kan&#xeb; institucionet kulturore?</span></label><textarea id=\"activity-answer-4\" data-activity-item=\"item-4\" aria-label=\"&#xc7;far&#xeb; r&#xeb;nd&#xeb;sie kan&#xeb; institucionet kulturore?\" class=\"min-h-11 w-full rounded-md border border-purple-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea></div></div></div></div></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <script type=\"text/javascript\">\n        window.correctAnswers = JSON.parse('{\"item-1\":\"\",\"item-2\":\"\",\"item-3\":\"\",\"item-4\":\"\"}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg085_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg085_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"108\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg085_sec001\" class=\"w-full bg-white overflow-hidden\">\n    <div class=\"w-full pt-8\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5\">\n        <div class=\"relative mb-6\">\n          <div class=\"h-12 bg-purple-500\"></div>\n          <div class=\"absolute right-8 top-[-14px] h-28 w-36 rounded-md bg-purple-500 max-sm:hidden\"></div>\n        </div>\n        <h1 class=\"adt-h2 font-bold text-left text-neutral-900\" data-id=\"pg085_n0004\">Institucionet kulturore</h1>\n        <div aria-hidden=\"true\" class=\"mt-3 h-1 w-96 max-sm:w-44 bg-purple-400\"></div>\n      </div>\n    </div>\n\n    <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-8 space-y-6\">\n      <div class=\"border-2 border-purple-300 bg-white p-5 max-sm:p-4 shadow-sm\">\n        <p class=\"adt-body text-left italic leading-relaxed text-neutral-800\">\n          <span data-id=\"pg085_n0007\">Institucionet kulturore jan&#xeb; vende ku njer&#xeb;zit m&#xeb;sojn&#xeb; p&#xeb;r kultur&#xeb;n, historin&#xeb;, tradit&#xeb;n, artin etj.</span>\n          <span data-id=\"pg085_n0008\">N&#xeb; k&#xeb;to vende ruhen, prezantohen dhe shpjegohen gj&#xeb;rat e vlefshme, si: zakonet, veprat artistike, librat, filmat dhe shum&#xeb; t&#xeb; tjera.</span><br>\n          <span data-id=\"pg085_n0009\">Ato p&#xeb;rb&#xeb;hen nga: muzet&#xeb;, teatrot, kinemat&#xeb;, bibliotekat, galerit&#xeb; etj.</span><br>\n          <span data-id=\"pg085_n0010\">K&#xeb;to institucione u mund&#xeb;sojn&#xeb; njer&#xeb;zve t&#xeb; m&#xeb;sojn&#xeb; dhe t&#xeb; njihen me kultur&#xeb;n e vendit t&#xeb; tyre.</span><br>\n          <span data-id=\"pg085_n0011\">Njer&#xeb;zit q&#xeb; duan t&#xeb; m&#xeb;sojn&#xeb; p&#xeb;r historin&#xeb; e nj&#xeb; vendi vizitojn&#xeb; muzet&#xeb;.</span><br>\n          <span data-id=\"pg085_n0012\">N&#xeb; teatro luhen shfaqjet, ku shikojm&#xeb; aktor&#xeb;t n&#xeb; sken&#xeb;, kurse n&#xeb; kinema shfaqen filma t&#xeb; ndrysh&#xeb;m.</span><br>\n          <span data-id=\"pg085_n0013\">N&#xeb; biblioteka, lexuesit shfryt&#xeb;zojn&#xeb; libra t&#xeb; ndrysh&#xeb;m dhe n&#xeb; galeri shkojn&#xeb; njer&#xeb;zit t&#xeb; cil&#xeb;ve u p&#xeb;lqejn&#xeb; ekspozitat artistike (p.sh.: piktura).</span>\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-2 gap-4 max-sm:grid-cols-1\">\n        <figure class=\"bg-white\">\n          <img data-id=\"pg085_im002\" src=\"images/pg085_im002.png\" alt=\"Hyrja e Teatrit Komb&#xeb;tar n&#xeb; Prishtin&#xeb;, me shkall&#xeb;t dhe mbishkrimin e madh n&#xeb; ballin&#xeb;.\" class=\"w-full h-auto border-2 border-purple-300 shadow-sm\">\n          <figcaption class=\"adt-caption text-center font-semibold text-neutral-800 mt-3\" data-id=\"pg085_n0015\">Teatri Komb&#xeb;tar &#x2013; Prishtin&#xeb;</figcaption>\n        </figure>\n\n        <figure class=\"bg-white\">\n          <img data-id=\"pg085_im001\" src=\"images/pg085_im001.png\" alt=\"Nd&#xeb;rtesa e Galeris&#xeb; s&#xeb; Arteve n&#xeb; Prishtin&#xeb;, me hap&#xeb;sir&#xeb; t&#xeb; gjelb&#xeb;r p&#xeb;rpara dhe pallate n&#xeb; sfond.\" class=\"w-full h-auto border-2 border-purple-300 shadow-sm\">\n          <figcaption class=\"adt-caption text-center font-semibold text-neutral-800 mt-3\" data-id=\"pg085_n0017\">Galeria e Arteve &#x2013; Prishtin&#xeb;</figcaption>\n        </figure>\n      </div>\n\n      <figure class=\"max-w-3xl mx-auto w-full\">\n        <img data-id=\"pg085_im003\" src=\"images/pg085_im003.png\" alt=\"Biblioteka Komb&#xeb;tare &#x201c;Pjet&#xeb;r Bogdani&#x201d; n&#xeb; Prishtin&#xeb;, me arkitektur&#xeb; karakteristike, kupola t&#xeb; bardha dhe fasad&#xeb; rrjet&#xeb;zuese.\" class=\"w-full h-auto border-2 border-purple-300 shadow-sm\">\n        <figcaption class=\"adt-caption text-center font-semibold text-neutral-800 mt-4\" data-id=\"pg085_n0019\">Biblioteka Komb&#xeb;tare &#x201c;Pjet&#xeb;r Bogdani&#x201c; &#x2013; Prishtin&#xeb;</figcaption>\n      </figure>\n\n      <p class=\"adt-body text-left text-neutral-800 pt-3 mt-4 border-t border-purple-200\">\n        <span data-id=\"pg085_n0020\">Fjal&#xeb;t ky&#xe7;e: institucion kulturor, galeri, teat&#xeb;r, bibliotek&#xeb;.</span>\n      </p>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg086_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg086_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"109\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\"><section data-section-type=\"text_and_single_image\" data-section-id=\"pg086_sec001\" class=\"w-full bg-white\"><div class=\"w-full bg-[#b06ab3]\"><div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-8\"><div class=\"flex items-center gap-6 max-sm:gap-4\"><div aria-hidden=\"true\" class=\"shrink-0 w-28 h-28 max-sm:w-20 max-sm:h-20 rounded-2xl bg-[#a665ab] border-4 border-white/20 flex items-center justify-center\"><div class=\"w-16 h-16 max-sm:w-12 max-sm:h-12 rounded-full border-4 border-white\"></div></div><div class=\"flex-1\"><h1 class=\"adt-h3 text-left font-bold text-white\" data-id=\"pg086_n0002\">Traditat dhe trash&#xeb;gimia jon&#xeb;</h1><div class=\"mt-4 inline-block bg-white px-4 py-3 rounded-r-2xl shadow-sm\"><h2 class=\"adt-h2 text-left font-semibold text-gray-900\" data-id=\"pg086_n0004\">Veshjet tradicionale</h2></div><div aria-hidden=\"true\" class=\"mt-3 h-1 w-64 max-sm:w-40 bg-white/80 rounded-full\"></div></div></div></div></div><div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-10\"><div class=\"mb-6\"><h3 class=\"adt-h3 inline-block text-left font-bold text-gray-900 bg-[#78c47f] px-4 py-2 rounded-md shadow-sm\" data-id=\"pg086_n0006\">Situata 1.</h3></div><p class=\"adt-body text-left text-gray-800 leading-relaxed mb-4\"><span data-id=\"pg086_n0008\">Klea me prind&#xeb;rit kishin vendosur t&#xeb; kalonin nj&#xeb; fundjav&#xeb; n&#xeb; Bjeshk&#xeb;t e Nemuna, n&#xeb; Bog&#xeb;.</span> <span data-id=\"pg086_n0009\">Ai vend aq i bukur me natyr&#xeb; mbres&#xeb;l&#xeb;n&#xeb;se, Kleas i ofronte qet&#xeb;si e k&#xeb;naq&#xeb;si.</span> <span data-id=\"pg086_n0010\">Nd&#xeb;rkoh&#xeb; q&#xeb; po ktheheshin nga pushimi i shkurt&#xeb;r, Klea po u thoshte prind&#xeb;rve q&#xeb; k&#xeb;to male ishin shum&#xeb; t&#xeb; bukura.</span></p><p class=\"adt-body text-left text-gray-800 leading-relaxed mb-4\"><span data-id=\"pg086_n0012\">N&#xeb;na e Kleas, q&#xeb; &#xe7;monte shum&#xeb; tradit&#xeb;n e popullit ton&#xeb;, shtoi se ky vend, p&#xeb;rve&#xe7;q&#xeb; kishte reliev t&#xeb; mrekulluesh&#xeb;m, kishte dhe shum&#xeb; ve&#xe7;ori t&#xeb; tjera q&#xeb; e b&#xeb;nin kaq t&#xeb; bukur.</span></p><p class=\"adt-body text-left text-gray-800 leading-relaxed mb-8\"><span data-id=\"pg086_n0014\">N&#xeb;na filloi t&#xeb; tregonte p&#xeb;r veshjen tradicionale t&#xeb; Rugov&#xeb;s dhe, nd&#xeb;rkoh&#xeb; q&#xeb; po fliste p&#xeb;r ngjyrat e k&#xeb;saj veshjeje, pun&#xeb;n e dor&#xeb;s e t&#xeb; tjera, Klea mrekullohej dhe vendosi q&#xeb; t&#xeb; k&#xeb;rkonte n&#xeb; internet k&#xeb;to veshje e t&#xeb; b&#xeb;nte nj&#xeb; prezantim p&#xeb;r to para klas&#xeb;s.</span> <span data-id=\"pg086_n0015\">Ajo donte q&#xeb; t&#xeb; nxiste dhe shok&#xeb;t e shoqet e klas&#xeb;s q&#xeb; t&#xeb; njihnin veshjet tradicionale t&#xeb; trevave t&#xeb; Kosov&#xeb;s, sepse pothuajse &#xe7;do vend ka veshjen e vet karakteristike.</span></p><figure class=\"clear-both\"><div class=\"rounded-none border-4 border-[#7dc97f] overflow-hidden shadow-lg bg-white\"><img data-id=\"pg086_im001\" src=\"images/pg086_im001.png\" alt=\"Pamje panoramike e Bjeshk&#xeb;ve e Nemuna n&#xeb; Rugov&#xeb;, me maja t&#xeb; thepisura shk&#xeb;mbore, lugina t&#xeb; thella dhe shpatet me gjelb&#xeb;rim n&#xeb;n qiell t&#xeb; kthjell&#xeb;t.\" class=\"w-full h-auto block\"></div><figcaption class=\"adt-caption text-center font-semibold text-gray-900 mt-4\" data-id=\"pg086_n0017\">Bjeksh&#xeb;t e Nemuna - Rugov&#xeb;</figcaption></figure></div></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg087_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg087_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"110\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-2 py-8 bg-white opacity-0\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg087_sec001\" class=\"w-full text-gray-900\">\n    <div class=\"mb-5 flex items-stretch\">\n      <div class=\"flex-1 bg-purple-500 px-6 py-4 flex items-center\">\n        <h1 class=\"adt-h3 text-left font-bold text-white\" data-id=\"pg087_n0002\">Traditat dhe trash&#xeb;gimia jon&#xeb;</h1>\n      </div>\n      <div class=\"w-28 bg-purple-500 ml-4 rounded-md max-sm:hidden\"></div>\n    </div>\n\n    <div class=\"mb-6 max-w-2xl\">\n      <h2 class=\"adt-h2 text-left font-bold text-gray-800 mb-2\" data-id=\"pg087_n0004\">Veshjet tradicionale</h2>\n      <div class=\"h-1 w-56 bg-purple-400 max-sm:w-36\"></div>\n    </div>\n\n    <aside class=\"mb-4 bg-purple-100 border border-purple-200 px-4 py-4 max-sm:px-2 max-sm:py-3\">\n      <div class=\"flex justify-end mb-2\">\n        <div class=\"bg-purple-500 text-white px-6 py-2 leading-none max-sm:px-3 max-sm:py-1\">\n          <span class=\"adt-h2 leading-none\" data-id=\"pg087_n0006\">?</span>\n        </div>\n      </div>\n      <div class=\"space-y-5 max-sm:space-y-4\">\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0009\">&#xc7;far&#xeb; r&#xeb;nd&#xeb;sie kan&#xeb; veshjet tradicionale?</span></div>\n          <label for=\"item-1\" class=\"sr-only\">&#xc7;far&#xeb; r&#xeb;nd&#xeb;sie kan&#xeb; veshjet tradicionale?</label>\n          <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"&#xc7;far&#xeb; r&#xeb;nd&#xeb;sie kan&#xeb; veshjet tradicionale?\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0011\">P&#xeb;rmend dy gj&#xeb;ra t&#xeb; ve&#xe7;anta q&#xeb; Klea i m&#xeb;soi n&#xeb; k&#xeb;t&#xeb; udh&#xeb;tim.</span></div>\n          <label for=\"item-2\" class=\"sr-only\">P&#xeb;rmend dy gj&#xeb;ra t&#xeb; ve&#xe7;anta q&#xeb; Klea i m&#xeb;soi n&#xeb; k&#xeb;t&#xeb; udh&#xeb;tim.</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"P&#xeb;rmend dy gj&#xeb;ra t&#xeb; ve&#xe7;anta q&#xeb; Klea i m&#xeb;soi n&#xeb; k&#xeb;t&#xeb; udh&#xeb;tim.\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0013\">A keni d&#xeb;gjuar p&#xeb;r ndonj&#xeb; veshje tjet&#xeb;r tradicionale?</span> <span data-id=\"pg087_n0014\">Diskutoni s&#xeb; bashku.</span></div>\n          <label for=\"item-3\" class=\"sr-only\">A keni d&#xeb;gjuar p&#xeb;r ndonj&#xeb; veshje tjet&#xeb;r tradicionale? Diskutoni s&#xeb; bashku.</label>\n          <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"A keni d&#xeb;gjuar p&#xeb;r ndonj&#xeb; veshje tjet&#xeb;r tradicionale? Diskutoni s&#xeb; bashku.\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0016\">A keni ndonj&#xeb; veshje tradicionale?</span></div>\n          <label for=\"item-4\" class=\"sr-only\">A keni ndonj&#xeb; veshje tradicionale?</label>\n          <input id=\"item-4\" type=\"text\" data-activity-item=\"item-4\" aria-label=\"A keni ndonj&#xeb; veshje tradicionale?\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\">\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0018\">Pse &#xeb;sht&#xeb; e r&#xeb;nd&#xeb;sishme t&#xeb; njohim dhe t&#xeb; veshim rrobat tradicionale t&#xeb; vendit ton&#xeb;?</span></div>\n          <label for=\"item-5\" class=\"sr-only\">Pse &#xeb;sht&#xeb; e r&#xeb;nd&#xeb;sishme t&#xeb; njohim dhe t&#xeb; veshim rrobat tradicionale t&#xeb; vendit ton&#xeb;?</label>\n          <textarea id=\"item-5\" data-activity-item=\"item-5\" aria-label=\"Pse &#xeb;sht&#xeb; e r&#xeb;nd&#xeb;sishme t&#xeb; njohim dhe t&#xeb; veshim rrobat tradicionale t&#xeb; vendit ton&#xeb;?\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0020\">Vishuni me rroba tradicionale dhe b&#xeb;ni ekspozit&#xeb; n&#xeb; shkoll&#xeb;.</span> <span data-id=\"pg087_n0021\">Tregoni si u ndiet.</span></div>\n          <label for=\"item-6\" class=\"sr-only\">Vishuni me rroba tradicionale dhe b&#xeb;ni ekspozit&#xeb; n&#xeb; shkoll&#xeb;. Tregoni si u ndiet.</label>\n          <textarea id=\"item-6\" data-activity-item=\"item-6\" aria-label=\"Vishuni me rroba tradicionale dhe b&#xeb;ni ekspozit&#xeb; n&#xeb; shkoll&#xeb;. Tregoni si u ndiet.\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"mb-8 border border-purple-400 px-4 py-4 bg-white\">\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0024\">Kostumet popullore jan&#xeb; veshje tradicionale q&#xeb; jan&#xeb; p&#xeb;rdorur nga njer&#xeb;zit n&#xeb; t&#xeb; kaluar&#xeb;n dhe q&#xeb; trash&#xeb;gohen brez pas brezi.</span></p>\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0026\">Secili rajon i nj&#xeb; vendi dhe secili shtet ka veshjet tradicionale t&#xeb; tij, p.sh.: veshja e Rugov&#xeb;s, e Hasit, e Tropoj&#xeb;s etj.</span></p>\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0028\">Veshja popullore e grave t&#xeb; Hasit ka karakteristik&#xeb; p&#xeb;rdorimin e d&#xeb;rras&#xeb;s, e cila mbulohet me veshje me motive dekorative, me ngjyra t&#xeb; ndryshme, ku mbizot&#xeb;ron e kuqja.</span> <span data-id=\"pg087_n0029\">Po ashtu, interesante &#xeb;sht&#xeb; veshja e grave t&#xeb; Rugov&#xeb;s, e p&#xeb;rb&#xeb;r&#xeb; nga k&#xeb;misha me m&#xeb;ng&#xeb; t&#xeb; shkurtra prej p&#xeb;lhure.</span></p>\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0031\">&#xc7;do veshje ka nj&#xeb; histori dhe karakterizohet nga elemente t&#xeb; ve&#xe7;anta q&#xeb; e ve&#xe7;ojn&#xeb; nga veshjet e tjera t&#xeb; nj&#xeb; treve, t&#xeb; nj&#xeb; krahine apo t&#xeb; nj&#xeb; rajoni.</span> <span data-id=\"pg087_n0032\">Veshjet popullore jan&#xeb; shum&#xeb; t&#xeb; k&#xeb;rkuara p&#xeb;r dit&#xeb;t e festave dhe p&#xeb;r ahengje t&#xeb; ndryshme.</span></p>\n      <p class=\"adt-body text-left text-gray-800 italic\"><span data-id=\"pg087_n0034\">Veshjet e grave karakterizohen me q&#xeb;ndisje dhe ngjyra t&#xeb; ndryshme, kurse veshjet e burrave kryesisht jan&#xeb; punime leshi: tirq, k&#xeb;mish&#xeb;, jelek dhe plisi q&#xeb; e karakterizon burrin tradicional shqiptar.</span></p>\n    </div>\n\n    <div class=\"mb-8 grid grid-cols-3 gap-x-10 gap-y-8 justify-items-center max-lg:grid-cols-2 max-sm:grid-cols-1 max-sm:gap-y-6\">\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center\">\n        <img src=\"images/pg087_im008_seg001_v1_crop_v1.png\" alt=\"Grua dhe burr&#xeb; me veshje tradicionale t&#xeb; Rugov&#xeb;s, me q&#xeb;ndisje shum&#xeb;ngjyr&#xeb;she, p&#xeb;rpar&#xeb;se t&#xeb; kuqe dhe plis t&#xeb; bardh&#xeb;.\" data-id=\"pg087_im008_seg001_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0036\">Veshje e Rugov&#xeb;s</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center\">\n        <img src=\"images/pg087_im008_seg002_v1_crop_v1.png\" alt=\"Dy kostume tradicionale t&#xeb; Drenic&#xeb;s me xhamadan t&#xeb; err&#xeb;t, brez t&#xeb; kuq dhe tirq.\" data-id=\"pg087_im008_seg002_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0038\">Veshje e Drenic&#xeb;s</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center max-lg:col-span-2 max-lg:justify-self-center max-sm:col-span-1\">\n        <img src=\"images/pg087_im008_seg003_v1.png\" alt=\"Veshje tradicionale e Hasit, e zbukuruar me motive t&#xeb; dendura shum&#xeb;ngjyr&#xeb;she dhe stoli n&#xeb; pjes&#xeb;n e sip&#xeb;rme.\" data-id=\"pg087_im008_seg003_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0040\">Veshje e Hasit</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center max-lg:justify-self-end max-sm:justify-self-center\">\n        <img src=\"images/pg087_im008_seg004_v1_crop_v1.png\" alt=\"Xhublet&#xeb; e zez&#xeb; me brez dhe vija roz&#xeb;, me fund t&#xeb; val&#xeb;zuar tradicional.\" data-id=\"pg087_im008_seg004_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0042\">Xhubleta</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center max-lg:justify-self-start max-sm:justify-self-center\">\n        <img src=\"images/pg087_im008_seg005_v1_crop_v1.png\" alt=\"Dy veshje tradicionale t&#xeb; Tropoj&#xeb;s me jelek t&#xeb; zi, k&#xeb;mish&#xeb; t&#xeb; bardh&#xeb; t&#xeb; q&#xeb;ndisur, fund t&#xeb; kuq dhe p&#xeb;rpar&#xeb;se t&#xeb; bardh&#xeb;.\" data-id=\"pg087_im008_seg005_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0044\">Veshje e Tropoj&#xeb;s</figcaption>\n      </figure>\n    </div>\n\n    <p class=\"adt-body text-left text-gray-900\"><span class=\"font-bold\" data-id=\"pg087_n0046\">Fjal&#xeb;t ky&#xe7;e:</span> <span data-id=\"pg087_n0047\">veshje tradicionale, tradit&#xeb;, kultur&#xeb;, zakon.</span></p>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg088_sec001.html":"<!DOCTY