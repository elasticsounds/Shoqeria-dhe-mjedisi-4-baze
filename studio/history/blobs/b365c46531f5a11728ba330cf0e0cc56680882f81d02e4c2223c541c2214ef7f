</div></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg024_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg024_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"32\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\"><section data-section-type=\"text_and_single_image\" data-section-id=\"pg024_sec001\" class=\"mx-auto w-full max-w-5xl bg-white px-8 py-8 max-lg:px-6 max-sm:px-5 max-sm:py-6\">\n  <div class=\"mb-8 max-sm:mb-6\">\n    <div class=\"flex items-stretch overflow-hidden rounded-[2rem] bg-white shadow-sm ring-1 ring-[#ead6ee] max-sm:flex-col\">\n      <div aria-hidden=\"true\" class=\"flex w-36 shrink-0 items-center justify-center bg-[#a86ab1] p-6 max-sm:w-full max-sm:justify-start max-sm:pb-10\">\n        <div class=\"flex h-24 w-24 items-center justify-center rounded-2xl bg-white/10 text-white\">\n          <svg viewBox=\"0 0 64 64\" class=\"h-16 w-16 fill-current\" aria-hidden=\"true\">\n            <path d=\"M32 18c0-6.6 5.4-12 12-12 5.4 0 10 3.6 11.5 8.6C57.5 13 60 14.7 60 20c0 9-8.7 15.7-16.5 22.1L32 51 20.5 42.1C12.7 35.7 4 29 4 20c0-5.3 2.5-7 4.5-5.4C10 9.6 14.6 6 20 6c6.6 0 12 5.4 12 12z\"/>\n            <path d=\"M10 23c-2 8.6 2.8 18.2 11.6 24.8-1.4-6.9-2.1-13.7-1.7-20.4.1-1.5-.8-2.8-2.2-3.4-2-.9-4.2-1.2-7.7-1zM54 23c3.5-.2 5.7.1 7.7 1 1.4.6 2.3 1.9 2.2 3.4.4 6.7-.3 13.5-1.7 20.4C53.4 41.2 48.6 31.6 46.6 23c1.6-.2 4-.2 7.4 0zM18.5 30.5c3.9 5.1 8.4 9.7 13.5 13.8v9.2c-9.5-6.2-16.4-14.4-20.2-23.5 2.2-.1 4.3.1 6.7.5zM45.5 30.5c2.4-.4 4.5-.6 6.7-.5-3.8 9.1-10.7 17.3-20.2 23.5v-9.2c5.1-4.1 9.6-8.7 13.5-13.8z\"/>\n          </svg>\n        </div>\n      </div>\n      <div class=\"min-w-0 flex-1 bg-white\">\n        <div aria-hidden=\"true\" class=\"h-24 bg-[#a86ab1] max-sm:h-5\"></div>\n        <div class=\"px-6 py-4 max-sm:px-4 max-sm:py-4\">\n          <h1 data-id=\"pg024_n0004\" class=\"adt-h2 font-semibold text-gray-900\">Ndihem i/e barabart&#xeb;</h1>\n          <div aria-hidden=\"true\" class=\"mt-3 h-1 w-56 max-w-full bg-[#b06ab3]\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"mb-8 max-sm:mb-6\">\n    <div class=\"flex items-start gap-8 max-sm:flex-col max-sm:gap-4\">\n      <h3 data-id=\"pg024_n0006\" class=\"adt-h3 shrink-0 bg-[#6bbb79] px-4 py-2 font-semibold text-gray-900 shadow-sm max-sm:inline-block max-sm:rounded-md\">Situata 1.</h3>\n      <p class=\"adt-body flex-1 leading-relaxed text-left text-gray-800\">\n        <span data-id=\"pg024_n0008\">T&#xeb; ndihesh i barabart&#xeb; me t&#xeb; tjer&#xeb;t &#xeb;sht&#xeb; prirje krejt&#xeb;sisht e natyrshme.</span>\n        <span data-id=\"pg024_n0009\">Syt&#xeb; e qeshur t&#xeb; Bes&#xeb;s, e cila ishte ulur n&#xeb; karroc&#xeb;n me rrota, dukeshin sikur luanin me topin q&#xeb; godiste her&#xeb; nj&#xeb; kosh, her&#xeb; nj&#xeb; tjet&#xeb;r n&#xeb; fush&#xeb;n e basketbollit.</span>\n        <span data-id=\"pg024_n0010\">Sa entuziaz&#xeb;m shprehnin syt&#xeb; e saj!</span>\n        <span data-id=\"pg024_n0011\">Kishte koh&#xeb; q&#xeb; ndiqte loj&#xeb;rat tona, madje ishte tifozja jon&#xeb; e p&#xeb;rhershme.</span>\n        <span data-id=\"pg024_n0012\">Trajneri i basketbollit na njoftoi se kishte menduar di&#xe7;ka t&#xeb; ve&#xe7;ant&#xeb;.</span>\n        <span data-id=\"pg024_n0013\">Dhe v&#xeb;rtet ashtu ndodhi</span>\n      </p>\n    </div>\n  </div>\n\n  <figure class=\"overflow-hidden rounded-[2rem] bg-[#eef3f7] p-3 shadow-lg ring-1 ring-[#d7e1ea]\">\n    <img data-id=\"pg024_im001\" src=\"images/pg024_im001.png\" alt=\"N&#xeb; sall&#xeb;n sportive, nj&#xeb; vajz&#xeb; n&#xeb; karroc&#xeb; me rrota q&#xeb;ndron pran&#xeb; trajnerit, nd&#xeb;rsa dy f&#xeb;mij&#xeb; luajn&#xeb; me top para port&#xeb;s dhe koshit t&#xeb; basketbollit, duke theksuar p&#xeb;rfshirjen dhe barazin&#xeb; n&#xeb; loj&#xeb;.\" class=\"z-10 h-auto w-full rounded-[1.4rem] object-cover\">\n  </figure>\n</section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg024_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg024_sec002\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and