mitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"13\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0\"><section data-section-type=\"text_and_single_image\" data-section-id=\"pg010_sec002\" class=\"bg-white text-gray-900\"><div class=\"mx-auto w-full max-w-5xl px-8 py-8 max-sm:px-5\"><div class=\"flex items-center gap-0 max-sm:items-start\"><div aria-hidden=\"true\" class=\"flex h-44 w-36 shrink-0 items-center justify-center rounded-l-2xl rounded-r-xl bg-purple-500 text-white max-lg:h-36 max-lg:w-28 max-sm:h-24 max-sm:w-20\"><svg viewBox=\"0 0 64 64\" class=\"h-16 w-16 fill-current max-sm:h-12 max-sm:w-12\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"20\" r=\"7\"/><circle cx=\"32\" cy=\"16\" r=\"8\"/><circle cx=\"44\" cy=\"20\" r=\"7\"/><path d=\"M11 43c0-7 5-13 12-13s12 6 12 13v3H11z\"/><path d=\"M20 46c0-9 6-16 12-16s12 7 12 16v0H20z\"/><path d=\"M33 46c0-7 5-13 12-13s12 6 12 13v0H33z\"/></svg></div><div class=\"min-w-0 flex-1 pt-10 max-lg:pt-7 max-sm:pt-2\"><div class=\"bg-purple-500 px-4 py-3 text-white\"><h1 class=\"adt-h1 font-bold leading-tight\"><span data-id=\"pg010_n0008\">Lidhjet dhe bashk&#xeb;punimi me t&#xeb; tjer&#xeb;t</span></h1></div><div class=\"max-w-[32rem] border-b-4 border-purple-400 px-4 py-3 max-lg:max-w-[28rem] max-sm:max-w-full\"><h2 class=\"adt-h2 font-medium leading-tight text-gray-900\"><span data-id=\"pg010_n0009\">Grupet shoq&#xeb;rore</span></h2></div></div></div></div><div class=\"mx-auto w-full max-w-5xl space-y-6 px-8 pb-10 max-sm:px-5\"><div class=\"pt-2\"><h3 class=\"adt-h3 inline-block bg-green-400 px-4 py-1 font-medium text-gray-900\"><span data-id=\"pg010_n0011\">Situata 1.</span></h3></div><p class=\"adt-body text-left leading-relaxed text-gray-800\"><span data-id=\"pg010_n0013\">Bora, s&#xeb; bashku me prind&#xeb;rit dhe v&#xeb;llan&#xeb; e madh, jeton n&#xeb; Prishtin&#xeb;.</span> <span data-id=\"pg010_n0014\">Ajo &#xeb;sht&#xeb; n&#xeb; klas&#xeb;n e kat&#xeb;rt.</span> <span data-id=\"pg010_n0015\">N&#xeb; shkoll&#xeb;n e saj ka shum&#xeb; grupe ku f&#xeb;mij&#xeb;t bashkohen, sepse mendojn&#xeb; nj&#xeb;soj, kan&#xeb; d&#xeb;shira e interesa t&#xeb; nj&#xeb;jt&#xeb; dhe duan t&#xeb; arrijn&#xeb; gj&#xeb;ra t&#xeb; p&#xeb;rbashk&#xeb;ta.</span> <span data-id=\"pg010_n0016\">K&#xeb;to grupe t&#xeb; shkoll&#xeb;s u mund&#xeb;sojn&#xeb; nx&#xeb;n&#xeb;sve q&#xeb; t&apos;i shprehin aft&#xeb;sit&#xeb; dhe talentet e tyre t&#xeb; ndryshme.</span> <span data-id=\"pg010_n0017\">Bora &#xeb;sht&#xeb; pjes&#xeb;tare e grupit t&#xeb; vall&#xeb;zimit dhe atij t&#xeb; recitimit.</span> <span data-id=\"pg010_n0018\">Nd&#xeb;rsa, v&#xeb;llai i saj &#xeb;sht&#xeb; pjes&#xeb;tar i grupit t&#xeb; futbollit dhe atij t&#xeb; piktur&#xeb;s.</span> <span data-id=\"pg010_n0019\">N&#xeb; k&#xeb;to grupe, ata m&#xeb;sojn&#xeb; shum&#xeb; gj&#xeb;ra t&#xeb; reja, duke bashk&#xeb;punuar me nj&#xeb;ri-tjetrin.</span></p><div class=\"overflow-hidden rounded-none bg-amber-50\"><img data-id=\"pg010_im002\" src=\"images/pg010_im002.png\" alt=\"F&#xeb;mij&#xeb; t&#xeb; veshur me kostume tradicionale vall&#xeb;zojn&#xeb; s&#xeb; bashku n&#xeb; rreth, t&#xeb; kapur p&#xeb;r dore.\" class=\"h-auto w-full object-contain\"></div><div class=\"relative overflow-hidden bg-purple-200/70 px-8 py-6 max-sm:px-4\"><div aria-hidden=\"true\" class=\"absolute left-0 top-0 z-10 flex h-20 w-20 -translate-x-3 items-center justify-center bg-purple-500 text-white max-sm:h-16 max-sm:w-16\"><svg viewBox=\"0 0 64 64\" class=\"h-12 w-12 fill-current\"><path d=\"M32 50a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm-9-33c1-9 9-15 19-13 