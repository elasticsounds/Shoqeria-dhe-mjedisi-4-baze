ata-id=\"pg018_im002_seg002_v1\" src=\"images/pg018_im002_seg002_v1.png\" alt=\"Punonj&#xeb;se e urgjenc&#xeb;s me mask&#xeb; dhe mburoj&#xeb; fytyre.\" class=\"w-full max-w-[220px] h-auto\">\n          <h4 data-id=\"pg018_n0011\" class=\"adt-h4 mt-4 font-bold text-red-600 self-start\">Urgjenca</h4>\n          <div aria-hidden=\"true\" class=\"mt-2 h-1 w-full rounded-full bg-red-300\"></div>\n        </div>\n        <div class=\"flex flex-col items-center text-left rounded-3xl bg-orange-50 p-5 shadow-sm border border-orange-100\">\n          <img data-id=\"pg018_im002_seg003_v1\" src=\"images/pg018_im002_seg003_v1.png\" alt=\"Zjarrfik&#xeb;s me helmet&#xeb; t&#xeb; kuqe dhe mask&#xeb;.\" class=\"w-full max-w-[220px] h-auto\">\n          <h4 data-id=\"pg018_n0013\" class=\"adt-h4 mt-4 font-bold text-red-600 self-start\">Zjarrfik&#xeb;sit</h4>\n          <div aria-hidden=\"true\" class=\"mt-2 h-1 w-full rounded-full bg-red-300\"></div>\n        </div>\n      </div>\n\n      <div class=\"rounded-2xl bg-green-50 border border-green-200 p-5 shadow-sm\">\n        <div class=\"mb-3\">\n          <h3 data-id=\"pg018_n0015\" class=\"adt-h3 inline-block bg-green-500 text-neutral-900 px-4 py-1 rounded\">Situata 1.</h3>\n        </div>\n        <p class=\"adt-body text-left leading-relaxed text-neutral-800\">\n          <span data-id=\"pg018_n0016\">Sot, kur shkuam n&#xeb; shkoll&#xeb;, n&#xeb; klas&#xeb; erdhi infermierja, e cila po kontrollonte higjien&#xeb;n dhe sh&#xeb;ndetin ton&#xeb;.</span>\n          <span data-id=\"pg018_n0017\">Mjek&#xeb;t dhe infermier&#xeb;t kujdesen p&#xeb;r sh&#xeb;ndetin e &#xe7;do individi.</span>\n        </p>\n      </div>\n\n      <div class=\"rounded-3xl overflow-hidden border border-amber-200 shadow-sm bg-amber-50\">\n        <img data-id=\"pg018_im003\" src=\"images/pg018_im003.jpg\" alt=\"N&#xeb; shkoll&#xeb;, infermierja ia mat temperatur&#xeb;n nj&#xeb; nx&#xeb;n&#xeb;si, nd&#xeb;rsa nx&#xeb;n&#xeb;sit mbajn&#xeb; maska, dezinfektojn&#xeb; duart, i lajn&#xeb; ato dhe mbajn&#xeb; distanc&#xeb; 2 metra.\" class=\"w-full h-auto\">\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg018_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg018_sec002\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"22\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <h1 class=\"sr-only\" id=\"page-heading\">Shoqëria dhe Mjedisi 4</h1>\n      <div class=\"container mx-auto max-w-5xl bg-white px-10 max-lg:px-8 max-sm:px-4 pt-10 pb-12 opacity-0\" id=\"content\">\n  <section role=\"region\" data-section-type=\"activity_fill_in_the_blank\" data-section-id=\"pg018_sec002\" class=\"mx-auto max-w-5xl\">\n    <div class=\"mx-auto flex max-w-4xl items-start max-sm:flex-col\">\n      <div class=\"flex w-28