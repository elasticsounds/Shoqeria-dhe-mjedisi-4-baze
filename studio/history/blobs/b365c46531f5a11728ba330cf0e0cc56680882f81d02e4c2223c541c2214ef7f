-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg098_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg098_sec001\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"125\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto opacity-0\">\n  <section data-section-type=\"text_only\" data-section-id=\"pg098_sec001\" class=\"bg-white text-neutral-900\">\n    <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 pt-8 pb-6\">\n      <div class=\"flex items-start gap-0 max-sm:flex-col max-sm:gap-4\">\n        <div class=\"w-36 h-56 bg-purple-400 rounded-l-xl max-sm:rounded-xl flex items-center justify-center shrink-0\">\n          <div aria-hidden=\"true\" class=\"text-white font-bold\">&#x2724;</div>\n        </div>\n        <div class=\"flex-1 pt-14 max-sm:pt-0\">\n          <div class=\"bg-purple-400 px-4 py-3\">\n            <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg098_n0002\">Resurset dhe trash&#xeb;gimia e vendit tim</h1>\n          </div>\n          <div class=\"pt-4 pb-2 border-b-4 border-purple-400 max-w-3xl\">\n            <h2 class=\"adt-h2 font-semibold text-neutral-800\" data-id=\"pg098_n0004\">Shfryt&#xeb;zimi i arsyesh&#xeb;m i pasurive natyrore</h2>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 pt-6 pb-12\">\n      <div class=\"flex items-start gap-8 max-sm:flex-col max-sm:gap-4\">\n        <div class=\"shrink-0 pt-1\">\n          <h3 class=\"adt-h3 inline-block bg-green-400 text-neutral-900 px-5 py-2\" data-id=\"pg098_n0006\">Situata 1.</h3>\n        </div>\n\n        <div class=\"flex-1\">\n          <p class=\"adt-body leading-relaxed text-left mb-3\">\n            <span data-id=\"pg098_n0008\">Zilja e or&#xeb;s s&#xeb; fundit ra dhe nx&#xeb;n&#xeb;sit dol&#xeb;n me vrap nga shkolla p&#xeb;r t&#xeb; luajtur me nj&#xeb;ri-tjetrin.</span>\n            <span data-id=\"pg098_n0009\">Nga ky grup u ndan&#xeb; dy shok&#xeb;, t&#xeb; cil&#xeb;t kishin p&#xeb;r detyr&#xeb; t&#xeb; b&#xeb;nin nj&#xeb; punim rreth ruajtjes s&#xeb; pasurive natyrore.</span>\n            <span data-id=\"pg098_n0010\">K&#xeb;shtu, ata filluan t&#xeb; mblidhnin informacionet q&#xeb; do t&#x2019;i prezantonin para klas&#xeb;s.</span>\n          </p>\n\n          <p class=\"adt-body leading-relaxed text-left mb-3\">\n            <span data-id=\"pg098_n0012\">- O Mali, di ti ndonj&#xeb; gj&#xeb; se si ndahen pasurit&#xeb; natyrore?</span>\n            <span data-id=\"pg098_n0013\">- N&#xeb; nj&#xeb; enciklopedi q&#xeb; e kam lexuar m&#xeb; par&#xeb;, thuhej se pasurit&#xeb; natyrore jan&#xeb; toka s&#xeb; bashku me mineralet e saj, uj&#xeb;rat, rrezet e diellit dhe atmosfera.</span>\n            <span data-id=\"pg098_n0014\">Ato ndahen n&#xeb; burime t&#xeb; rip&#xeb;rt&#xeb;ritshme dhe t&#xeb; parip&#xeb;rt&#xeb;ritshme.</span>\n            <span data-id=\"pg098_n0015\">- P&#xeb;r t&#x2019;i shfryt&#xeb;zuar k&#xeb;to pasuri n&#xeb; m&#xeb;nyr&#xeb; t&#xeb; arsyeshme, si ide m&#xeb; e p&#xeb;rshtatshme do t&#xeb; ishte shfryt&#xeb;zimi m&#xeb; i madh i paneleve diellore dhe i helikave q&#xeb; l&#xeb;vizin me ndihm&#xeb;n e er&#xeb;s, pasi pasurit&#xeb; n&#xeb;ntok&#xeb;sore, si qymyri, nafta dhe gazi natyror s&#xeb; bashku me uj&#xeb;rat jan&#xeb; burime t&#xeb; parip&#xeb;rt&#xeb;ritshme, - tha Era.</span>\n            <span data-id=\"pg098_n0016\">- K&#xeb;tij mendimi mund t&apos;ia shtojm&#xeb; faktin se burimet e parip&#xeb;rt&#xeb;ritshme mund t&#xeb; harxhohen nj&#xeb; dit&#xeb; dhe k&#xeb;shtu brezat e ardhsh&#xeb;m nuk do t&#xeb; ken&#xeb; mund&#xeb;si q&#xeb; t&#x2019;i p&#xeb;rdorin ato.</span>\n            <span data-id=\"pg098_n0017\">- Nafta, qymyri dhe gazi natyror jan&#xeb; shkaktar&#xeb; t&#xeb; ndotjes s&#xeb; ambientit duke e ulur cil&#xeb;sin&#xeb; e ajrit.</span>\n            <span data-id=\"pg098_n0018\">N&#xeb; fillim, duhet t&#xeb; mbjellim disa pem&#xeb;, n&#xeb; m&#xeb;nyr&#xeb; q&#xeb; brezat e ardhsh&#xeb;m, por edhe ata q&#xeb; jan&#xeb; tani, t&#xeb; ken&#xeb; aj&#xeb;r t&#xeb; past&#xeb;r.</span>\n            <span data-id=\"pg098_n0019\">Pastaj, mund t&#xeb; mbajm&#xeb; edhe aktivitete informuese n&#xeb;p&#xeb;r shkolla se si mund t&#xeb; kursejm&#xeb; ujin dhe energjin&#xeb; elektrike, duke i p&#xeb;rdorur n&#xeb; mas&#xeb; t&#xeb; caktuar.</span>\n            <span data-id=\"pg098_n0020\">- T&#xeb; shkojm&#xeb; m&#xeb; shpejt n&#xeb; sht&#xeb;pi dhe t&#x2019;i shkruajm&#xeb; k&#xeb;to mendime.</span>\n          </p>\n\n          <p class=\"adt-body leading-relaxed text-left mb-24\">\n            <span data-id=\"pg098_n0022\">Duke biseduar, Mali dhe Era erdh&#xeb;n n&#xeb; p&#xeb;rfundim se m&#xeb;nyra m&#xeb; e mir&#xeb; p&#xeb;r ruajtjen e resurseve natyrore &#xeb;sht&#xeb; q&#xeb; burimet e rip&#xeb;rt&#xeb;ritshme t&#xeb; p&#xeb;rdoren m&#xeb; shum&#xeb; se ato t&#xeb; parip&#xeb;rt&#xeb;ritshme dhe se secili prej nesh t&#xeb; vet&#xeb;dij&#xeb;sohet p&#xeb;r p&#xeb;rdorimin e arsyesh&#xeb;m t&#xeb; tyre.</span>\n          </p>\n        </div>\n      </div>\n\n      <div class=\"max-w-4xl ml-10 max-sm:ml-0 pl-4 border-l-4 border-purple-400\">\n        <p class=\"adt-body text-left\">\n          <span data-id=\"pg098_n0024\">Fjal&#xeb;t ky&#xe7;e:</span>\n          <span data-id=\"pg098_n0025\">pasuri natyrore, t&#xeb; parip&#xeb;rt&#xeb;ritshme, t&#xeb; rip&#xeb;rt&#xeb;ritshme, diell, uj&#xeb;, aj&#xeb;r, l&#xeb;nd&#xeb; djeg&#xeb;se.</span>\n        </p>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>\n","./pg098_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg098_sec002\" />\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"126\" />\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <h1 class=\"sr-only\" id=\"page-heading\">Shoqëria dhe Mjedisi 