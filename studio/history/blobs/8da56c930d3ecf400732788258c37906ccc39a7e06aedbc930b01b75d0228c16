<p class="bk-prompt" data-id="pg008_n0013" id="opinion-prompt">Jepe edhe ti mendimin tënd.</p>
<details>
<summary class="bk-btn">Shënime (opsionale)</summary>
<label class="bk-label" id="opinion-notes-label" for="activity-item-1">Shënime private</label>
<textarea class="bk-field" id="activity-item-1" data-activity-item="item-1" aria-label="Jepe edhe ti mendimin tënd." aria-labelledby="opinion-prompt opinion-notes-label" rows="3"></textarea>
<p class="bk-feedback" role="status" aria-live="polite" id="opinion-save-status"></p>
