<script>
(function(){
const field=document.getElementById('activity-item-1');
const status=document.getElementById('opinion-save-status');
const retry=document.querySelector('[data-action="retry-save"]');
const key='shoqeria-mjedisi-4:pg008_sec001:discussion:item-1';
let draft=field.value,dirty=false;
try {const saved=localStorage.getItem(key);if(saved!==null){field.value=saved;draft=saved;}}catch(e){status.textContent='⚠ Nuk u ruajt.';retry.hidden=false;}
function save(){draft=field.value;try{localStorage.setItem(key,draft);status.textContent='✓ U ruajt.';retry.hidden=true;}catch(e){status.textContent='⚠ Nuk u ruajt. Shënimet mbeten këtu; provo përsëri.';retry.hidden=false;}}
field.addEventListener('input',function(){dirty=true;save();});
retry.addEventListener('click',save);
window.addEventListener('pagehide',function(){if(dirty)save();});
})();
</script>
