<script>
/* These optional discussion notes share the original source activity identity. */
(function(){
const prefix='shoqeria-dhe-mjedisi-4:pg024_sec002:';
function read(store,key){try{const record=JSON.parse(window[store].getItem(key));return record&&typeof record.value==='string'?record:null;}catch(e){return null;}}
document.querySelectorAll('#content textarea[data-activity-item]').forEach(function(field){
const key=prefix+field.dataset.activityItem,group=field.closest('.bk-activity'),status=group.querySelector('[role="status"]'),retry=group.querySelector('[data-action="retry-save"]');
const local=read('localStorage',key),backup=read('sessionStorage',key),saved=backup&&(!local||backup.time>local.time)?backup:local;
let draft=saved||{value:field.value,time:0};
if(saved){field.value=saved.value;status.textContent=local&&local.time>=saved.time?'✓ U ruajt.':'! Nuk u ruajt. Shënimi është ruajtur përkohësisht në këtë sesion.';retry.hidden=!!(local&&local.time>=saved.time);}
function save(){
draft={value:field.value,time:Date.now()};
try{sessionStorage.setItem(key,JSON.stringify(draft));}catch(e){}
try{localStorage.setItem(key,JSON.stringify(draft));status.textContent='✓ U ruajt.';retry.hidden=true;}catch(e){status.textContent='! Nuk u ruajt. Mbajeni këtë faqe hapur dhe provoni përsëri.';retry.hidden=false;}
}
field.addEventListener('input',save);field.addEventListener('change',save);retry.addEventListener('click',save);
window.addEventListener('pagehide',function(){if(field.value!==draft.value)save();});
});
})();
</script>
<script id="temporary-draft-probe">
/* Temporary acceptance probe: exercise failure/retry without altering learner drafts. */
document.querySelectorAll('#content textarea').forEach(function(field){
 const key='shoqeria-dhe-mjedisi-4:pg024_sec002:'+field.dataset.activityItem;
 const previous=field.value,local=localStorage.getItem(key),session=sessionStorage.getItem(key);
 const nativeSet=Storage.prototype.setItem;
 const group=field.closest('.bk-activity'),status=group.querySelector('[role="status"]'),retry=group.querySelector('[data-action="retry-save"]');
 try{
  Storage.prototype.setItem=function(k,v){if(this===localStorage)throw new Error('Simulated unavailable storage');return nativeSet.call(this,k,v);};
  field.value='Provë me ë dhe ç.\nShënime në rreshtin e dytë.';
  field.dispatchEvent(new Event('input',{bubbles:true}));
  if(!status.textContent.startsWith('! Nuk u ruajt.')||retry.hidden||!field.value.includes('ë dhe ç'))throw new Error('Draft failure retention failed: '+field.id);
  Storage.prototype.setItem=nativeSet;
  retry.click();
  if(JSON.parse(localStorage.getItem(key)).value!==field.value||!retry.hidden||status.textContent!=='✓ U ruajt.')throw new Error('Draft retry failed: '+field.id);
 }finally{
  Storage.prototype.setItem=nativeSet;
  field.value=previous;
  if(local===null)localStorage.removeItem(key);else nativeSet.call(localStorage,key,local);
  if(session===null)sessionStorage.removeItem(key);else nativeSet.call(sessionStorage,key,session);
  status.textContent='';retry.hidden=true;
 }
});
</script>
