<script>
(function () {
  document.querySelectorAll('#content textarea[data-activity-item]').forEach(function (field) {
    var item = field.dataset.activityItem;
    var key = 'shoqeria-mjedisi4:pg098_sec002:' + item;
    var status = document.getElementById(field.getAttribute('aria-describedby'));
    var retry = document.querySelector('[data-retry="' + item + '"]');
    function save() {
      try {
        localStorage.setItem(key, field.value);
        if (localStorage.getItem(key) !== field.value) throw new Error('save failed');
        status.textContent = '✓ U ruajt.'; status.hidden = false; retry.hidden = true;
      } catch (e) {
        status.textContent = '! Nuk u ruajt.'; status.hidden = false; retry.hidden = false;
      }
    }
    try { var saved = localStorage.getItem(key); if (saved !== null) field.value = saved; }
    catch (e) { status.textContent = '! Nuk u ruajt.'; status.hidden = false; retry.hidden = false; }
    field.addEventListener('input', save);
    retry.addEventListener('click', save);
  });
}());
</script>
