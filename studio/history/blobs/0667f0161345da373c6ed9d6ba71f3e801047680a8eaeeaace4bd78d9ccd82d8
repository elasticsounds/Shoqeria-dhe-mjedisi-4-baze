<script>(function(){document.querySelectorAll('#content [data-activity-pattern="structured-entry"]').forEach(function(section){var fields=section.querySelectorAll('textarea[data-activity-item]'),status=section.querySelector('.bk-feedback'),retry=section.querySelector('[data-action="retry-save"]'),dirty=new Set();function key(field){return 'Shoqeria-dhe-Mjedisi-4:pg107_sec001:'+field.dataset.activityItem}function failure(){status.hidden=false;status.textContent='! Nuk u ruajt.';retry.hidden=false}function save(field){try{localStorage.setItem(key(field),field.value);dirty.delete(field);if(dirty.size){failure()}else{status.hidden=false;status.textContent='✓ U ruajt.';retry.hidden=true}}catch(e){dirty.add(field);failure()}}fields.forEach(function(field){try{var saved=localStorage.getItem(key(field));if(saved!==null)field.value=saved}catch(e){failure()}field.addEventListener('input',function(){save(field)})});retry.addEventListener('click',function(){if(dirty.size){Array.from(dirty).forEach(save)}else{fields.forEach(save)}})})})();</script></body></html>