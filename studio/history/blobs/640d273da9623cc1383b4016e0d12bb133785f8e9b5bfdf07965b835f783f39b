<script>
(function(){
function init(){document.querySelectorAll('#content textarea[data-activity-item]').forEach(function(field){
var details=field.closest('details'),status=details.querySelector('[role="status"]'),retry=details.querySelector('[data-action="retry-save"]');
var key='ShoqeriaMjedisi4:pg015_sec001:'+field.dataset.activityItem;
var draft=field.value,dirty=false;
try{var saved=localStorage.getItem(key);if(saved!==null){field.value=saved;draft=saved;}}catch(e){status.textContent='⚠ Nuk u ruajt. Ruajtja lokale nuk është e disponueshme.';retry.hidden=false;}
function save(){draft=field.value;dirty=true;try{localStorage.setItem(key,draft);dirty=false;status.textContent='✓ U ruajt.';retry.hidden=true;}catch(e){status.textContent='⚠ Nuk u ruajt. Shënimi mbetet në këtë faqe; provoni përsëri.';retry.hidden=false;}}
field.addEventListener('input',save);field.addEventListener('change',save);retry.addEventListener('click',save);
window.addEventListener('pagehide',function(){if(dirty)save();});
window.addEventListener('pageshow',function(){if(dirty){field.value=draft;return;}try{var saved=localStorage.getItem(key);if(saved!==null)field.value=saved;}catch(e){}});
});}
if(document.readyState==='complete')init();else window.addEventListener('load',init,{once:true});
})();
</script>
