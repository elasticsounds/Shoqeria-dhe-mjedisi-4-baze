<script>
window.activityAnswerTextIds = JSON.parse('{}');
(function () {
  var book = new URL('.', location.href).pathname;
  document.querySelectorAll('#content textarea[data-activity-item]').forEach(function (field) {
    var box = field.closest('.bk-activity');
    var status = box.querySelector('[role=status]');
    var retry = box.querySelector('[data-action=retry-save]');
    var key = 'adt-notes:' + book + ':pg048_sec002:' + field.dataset.activityItem;
    var timer;
    function show(message, failed) { status.hidden = false; status.textContent = message; retry.hidden = !failed; }
    function save() {
      clearTimeout(timer);
      try {
        localStorage.setItem(key, field.value);
        retry.hidden = true;
        timer = setTimeout(function () { show('✓ U ruajt.', false); }, 400);
      } catch (e) { show('⚠ Nuk u ruajt. Shënimi mbetet në fushë.', true); }
    }
    try { var saved = localStorage.getItem(key); if (saved !== null) field.value = saved; }
    catch (e) { show('⚠ Shënimi nuk mund të lexohet nga ruajtja.', true); }
    field.addEventListener('input', save);
    retry.addEventListener('click', save);
  });
}());
</script>
