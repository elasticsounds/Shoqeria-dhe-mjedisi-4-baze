<body class="min-h-screen flex items-center justify-center"><main class="w-full"><div id="content" class="bk" data-family="lesson-discussion"><section data-section-id="pg105_sec001_p3" data-section-type="activity_open_ended_answer"><div class="bk-card bk-card--outline bk-activity" data-activity-pattern="short-response" data-activity-variant="ruled-list"><p class="bk-prompt" id="pg105-advice"><span data-id="pg105_n0020">Shkruaj një këshillë për Malin.</span> <span data-id="pg105_n0021">Tregoji atij se çfarë duhet të bëjë për të qenë i shëndetshëm.</span></p><span data-id="pg105_n0022"></span><input class="bk-field" id="activity-item-1" data-activity-item="item-1" type="text" aria-label="Shkruaj një këshillë për Malin, rreshti 1" aria-describedby="pg105-advice"><span data-id="pg105_n0023"></span><input class="bk-field" id="activity-item-2" data-activity-item="item-2" type="text" aria-label="Shkruaj një këshillë për Malin, rreshti 2" aria-describedby="pg105-advice"><span data-id="pg105_n0024"></span><input class="bk-field" id="activity-item-3" data-activity-item="item-3" type="text" aria-label="Shkruaj një këshillë për Malin, rreshti 3" aria-describedby="pg105-advice"><span data-id="pg105_n0025"></span><input class="bk-field" id="activity-item-4" data-activity-item="item-4" type="text" aria-label="Shkruaj një këshillë për Malin, rreshti 4" aria-describedby="pg105-advice"><span data-id="pg105_n0026"></span><input class="bk-field" id="activity-item-5" data-activity-item="item-5" type="text" aria-label="Shkruaj një këshillë për Malin, rreshti 5" aria-describedby="pg105-advice"><div class="bk-row"><button class="bk-btn" type="button" id="pg105-save">Dërgo</button><button class="bk-btn bk-btn--secondary" type="button" id="pg105-retry" hidden>Provo ruajtjen përsëri</button></div><p class="bk-feedback" id="pg105-status" role="status" aria-live="polite" hidden></p></div></section></div></main><script>window.activityAnswerTextIds = JSON.parse('{}');</script><div class="relative z-50" id="interface-container"></div><div class="relative z-50" id="nav-container"></div><script src="./assets/offline-preloader.js"></script><script src="./assets/scorm.js"></script><script src="./assets/base.bundle.local.js"></script><script>
(function(){
  var inputs=Array.from(document.querySelectorAll('#content [data-activity-item]'));
  var key='ShoqeriaDheMjedisi4:pg105_sec001:advice';
  var status=document.getElementById('pg105-status'), retry=document.getElementById('pg105-retry'), timer;
  try { var stored=JSON.parse(localStorage.getItem(key)||'{}'); inputs.forEach(function(input){if(typeof stored[input.dataset.activityItem]==='string') input.value=stored[input.dataset.activityItem];}); } catch(e) { status.hidden=false; status.textContent='! Shënimet e ruajtura nuk mund të lexohen.'; }
  function save(){
    clearTimeout(timer); var draft={}; inputs.forEach(function(input){draft[input.dataset.activityItem]=input.value;});
    try { var text=JSON.stringify(draft); localStorage.setItem(key,text); if(localStorage.getItem(key)!==text) throw new Error('save'); status.hidden=false; status.textContent='✓ U ruajt.'; retry.hidden=true; }
    catch(e){status.hidden=false; status.textContent='! Nuk u ruajt.'; retry.hidden=false;}
  }
  inputs.forEach(function(input){input.addEventListener('input',function(){clearTimeout(timer);timer=setTimeout(save,500);});});
  document.getElementById('pg105-save').addEventListener('click',save); retry.addEventListener('click',save);
})();
</script></body></html>