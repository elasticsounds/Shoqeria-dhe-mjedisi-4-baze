        <li class="adt-body text-left">
          <div data-id="pg053_n0013">Shkruani një kërkesë dhe përpiquni t’i bindni drejtuesit për atë që kërkoni.</div>
          <label for="item-1" class="sr-only">Shkruani një kërkesë dhe përpiquni t’i bindni drejtuesit për atë që kërkoni.</label>
          <textarea id="item-1" data-activity-item="item-1" aria-label="Shkruani një kërkesë dhe përpiquni t’i bindni drejtuesit për atë që kërkoni." class="mt-3 min-h-11 w-full rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none ring-0 focus:border-purple-500"></textarea>
