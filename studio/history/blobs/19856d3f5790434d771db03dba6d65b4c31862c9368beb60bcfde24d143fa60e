        <li class="adt-body text-left">
          <div data-id="pg053_n0015">Si mendoni të përfshiheni në vendime që ju përkasin dhe juve?</div>
          <label for="item-2" class="sr-only">Si mendoni të përfshiheni në vendime që ju përkasin dhe juve?</label>
          <textarea id="item-2" data-activity-item="item-2" aria-label="Si mendoni të përfshiheni në vendime që ju përkasin dhe juve?" class="mt-3 min-h-11 w-full rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none ring-0 focus:border-purple-500"></textarea>
        </li>
