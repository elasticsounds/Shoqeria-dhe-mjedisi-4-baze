<script>
(function () {
  var fields = Array.from(document.querySelectorAll('#content [data-activity-item]'));
  var status = document.getElementById('plan-status');
  var retry = document.getElementById('plan-retry');
  var prefix = 'Shoqeria-dhe-Mjedisi-4:pg125_sec001:';
  var failed = false;
  function key(field) { return prefix + field.getAttribute('data-activity-item'); }
  function save() {
    try {
      fields.forEach(function (field) { localStorage.setItem(key(field), field.value); });
      failed = false; retry.hidden = true; status.textContent = '✓ Plani u ruajt në këtë pajisje.';
    } catch (error) {
      failed = true; retry.hidden = false; status.textContent = '⚠ Plani nuk u ruajt. Teksti mbetet këtu; provoni përsëri.';
    }
  }
  try { fields.forEach(function (field) { var value = localStorage.getItem(key(field)); if (value !== null) field.value = value; }); }
  catch (error) { failed = true; retry.hidden = false; status.textContent = '⚠ Ruajtja nuk është e disponueshme. Teksti mbetet këtu; provoni përsëri.'; }
  fields.forEach(function (field) { field.addEventListener('input', save); });
  retry.addEventListener('click', save);
  window.addEventListener('beforeunload', function (event) { if (failed) { event.preventDefault(); event.returnValue = ''; } });
  function placeSend() {
    var slot = document.getElementById('send-position');
    var button = Array.from(document.querySelectorAll('button')).find(function (el) { return el.textContent.trim() === 'Dërgo' && !slot.contains(el); });
    if (button) {
      var wrapper = button.parentElement;
      var origin = wrapper && wrapper.parentElement;
      button.className = 'bk-btn';
      if (wrapper && wrapper !== document.body && wrapper !== document.getElementById('content')) {
        slot.appendChild(wrapper);
        wrapper.style.position = 'static'; wrapper.style.transform = 'none'; wrapper.style.background = 'transparent'; wrapper.style.padding = '0'; wrapper.style.boxShadow = 'none';
        if (origin && origin !== document.body && origin.id !== 'interface-container' && origin.id !== 'nav-container' && !origin.textContent.trim() && !origin.querySelector('button,input,a,select,textarea')) origin.remove();
      } else { slot.appendChild(button); }
    }
  }
  new MutationObserver(placeSend).observe(document.body, {childList: true, subtree: true});
  placeSend();
})();
</script>
