  <script>
  (function () {
    function setup() {
      document.querySelectorAll('#content textarea[data-activity-item]').forEach(function (field) {
        var details = field.closest('details');
        var status = details.querySelector('[role="status"]');
        var retry = details.querySelector('[data-action="retry-save"]');
        var key = 'Shoqeria-dhe-Mjedisi-4:' + location.pathname.replace(/[^/]*$/, '') + ':pg112_sec002:' + field.dataset.activityItem;
        var edited = false;
        function message(ok) {
          status.textContent = ok ? '✓ U ruajt.' : '⚠ Nuk u ruajt.';
          status.hidden = false;
          retry.hidden = ok;
        }
        function restore() {
          try {
            var saved = localStorage.getItem(key);
            if (saved !== null) field.value = saved;
            status.hidden = true;
            retry.hidden = true;
          } catch (error) { message(false); }
        }
        function save() {
          try {
            localStorage.setItem(key, field.value);
            if (localStorage.getItem(key) !== field.value) throw new Error('Save verification failed');
            message(true);
          } catch (error) { message(false); }
        }
        restore();
        field.addEventListener('input', function () { edited = true; save(); });
        retry.addEventListener('click', function () { if (edited) save(); else restore(); });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup); else setup();
  }());
  </script>
