<body class="min-h-screen flex items-center justify-center">
  <main class="w-full">
    <div class="bk" data-family="lesson-discussion" id="content">
      <section data-section-type="boxed_text" data-section-id="pg089_sec001">
        <header class="bk-banner"><h1 class="bk-title" data-id="pg089_n0002">Traditat dhe trashëgimia jonë</h1></header>
        <div class="bk-stack">
          <h2 class="bk-heading" data-id="pg089_n0004">Pjesëmarrja jonë në festë</h2>
          <div class="bk-card bk-card--surface1 bk-stack">
            <section class="bk-activity" data-activity-pattern="discussion" data-activity-variant="group-discussion">
              <label class="bk-prompt bk-label" for="item-1"><span data-id="pg089_n0010">Pse është e rëndësishme të zbukurohet ambienti për një festë të caktuar?</span></label>
              <details><summary class="bk-btn bk-btn--secondary">Shënime (opsionale)</summary>
                <textarea class="bk-field" id="item-1" data-activity-item="item-1" rows="3"></textarea>
                <p class="bk-feedback" role="status" aria-live="polite"></p><button class="bk-btn bk-btn--secondary" type="button" data-action="retry-save" hidden>Provo ruajtjen përsëri</button>
              </details>
            </section>
            <section class="bk-activity" data-activity-pattern="discussion" data-activity-variant="group-discussion">
              <label class="bk-prompt bk-label" for="item-2"><span data-id="pg089_n0012">Si duhet të veprojmë gjatë festës, në të cilën jemi të ftuar?</span></label>
              <details><summary class="bk-btn bk-btn--secondary">Shënime (opsionale)</summary>
                <textarea class="bk-field" id="item-2" data-activity-item="item-2" rows="3"></textarea>
                <p class="bk-feedback" role="status" aria-live="polite"></p><button class="bk-btn bk-btn--secondary" type="button" data-action="retry-save" hidden>Provo ruajtjen përsëri</button>
              </details>
            </section>
          </div>
