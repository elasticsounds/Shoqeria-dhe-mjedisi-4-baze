  <script>window.activityAnswerTextIds = JSON.parse('{}');</script>
  <div class="relative z-50" id="interface-container"></div>
  <div class="relative z-50" id="nav-container"></div>
  <script src="./assets/offline-preloader.js"></script>
  <script src="./assets/scorm.js"></script>
  <script src="./assets/base.bundle.local.js"></script>
  <script>
  (function () {
    document.querySelectorAll('#content textarea[data-activity-item]').forEach(function (field) {
      var key = 'ShoqeriaDheMjedisi4:pg089_sec001:' + field.dataset.activityItem;
      var details = field.closest('details'), status = details.querySelector('[role="status"]'), retry = details.querySelector('[data-action="retry-save"]');
      function fail() { status.textContent = '⚠ Nuk u ruajt. Shënimi mbetet këtu; provoni përsëri.'; retry.hidden = false; }
      function save() {
        try { localStorage.setItem(key, field.value); if (localStorage.getItem(key) !== field.value) throw new Error('save'); status.textContent = '✓ U ruajt.'; retry.hidden = true; }
        catch (error) { fail(); }
      }
      try { var saved = localStorage.getItem(key); if (saved !== null) field.value = saved; }
      catch (error) { fail(); }
      field.addEventListener('input', save);
      retry.addEventListener('click', save);
    });
  }());
  </script>
