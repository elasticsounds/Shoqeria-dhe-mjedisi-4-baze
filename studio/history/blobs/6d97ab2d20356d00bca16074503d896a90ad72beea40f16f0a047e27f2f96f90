    <script>
    // The reader refreshes data-id text from its dictionary; restore source emphasis after refresh.
    (() => {
      const line = document.querySelector('[data-id="pg007_n0079"]');
      const label = 'Fjalët kyçe:';
      function emphasizeLabel() {
        if (line.querySelector('strong') || !line.textContent.startsWith(label)) return;
        const text = line.textContent;
        const strong = document.createElement('strong');
        strong.textContent = label;
        line.replaceChildren(strong, document.createTextNode(text.slice(label.length)));
      }
      new MutationObserver(emphasizeLabel).observe(line, {childList:true, subtree:true});
      emphasizeLabel();
    })();
    </script>
    <script>
    // Supply this screen's display label without changing reader links or reading order.
