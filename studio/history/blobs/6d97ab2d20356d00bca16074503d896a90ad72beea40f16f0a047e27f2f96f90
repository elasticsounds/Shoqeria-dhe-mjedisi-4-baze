        root.querySelectorAll('.truncate').forEach(node => {
          if (!node.children.length && /^(Fjalët kyçe:|Indeksi$)/.test(node.textContent.trim())) {
            node.textContent = title;
            node.setAttribute('title', title);
          }
        });
