      <h1 class="adt-h1 font-bold text-white" data-id="pg103_n0002">Resurset dhe trash&#xeb;gimia e vendit tim</h1>
      <div aria-hidden="true" class="shrink-0 w-24 h-24 rounded-2xl bg-purple-400/80 flex items-center justify-center text-white">
