    <h2 class="adt-h2 font-semibold text-slate-900 border-b-4 border-purple-400 pb-2 inline-block" data-id="pg103_n0004">Ruajm&#xeb; trash&#xeb;gimin&#xeb; kulturore</h2>
  </div>

  <aside class="mt-5 mb-6 rounded-2xl bg-purple-100 border border-purple-200 overflow-hidden shadow-sm">
    <div class="flex items-stretch">
