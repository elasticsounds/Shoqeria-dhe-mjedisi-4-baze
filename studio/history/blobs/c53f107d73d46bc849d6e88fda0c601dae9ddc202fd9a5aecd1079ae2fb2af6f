  <script>
    (function () {
      var fields = document.querySelectorAll('#content [data-activity-item]');
      fields.forEach(function (field) {
        var key = 'shoqeria-mjedisi-4:pg077_sec002:' + field.dataset.activityItem;
        var details = field.closest('details');
        var feedback = details.querySelector('[role="status"]');
        var retry = details.querySelector('[data-action="retry-save"]');
        try {
          var saved = localStorage.getItem(key);
          if (saved !== null) field.value = saved;
        } catch (e) {
          feedback.hidden = false;
          feedback.textContent = '⚠ Nuk u lexuan shënimet e ruajtura.';
        }
        function save() {
          try {
            localStorage.setItem(key, field.value);
            feedback.hidden = false;
            feedback.textContent = '✓ U ruajt.';
            retry.hidden = true;
          } catch (e) {
            feedback.hidden = false;
            feedback.textContent = '⚠ Nuk u ruajt. Shënimi mbetet këtu; provo përsëri.';
            retry.hidden = false;
          }
        }
        field.addEventListener('input', save);
        retry.addEventListener('click', save);
      });
    }());
  </script>
