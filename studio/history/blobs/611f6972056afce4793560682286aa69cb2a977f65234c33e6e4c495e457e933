<script>
(function(){
'use strict';
const book='Shoqeria-dhe-Mjedisi-4', source='pg027_sec001';
document.querySelectorAll('#content textarea[data-activity-item]').forEach(function(field){
const key=book+':'+source+':'+field.dataset.activityItem;
const group=field.closest('.bk-activity');
const status=group.querySelector('[role="status"]');
const retry=group.querySelector('[data-action="retry-save"]');
let touched=false, saved=null;
function report(ok){status.hidden=false;status.textContent=ok?'✓ U ruajt.':'⚠ Nuk u ruajt. Shënimi mbetet këtu; provo përsëri.';retry.hidden=ok;}
function save(){
try{localStorage.setItem(key,field.value);saved=field.value;report(true);}
catch(error){report(false);}
}
try{saved=localStorage.getItem(key);if(saved!==null)field.value=saved;}
catch(error){report(false);}
field.addEventListener('input',function(){touched=true;save();});
field.addEventListener('change',function(){touched=true;save();});
retry.addEventListener('click',save);
// The existing reader may restore a legacy draft during its load lifecycle.
// Adopt it only when this section-scoped record does not yet exist.
function reconcile(){if(touched)return;if(saved!==null){field.value=saved;}else if(field.value!==''){save();}}
window.addEventListener('load',function(){reconcile();setTimeout(reconcile,500);});
window.addEventListener('pageshow',reconcile);
window.addEventListener('pagehide',function(){if(touched && field.value!==saved)save();});
});
})();
</script>
