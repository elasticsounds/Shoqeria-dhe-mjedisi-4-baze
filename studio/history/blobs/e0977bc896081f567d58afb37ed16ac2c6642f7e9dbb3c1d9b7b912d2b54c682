<template id="dance-part">
<header class="bk-banner"><h1 data-id="pg011_n0002" class="bk-title">Lidhjet dhe bashkëpunimi me të tjerët</h1><img src="studio/assets/pg011_sec001-people.png" alt="" aria-hidden="true" width="48" height="48"></header>
<h2 data-id="pg011_n0004" class="bk-heading">Grupet shoqërore</h2>
<figure id="scene" class="bk-figure" data-part="1"><img data-id="pg011_im001" src="images/pg011_im001.png" alt="Tre fëmijë vallëzojnë të lumtur së bashku, me duart lart dhe nota muzikore përreth."></figure>
</template>
<template id="football-part"><figure id="scene" class="bk-figure" data-part="2"><img data-id="pg011_im002" src="images/pg011_im002.png" alt="Një djalë me këmbën mbi topin e futbollit dhe një vajzë përballë tij në një fushë me bar."></figure></template>
<script>window.activityAnswerTextIds = JSON.parse('{}');</script>
<div id="interface-container"></div>
<div id="nav-container"></div>
<script src="./assets/offline-preloader.js"></script>
<script src="./assets/scorm.js"></script>
<script src="./assets/base.bundle.local.js"></script>
<script>
(function(){
const content=document.getElementById('part-content'),previous=document.getElementById('previous-scene'),next=document.getElementById('next-scene'),inspect=document.getElementById('inspect-scene'),dialog=document.getElementById('image-view');
function show(part,focus){
content.replaceChildren(document.getElementById(part===2?'football-part':'dance-part').content.cloneNode(true));
previous.hidden=part===1;next.hidden=part===2;
document.getElementById('part-status').textContent=part+' / 2';
if(focus){inspect.focus({preventScroll:true});window.scrollTo({top:0,behavior:'instant'});}
}
previous.addEventListener('click',()=>{history.replaceState(null,'',location.pathname+location.search);show(1,true)});
next.addEventListener('click',()=>{history.replaceState(null,'',location.pathname+location.search+'#pamja-2');show(2,true)});
inspect.addEventListener('click',()=>{const image=content.querySelector('figure img'),large=document.getElementById('large-scene');large.src=image.getAttribute('src');large.alt=image.alt;dialog.showModal();document.getElementById('close-view').focus()});
document.getElementById('close-view').addEventListener('click',()=>dialog.close());
dialog.addEventListener('close',()=>inspect.focus());
if(location.hash==='#pamja-2')show(2,false);
})();
</script>
</body>
