#content dialog{width:calc(100% - 32px);max-width:var(--bk-shell);max-height:calc(100dvh - 32px);overflow:auto;padding:var(--bk-pad);border:var(--bk-border) solid var(--bk-primary);border-radius:var(--bk-r-card);color:var(--bk-ink);background:var(--bk-paper)}
