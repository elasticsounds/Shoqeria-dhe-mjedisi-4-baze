<script>
// The reader localizes each data-id as one string. Restore its semantic pair after localization.
(() => {
  const list = document.querySelector('#content dl');
  function restorePairs() {
    list.querySelectorAll(':scope > div[data-id]').forEach(entry => {
      if (entry.querySelector(':scope > dt') && entry.querySelector(':scope > dd')) return;
      const match = entry.textContent.match(/^\s*(.*?)\s([–-])\s([\s\S]*)$/);
      if (!match) return;
      const term = document.createElement('dt');
      const definition = document.createElement('dd');
      term.textContent = match[1];
      definition.textContent = match[2] + ' ' + match[3];
      entry.replaceChildren(term, document.createTextNode(' '), definition);
    });
  }
  new MutationObserver(restorePairs).observe(list, {childList:true, subtree:true, characterData:true});
  restorePairs();
})();
</script>
