    <script type="text/javascript">
    (function () {
      'use strict';
      var prefix = 'ShoqeriaDheMjedisi4:pg122_sec002:';
      var failed = new Set();
      function root() { return document.querySelector('[data-section-id="pg122_sec002"]'); }
      function prepare(input) {
        var card = input.closest('.bk-activity');
        if (card.querySelector('.bk-feedback')) return;
        var status = document.createElement('p');
        status.className = 'bk-feedback'; status.id = 'pg122-status-' + input.getAttribute('data-activity-item');
        status.setAttribute('role', 'status'); status.setAttribute('aria-live', 'polite');
        input.setAttribute('aria-describedby', status.id); card.appendChild(status);
        var retry = document.createElement('button');
        retry.type = 'button'; retry.className = 'bk-btn bk-btn--secondary'; retry.dataset.retry = input.getAttribute('data-activity-item');
        retry.textContent = 'Provo ruajtjen përsëri'; retry.hidden = true; card.appendChild(retry);
      }
      function save(input) {
        prepare(input);
        var item = input.getAttribute('data-activity-item'), card = input.closest('.bk-activity');
        var status = card.querySelector('.bk-feedback'), retry = card.querySelector('[data-retry]');
        try {
          localStorage.setItem(prefix + item, input.value);
          if (localStorage.getItem(prefix + item) !== input.value) throw new Error('save failed');
          failed.delete(item); status.textContent = '✓ U ruajt.'; retry.hidden = true;
        } catch (e) {
          failed.add(item); status.textContent = '! Nuk u ruajt. Përgjigjja mbetet këtu; provo përsëri.'; retry.hidden = false;
        }
      }
      function restore() {
        var r = root(); if (!r) return;
        r.querySelectorAll('textarea[data-activity-item]').forEach(function (input) {
          prepare(input);
          try { var value = localStorage.getItem(prefix + input.getAttribute('data-activity-item')); if (value !== null) input.value = value; }
          catch (e) { input.closest('.bk-activity').querySelector('.bk-feedback').textContent = '! Ruajtja nuk është e qasshme.'; }
        });
      }
      document.addEventListener('input', function (event) {
        var r = root(); if (r && event.target.matches('textarea[data-activity-item]') && r.contains(event.target)) save(event.target);
      });
      document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-retry]'), r = root();
        if (button && r && r.contains(button)) { var input = r.querySelector('textarea[data-activity-item="' + button.dataset.retry + '"]'); if (input) save(input); }
      });
      window.addEventListener('beforeunload', function (event) { if (failed.size) { event.preventDefault(); event.returnValue = ''; } });
      document.addEventListener('adt:page-changed', restore);
      restore();
    })();
    </script>
