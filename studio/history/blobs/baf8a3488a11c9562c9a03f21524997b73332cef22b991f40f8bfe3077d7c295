<script>
(function(){
const viewer=document.getElementById('pg016-viewer');
const trigger=document.getElementById('pg016-inspect');
const original=document.getElementById('pg016-original');
const zoomIn=document.getElementById('pg016-zoom-in');
const zoomOut=document.getElementById('pg016-zoom-out');
let zoom=1;
function update(){original.style.width=(zoom*100)+'%';zoomOut.disabled=zoom===1;zoomIn.disabled=zoom===4;document.getElementById('pg016-view-status').textContent=(zoom*100)+'%';}
trigger.addEventListener('click',function(){zoom=1;update();viewer.showModal();viewer.scrollTop=0;viewer.scrollLeft=0;});
document.getElementById('pg016-close').addEventListener('click',function(){viewer.close();});
viewer.addEventListener('close',function(){trigger.focus();});
zoomIn.addEventListener('click',function(){zoom=Math.min(4,zoom+1);update();});
zoomOut.addEventListener('click',function(){zoom=Math.max(1,zoom-1);update();});
})();
</script>
