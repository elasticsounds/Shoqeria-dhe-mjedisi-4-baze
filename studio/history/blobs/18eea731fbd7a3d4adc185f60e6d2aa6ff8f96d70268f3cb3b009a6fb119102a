d\" content=\"pg096_sec003\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"133\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <h1 class=\"sr-only\" id=\"page-heading\">Shoqëria dhe Mjedisi 4</h1>\n      <div data-family=\"lesson-discussion\" id=\"content\" class=\"container opacity-0 bk\"><span aria-hidden=\"true\" data-ornament=\"folio-rule\" class=\"bk-orn bk-orn--folio-rule\"></span><section data-section-type=\"boxed_text\" data-section-id=\"pg096_sec003\" class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-4 py-8 bg-white\"><div class=\"border-2 border-purple-400 bg-white overflow-hidden\"><div class=\"flex items-stretch max-sm:flex-col\"><div aria-hidden=\"true\" class=\"w-44 max-lg:w-36 max-sm:w-full shrink-0 bg-purple-500 flex items-center justify-center px-4 py-5 max-sm:py-4\"><div class=\"h-16 w-16 max-sm:h-14 max-sm:w-14 rounded-sm border-2 border-white/80 bg-white/10\"></div></div><div class=\"flex-1 px-7 py-5 max-lg:px-5 max-lg:py-4 max-sm:px-4 max-sm:py-4\"><p class=\"adt-body text-left italic leading-relaxed text-gray-800\"><span data-id=\"pg096_n0031\">Pasuritë mbitokësore janë të gjitha pasuritë që gjenden mbi sipërfaqen e tokës.</span> <span data-id=\"pg096_n0032\">Pasuri mbitokësore janë: ujërat (lumenjtë, liqenet, detet, oqeanet), fushat, malet, kafshët e bimët.</span> <span data-id=\"pg096_n0033\">Pasuritë mbitokësore janë pasuri që ndikojnë në zhvillimin ekonomik të vendit.</span> <span data-id=\"pg096_n0034\">Druri karakterizohet si burim kryesor i ngrohjes dhe i prodhimit të shumë sendeve në dobi të njeriut.</span> <span data-id=\"pg096_n0035\">Pasuritë ujore përfshijnë liqenet, lumenjtë, ujërat minerale dhe termike.</span> <span data-id=\"pg096_n0036\">Liqenet më të njohura janë: liqeni i Radoniqit, i Ujmanit, ai i Batllavës, i Përlepnicës dhe i Badovcit.</span> <span data-id=\"pg096_n0037\">Ndërsa, lumenjtë kryesorë janë: Drini i Bardhë, Lepenci, Morava dhe Ibri.</span> <span data-id=\"pg096_n0038\">Ujërat kryesore minerale dhe termike janë Banja e Pejës, Banjska dhe Banja e Kllokotit.</span> <span data-id=\"pg096_n0039\">Të gjitha këto njihen si banja termale shëruese, të cilat shfrytëzohen për shërimin e shumë sëmundjeve.</span></p></div></div></div></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg097_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg097_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" 