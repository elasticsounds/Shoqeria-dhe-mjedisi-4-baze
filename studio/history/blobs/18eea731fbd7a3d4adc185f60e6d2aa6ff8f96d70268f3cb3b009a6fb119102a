 grupit.\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-400 bg-white px-4 py-3 text-gray-900 outline-none focus:border-purple-600\">\n      </div>\n      <p class=\"adt-body text-left text-gray-900 leading-relaxed mb-3\">\n        <span data-id=\"pg043_n0007\">Ndiq hapat më poshtë për të kryer veprimtarinë/ temën që e keni caktuar:</span>\n      </p>\n      <ul class=\"space-y-3\">\n        <li>\n          <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg043_n0010\">tematika e veprimtarisë;</span></p>\n          <label for=\"activity-item-2\" class=\"sr-only\">tematika e veprimtarisë;</label>\n          <input id=\"activity-item-2\" data-activity-item=\"item-2\" type=\"text\" aria-label=\"tematika e veprimtarisë;\" class=\"mt-2 w-full min-h-11 rounded-lg border border-purple-300 bg-white px-4 py-3 text-gray-900 outline-none focus:border-purple-600\">\n        </li>\n        <li>\n          <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg043_n0012\">rëndësinë që ka pjesëmarrja në këto aktivitete;</span></p>\n          <label for=\"activity-item-3\" class=\"sr-only\">rëndësinë që ka pjesëmarrja në këto aktivitete;</label>\n          <textarea id=\"activity-item-3\" data-activity-item=\"item-3\" aria-label=\"rëndësinë që ka pjesëmarrja në këto aktivitete;\" class=\"mt-2 w-full min-h-11 rounded-lg border border-purple-300 bg-white px-4 py-3 text-gray-900 outline-none focus:border-purple-600\" rows=\"2\"></textarea>\n        </li>\n        <li>\n          <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg043_n0014\">përgjegjësia që ka secili prej grupeve të punës;</span></p>\n          <label for=\"activity-item-4\" class=\"sr-only\">përgjegjësia që ka secili prej grupeve të punës;</label>\n          <textarea id=\"activity-item-4\" data-activity-item=\"item-4\" aria-label=\"përgjegjësia që ka secili prej grupeve të punës;\" class=\"mt-2 w-full min-h-11 rounded-lg border border-purple-300 bg-white px-4 py-3 text-g