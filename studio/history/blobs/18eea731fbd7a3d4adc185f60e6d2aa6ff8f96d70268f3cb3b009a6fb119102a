g060_n0010_easy_read":"Poezia më e bukur ishte poezia e Malit.\nAta vendosën ta dërgojnë atë në redaksi për botim.","pg060_n0011_easy_read":"Eja ta lexojmë edhe 1 herë së bashku.","pg060_n0013_easy_read":"Kosova","pg060_n0015_easy_read":"E dua Kosovën e maleve të Sharrit.","pg060_n0016_easy_read":"E dua Kosovën e Adem Jasharit.","pg060_n0017_easy_read":"E dua Kosovën, të fortë dhe trime.","pg060_n0018_easy_read":"E dua Kosovën e luftëtarëve dhe të nënave heroike.","pg060_n0019_easy_read":"E dua Kosovën e qëndresës.","pg060_n0020_easy_read":"E dua Kosovën e fjalës dhe të besës.","pg060_n0021_easy_read":"E dua Kosovën e dashurisë.","pg060_n0022_easy_read":"E dua Kosovën e mirësisë.","pg060_n0023_easy_read":"E dua Kosovën për malet e gjelbëruara.","pg060_n0024_easy_read":"E dua Kosovën për pasuritë e bekuara.","pg060_n0025_easy_read":"E dua Kosovën e Kushtetutës dhe të ligjit.","pg060_n0026_easy_read":"Të dua ashtu si je.","pg060_n0027_easy_read":"Sepse për mua je atdheu më i bukur.","pg060_n0031_easy_read":"Çfarë mendon për këtë poezi?","pg060_n0033_easy_read":"Përse përmendet luftëtari Adem Jashari?","pg060_n0035_easy_read":"Si e tregon ti dashurinë për vendin tënd?","pg060_n0037_easy_read":"Përse ekzistojnë kushtetuta dhe ligji në një shtet?","pg060_n0039_easy_read":"Çfarë ndodh nëse 1 njeri nuk i respekton ligjet?","pg060_n0042_easy_read":"Atdheu tregon rrënjët tona.\nAtdheu tregon vendin ku kemi lindur.\nAtdheu tregon traditat dhe zakonet tona.","pg060_n0043_easy_read":"Atdheu ynë është Kosova.","pg060_n0044_easy_read":"Ne jemi krenarë për vendin tonë.","pg060_n0045_easy_read":"Kosova ka shumë bukuri natyrore.","pg060_n0046_easy_read":"Ne krenohemi me historinë e Kosovës.\nHistoria e Kosovës shërben si udhërrëfyes për të gjithë brezat e rinj.","pg060_n0047_easy_read":"Kosova qeveriset me sistem demokratik.\nKy sistem përbëhet nga 3 degë të pavarura të pushtetit:\n- Parlamenti\n- Qeveria\n- Gjyqësori","pg060_n0048_easy_read":"Të 3 degët punojnë sipas Kushtetutës dhe ligjeve.\nParlamenti i nxjerr ligjet.","pg060_n0051_easy_read":"Fjalët kyçe:","pg060_n0052_easy_read":"- Kosovë\n- atdhe\n- shqiptar\n- kosovar","pg061_n0009_easy_read":"Në familjen e Kledit po bëhen gati për udhëtim.","pg061_n0010_easy_read":"Ata do të shkojnë në Angli për pushime.","pg061_n0011_easy_read":"Kledi është 6 vjeç dhe shumë i emocionuar.\nAi do të udhëtojë me aeroplan për herë të parë.","pg061_n0012_easy_read":"Të gjithë po i mblidhnin gjërat e nevojshme.\nPastaj po i palosnin dhe po i vinin në valixhe.","pg061_n0014_easy_read":"Mamaja erdhi me pasaportat në dorë.","pg061_n0015_easy_read":"Pasaportat janë më të rëndësishmet.\nPa to, ne nuk mund të hyjmë në aeroplan.","pg061_n0016_easy_read":"Kledi e mori pasaportën në dorë.\nAi po e shikonte me kujdes.","pg061_n0018_easy_read":"- Babi, - pyeti Kledi.","pg061_n0019_easy_read":"- Pse në pasaportë është flamuri ynë?","pg061_n0020_easy_read":"- Ai nuk është flamuri, biri im.","pg061_n0021_easy_read":"- Është stema e Kosovës, - tha babai.","pg061_n0022_easy_read":"- Çfarë është stema?","pg061_n0023_easy_read":"- Çdo shtet ka:\n- flamurin\n- stemën\n- himnin e vet.","pg061_n0024_easy_read":"- Këto janë simbolet e shtetit.","pg061_n0025_easy_read":"- Simbolet e përfaqësojnë shtetin tonë në të gjithë botën.","pg061_n0026_easy_read":"- Edhe shteti ynë, Kosova jonë e dashur, e ka fituar Pavarësinë më 17 shkurt 2008.\nQë nga ajo datë, Kosova është shpallur shtet dhe quhet Republika e Kosovës.","pg061_n0027_easy_read":"- 17 Shkurti është festa jonë shtetërore.","pg061_n0029_easy_read":"- Pse në flamur janë 6 yje? - vazhdoi Kledi.","pg061_n0030_easy_read":"- Sepse në Kosovë jetojnë edhe popuj të tjerë, përveç shqiptarëve.","pg061_n0031_easy_read":"- Ua, - tha mamaja.","pg061_n0032_easy_read":"- Vazhdoni bisedën një herë tjetër.\nKoha po ikën dhe ne duhet të nisemi.","pg061_n0034_easy_read":"Kledi dëgjoi për herë të parë për simbolet e shtetit.\nKjo gjë iu duk shumë interesante.","pg062_n0007_easy_read":"Kur është shpallur pavarësia e Kosovës?","pg062_n0009_easy_read":"Cilat janë simbolet e shtetit?","pg062_n0011_easy_read":"Cilët popuj i simbolizojnë yjet në flamurin e Kosovës?","pg062_n0013_easy_read":"Kur dëgjohet Himni i Kosovës?","pg062_n0015_easy_read":"Si ka ndikuar heqja e vizave në jetën e familjeve në Kosovë?","pg062_n0017_easy_read":"Dëgjojeni Himnin e Kosovës në klasë.","pg062_n0020_easy_read":"Pavarësia e Kosovës u shpall më 17 shkurt 2008.","pg062_n0021_easy_read":"Kjo datë është festa më e rëndësishme e Kosovës.\nKjo festë kremtohet me shumë dashuri.","pg062_n0022_easy_read":"Në gjithë vendin tonë dhe në të gjitha vendet ku jetojnë shqiptarët, organizohen aktivitete festive për ta shënuar këtë ditë.","pg062_n0023_easy_read":"Shteti ynë krijoi simbolet shtetërore:\n- flamurin\n- stemën\n- himnin shtetëror","pg062_n0025_easy_read":"Flamuri i Kosovës ka ngjyrë të kaltër.\nNë flamur është një hartë e verdhë e Kosovës.\nMbi hartë janë 6 yje të bardha.","pg062_n0026_easy_read":"Yjet tregojnë 6 popujt, pra komunitetet etnike, që jetojnë në Kosovë.","pg062_n0028_easy_read":"Stema e Kosovës është simbol i Republikës së Kosovës.","pg062_n0030_easy_read":"Himni është një këngë solemne.\nAi ekzekutohet:\n- në ceremonitë shtetërore\n- në çdo veprimtari ndërkombëtare\n- në ngjarjet sportive ku merr pjesë vendi ynë\n- në raste të tjera që përcaktohen me ligje përkatëse","pg062_n0032_easy_read":"Fjalët kyçe:\n- simbol shtetëror\n- flamur\n- stemë\n- himn\n- festë shtetërore\n- 17 Shkurti\n- pavarësi","pg063_n0008_easy_read":"Luna dhe Lisi janë shokë të mirë.","pg063_n0009_easy_read":"Ata vendosën ta mësojnë mësimin \"Rajonet e Kosovës\" në shtëpinë e Lisit.\nAta e bënë këtë sepse nëna e Lisit është mësuese e gjeografisë.","pg063_n0010_easy_read":"Të gjithë nxënësit e duan shumë mësuesen Lirikë.\nAjo e shpjegon mësimin përmes lojës.","pg063_n0012_easy_read":"Mësuesja Lirikë e kishte përgatitur hartën e Kosovës.\nNjë pjesë e hartës ishte me ngjyrë të kaltër.\nNjë pjesë tjetër ishte me ngjyrë të verdhë.","pg063_n0013_easy_read":"Mësuesja Lirikë shpjegoi se Kosova është e ndarë në 2 rajone:\n- Fusha e Kosovës\n- Rrafshi i Dukagjinit","pg063_n0014_easy_read":"Pastaj, mësuesja Lirikë tregoi se Kosova ka 7 qendra rajonale.","pg063_n0015_easy_read":"Mësuesja Lirikë mori etiketat me emra.\nAjo vendosi 3 etiketa në Rrafshin e Dukagjinit:\n- Gjakova\n- Peja\n- Prizreni\nAjo vendosi 4 etiketa në Fushën e Kosovës:\n- Ferizaji\n- Gjilani\n- Mitrovica\n- Prishtina","pg063_n0016_easy_read":"Etiketa me emrin e Prishtinës ishte me ngjyrë të kuqe.\nKjo etiketë dallohej nga qendrat e tjera rajonale.\nPrishtina është kryeqyteti i Kosovës.","pg063_n0018_easy_read":"Luna dhe Lisi u kënaqën shumë.","pg063_n0019_easy_read":"- Nuk do t’i harrojmë kurrë këto që mësuam sot,","pg063_n0020_easy_read":"- thanë Luna dhe Lisi.","pg063_n0022_easy_read":"Mitrovica","pg063_n0023_easy_read":"Peja","pg063_n0024_easy_read":"Prishtina","pg063_n0025_easy_read":"Rrafshi i Dukagjinit","pg063_n0026_easy_read":"Fusha e Kosovës","pg063_n0027_easy_read":"Gjilani","pg063_n0028_easy_read":"Gjakova","pg063_n0029_easy_read":"Ferizaj","pg063_n0030_easy_read":"Prizreni","pg063_n0034_easy_read":"Zgjidh 1 ngjyrë.\nPastaj ngjyros aq katrorë sa tregojnë më së miri sa pajtohesh me këto pohime.","pg063_n0035_easy_read":"Në fund të kësaj njësie mësimore, unë mund të tregoj se:","pg063_n0037_easy_read":"Kosova ka 2 regjione. □□□□□","pg063_n0039_easy_read":"Kosova ka 7 qendra regjionale. □□□□□","pg063_n0041_easy_read":"Prishtina është kryeqyteti i Kosovës. □□□□□","pg063_n0043_easy_read":"Peja dallohet për Grykën e Rugovës dhe për Drinin e Bardhë. □□□□□","pg064_n0007_easy_read":"A mësoni edhe ju ndonjëherë duke luajtur?","pg064_n0009_easy_read":"Cilat janë rajonet e Kosovës?","pg064_n0011_easy_read":"Cilat janë qendrat rajonale të Kosovës?","pg064_n0013_easy_read":"Në cilin rajon jetoni ju?","pg064_n0015_easy_read":"Cili është kryeqyteti i Kosovës?","pg064_n0017_easy_read":"Përmend disa veçori të rajoneve të Kosovës.","pg064_n0019_easy_read":"Njihuni me disa vende karakteristike të qendrave rajonale të Kosovës.","pg064_n0021_easy_read":"Rajonet e Kosovës","pg064_n0022_easy_read":"Peja","pg064_n0023_easy_read":"Peja dallohet për Grykën e Rugovës dhe për burimin e Drinit të Bardhë.","pg064_n0024_easy_read":"Gjakova","pg064_n0025_easy_read":"Gjakova dallohet për:\n- Kodrën e Çabratit\n- lumin Erenik\n- lumin Krena","pg064_n0026_easy_read":"Prizreni","pg064_n0027_easy_read":"Në Prizren gjenden:\n- ndërtesa e Lidhjes së Prizrenit\n- malet e Sharrit me bukuri të mëdha","pg064_n0028_easy_read":"Ferizaj","pg064_n0029_easy_read":"Në Ferizaj është ndërtuar Kampi i Ushtrisë Amerikane.","pg064_n0030_easy_read":"Gjilani","pg064_n0031_easy_read":"Gjilani dallohet për kalanë mesjetare të Artanës (Novobërdës).","pg064_n0032_easy_read":"Mitrovica","pg064_n0033_easy_read":"Në Mitrovicë është miniera e Trepçës.","pg064_n0034_easy_read":"Prishtina","pg064_n0035_easy_read":"Në Prishtinë gjenden:\n- qyteti antik Ulpiana\n- Biblioteka Kombëtare\n- Muzeu Kombëtar\n- Muzeu Etnografik\n- Universiteti i Prishtinës\n- etj.","pg064_n0038_easy_read":"Hulumto dhe gjej disa vende karakteristike:\n- të rajonit ku jeton\n- të rajoneve të tjera të vendit tonë","pg064_n0039_easy_read":"Prezanto para klasës punën që e ke bërë.\nPastaj diskutoni për të.","pg064_n0042_easy_read":"Fjalët kyçe:","pg064_n0043_easy_read":"- qendër rajonale\n- rajon\n- kryeqytet","pg065_n0008_easy_read":"Gjyshja e Kleas ka shumë qejf të qëndisë.","pg065_n0009_easy_read":"Ajo i ka qëndisur Kleas shumë fustane dhe triko.\nTë gjitha shoqeve u pëlqejnë.","pg065_n0010_easy_read":"Në veshjet e Kleas duken si lule shumëngjyrëshe.","pg065_n0011_easy_read":"Një ditë, gjyshja vendosi të qëndisë flamurin e Kosovës.","pg065_n0012_easy_read":"Ajo punonte gjithë ditën.\nAjo donte ta bënte gati për 17 Shkurtin, festën e Pavarësisë së Kosovës.","pg065_n0014_easy_read":"- Ke duar të arta, moj gjyshe!","pg065_n0015_easy_read":"Klea i tha:\n- Më dukesh si Marigona e Flamurit.","pg065_n0016_easy_read":"- Nuk kam parë flamur më të bukur!","pg065_n0017_easy_read":"Gjyshja i prekte me radhë yjet në flamur.\nAjo tregonte diçka për traditën e secilit popull që jeton në vendin tonë.","pg065_n0018_easy_read":"- Secili popull që jeton në vendin tonë ka zakonet e veta.\nAi ka edhe kulturën e vet.\nKjo e bën të veçantë.","pg065_n0019_easy_read":"Është e rëndësishme që të gjithë popujt t'i respektojnë kulturat e njëri-tjetrit.\nAta duhet të jetojnë në harmoni.","pg065_n0020_easy_read":"Klea i tha:\n- Ti je si një libër historie, moj gjyshja ime e dashur.\nPastaj Klea e përqafoi me shumë dashuri.","pg065_n0024_easy_read":"Përmend popujt që jetojnë në Republikën e Kosovës!","pg065_n0026_easy_read":"Përshkruaj të drejtat e komuniteteve etnike në Republikën e Kosovës!","pg065_n0028_easy_read":"Cilat gjuhë zyrtare fliten në Republikën e Kosovës?","pg065_n0030_easy_read":"A i respekton secili komunitet në vendin tonë traditat dhe zakonet e veta?","pg065_n0033_easy_read":"Flamuri i Kosovës ka 6 yje të bardha.","pg065_n0034_easy_read":"Yjet zyrtarisht tregojnë 6 popujt, ose komunitetet etnike, që jetojnë në Kosovë:\n- shqiptarët\n- serbët\n- turqit\n- boshnjakët\n- romët\n- goranët","pg065_n0035_easy_read":"Gjuhë zyrtare në Kosovë janë:\n- gjuha shqipe\n- gjuha serbe","pg065_n0036_easy_read":"Të gjithë kanë të drejtë:\n- të flasin gjuhën e tyre\n- t'i ndjekin zakonet e tyre\n- t'i ndjekin traditat e tyre\n- ta ndjekin besimin fetar të tyre\n- t'i festojnë festat e tyre","pg065_n0037_easy_read":"Secili komunitet i feston festat e veta.\nNë këto festa ka:\n- veshje tradicionale\n- muzikë tradicionale\n- ushqime tradicionale","pg065_n0038_easy_read":"Kjo tregon se të gjitha komunitetet në Kosovë respektohen.\nAto kanë të drejta të barabarta.","pg065_n0040_easy_read":"Fjalët kyçe:","pg065_n0041_easy_read":"- komunitet etnik\n- pakicë kombëtare\n- gjuhë zyrtare","pg066_n0005_easy_read":"1.","pg066_n0006_easy_read":"Shikoni hartën e vendit tonë.","pg066_n0007_easy_read":"Diskutoni në klasë për shtetet që kufizohen me Republikën e Kosovës.","pg066_n0009_easy_read":"Mitrovica","pg066_n0010_easy_read":"Peja","pg066_n0011_easy_read":"Gjakova","pg066_n0012_easy_read":"Prizreni","pg066_n0013_easy_read":"Prishtina","pg066_n0014_easy_read":"Ferizaj","pg066_n0015_easy_read":"Gjilani","pg066_n0016_easy_read":"Mali i Zi","pg066_n0017_easy_read":"Shqipëria","pg066_n0018_easy_read":"Serbia","pg066_n0019_easy_read":"Maqedonia e Veriut","pg067_n0008_easy_read":"Çfarë sheh në fotografinë e dhënë?","pg067_n0010_easy_read":"Çfarë bën polici?","pg067_n0012_easy_read":"Çfarë po i jep shoferi policit?\nPse?","pg067_n0014_easy_read":"Në cilin shtet ke shkuar ti?\nMe cilin dokument e ke kaluar kufirin?","pg067_n0016_easy_read":"A mund të kalosh në shtetin tjetër pa dokument identifikimi?\nPse?","pg067_n0019_easy_read":"Çdo shtet ka shtete përreth.\nKëto quhen shtete fqinje.","pg067_n0020_easy_read":"Shtetet ndahen nga njëri-tjetri me kufij.","pg067_n0021_easy_read":"Kosova kufizohet me:\n- Shqipërinë\n- Maqedoninë e Veriut\n- Serbinë\n- Malin e Zi","pg067_n0022_easy_read":"Këto janë shtetet fqinje të Kosovës.","pg067_n0024_easy_read":"Hapësira mes 2 shteteve quhet vendkalim kufitar.\nAjo shërben për të kontrolluar personat dhe mallrat që kalojnë nga 1 shtet në tjetrin.","pg067_n0025_easy_read":"Në këto vende ka organe policore.\nAto regjistrojnë hyrjet dhe daljet e:\n- personave\n- automjeteve\n- mallrave\nnga 1 vend në tjetrin.","pg067_n0026_easy_read":"Të gjithë personat që kalojnë kufirin duhet të tregojnë pasaportën.\nAta duhet të tregojnë edhe dokumentet për mallrat që transportojnë.","pg067_n0028_easy_read":"Kosova ka shumë pika kufitare.","pg067_n0029_easy_read":"Disa vendkalime kufitare që e lidhin Kosovën me shtetet fqinje janë:\n- Qafë-Morina\n- Qafë-Prushi\n- Morina\nKëto e lidhin Kosovën me Shqipërinë.","pg067_n0031_easy_read":"Vendkalimi kufitar \"Kulla\" e lidh Kosovën me Malin e Zi.","pg067_n0033_easy_read":"Në secilin vendkalim kufitar është flamuri i 2 shteteve që i lidh ai kufi.","pg067_n0035_easy_read":"Fjalët kyçe:","pg067_n0036_easy_read":"- shtet fqinj\n- vendkalim kufitar\n- kontroll\n- organe policore\n- pasaportë\n- dokument","pg068_n0005_easy_read":"Pavarësia e Kosovës u shpall më 17 shkurt 2008.","pg068_n0006_easy_read":"Kjo ditë ishte shumë e rëndësishme.\nAjo erdhi pas shumë vjetësh vështirësi dhe përpjekjesh të popullit tonë.","pg068_n0007_easy_read":"Për shumë vite, qytetarët e Kosovës vuajtën nga Serbia.\nSerbia ishte pushtuese.","pg068_n0008_easy_read":"Shumë intelektualë të Kosovës bënë përpjekje në mënyra të ndryshme.\nAta nuk lejuan që Serbia ta kufizonte lirinë e popullit tonë.","pg068_n0009_easy_read":"Presidenti i parë i Kosovës, Ibrahim Rugova, dhe bashkëpunëtorët e tij donin që problemi me Serbinë të zgjidhej në mënyrë paqësore.","pg068_n0010_easy_read":"Më pas, shumë burra dhe gra, djem dhe vajza, u bashkuan në Ushtrinë Çlirimtare të Kosovës, UÇK.\nAta luftuan për lirinë e vendit.","pg068_n0011_easy_read":"Ata luftuan me trimëri dhe guxim.\nAta luftuan për ta çliruar dhe mbrojtur vendin.","pg068_n0012_easy_read":"Për lirinë që e gëzojmë sot, shumë luftëtarë dhanë jetën e tyre.\nMes tyre ishte edhe komandanti legjendar Adem Jashari, bashkë me familjen e tij.\nEdhe shumë familje të tjera humbën të dashurit e tyre.","pg068_n0013_easy_read":"Ne përkulemi me respekt para kujtimit të tyre.","pg068_n0015_easy_read":"Më 17 shkurt 2008, në një mbledhje të Kuvendit të Kosovës, kryeministri Hashim Thaçi e lexoi Deklaratën e Pavarësisë.\nAtë ditë, Kosova u shpall shtet i lirë, i pavarur dhe demokratik.","pg068_n0016_easy_read":"Që nga ajo ditë, Kosova është republikë parlamentare.\nKosova ka qeveri dhe institucione që kujdesen për të gjithë qytetarët.","pg068_n0018_easy_read":"Për festën e Pavarësisë së Kosovës, zbukuroni klasën me flamurin e Kosovës.","pg068_n0019_easy_read":"Vishuni me ngjyrat e flamurit:\n- e kaltër\n- e bardhë\n- e verdhë","pg068_n0020_easy_read":"Dëgjoni himnin e Kosovës.\nPastaj ngrihuni në këmbë, si shenjë respekti për vendin tonë.","pg068_n0021_easy_read":"Krijoni disa kënde në klasë.","pg068_n0026_easy_read":"Bëni një ekspozitë me fotot e njerëzve që luftuan dhe dhanë jetën për lirinë e Kosovës.","pg068_n0031_easy_read":"Secili nga ju sillni në klasë disa ëmbëlsira.\nFestoni së bashku.","pg068_n0036_easy_read":"Ekspozoni vizatime me temë:","pg068_n0037_easy_read":"17 Shkurti, Pavarësia e Kosovës.","pg068_n0042_easy_read":"Përgatitni kuize dhe asociacione me pyetje për Pavarësinë e Kosovës.\nPastaj garoni së bashku.","pg068_n0047_easy_read":"Të veshur me ngjyrat e flamurit, vallëzoni dhe këndoni së bashku.\nKëndoni këngë patriotike të vendit tonë.","pg069_n0008_easy_read":"Dje isha ulur para oxhakut në dhomën e ndenjjes.\nDëgjoja kërcitjen e zjarrit.\nAtëherë kujtova shtëpinë e madhe të fëmijërisë sime në fshatin tonë.\nEdhe ajo shtëpi kishte oxhak.\nNe mblidheshim rreth tij për t'i dëgjuar historitë e gjyshit tim.","pg069_n0009_easy_read":"Nën një çati jetonim 27 anëtarë.","pg069_n0010_easy_read":"Gratë e shtëpisë përgatitnin ushqimin.\nAto na shtronin sofrën me radhë.\nSë pari hanin fëmijët.\nPastaj hanin burrat.\nNë fund hanin gratë.","pg069_n0011_easy_read":"Detyra e grave ishte:\n- të bënin punët e shtëpisë\n- të kujdeseshin për fëmijët\n- t'i rritnin fëmijët","pg069_n0012_easy_read":"Pak gra ishin të shkolluara dhe të punësuara.","pg069_n0013_easy_read":"Vendimet në shtëpi i merrte gjyshi, sepse ai ishte i zoti i shtëpisë.","pg069_n0014_easy_read":"Ato ishin kohë të vështira.","pg069_n0015_easy_read":"Nuk kishim ujësjellës.","pg069_n0016_easy_read":"Nuk kishim rrymë elektrike.","pg069_n0017_easy_read":"Natën ndriçonim me qirinj ose me llambë vajguri.","pg069_n0018_easy_read":"Tani jetoj në qytet, në Pejë.","pg069_n0019_easy_read":"U ktheva nga puna.","pg069_n0020_easy_read":"Po e përgatis darkën për gruan time, e cila është mjeke.\nAjo së shpejti do të kthehet nga spitali ku punon.\nPo e përgatis darkën edhe për vajzën time, e cila është studente dhe po vjen me makinë nga Prishtina.","pg069_n0021_easy_read":"Vajza ime do ta marrë në aeroport vëllanë e saj.\nAi po studion në Londër.","pg069_n0022_easy_read":"Kësaj i thonë familje bashkëkohore!","pg069_n0025_easy_read":"Si ishte familja më herët?","pg069_n0027_easy_read":"Me çka merreshin gratë?","pg069_n0029_easy_read":"Pse ishte jeta e vështirë?","pg069_n0031_easy_read":"Kush i merrte vendimet në familje?","pg069_n0033_easy_read":"Si është familja bashkëkohore?","pg069_n0034_easy_read":"Si merren vendimet dhe si ndahen përgjegjësitë?","pg069_n0036_easy_read":"Bëj një krahasim mes mënyrës si kanë qenë familjet dikur dhe si janë sot.","pg069_n0039_easy_read":"Familja është grupi i parë dhe më i vogël shoqëror.\nJeta e njeriut fillon në familje.","pg069_n0040_easy_read":"Historikisht, familja shqiptare përbëhej nga shumë anëtarë.\nNë të jetonin 3 deri në 4 breza:\n- prindërit\n- fëmijët\n- gjyshërit","pg069_n0041_easy_read":"Nganjëherë në familje jetonin edhe stërgjyshërit.","pg069_n0042_easy_read":"Prandaj ajo quhej familje e zgjeruar.","pg069_n0043_easy_read":"Familja ishte tradicionale dhe e udhëhiqte i zoti i shtëpisë.","pg069_n0044_easy_read":"Sot familja ka pësuar ndryshime të mëdha.","pg069_n0045_easy_read":"Ndryshe nga familjet tradicionale, në familjen bashkëkohore jetojnë vetëm 2 breza.\nKjo familje po bëhet gjithnjë e më e zakonshme në Kosovë.\nKjo do të thotë se jetojnë prindërit me fëmijët.","pg069_n0046_easy_read":"Ndarja e punëve në familje bëhet me marrëveshje.","pg069_n0047_easy_read":"Kjo do të thotë se familjen e drejtojnë bashkë të 2 prindërit.","pg069_n0049_easy_read":"Fjalët kyçe:","pg069_n0050_easy_read":"- familje\n- tradicionale\n- bashkëkohore\n- shumëgjeneratëshe","pg070_n0006_easy_read":"1.","pg070_n0007_easy_read":"Shiko fotografitë e dhëna.\nPastaj krahaso fshatin dikur me fshatin sot.","pg070_n0008_easy_read":"Fshati dikur","pg070_n0009_easy_read":"Gjërat e përbashkëta","pg070_n0010_easy_read":"Fshati sot","pg070_n0014_easy_read":"Si ishte jeta në fshat më parë dhe si është sot?","pg070_n0016_easy_read":"Cilat punë bëhen në fshat?","pg070_n0018_easy_read":"Si punohej toka më parë dhe si punohet sot?","pg070_n0020_easy_read":"Cilat prodhime rriten në fshat?","pg070_n0023_easy_read":"Fshati është vend ku jeton një grup njerëzish.\nKëta njerëz merren me bujqësi dhe blegtori.","pg070_n0024_easy_read":"Fshati më parë kishte shtëpi të vogla dhe familje të mëdha.","pg070_n0025_easy_read":"Jeta ishte më e vështirë.","pg070_n0026_easy_read":"Toka punohej me plug.\nNuk kishte energji elektrike.\nNuk kishte ujësjellës.","pg070_n0027_easy_read":"Shumë fshatra nuk kishin shkolla.","pg070_n0028_easy_read":"Shpesh, udhëtimi për në shkollë ishte shumë i vështirë.","pg070_n0029_easy_read":"Sot fshati ka ndryshuar shumë.","pg070_n0030_easy_read":"Shtëpi të mëdha dhe shumë moderne ka kudo.","pg070_n0031_easy_read":"Puna në fusha është më e lehtë, sepse ka mjete bashkëkohore.","pg070_n0032_easy_read":"Janë ndërtuar ferma shumë të përshtatshme për rritjen e kafshëve.","pg070_n0033_easy_read":"Çdo fshat ka:\n- energji elektrike\n- ujësjellës\n- rrugë të asfaltuara","pg070_n0034_easy_read":"Prandaj, fshati i sotëm është pothuajse i njëjtë me qytetin.","pg070_n0037_easy_read":"Fjalët kyçe:","pg070_n0038_easy_read":"- fshat\n- bujqësi\n- blegtori\n- fushë\n- stallë\n- fermë","pg071_n0008_easy_read":"Klea jeton në Prishtinë.","pg071_n0009_easy_read":"Klea shpesh shkon te gjyshërit.\nAjo bisedon me ta.","pg071_n0010_easy_read":"Sot Klea dhe gjyshi shkuan në parkun e lagjes.\nAta biseduan për qytetin dikur dhe sot.","pg071_n0011_easy_read":"Gjyshi tregoi:\n\"Qyteti dikur ishte më i vogël.\nKishte më pak banorë.","pg071_n0012_easy_read":"Nuk kishte shumë mjete komunikacioni.","pg071_n0013_easy_read":"Ndërtesat ishin larg nga njëra-tjetra.","pg071_n0014_easy_read":"I merrnim shërbimet që na duheshin në të gjitha institucionet.","pg071_n0015_easy_read":"Njerëzit merreshin me zeje të ndryshme, si:\n- farkëtarë\n- marangozë\n- këpucarë\n- rrobaqepës\n- plisaxhi\n- dhe shumë të tjera","pg071_n0016_easy_read":"Tregtarët kishin dyqane të vogla.\nNga ato dyqane ata siguronin jetesën.","pg071_n0017_easy_read":"Në çdo lagje kishte parqe të gjelbëruara.","pg071_n0018_easy_read":"Sot gjithçka duket se ecën shpejt.","pg071_n0019_easy_read":"Sot ka:\n- shumë ndërtesa afër njëra-tjetrës\n- lagje të reja\n- qendra të mëdha tregtare\n- komunikacion të pandalshëm\n- pak gjelbërim\nTë gjitha pjesët e tokës shfrytëzohen për ndërtim.","pg071_n0020_easy_read":"Ka ndryshime:\n- në rrugë\n- në ndërtesa\n- në objekte të ndryshme\n- në zhvillimin teknologjik","pg071_n0021_easy_read":"Të gjithë janë në lëvizje.\"","pg071_n0024_easy_read":"Si ishte qyteti dikur?","pg071_n0026_easy_read":"Si është qyteti sot?","pg071_n0028_easy_read":"Pse gjyshi tha se gjithçka ishte në lëvizje?","pg071_n0030_easy_read":"Çfarë mendon ti për ndotjen e ajrit në qytet dikur dhe sot?\nPse?","pg071_n0033_easy_read":"Qyteti është vendbanim i madh dhe urban.\nNë qytet, shumica e popullsisë jeton nga industria, tregtia dhe shërbimet.","pg071_n0034_easy_read":"Në qytete ka shumë:\n- ndërmarrje industriale\n- ndërmarrje tregtare\n- institucione politike\n- institucione shoqërore\n- institucione shëndetësore\n- institucione kulturore\n- institucione administrative","pg071_n0035_easy_read":"Qytetet dikur kishin:\n- ndërtesa të ulëta\n- rrugë të ngushta\n- pak mjete komunikacioni\n- zona të gjelbra","pg071_n0036_easy_read":"Nuk kishte shumë spitale, shkolla dhe çerdhe.\nTë gjitha ishin institucione shtetërore.","pg071_n0037_easy_read":"Qytetet sot kanë:\n- rrugë të gjera\n- komunikacion të dendur\n- parkingje të shumta\n- ndërtesa të larta\nZonat e gjelbra janë zvogëluar shumë.","pg071_n0038_easy_read":"Në qytete ka shumë shkolla shtetërore dhe private.","pg071_n0039_easy_read":"Ka shumë kopshte dhe çerdhe.\nAto ofrojnë shërbime për edukim dhe kujdes për fëmijët në edukimin parashkollor.","pg071_n0040_easy_read":"Ka spitale shtetërore dhe private.\nNë to, njerëzit marrin shërbimin e duhur për t’u shëruar nga sëmundje të ndryshme.","pg071_n0042_easy_read":"Fjalët kyçe:","pg071_n0043_easy_read":"qytet, banor, institucion, shëndetësi, kulturë.","pg072_n0007_easy_read":"Mësuesja u kërkoi nxënësve të mendojnë dhe të shkruajnë çfarë u vjen në mendje kur përmendet ekonomia.","pg072_n0008_easy_read":"Secili nxënës filloi të shkruajë në fletore.","pg072_n0009_easy_read":"Pastaj, nxënësit i lexuan mendimet e tyre.\nMësuesja i shkroi ato në tabelë.","pg072_n0011_easy_read":"Ekonomi do të thotë prodhim.","pg072_n0012_easy_read":"Vendet me ekonomi të zhvilluar janë të pasura.","pg072_n0013_easy_read":"Kur ekonomia është e zhvilluar, shumë njerëz janë të punësuar.","pg072_n0014_easy_read":"Në fshat, njerëzit zakonisht punojnë tokën dhe rrisin kafshë.","pg072_n0015_easy_read":"Në qytet ndërtohen shumë fabrika.","pg073_n0006_easy_read":"Në klasën tuaj, shkruani çfarë dini për ekonominë.","pg073_n0007_easy_read":"Përmendni profesionet e prindërve dhe të familjarëve tuaj.\nPastaj tregoni në cilat degë të ekonomisë bëjnë pjesë këto profesione.","pg073_n0008_easy_read":"Krahasoni tabelën e plotësuar me shokun ose shoqen e bankës.","pg073_n0012_easy_read":"Emri i familjarit","pg073_n0014_easy_read":"Profesioni","pg073_n0016_easy_read":"Dega e ekonomisë","pg073_n0027_easy_read":"Ekonomia studion:\n- si prodhohen mallrat dhe shërbimet\n- si shpërndahen mallrat dhe shërbimet\n- si përdoren mallrat dhe shërbimet","pg073_n0029_easy_read":"Degët e ekonomisë janë:","pg073_n0032_easy_read":"Bujqësia, blegtoria dhe peshkimi merren me prodhimin e ushqimeve.\nKëto ushqime quhen prodhime bujqësore.","pg073_n0034_easy_read":"Industria merret me prodhimet që dalin nga fabrikat, punëtoritë dhe minierat.","pg073_n0035_easy_read":"Këto prodhime quhen prodhime industriale.","pg073_n0037_easy_read":"Tregtia, hotelieria dhe turizmi.","pg073_n0039_easy_read":"Të gjitha degët e ekonomisë ekzistojnë qysh nga kohët e vjetra.","pg073_n0040_easy_read":"Atëherë, shumë punëtorë e kryenin punën me mjete primitive.\nSasitë e prodhimeve ishin të vogla.","pg073_n0042_easy_read":"Sot, më pak punëtorë e kryejnë punën me makineri të specializuara.\nSasitë e prodhimeve janë shumë më të mëdha.","pg073_n0045_easy_read":"Në Kosovë, dikur njerëzit i siguronin të ardhurat nga:\n- punimi i tokës, pra bujqësia\n- rritja e kafshëve\n- zejet e ndryshme","pg073_n0047_easy_read":"Sot, Kosova ka ekonomi të zhvilluar me:\n- tregti\n- shërbime\n- industri\n- ndërtimtari\n- etj.","pg073_n0048_easy_read":"Këto ndryshime kanë ndikuar në krijimin e një jete më të mirë në vendin tonë.","pg073_n0050_easy_read":"Fjalët kyçe:","pg073_n0051_easy_read":"- ekonomi\n- prodhim bujqësor\n- prodhim industrial","pg074_n0005_easy_read":"Situata 1.","pg074_n0007_easy_read":"Mira dhe Nili po luanin.\nAta po bënin gara për njohuri të ndryshme.","pg074_n0008_easy_read":"Sot, ata vendosën të luanin lojën: Ekonomia e vendit tim.","pg074_n0009_easy_read":"Mira shkroi për punët që bëhen në fshat.\nNili shkroi për punët që bëhen në qytet.","pg074_n0019_easy_read":"Njerëzit në fshat merren më së shumti me bujqësi.\nKjo do të thotë se ata merren me:\n- punimin e tokës\n- rritjen e drithërave\n- rritjen e frutave\n- rritjen e perimeve","pg074_n0021_easy_read":"Punimi i tokës dikur ishte shumë i vështirë.\nNjerëzit punonin vetëm me parmendë.\nParmenda është vegël e thjeshtë pune.","pg074_n0022_easy_read":"Për punimin e tokës duheshin më shumë punëtorë.\nShpenzohej edhe më shumë kohë.","pg074_n0024_easy_read":"Sot, punimi i tokës është shumë më i lehtë dhe më i shpejtë.\nKjo ndodh falë mjeteve më të përparuara të punës.","pg074_n0026_easy_read":"Në fshat, një pjesë e njerëzve merren me blegtori.\nKjo do të thotë se ata merren me rritjen e kafshëve dhe të shpendëve.","pg074_n0027_easy_read":"Ata kanë ndërtuar ferma moderne.\nNë to rritin bimë dhe kafshë.\nPrej tyre sigurojnë produkte ushqimore.","pg074_n0030_easy_read":"Njerëzit në qytete punojnë në:\n- fabrika\n- punishte\n- uzina\n- miniera","pg074_n0031_easy_read":"Nga këto punë dalin prodhime.\nKëto prodhime i quajmë prodhime industriale.","pg074_n0033_easy_read":"Në qytete është zhvilluar edhe tregtia.\nKjo ndodh falë shumë dyqaneve dhe qendrave tregtare.","pg074_n0034_easy_read":"Dyqanet dhe qendrat tregtare kanë mallra.\nKëto mallra vijnë nga vendi ynë dhe nga vende të tjera të botës.","pg074_n0036_easy_read":"Dikur, ne njihnim dhe hanim vetëm frutat dhe perimet e vendit tonë.\nSot, ne shijojmë edhe frutat dhe perimet nga vende të largëta të botës.","pg074_n0037_easy_read":"Po ashtu, edhe prodhimet e vendit tonë gjenden në vende të ndryshme të botës.","pg074_n0039_easy_read":"Njerëzit merren edhe me zeje të ndryshme.","pg075_n0007_easy_read":"Pse punojnë njerëzit?","pg075_n0009_easy_read":"Cilat degë të ekonomisë janë të zhvilluara në fshat? Cilat janë të zhvilluara në qytet?","pg075_n0011_easy_read":"Cilat degë të ekonomisë janë të zhvilluara në vendin tonë?","pg075_n0013_easy_read":"Pse mendon se në vendin tonë prodhohet rrymë elektrike me thëngjill?","pg075_n0016_easy_read":"Vendi ynë ka një ekonomi mjaft të zhvilluar.","pg075_n0017_easy_read":"Secili vend duhet t’i zhvillojë ato degë të ekonomisë që përshtaten me pasuritë natyrore të atij vendi.","pg075_n0019_easy_read":"Në vendin tonë është zhvilluar bujqësia duke shfrytëzuar tokën e punueshme.\nNga bujqësia marrim shumë prodhime bujqësore:\n- fruta\n- perime\n- drithëra","pg075_n0021_easy_read":"Po ashtu, është zhvilluar edhe blegtoria.\nBlegtoria është degë e ekonomisë që merret me rritjen e kafshëve, si:\n- delet\n- lopët\nKjo ka mundësuar rritjen e prodhimit të:\n- mishit\n- qumështit\n- produkteve të tij","pg075_n0023_easy_read":"Kosova prodhon energji elektrike duke shfrytëzuar thëngjillin si pasuri nëntokësore.","pg075_n0025_easy_read":"Industria është e zhvilluar më shumë në ndërmarrje të vogla.\nNga to marrim prodhime industriale.","pg075_n0026_easy_read":"Tregtia është mjaft e zhvilluar.\nAjo përfshin mallra vendore dhe mallra nga vende të ndryshme të botës.","pg075_n0028_easy_read":"Bukuritë natyrore në malet e Sharrit, me vendpushimin Brezovica dhe Prevalla, si edhe Bjeshkët e Nemuna, me vendpushimin në Bogë, kanë mundësuar zhvillimin e turizmit dimëror në vendin tonë.","pg075_n0030_easy_read":"Në Kosovë ka shumë banka.\nNë to punojnë njerëz të përgatitur.\nAta ofrojnë shërbime për qytetarët.","pg075_n0032_easy_read":"Fjalët kyçe:","pg075_n0033_easy_read":"- bujqësi\n- blegtori\n- industri\n- turizëm\n- bankë","pg076_n0007_easy_read":"Ne jemi të lumtur që kemi shkolla në gjuhën shqipe.","pg076_n0008_easy_read":"Cilët janë njerëzit që ndihmuan në hapjen e këtyre shkollave?","pg076_n0009_easy_read":"Ata janë shumë.","pg076_n0010_easy_read":"Mëso për disa prej tyre.\nAta janë të paharrueshëm për ne dhe për gjeneratat që do të vijnë.","pg076_n0013_easy_read":"Ernest Koliqi pati një rol të rëndësishëm në hapjen e shkollave shqipe në Kosovë.","pg076_n0014_easy_read":"Në Kosovë mungonin mësuesit.\nPrandaj, Ernest Koliqi u kujdes të sillte mësues nga Shqipëria.","pg076_n0017_easy_read":"Disa mësues që ndihmuan në përhapjen e dijes në Kosovë ishin:\n- Mehmet Gjevori\n- Tajar Hatipi\n- Vezire Xherina\n- Beqir Kastrati\n- shumë të tjerë\nKëta mësues lanë gjurmë të pashlyeshme në arsimin e vendit tonë.","pg076_n0019_easy_read":"Mati Logoreci ishte mësuesi i parë në shkollën \"Shkolla Shqipe e Djemve\" në Prizren.","pg076_n0021_easy_read":"Sot, në vendin tonë, punon një numër i madh i mësimdhënësve profesionistë.\nAta e dinë përgjegjësinë që kanë për arsimimin e brezave të rinj.\nAta punojnë me përkushtim dhe me dashuri.","pg076_n0024_easy_read":"Cilat shkolla janë në qytetin ose fshatin tënd?","pg076_n0025_easy_read":"Shkruaj emrat e njerëzve nga qyteti ose fshati yt që dhanë kontribut në arsim.","pg076_n0026_easy_read":"Pse mendon se këta njerëz nuk duhet të harrohen?\nPërmend së paku 3 arsye.","pg077_n0008_easy_read":"Mali shkon rregullisht te dentisti.","pg077_n0009_easy_read":"Mali gëzohet shumë kur i sheh ato mjete që përdoren për të rregulluar dhëmbët.","pg077_n0010_easy_read":"Edhe sjellja e butë e dentistit ka bërë që Mali të kujdeset me dëshirë për shëndetin e dhëmbëve.","pg077_n0011_easy_read":"Një ditë, Mali e pyeti gjyshin:","pg077_n0012_easy_read":"- Gjysh, si ka qenë mjekësia në kohën tënde?","pg077_n0013_easy_read":"- Në kohën time, - tha gjyshi, - nuk kishte shumë mjekë.","pg077_n0014_easy_read":"Mjekët duhej të shkonin të shkolloheshin në vende të tjera, sepse te ne nuk kishte shkolla.","pg077_n0015_easy_read":"Mjekët ishin shumë të kujdesshëm dhe shëronin shumë njerëz. Ata nuk i kishin mjetet që janë sot.","pg077_n0016_easy_read":"Sot ka shumë mjekë. Ne duhet të flasim për ta me respekt. Ata punojnë me kujdes dhe janë gjithmonë në shërbim të popullit.","pg077_n0017_easy_read":"Gjyshi është gjithmonë i gatshëm t’u përgjigjet pyetjeve të Malit.","pg077_n0020_easy_read":"Vendi ynë ka arsim, shëndetësi dhe ekonomi falë punës së palodhshme të specialistëve të këtyre fushave. Ata punojnë gjithmonë për të mirën e vendit tonë.","pg077_n0021_easy_read":"Sot, në vendin tonë, mësimdhënia bashkëkohore ka dallime të mëdha në cilësi nga mësimdhënia tradicionale.","pg077_n0022_easy_read":"Mësuesit kanë një rol shumë të rëndësishëm në arsimin e vendit tonë.","pg077_n0023_easy_read":"Mjekët janë të kualifikuar dhe të specializuar në fusha të ndryshme.","pg077_n0024_easy_read":"Ndryshe nga mjekët e dikurshëm, sot mjekët shkollohen në vendin tonë.","pg077_n0025_easy_read":"Edhe ekonomistët ndihmojnë në zhvillimin e vendit. Ata punojnë që ne të kemi një jetë më të mirë.","pg077_n0027_easy_read":"Fjalët kyçe:","pg077_n0028_easy_read":"- arsim\n- shëndetësi\n- ekonomi\n- specialist\n- kontribut","pg077_n0031_easy_read":"Shkruaj emrat e mjekëve dhe të infermierëve të qytetit ose të fshatit tënd.\nShkruaj emrat e atyre që kanë dhënë kontribut në shëndetësi.","pg077_n0032_easy_read":"Cili është mjeku i familjes sate?","pg077_n0033_easy_read":"Çfarë mendon ti për punën e mjekëve?","pg078_n0007_easy_read":"Një ditë, në klasën e Kleas, mësuesi u kërkoi nxënësve të bënin një hulumtim për njerëzit që dhanë kontribut në fusha të ndryshme të artit, si:\n- muzikë\n- sport\n- teatër\n- film\n- pikturë","pg078_n0008_easy_read":"Nxënësit vendosën të punonin në grupe.\nPastaj, nxënësit do të prezantonin para klasës.","pg078_n0012_easy_read":"Sportet më të njohura në Kosovë janë:\n- futbolli\n- basketbolli\n- hendbolli\n- volejbolli","pg078_n0013_easy_read":"Ne, si grup, mblodhëm shënime për futbollin.","pg078_n0014_easy_read":"Futbolli është një ndër sportet më të zhvilluara në Kosovë.","pg078_n0015_easy_read":"Në tërë Kosovën ka shkolla të futbollit.\nNë to ushtrohen shumë fëmijë.\nNga këto shkolla kanë dalë shumë talente.","pg078_n0017_easy_read":"Në fotografi është Fadil Vokrri.\nFadil Vokrri është një emër i njohur i futbollit kosovar.","pg078_n0021_easy_read":"Sportet individuale i sollën Kosovës sukseset më të mëdha.","pg078_n0022_easy_read":"Në fotografi është paraqitur njëra ndër sportistet më të njohura nga Kosova.\nAjo bëri që emri i Kosovës të përmendej kudo në botë.","pg078_n0024_easy_read":"Majlinda Kelmendi është xhudistja që i dha Kosovës titullin e parë botëror në xhudo.\nAjo mori edhe shumë medalje të tjera të arta.","pg079_n0009_easy_read":"Muzika është pjesë e kulturës së një populli.","pg079_n0010_easy_read":"Në Kosovë, në fillim u zhvillua muzika folklorike dhe popullore.\nMë vonë u zhvilluan edhe zhanre të tjera, si:\n- muzika klasike\n- muzika moderne\n- zhanre të tjera","pg079_n0013_easy_read":"Ymer Riza ishte një nga këngëtarët e parë shqiptarë të muzikës popullore me sharki dhe çifteli.","pg079_n0014_easy_read":"Ymer Riza u konsiderua legjendë e folklorit shqiptar.","pg079_n0017_easy_read":"Nexhmije Pagarusha ishte këngëtare e muzikës popullore dhe e operës.","pg079_n0018_easy_read":"Nexhmije Pagarusha ishte edhe aktore e suksesshme në film dhe në teatër.","pg079_n0019_easy_read":"Nexhmije Pagarusha njihet si Bilbili i Kosovës dhe Mbretëresha e muzikës shqiptare.","pg079_n0022_easy_read":"Këngëtaret nga vendi ynë që janë bërë shumë të famshme dhe kanë arritur sukses të madh në botë janë Rita Ora dhe Dua Lipa.","pg079_n0024_easy_read":"Rita Ora","pg079_n0026_easy_read":"Dua Lipa","pg079_n0032_easy_read":"Bekim Fehmiu ishte aktori i parë kosovar i teatrit dhe i filmit.","pg079_n0033_easy_read":"Bekim Fehmiu luajti në më shumë se 40 filma.","pg079_n0036_easy_read":"Zake Prelvukaj është piktore e njohur nga Kosova.","pg079_n0037_easy_read":"Zake Prelvukaj njihet për:","pg079_n0038_easy_read":"- piktura me ngjyra të forta dhe të gjalla\n- trajtimin e figurës së gruas shqiptare\n- elemente nga tradita dhe kultura kombëtare","pg080_n0005_easy_read":"Gjeli,\nEngjëll Berisha,\n1996.","pg080_n0009_easy_read":"A mendoni se Kosova ka kulturë të zhvilluar?","pg080_n0010_easy_read":"Pse mendoni kështu?","pg080_n0012_easy_read":"Bëni edhe ju një hulumtim për sporte të tjera dhe për zhanre të tjera të muzikës.","pg080_n0014_easy_read":"Shkruani emra të njohur nga këto fusha, nga fshati ose qyteti ku jetoni.","pg080_n0017_easy_read":"Kosova ka një kulturë mjaft të zhvilluar.","pg080_n0018_easy_read":"Kjo shihet në këto fusha:\n- sport\n- muzikë\n- teatër\n- film\n- pikturë","pg080_n0019_easy_read":"Shumë sportistë, muzikantë dhe artistë e kanë ngritur lart emrin e Kosovës.\nPër këtë arsye, Kosova renditet në mesin e fitueseve të çmimeve botërore.","pg080_n0020_easy_read":"Trashëgimia kulturore e Kosovës është krijuar gjatë shumë shekujve.\nAjo po përcillet brez pas brezi.\nKjo e ruan identitetin tonë si popull.","pg080_n0021_easy_read":"Në Kosovë ka jetë të pasur kulturore dhe artistike.\nKa aktivitete të ndryshme në këto nivele:\n- lokal\n- kombëtar\n- ndërkombëtar","pg080_n0022_easy_read":"Ne krenohemi me të gjithë ata që kanë ndihmuar në ruajtjen dhe pasurimin e kulturës kombëtare.","pg080_n0025_easy_read":"Fjalët kyçe:","pg080_n0026_easy_read":"Fjalët kyçe janë:\n- sport\n- art\n- muzikë\n- teatër\n- pikturë\n- film","pg081_n0002_easy_read":"Jeta në Kosovë dikur dhe sot","pg081_n0004_easy_read":"Takim: \"Mësojmë nga jeta e personaliteteve tona\"","pg081_n0007_easy_read":"Bashkë me mësuesen ose mësuesin, ftoni në klasë një person të njohur nga qyteti ose fshati juaj.","pg081_n0010_easy_read":"Mjek ose mjeke","pg081_n0012_easy_read":"Ekonomist ose ekonomiste","pg081_n0014_easy_read":"Biznesmen ose biznesmene","pg081_n0016_easy_read":"Sportist ose sportiste","pg081_n0018_easy_read":"Muzikant ose muzikante","pg081_n0020_easy_read":"Veteran i arsimit ose veterane e arsimit.\nMund të ftoni edhe njerëz të suksesshëm nga një fushë tjetër.","pg081_n0022_easy_read":"Përgatitni disa pyetje për të intervistuar të ftuarin tuaj.\nKështu mund ta njihni punën e tij.","pg081_n0023_easy_read":"Me pyetje, përpiquni të kuptoni jetën dhe punën e tij.","pg081_n0024_easy_read":"Shkruani pyetjet për intervistë.","pg081_n0025_easy_read":"1.","pg081_n0026_easy_read":"2.","pg081_n0027_easy_read":"3.","pg081_n0028_easy_read":"4.","pg081_n0029_easy_read":"5.","pg081_n0030_easy_read":"6.","pg081_n0034_easy_read":"Kërkoni që ai ose ajo të japë një mesazh për brezat e rinj.","pg081_n0035_easy_read":"Nëse një i ftuar nuk mund të vijë në klasën tuaj, ju mund të bëni një ekspozitë.\nVendosni fotografitë e personave të njohur dhe veprat e tyre.","pg081_n0036_easy_read":"Aktivitet:\nMësuesi përgatit etiketa me emrat e njerëzve të njohur të vendit tuaj.","pg081_n0037_easy_read":"Ti dhe shokët e tu i merrni etiketat.\nPastaj i vendosni sipas kategorive.","pg081_n0042_easy_read":"Sportist/e","pg081_n0044_easy_read":"Mjek/e","pg081_n0046_easy_read":"Këngëtar/e","pg081_n0048_easy_read":"Aktor/e","pg081_n0056_easy_read":"Mësues/e","pg081_n0058_easy_read":"Biznesmen/e","pg081_n0060_easy_read":"Luftëtar/e","pg082_n0007_easy_read":"Mali dhe prindërit e tij u ftuan për vizitë nga disa miq të vjetër në Shkodër, në Shqipëri.","pg082_n0008_easy_read":"Gjatë vizitës, Mali provoi një pjatë me ushqime tradicionale. Ai nuk i kishte ngrënë kurrë më parë këto ushqime.","pg082_n0010_easy_read":"Duke folur me prindërit, Mali e kishte kuptuar se pothuajse çdo vend ka veçoritë e veta në:\n- ushqim\n- veshje\n- të folur\nKëto veçori e dallojnë një vend nga vendet e tjera.","pg082_n0012_easy_read":"Për Malin, ky ushqim ishte më i veçantë se ushqimet që kishte provuar më parë.","pg082_n0013_easy_read":"Mikpritja në familjen shkodrane i bëri shumë përshtypje Malit. Edhe humori i tyre gjatë gjithë kohës i bëri shumë përshtypje.","pg082_n0014_easy_read":"Familja e Malit u prit me shumë dashuri.","pg082_n0015_easy_read":"Atyre u shërbyen çaj dhe ëmbëlsira. Kështu, ata kaluan çaste shumë të bukura.","pg082_n0017_easy_read":"Mali u miqësua shumë me Tomorin, djalin e familjes shkodrane. Ata kaluan bashkë tërë pasditen.","pg082_n0018_easy_read":"Tomori i ndau të gjitha lodrat me Malin. Kjo bëri që Mali të ndihej si në shtëpinë e vet.","pg082_n0020_easy_read":"Gjatë kthimit për në shtëpi, Mali i tha babait se ishte befasuar nga mikpritja.","pg082_n0021_easy_read":"Babai i tha Malit se shqiptarët e kanë trashëguar këtë traditë nga paraardhësit.","pg082_n0023_easy_read":"Shkodra","pg083_n0005_easy_read":"Ushqim tradicional","pg083_n0007_easy_read":"Veshjet tona","pg083_n0008_easy_read":"tradicionale","pg083_n0009_easy_read":"Ndahuni në grupe.\nPastaj diskutoni për fotografitë e dhëna.","pg083_n0013_easy_read":"Përmend 3 ushqime tradicionale.","pg083_n0015_easy_read":"Trego 3 elemente të traditës sonë kombëtare.","pg083_n0017_easy_read":"Si e kupton fjalën \"mikpritje\"?","pg083_n0019_easy_read":"Shkruaj një recetë të një ushqimi tradicional.\nKy ushqim gatuhet në shtëpinë tuaj.","pg083_n0020_easy_read":"Lexoni recetat.\nPastaj shkëmbejini ato me shokët tuaj.","pg083_n0023_easy_read":"Kultura ka të bëjë me mënyrën se si jeton një komunitet ose një shoqëri.","pg083_n0024_easy_read":"Kultura përfshin shumë elemente, si:\n- gjuhën\n- muzikën\n- artet\n- traditat\n- besimet\n- doket\n- zakonet","pg083_n0026_easy_read":"Tradita është ajo që njerëzit e një populli e kanë bërë dhe e kanë ruajtur për një kohë të gjatë.\nPër shembull:\n- zakonet\n- festat\n- këngët\n- vallet\n- veshjet\n- besimet\n- virtytet\n- mënyra e jetesës","pg083_n0028_easy_read":"Secili popull e ka traditën e vet.\nTradita mund të shihet në:\n- arkitekturën e qytetit\n- ndërtimin dhe rregullimin e shtëpive\n- organizimin e festave të ndryshme\n- mënyrën e gatimit","pg083_n0029_easy_read":"Shqiptarët dallohen për mënyrën se si i organizojnë dasmat tradicionale.","pg083_n0030_easy_read":"Këto tradita janë formuar gjatë historisë, në jetën e një populli.\nAto ruhen dhe trashëgohen.","pg083_n0031_easy_read":"Vendi ynë ka një traditë shumë të pasur.\nKjo traditë ruhet dhe përcillet nga brezi në brez.","pg083_n0032_easy_read":"Fjalët kyçe:\n- traditë\n- zakon\n- ushqim\n- mikpritje","pg084_n0006_easy_read":"Fëmijët e klasës së 4 vizituan kryeqytetin e Kosovës, Prishtinën, së bashku me mësuesen e tyre.","pg084_n0007_easy_read":"Gjatë kthimit në qytetin e tyre, fëmijët po bisedonin me mësuesen për vendet që i vizituan.","pg084_n0008_easy_read":"Secili fëmijë po tregonte se cili vend i kishte lënë më shumë përshtypje.","pg084_n0009_easy_read":"Rronit i kishte lënë përshtypje Teatri i Kukullave.\nPër të, koha aty ishte çlodhëse, e këndshme dhe shumë edukative.","pg084_n0010_easy_read":"Albanës i kishte lënë shumë përshtypje Muzeu i Kosovës.","pg084_n0011_easy_read":"Në Muzeun e Kosovës, Albana kishte mësuar më shumë për paraardhësit dhe historinë e popullit tonë.","pg084_n0012_easy_read":"Bora ishte mahnitur nga arkitektura e Bibliotekës Kombëtare.\nAjo thoshte se mezi priste të bëhej studente e mjekësisë dhe të lexonte aty.","pg084_n0013_easy_read":"Fëmijëve u kishin lënë përshtypje edhe këto vende:\n- Teatri Kombëtar\n- Galeria e Arteve\n- vende të tjera që i kishin vizituar shkurt\nPër secilin vend, fëmijët kishin mësuar diçka të veçantë.","pg084_n0015_easy_read":"Kryeqyteti i Kosovës – Prishtina","pg084_n0018_easy_read":"Cilat janë institucionet kulturore në Kosovë?","pg084_n0019_easy_read":"Përmend disa institucione kulturore në qytetin tënd.","pg084_n0020_easy_read":"Pse Biblioteka Kombëtare i bëri përshtypje Borës?","pg084_n0021_easy_read":"Çfarë rëndësie kanë institucionet kulturore?","pg085_n0007_easy_read":"Institucionet kulturore janë vende.\nNë këto vende, njerëzit mësojnë për kulturën, historinë, traditën dhe artin.","pg085_n0008_easy_read":"Në këto vende ruhen, prezantohen dhe shpjegohen gjëra të vlefshme, si:\n- zakonet\n- veprat artistike\n- librat\n- filmat\n- shumë gjëra të tjera","pg085_n0009_easy_read":"Institucionet kulturore përbëhen nga:\n- muzetë\n- teatrot\n- kinematë\n- bibliotekat\n- galeritë\n- të tjera","pg085_n0010_easy_read":"Këto institucione u japin njerëzve mundësi të mësojnë.\nNjerëzit njihen me kulturën e vendit të tyre.","pg085_n0011_easy_read":"Njerëzit që duan të mësojnë për historinë e një vendi vizitojnë muzetë.","pg085_n0012_easy_read":"Në teatro luhen shfaqje.\nAty ne shikojmë aktorët në skenë.\nNë kinema shfaqen filma të ndryshëm.","pg085_n0013_easy_read":"Në biblioteka, lexuesit përdorin libra të ndryshëm.\nNë galeri shkojnë njerëzit që i pëlqejnë ekspozitat artistike, për shembull pikturat.","pg085_n0015_easy_read":"Teatri Kombëtar – Prishtinë","pg085_n0017_easy_read":"Galeria e Arteve – Prishtinë","pg085_n0019_easy_read":"Biblioteka Kombëtare \"Pjetër Bogdani“ – Prishtinë","pg085_n0020_easy_read":"Fjalët kyçe:\n- institucion kulturor\n- galeri\n- teatër\n- bibliotekë","pg086_n0008_easy_read":"Klea me prindërit vendosën ta kalojnë 1 fundjavë në Bjeshkët e Nemuna, në Bogë.","pg086_n0009_easy_read":"Ai vend ishte shumë i bukur dhe kishte natyrë mbresëlënëse. Ky vend i jepte Kleas qetësi dhe kënaqësi.","pg086_n0010_easy_read":"Kur po ktheheshin nga pushimi i shkurtër, Klea po u thoshte prindërve se këto male ishin shumë të bukura.","pg086_n0012_easy_read":"Nëna e Kleas e çmonte shumë traditën e popullit tonë. Ajo shtoi se ky vend kishte reliev të mrekullueshëm. Ky vend kishte edhe shumë veçori të tjera që e bënin kaq të bukur.","pg086_n0014_easy_read":"Nëna filloi të tregonte për veshjen tradicionale të Rugovës. Ajo po fliste për:\n- ngjyrat e kësaj veshjeje\n- punën e dorës\n- gjëra të tjera\nKlea mrekullohej. Pastaj Klea vendosi t'i kërkonte këto veshje në internet dhe të bënte 1 prezantim për to para klasës.","pg086_n0015_easy_read":"Klea donte t'i nxiste edhe shokët dhe shoqet e klasës që t'i njihnin veshjet tradicionale të trevave të Kosovës. Pothuajse çdo vend e ka veshjen e vet karakteristike.","pg086_n0017_easy_read":"Bjeshkët e Nemuna - Rugovë","pg087_n0006_easy_read":"?","pg087_n0009_easy_read":"Çfarë rëndësie kanë veshjet tradicionale?","pg087_n0011_easy_read":"Përmend 2 gjëra të veçanta që Klea i mësoi në këtë udhëtim.","pg087_n0013_easy_read":"A keni dëgjuar për ndonjë veshje tjetër tradicionale?","pg087_n0014_easy_read":"Diskutoni së bashku.","pg087_n0016_easy_read":"A keni ndonjë veshje tradicionale?","pg087_n0018_easy_read":"Pse është e rëndësishme t’i njohim dhe t’i veshim rrobat tradicionale të vendit tonë?","pg087_n0020_easy_read":"Vishuni me rroba tradicionale.\nPastaj bëni një ekspozitë në shkollë.","pg087_n0021_easy_read":"Tregoni si u ndiet.","pg087_n0024_easy_read":"Kostumet popullore janë veshje tradicionale.\nNjerëzit i kanë përdorur ato në të kaluarën.\nKëto veshje kalojnë brez pas brezi.","pg087_n0026_easy_read":"Çdo rajon i një vendi dhe çdo shtet ka veshjet e veta tradicionale.\nPër shembull:\n- veshja e Rugovës\n- veshja e Hasit\n- veshja e Tropojës","pg087_n0028_easy_read":"Veshja popullore e grave të Hasit ka si veçori përdorimin e dërrasës.\nAjo mbulohet me veshje me zbukurime dhe me ngjyra të ndryshme.\nNgjyra që shihet më shumë është e kuqja.","pg087_n0029_easy_read":"Edhe veshja e grave të Rugovës është interesante.\nAjo përbëhet nga këmisha prej pëlhure me mëngë të shkurtra.","pg087_n0031_easy_read":"Çdo veshje ka një histori.\nÇdo veshje ka elemente të veçanta.\nKëto elemente e dallojnë atë nga veshjet e tjera të një treve, të një krahine ose të një rajoni.","pg087_n0032_easy_read":"Veshjet popullore kërkohen shumë për ditë feste dhe për ahengje të ndryshme.","pg087_n0034_easy_read":"Veshjet e grave dallohen për:\n- qëndisje\n- ngjyra të ndryshme\n\nVeshjet e burrave janë kryesisht punime leshi, si:\n- tirq\n- këmishë\n- jelek\n- plisi\n\nPlisi e karakterizon burrin tradicional shqiptar.","pg087_n0036_easy_read":"Veshje e Rugovës","pg087_n0038_easy_read":"Veshje e Drenicës","pg087_n0040_easy_read":"Veshje e Hasit","pg087_n0042_easy_read":"Xhubleta","pg087_n0044_easy_read":"Veshje e Tropojës","pg087_n0046_easy_read":"Fjalët kyçe:","pg087_n0047_easy_read":"- veshje tradicionale\n- traditë\n- kulturë\n- zakon","pg088_n0008_easy_read":"Buna, shoqja e klasës së Jonit dhe Drinit, e organizoi dasmën e motrës së saj në shtëpinë e saj.","pg088_n0009_easy_read":"Motra e Bunës po martohej.\nBuna donte t’i ftonte shokët dhe shoqet e klasës.\nDisa do ta mbanin fustanin e nuses.\nTë tjerët do të mbanin lule.","pg088_n0010_easy_read":"Buna, prindërit e saj dhe vëllezërit e saj e përgatitën shtëpinë.\nAta e zbukuruan dhomën e ndenjjes.\nAta përgatitën edhe ëmbëlsira dhe ushqime të ndryshme.","pg088_n0011_easy_read":"Joni po përgatitej për dasmë.\nNëna iu afrua Jonit.\nAjo i tregoi se ishte shumë e rëndësishme të respektonte familjen e Bunës dhe përgatitjet e tyre për dasmë.","pg088_n0012_easy_read":"Nëna i tregoi Jonit se ishte shumë e rëndësishme të shkonte në orarin e caktuar te shtëpia e Bunës.","pg088_n0013_easy_read":"Nëna i tha Jonit të mendonte edhe për një dhuratë për Bunën.\nKjo dhuratë do ta gëzonte shumë Bunën.\nNë raste të tilla, të gjithë bëjnë dhurata.","pg088_n0014_easy_read":"Joni mësoi shumë gjëra të bukura!","pg088_n0015_easy_read":"Joni përjetoi shumë emocione.\nAi nuk do t’i harrojë kurrë ato.","pg089_n0006_easy_read":"Fjalët kyçe:\n- festë\n- ditëlindje\n- urim\n- gëzim","pg089_n0010_easy_read":"Pse është e rëndësishme të zbukurohet ambienti për një festë të caktuar?","pg089_n0012_easy_read":"Si duhet të veprojmë gjatë festës kur jemi të ftuar?","pg089_n0015_easy_read":"Si duhet të veprojmë gjatë një feste kur jemi mikpritës?","pg089_n0017_easy_read":"Cila festë ju pëlqen më shumë dhe pse?","pg089_n0021_easy_read":"Festa është një ditë e veçantë.\nAjo lidhet me një ngjarje të gëzueshme.","pg089_n0022_easy_read":"Dita e festës dallon nga ditët e tjera.\nPër këtë ditë përgatitet ushqim më i veçantë.\nEdhe veshjet janë ndryshe nga veshjet e përditshme.","pg089_n0023_easy_read":"Gjatë ditëve të festave, ne jemi të lumtur.\nNe festojmë së bashku me:\n- prindërit\n- kushërinjtë\n- miqtë\n- shokët","pg089_n0024_easy_read":"Zakonisht, gjatë festave ne:\n- marrim dhurata\n- japim dhurata\n- vallëzojmë\n- këndojmë","pg089_n0026_easy_read":"Festat mund të jenë:\n- individuale\n- familjare\n- shtetërore\n- kombëtare\n- ndërkombëtare\n- fetare","pg089_n0027_easy_read":"Festat individuale janë festa që i përkasin 1 personi.\nPër shembull, festa e ditëlindjes.","pg089_n0028_easy_read":"Festat shtetërore janë festa që i feston 1 shtet.\nPër shembull, Pavarësia e Kosovës.","pg089_n0029_easy_read":"Festa kombëtare është festë që e feston 1 komb ose 1 popull, kudo që ndodhet.\nPër shembull, të gjithë shqiptarët që jetojnë në vende të ndryshme të botës e festojnë Pavarësinë e Shqipërisë.","pg089_n0031_easy_read":"Festa ndërkombëtare është festë që festohet në të gjithë botën.\nPër shembull, Dita e Gruas.","pg090_n0006_easy_read":"Andrra i ftoi të gjithë shokët dhe shoqet në ditëlindjen e saj.","pg090_n0007_easy_read":"Jonit i pëlqente të ilustronte çdo ngjarje.\nAtij i bëri përshtypje që në shtëpinë e Andrrës kishte shumë piktura në mur dhe shumë libra në bibliotekë.","pg090_n0008_easy_read":"Joni u mrekullua.\nNë çdo pikturë, burrat mbanin plis në kokë dhe gratë kishin veshje me shumë ngjyra.","pg090_n0009_easy_read":"Veshjet e tyre ishin ndryshe nga veshjet e sotme.","pg090_n0010_easy_read":"Pikturat tregonin historinë e popullit tonë.\nLibrat kishin emrat e autorëve të mëdhenj shqiptarë, si:\n- vëllezërit Frashëri\n- Gjergj Fishta\n- Asdreni\n- Ismail Kadare","pg090_n0011_easy_read":"Aty kishte edhe fotografi të Motrës Tone dhe të motrave Qiriazi.","pg090_n0013_easy_read":"Kur prindërit e Andrrës erdhën për t’i përshëndetur fëmijët, Joni e pyeti mamanë e Andrrës:\n- A mund ta huazoj 1 nga këta libra, që ta lexoj gjatë pushimit të verës?","pg090_n0014_easy_read":"Zonja u gëzua.\nAjo buzëqeshi lehtë dhe i tha Jonit se këta libra ishin për të rriturit.","pg090_n0015_easy_read":"Ajo i premtoi Jonit se, kur të rritej, do t’ia huazonte të gjithë librat.\nVetëm kështu Joni do të mund të shihte çfarë shkrimesh me vlerë kanë shkruar këta shkrimtarë.","pg090_n0017_easy_read":"Joni, i mrekulluar, e pyeti:\n- A janë të gjithë shqiptarë?","pg090_n0018_easy_read":"- Po, - tha zonja. - Por, që ta njohim sa e bukur është bota dhe sa shumë kultura të ndryshme ka, ne duhet t’i lexojmë edhe autorët e huaj.","pg090_n0019_easy_read":"Joni u pajtua me këtë mendim dhe iu bashkua shokëve.","pg090_n0022_easy_read":"Aleksandër Stavre Drenova","pg090_n0024_easy_read":"Vëllezërit Frashëri","pg090_n0026_easy_read":"Vëllezërit Frashëri","pg090_n0028_easy_read":"Vëllezërit Frashëri","pg090_n0030_easy_read":"Gjergj Fishta","pg090_n0032_easy_read":"Ismail Kadare","pg090_n0034_easy_read":"Motra Tone","pg090_n0036_easy_read":"Motrat Qiriazi","pg090_n0038_easy_read":"Motrat Qiriazi","pg090_n0041_easy_read":"Kultura është gjithçka që një grup njerëzish e kanë të përbashkët, si:\n- mënyra si mendojnë\n- mënyra si sillen\n- mënyra si jetojnë\n- besimet\n- zakonet\n- vlerat që ndjekin","pg090_n0042_easy_read":"Kultura përfshin:\n- gjuhën\n- fenë\n- veshjen\n- ushqimin\n- muzikën\n- artin\n- festat","pg090_n0043_easy_read":"Kultura tregon si është ndërtuar jeta e një populli.\nAjo tregon edhe çfarë gjërash me vlerë ka krijuar ai popull me kalimin e kohës.","pg090_n0046_easy_read":"Fjalët kyçe:","pg090_n0047_easy_read":"kulturë, libër, pikturë.","pg090_n0049_easy_read":"Diskutoni për situatën e dhënë.","pg090_n0050_easy_read":"Si lidhen librat me kulturën e një vendi?","pg090_n0051_easy_read":"A ke dëgjuar ose parë ndonjë pjesë të veçantë të një kulture tjetër?","pg090_n0052_easy_read":"Çfarë është kultura për ty?","pg090_n0053_easy_read":"Si do ta prezantoje kulturën e vendit tonë para njerëzve që vijnë nga një vend tjetër?","pg091_n0007_easy_read":"Zgjidh 1 ngjyrë.\nPastaj ngjyros aq katrorë sa tregojnë më së miri sa pajtohesh me këto pohime.","pg091_n0008_easy_read":"Në fund të kësaj njësie mësimore, unë mund të tregoj se:","pg091_n0009_easy_read":"- Kur njeriu zhvillohet, zhvillohet edhe kultura.","pg091_n0011_easy_read":"□","pg091_n0013_easy_read":"□","pg091_n0015_easy_read":"□","pg091_n0017_easy_read":"□","pg091_n0019_easy_read":"□","pg091_n0020_easy_read":"- Kultura është trashëgimia kulturore e njerëzve.","pg091_n0022_easy_read":"□","pg091_n0024_easy_read":"□","pg091_n0026_easy_read":"□","pg091_n0028_easy_read":"□","pg091_n0030_easy_read":"□","pg091_n0031_easy_read":"- Stili i jetës, mënyra e të menduarit dhe sjellja e tregojnë kulturën e njeriut.","pg091_n0033_easy_read":"□","pg091_n0035_easy_read":"□","pg091_n0037_easy_read":"□","pg091_n0039_easy_read":"□","pg091_n0041_easy_read":"□","pg091_n0042_easy_read":"- Kultura e 1 vendi shprehet në:\n- mënyrën e ndërtimit të objekteve\n- përgatitjen e ushqimit\n- mënyrën e veshjes\n- artin","pg091_n0044_easy_read":"□","pg091_n0046_easy_read":"□","pg091_n0048_easy_read":"□","pg091_n0050_easy_read":"□","pg091_n0052_easy_read":"□","pg092_n0006_easy_read":"Buna: Përshëndetje, Rita!","pg092_n0007_easy_read":"Më duhet të shkruaj një artikull informues për përdorimin e pasurive natyrore në Kosovë.\nNuk e di çfarë të shkruaj.","pg092_n0008_easy_read":"A mund të më ndihmosh me ndonjë informacion?","pg092_n0009_easy_read":"Rita: Sigurisht.","pg092_n0010_easy_read":"Atëherë, në fillim duhet të përmendet se Kosova ka shumë pasuri natyrore.","pg092_n0011_easy_read":"Kosova ka:\n- pyje\n- lumenj\n- male\n- tokë bujqësore\n- shumë pasuri nëntokësore","pg092_n0012_easy_read":"Kosova është ndër vendet më të pasura në Evropë për pasuri natyrore.","pg092_n0013_easy_read":"Pasuritë natyrore ndahen në:","pg092_n0024_easy_read":"1. Toka e punueshme përdoret për zhvillimin e bujqësisë.","pg092_n0026_easy_read":"2. Lumenjtë i përdorim për ujë të pijshëm ose për ujitje.","pg092_n0028_easy_read":"3. Liqenet artificiale përdoren për ujë të pijshëm.","pg092_n0030_easy_read":"4. Pyjet përdoren për:\n- ngrohje\n- prodhimin e gjësendeve të ndryshme","pg092_n0031_easy_read":"Po ashtu, pyjet janë të rëndësishme për llojllojshmërinë e bimëve.","pg092_n0033_easy_read":"5. Kosova është e pasur me lloje të ndryshme bimore.","pg092_n0037_easy_read":"1. Thëngjilli linjit përdoret për prodhimin e energjisë elektrike në Termocentralin “Kosova”.","pg092_n0039_easy_read":"2. Ka shumë minerale.\nMë së shumti ka plumb.\nPlumbi nxirret nga minierat e Trepçës në Mitrovicë.","pg092_n0041_easy_read":"3. Ka shumë xehe.","pg092_n0043_easy_read":"Buna: Uaaa, nuk e kam ditur që vendi ynë ka kaq shumë pasuri natyrore.","pg092_n0044_easy_read":"Faleminderit, Rita!","pg092_n0045_easy_read":"Besoj se me këto informacione, artikulli im do të informojë shumë njerëz për pasuritë tona natyrore!","pg093_n0006_easy_read":"Drini i Bardhë","pg093_n0010_easy_read":"Bisedoni për situatën e dhënë.","pg093_n0012_easy_read":"Me çfarë pasurish natyrore është e pasur Kosova?","pg093_n0014_easy_read":"Përmendni lumin ose liqenin artificial që është në rajonin ku jetoni ju.","pg093_n0016_easy_read":"Pse duhet të kujdesemi për ruajtjen e pasurive natyrore?","pg093_n0019_easy_read":"Pasuri natyrore janë të mirat materiale që gjenden në natyrë.\nNjeriu mund t'i përdorë ato për ta përmirësuar jetën e tij.","pg093_n0020_easy_read":"Kosova ka sipërfaqe të vogël, por ka shumë pasuri natyrore.","pg093_n0021_easy_read":"Një pjesë e këtyre pasurive është përdorur për zhvillimin ekonomik.\nPjesa tjetër mund të shfrytëzohet në të ardhmen.","pg093_n0022_easy_read":"Kosova ka shumë toka të punueshme.\nKëto toka shfrytëzohen për kultivimin e:\n- drithërave\n- perimeve\n- frutave","pg093_n0023_easy_read":"Ndër pasuritë e Kosovës janë edhe:\n- lumenjtë\n- liqenet\n- pyjet\n- pasuritë nëntokësore","pg093_n0024_easy_read":"Fjalët kyçe:\n- pasuri natyrore\n- ujë\n- lumë\n- liqen\n- tokë\n- pyll","pg094_n0007_easy_read":"Pasi erdhën turistët e fundit, udhërrëfyesi shkoi te grupi japonez dhe nisi bisedën me ta.","pg094_n0008_easy_read":"Udhërrëfyesi nuk e dinte pse ky grup kishte ardhur nga larg në Kosovë. Prandaj, ai u interesua menjëherë për ta kuptuar këtë.","pg094_n0010_easy_read":"- Përshëndetje dhe mirë se keni ardhur në Kosovë!","pg094_n0011_easy_read":"Jam i lumtur që keni ardhur në shtetin tonë.","pg094_n0013_easy_read":"- Konnichiwa (përshëndetje), ju faleminderit shumë për mikpritjen!","pg094_n0014_easy_read":"Shpresoj që të kalojmë mirë së bashku!","pg094_n0016_easy_read":"- Meqë po bisedojmë, a mund t’ju pyes pse e zgjodhët Kosovën për vizitë?","pg094_n0018_easy_read":"- Ne po bëjmë disa hulumtime për pasuritë nëntokësore të vendeve të Evropës. Ndër këto vende, ne zgjodhëm edhe Kosovën.","pg094_n0019_easy_read":"Nuk kishte shumë informacione në internet për pasuritë nëntokësore të vendit tuaj. Prandaj, ato që do t’i mësojmë sa të jemi këtu, do t’i tregojmë në uebfaqe.","pg094_n0021_easy_read":"- Para se t’i vizitojmë vendet që ju duhen për hulumtim, unë mund t’ju tregoj shkurt për pasuritë tona nëntokësore.","pg094_n0022_easy_read":"Kosova ka një nëntokë mjaft të pasur:\n- thëngjill linjit, në sasinë më të madhe\n- minerale të plumbit\n- minerale të zinkut\n- minerale të argjendit\n- minerale të arit\n- shumë të tjera\nThëngjilli linjit përdoret për prodhimin e energjisë elektrike në Termocentralin “Kosova A” dhe “Kosova B”.","pg094_n0023_easy_read":"Miniera më aktive është “Trepça”. Ajo ndodhet në Mitrovicë.","pg094_n0025_easy_read":"- Sipas asaj që thatë ju, Kosova është mjaft e pasur me minerale.","pg095_n0007_easy_read":"Bisedoni për situatën që është dhënë.","pg095_n0009_easy_read":"Cilat janë pasuritë nëntokësore të Kosovës?","pg095_n0011_easy_read":"Për çfarë përdoren pasuritë nëntokësore?","pg095_n0013_easy_read":"A duhet të kemi kujdes kur i shfrytëzojmë pasuritë nëntokësore?","pg095_n0014_easy_read":"Pse?","pg095_n0016_easy_read":"A mendon edhe ti se, me të gjitha këto pasuri nëntokësore, ekonomia e vendit tonë mund të zhvillohet më shumë?","pg095_n0019_easy_read":"Kosova ka shumë pasuri natyrore.","pg095_n0020_easy_read":"Pasuritë natyrore që nxirren nga toka quhen pasuri nëntokësore.","pg095_n0021_easy_read":"Zbulimi, shfrytëzimi dhe përpunimi i pasurive nëntokësore janë shumë të rëndësishme për ekonominë e vendit.","pg095_n0022_easy_read":"Pasuritë nëntokësore janë:\n- shkëmbinjtë\n- mineralet\n- xehet\n- lëndët djegëse","pg095_n0023_easy_read":"Lëndët djegëse janë:\n- thëngjilli\n- nafta\n- gazi natyror","pg095_n0024_easy_read":"Kosova ka shumë thëngjill.\nNga thëngjilli prodhohet energjia elektrike në Termocentralin e Kosovës.","pg095_n0025_easy_read":"Kosova ka shumë minerale.\nPlumbi është më i shumti.\nPlumbi nxirret nga minierat e Trepçës në Mitrovicë.","pg095_n0026_easy_read":"Ka interesim të madh për gjetjen e gazit natyror në Kosovë.\nKa interesim të madh edhe për shfrytëzimin e tij për prodhimin e energjisë.","pg095_n0027_easy_read":"Këto pasuri duhet të shfrytëzohen me kujdes.\nHarxhimi i pakontrolluar shkakton humbje.\nKëto pasuri janë të paripërtëritshme.","pg095_n0029_easy_read":"Prodhimi i energjisë elektrike me thëngjill në termocentrale, Obiliq","pg095_n0031_easy_read":"Fjalët kyçe:","pg095_n0032_easy_read":"- pasuri nëntokësore\n- minerale\n- minierë\n- lëndë djegëse\n- thëngjill","pg096_n0006_easy_read":"Një ditë, Rona dhe Miri mësuan për pasuritë mbitokësore të Kosovës.","pg096_n0007_easy_read":"Miri ishte shumë i lodhur.\nPrandaj, ai nuk e kuptoi mirë këtë mësim.","pg096_n0008_easy_read":"- Jo! Unë nuk po arrij ta kuptoj.\nRona, a mund të ma përmendësh edhe 1 herë disa shembuj?","pg096_n0009_easy_read":"- Po, sigurisht.","pg096_n0010_easy_read":"Pasuritë mbitokësore janë të gjitha pasuritë që gjenden mbi sipërfaqen e tokës.","pg096_n0011_easy_read":"Pjesa më e madhe e tokës në Kosovë është tokë e punueshme.\nKjo është më shumë se gjysma e tokës.\nKjo tokë ndihmon zhvillimin e bujqësisë.","pg096_n0012_easy_read":"Pjesa tjetër është tokë pyjore.\nMalet më të njohura janë:\n- Bjeshkët e Nemuna\n- malet e Sharrit\n- malet e Pashtrikut\n- shumë male të tjera","pg096_n0013_easy_read":"- Rona, më duket se, përveç tokës, ne përmendëm edhe faktorë të tjerë që e pasurojnë vendin tonë.","pg096_n0014_easy_read":"- Po, një pasuri tjetër është edhe druri.","pg096_n0015_easy_read":"Është shumë e rëndësishme që prerja e drurëve të bëhet në mënyrë të kontrolluar.","pg096_n0016_easy_read":"- Pastaj folëm për pasuritë ujore.","pg096_n0017_easy_read":"- Aq sa di unë, pasuritë ujore përfshijnë:\n- liqenet\n- lumenjtë\n- ujërat minerale\n- ujërat termike","pg096_n0018_easy_read":"- Të lumtë, Rona!","pg096_n0019_easy_read":"- Cili është lumi më i gjatë nga lumenjtë që përmende?","pg096_n0020_easy_read":"- Drini i Bardhë.","pg096_n0021_easy_read":"- Po ujërat minerale dhe ujërat termike?","pg096_n0022_easy_read":"- Ujërat kryesore minerale dhe termike njihen si banja shëruese.\nAto përmbajnë minerale.\nShumë njerëz gjejnë shërim në këto ujëra.","pg096_n0024_easy_read":"Bisedoni për situatën e dhënë.","pg096_n0025_easy_read":"Cilat janë pasuritë mbi tokë të vendit tonë?","pg096_n0026_easy_read":"Cilat janë malet kryesore të vendit tonë?","pg096_n0027_easy_read":"Pse janë të rëndësishme malet?","pg096_n0028_easy_read":"Cilët janë lumenjtë më të mëdhenj të vendit tonë?","pg096_n0031_easy_read":"Pasuritë mbitokësore janë të gjitha pasuritë që gjenden mbi sipërfaqen e tokës.","pg096_n0032_easy_read":"Pasuri mbitokësore janë:\n- ujërat, si lumenjtë, liqenet, detet dhe oqeanet\n- fushat\n- malet\n- kafshët\n- bimët","pg096_n0033_easy_read":"Pasuritë mbitokësore ndikojnë në zhvillimin ekonomik të vendit.","pg096_n0034_easy_read":"Druri është burim kryesor për ngrohje.\nDruri përdoret edhe për prodhimin e shumë sendeve që i shërbejnë njeriut.","pg096_n0035_easy_read":"Pasuritë ujore përfshijnë:\n- liqenet\n- lumenjtë\n- ujërat minerale\n- ujërat termike","pg096_n0036_easy_read":"Liqenet më të njohura janë:\n- liqeni i Radoniqit\n- liqeni i Ujmanit\n- liqeni i Batllavës\n- liqeni i Përlepnicës\n- liqeni i Badovcit","pg096_n0037_easy_read":"Lumenjtë kryesorë janë:\n- Drini i Bardhë\n- Lepenci\n- Morava\n- Ibri","pg096_n0038_easy_read":"Ujërat kryesore minerale dhe termike janë:\n- Banja e Pejës\n- Banjska\n- Banja e Kllokotit","pg096_n0039_easy_read":"Banja e Pejës, Banjska dhe Banja e Kllokotit njihen si banja termale shëruese.\nKëto banja përdoren për shërimin e shumë sëmundjeve.","pg097_n0005_easy_read":"Fjalët kyçe:\n- pasuri mbitokësore\n- tokë pjellore\n- pyll\n- lumë\n- liqen\n- ujë termal","pg098_n0008_easy_read":"Ra zilja e orës së fundit. Nxënësit dolën me vrap nga shkolla për të luajtur me njëri-tjetrin.","pg098_n0009_easy_read":"Nga ky grup u ndanë 2 shokë. Ata kishin detyrë të bënin një punim për ruajtjen e pasurive natyrore.","pg098_n0010_easy_read":"Pastaj, Mali dhe Era filluan të mblidhnin informacione. Ata do t’i prezantonin ato para klasës.","pg098_n0012_easy_read":"- O Mali, a di ti si ndahen pasuritë natyrore?","pg098_n0013_easy_read":"- Në një enciklopedi që e kam lexuar më parë, shkruhej se pasuritë natyrore janë:\n- toka dhe mineralet e saj\n- ujërat\n- rrezet e diellit\n- atmosfera","pg098_n0014_easy_read":"Pasuritë natyrore ndahen në 2 lloje: burime të ripërtëritshme dhe të paripërtëritshme.","pg098_n0015_easy_read":"- Që t’i përdorim këto pasuri me kujdes, ideja më e mirë është të përdorim më shumë panele diellore dhe helika që lëvizin me erë. Era tha se qymyri, nafta, gazi natyror dhe ujërat janë burime të paripërtëritshme.","pg098_n0016_easy_read":"- Këtij mendimi mund t’ia shtojmë edhe këtë fakt: burimet e paripërtëritshme mund të harxhohen një ditë. Atëherë, brezat e ardhshëm nuk do të kenë mundësi t’i përdorin ato.","pg098_n0017_easy_read":"- Nafta, qymyri dhe gazi natyror e ndotin mjedisin. Ato e ulin cilësinë e ajrit.","pg098_n0018_easy_read":"Në fillim, duhet të mbjellim disa pemë. Kështu, brezat e ardhshëm dhe njerëzit që jetojnë tani do të kenë ajër të pastër.","pg098_n0019_easy_read":"Pastaj, mund të mbajmë aktivitete informuese nëpër shkolla. Në këto aktivitete mund të tregojmë si ta kursejmë ujin dhe energjinë elektrike, duke i përdorur me masë.","pg098_n0020_easy_read":"- Të shkojmë më shpejt në shtëpi dhe t’i shkruajmë këto mendime.","pg098_n0022_easy_read":"Duke biseduar, Mali dhe Era arritën në këtë përfundim: mënyra më e mirë për t’i ruajtur resurset natyrore është të përdorim më shumë burimet e ripërtëritshme se burimet e paripërtëritshme. Po ashtu, secili prej nesh duhet të vetëdijesohet që t’i përdorë ato me kujdes.","pg098_n0024_easy_read":"Fjalët kyçe:","pg098_n0025_easy_read":"- pasuri natyrore\n- të paripërtëritshme\n- të ripërtëritshme\n- diell\n- ujë\n- ajër\n- lëndë djegëse","pg098_n0028_easy_read":"Për çka biseduan Mali dhe Era?","pg098_n0029_easy_read":"Si ndahen pasuritë natyrore?","pg098_n0030_easy_read":"Pse është e rëndësishme që burimet natyrore të shfrytëzohen në mënyrë të arsyeshme?","pg098_n0031_easy_read":"Pse duhet të përdorim më shumë energjinë e erës dhe energjinë diellore?","pg099_n0008_easy_read":"Pasuritë natyrore, ose burimet natyrore, janë të mira materiale.\nKëto gjenden në natyrë.\nNjeriu mund t’i përdorë ato.","pg099_n0009_easy_read":"Burimet natyrore ndahen në 2 grupe:\n- burime të ripërtëritshme, si dielli dhe ajri\n- burime të paripërtëritshme, si lëndët djegëse, qymyri, nafta, gazi natyror dhe uji","pg099_n0010_easy_read":"Burimet natyrore duhet të shfrytëzohen me kujdes.\nShfrytëzimi i pakontrolluar i tyre i shter ose i harxhon ato.\nKjo ndodh sepse këto burime janë të paripërtëritshme.","pg099_n0011_easy_read":"Po ashtu, shfrytëzimi i këtyre burimeve shkakton ndotje të ambientit.","pg099_n0012_easy_read":"Sot, në botë po punohet për të prodhuar energji nga rrezet e diellit dhe nga era.\nKëto janë burime të ripërtëritshme.\nAto e ruajnë ambientin nga ndotja.","pg100_n0007_easy_read":"Një ditë, Rona pa një detyrë në një revistë.\nNë detyrë kishte shumë fotografi.","pg100_n0008_easy_read":"Mbi fotografi shkruante ky udhëzim:","pg100_n0011_easy_read":"Luaj dhe mëso.","pg100_n0013_easy_read":"Ndaji fotografitë në 2 grupe.","pg100_n0015_easy_read":"Trego çka janë pasuritë natyrore dhe çka janë pasuritë njerëzore.","pg100_n0017_easy_read":"Rona dëshiron ta tregojë zgjidhjen e detyrës.\nPrandaj, Rona e publikoi atë në librin tonë.","pg101_n0013_easy_read":"Këtu bëjnë pjesë:\n- dielli\n- ujërat\n- pyjet\n- bimët\n- etj.","pg101_n0015_easy_read":"Këtu bëjnë pjesë:\n- mjekët\n- mësuesit\n- policët\n- muratorët\n- etj.","pg101_n0017_easy_read":"Në grupin e parë, \"Pasuri natyrore\", bëjnë pjesë të gjitha pasuritë që gjenden në natyrë.\nKëto pasuri janë pjesë e natyrës.","pg101_n0018_easy_read":"Në grupin e dytë, \"Pasuri njerëzore\", bëjnë pjesë njerëzit që përdorin aftësitë e tyre për të kryer një shërbim.","pg101_n0019_easy_read":"Rona tha:\n\"Të dashur moshatarë të mi!\nNë tabelën më lart, shtoni edhe pasuri të tjera natyrore dhe njerëzore në listë.\"","pg101_n0022_easy_read":"Vendi ynë ka shumë pasuri natyrore.","pg101_n0023_easy_read":"Pasuritë njerëzore e bëjnë vendin tonë edhe më të pasur.","pg101_n0024_easy_read":"Nxënësit në vendin tonë shkollohen dhe përgatiten për t’i shërbyer shtetit.","pg101_n0025_easy_read":"Pasuri njerëzore quhen edhe burime njerëzore.\nAto janë fuqia punëtore e një vendi dhe njohuritë që kanë njerëzit për të ushtruar një profesion.","pg101_n0026_easy_read":"Burimet njerëzore janë shtytësi kryesor i zhvillimit ekonomik të vendit.","pg101_n0027_easy_read":"Sa më të ditur të jenë njerëzit, aq më të aftë janë ata të përdorin aftësitë e tyre për të kryer një shërbim.","pg101_n0028_easy_read":"Fjalët kyçe:\n- pasuri njerëzore\n- aftësi\n- shërbim","pg101_n0031_easy_read":"- Trego mendimin tënd.\n- Shpjego pse quhen pasuri natyrore.\n- Shpjego pse quhen pasuri njerëzore.","pg101_n0032_easy_read":"- Shiko nga dritarja.\n- Shkruaj cilat pasuri natyrore sheh.","pg101_n0034_easy_read":"- Mendo për anëtarët e familjes sate.\n- Shkruaj cilat pasuri njerëzore përfaqësojnë ata.","pg101_n0036_easy_read":"Shtoni edhe gjëra të tjera në listën e pasurive natyrore dhe njerëzore.","pg101_n0040_easy_read":"Pasuri natyrore","pg101_n0042_easy_read":"Pasuri njerëzore","pg101_n0045_easy_read":"Shembuj të pasurive natyrore:\n- Dielli\n- ujërat\n- pyjet\n- bimët","pg101_n0048_easy_read":"Shembuj të pasurive njerëzore:\n- Mjekët\n- mësuesit\n- policët\n- muratorët","pg102_n0007_easy_read":"Familja Gashi kishte dalë për ta kaluar fundjavën në Prizren.","pg102_n0008_easy_read":"Hëna, 10-vjeçare, po e shijonte shumë këtë udhëtim.","pg102_n0009_easy_read":"Kureshtja e Hënës u rrit kur pa shumë ndërtesa të vjetra:\n- muze\n- kala\n- vende që përfaqësonin kulturën e vendit tonë","pg102_n0010_easy_read":"Kush tjetër mund t'i jepte përgjigje më të sakta se babai i saj?\nBabai i saj ishte zejtar në Gjakovë.","pg102_n0011_easy_read":"- Babi, a mund të ma tregosh prapë çka quhet trashëgimi kulturore?","pg102_n0012_easy_read":"- Po, Hëna.","pg102_n0013_easy_read":"Këto kanë rëndësi të madhe për ruajtjen e kulturës dhe traditës shqiptare:\n- parqet natyrore\n- galeritë e artit\n- kalatë\n- kullat\n- shtëpitë e vjetra\n- monumentet fetare\n- rrugicat e ngushta\n- shatërvanët\n- shumë objekte të tjera","pg102_n0014_easy_read":"- Të gjitha këto që i përmende janë objekte.","pg102_n0015_easy_read":"A ka edhe gjëra të tjera që përfaqësojnë trashëgiminë kulturore?","pg102_n0016_easy_read":"- Po, sigurisht.","pg102_n0017_easy_read":"Trashëgimia jomateriale përfshin gjuhën dhe krijimtaritë popullore.","pg102_n0018_easy_read":"- Cilat janë disa nga monumentet kryesore arkeologjike?","pg102_n0019_easy_read":"- Mund t'i përmendim:\n- qytetin e lashtë të Ulpianës\n- Manastirin e Deçanit\n- Shtëpinë e Lidhjes së Prizrenit","pg102_n0020_easy_read":"Kosova ka edhe shumë muze.","pg102_n0021_easy_read":"Veshjet dhe gatimet tradicionale kalojnë nga brezi në brez.\nAto janë mjaft unike.","pg102_n0022_easy_read":"- E mrekullueshme.","pg102_n0023_easy_read":"Mezi po pres të bisedoj në shkollë me shokët dhe me mësuesen për gjërat që mësova sot.","pg102_n0025_easy_read":"- Bisedoni për situatën e dhënë.","pg102_n0026_easy_read":"- Çfarë e përbën trashëgiminë kulturore materiale?","pg103_n0008_easy_read":"Çka bën pjesë në trashëgiminë kulturore jomateriale?","pg103_n0010_easy_read":"A duhet të krenohemi me trashëgiminë kulturore të vendit tonë?\nPse?","pg103_n0013_easy_read":"Kur përdoren më shumë veshjet dhe gatimet tradicionale?","pg103_n0016_easy_read":"Kosova ka trashëgimi kulturore të larmishme.\nKjo e bën Kosovën vend tërheqës për të gjithë vizitorët.","pg103_n0017_easy_read":"Çdo pjesë e Kosovës ka trashëgimi të pasur materiale, si:\n- qendra arkeologjike\n- parqe natyrore\n- kala\n- kulla\n- monumente fetare\n- galeri arti\n- rrugë të ngushta me kalldrëm\n- shatërvanë\n- muze\n- shtëpi të vjetra\n- objekte të tjera","pg103_n0019_easy_read":"Kosova ka 7 muze aktivë.\nNë këta muze ruhen shumë monumente kulturore.\nKëto monumente tregojnë historinë e popullit tonë.","pg103_n0020_easy_read":"Ndër këta muze, vlen të theksohen:\n- Muzeu Historik Kombëtar\n- Muzeu Etnologjik \"Emin Gjiku\"\n- Muzeu i Prizrenit\n\nMuzeu i Prizrenit në fillim ka funksionuar si banjë turke.","pg103_n0021_easy_read":"Po ashtu, Kosova ka edhe Kompleksin Memorial \"Adem Jashari\".","pg103_n0023_easy_read":"Në Kosovë ka edhe shumë monumente të tjera.","pg103_n0024_easy_read":"Shumica e monumenteve janë:\n- manastire\n- kështjella\n- kisha\n- xhami","pg103_n0025_easy_read":"Ndër objektet arkeologjike, vlen të përmendet qyteti i lashtë i Ulpianës.","pg103_n0026_easy_read":"Gjithashtu, janë edhe:\n- Manastiri i Deçanit\n- Shtëpia e Lidhjes së Prizrenit\n\nShtëpia e Lidhjes së Prizrenit përbëhet nga 4 godina.","pg103_n0028_easy_read":"Të gjitha këto objekte i përkasin trashëgimisë kulturore materiale.","pg103_n0029_easy_read":"Këto objekte mbrohen me Ligjin për Trashëgiminë Kulturore.","pg103_n0031_easy_read":"Trashëgimia kulturore jomateriale përfshin:\n- gjuhën\n- krijimtaritë popullore\n\nAto janë ruajtur dhe janë përcjellë ndër breza.","pg103_n0033_easy_read":"Edhe veshjet dhe ushqimet tradicionale kanë vend të veçantë në trashëgiminë kulturore të vendit tonë.","pg103_n0035_easy_read":"Fjalët kyçe:\n- trashëgimi kulturore\n- objekt\n- muze\n- monument\n- veshje\n- ushqim","pg104_n0006_easy_read":"Mali shkon në shtrat çdo mbrëmje pas mesnatës.","pg104_n0007_easy_read":"Të nesërmen, Mali duhet të zgjohet në orën 07:00.\nAi duhet të përgatitet për shkollë.","pg104_n0008_easy_read":"Çdo mbrëmje, Mali i bën gati rrobat e shkollës.\nNë mëngjes, ai i vesh shpejt.\nPastaj shkon me vrap në shkollë.","pg104_n0009_easy_read":"Mali e ha mëngjesin në shkollë, në orën 9:30.","pg104_n0010_easy_read":"Pas mësimit, Mali kthehet në shtëpi i lodhur.\nAi ha drekën.\nPastaj i lëshon perdet e dritareve që të bëhet errësirë.\nMenjëherë shtrihet për të fjetur pasdite.","pg104_n0011_easy_read":"Shokët e thërrasin Malin që të luajë futboll ose ndonjë lojë tjetër në ajër të pastër.\nPor Mali nuk u bashkohet asnjëherë.\nAi duhet të flejë.","pg104_n0012_easy_read":"Pasi zgjohet, Mali pëlqen të hajë ushqime të shpejta.\nAi pëlqen edhe të pijë pije të gazuara.","pg104_n0013_easy_read":"Mali nuk ha me orar.\nAi nuk pi mjaft ujë.","pg104_n0014_easy_read":"Të gjithë janë të brengosur.\nMali është shumë i zbehtë dhe nuk është i shëndetshëm.","pg104_n0015_easy_read":"Prindërit kanë vendosur t’i ndryshojnë shprehitë e Malit.\nAta duan që Mali të bëjë një jetë më të shëndetshme.","pg105_n0008_easy_read":"Pse Mali është i zbehtë dhe pse nuk është i shëndetshëm?","pg105_n0010_easy_read":"Çfarë duhet të bëjmë që të jemi të shëndetshëm?","pg105_n0012_easy_read":"Cili është ushqimi yt i preferuar?","pg105_n0013_easy_read":"A mendon se ai ushqim është i shëndetshëm?","pg105_n0014_easy_read":"Pse?","pg105_n0016_easy_read":"Si mund ta përmirësosh ushqimin tënd?","pg105_n0018_easy_read":"Sa i rëndësishëm është sporti për ty?","pg105_n0020_easy_read":"Shkruaj një këshillë për Malin.","pg105_n0021_easy_read":"Tregoji Malit çfarë duhet të bëjë që të jetë i shëndetshëm.","pg105_n0029_easy_read":"Ne e ruajmë shëndetin vetëm me kujdes të vazhdueshëm.","pg105_n0030_easy_read":"Kujdesi shëndetësor do të thotë ta ruajmë ose ta përmirësojmë shëndetin tonë.","pg105_n0031_easy_read":"Për një jetë të shëndetshme, duhet të bëjmë këto gjëra:\n- të kujdesemi për higjienën personale\n- të hamë ushqim të shëndetshëm\n- të merremi me aktivitet fizik\n- të merremi me sporte të ndryshme\n- të bëjmë shëtitje në ajër të pastër\n\nTë gjitha këto e forcojnë trupin dhe mendjen.","pg105_n0033_easy_read":"Që të mund t'i bëjmë të gjitha aktivitetet e ditës, duhet të flemë së paku 8 orë gjatë natës.","pg105_n0035_easy_read":"Duhet të bëjmë vizita të rregullta te stomatologu dhe te mjeku i familjes.","pg105_n0037_easy_read":"Shprehitë për kujdesin shëndetësor krijohen qysh në fëmijëri të hershme.\nKëto shprehi zbatohen gjatë gjithë jetës.","pg105_n0039_easy_read":"Fjalët kyçe:","pg105_n0040_easy_read":"- kujdes shëndetësor\n- higjienë\n- sport\n- ushqim i shëndetshëm\n- vizitë mjekësore","pg106_n0002_easy_read":"Burimet dhe trashëgimia e vendit tim","pg106_n0003_easy_read":"Ndihmojmë për një mjedis të pastër","pg106_n0004_easy_read":"Situata 1.","pg106_n0006_easy_read":"Mësuesi: Nxënës, sot do të flasim për ambientin. Secili prej jush të tregojë si mund të ndihmojë për një mjedis të pastër.","pg106_n0007_easy_read":"Arsimi: Mësues, makinat e ndotin ajrin. Prandaj, në qytet duhet të ecim, të përdorim biçikletën ose transportin publik, si autobusi.","pg106_n0008_easy_read":"Ema: Për një jetë të shëndetshme në planetin tonë, menaxhimi i mbeturinave do të ketë rol të rëndësishëm në të ardhmen.","pg106_n0009_easy_read":"Mbeturinat duhet të riciklohen.","pg106_n0010_easy_read":"Riciklimi i mbeturinave është shumë i rëndësishëm.","pg106_n0011_easy_read":"Prodhimi i sendeve nga mbeturinat e ricikluara harxhon më pak energji se prodhimi i tyre nga materiale të reja.","pg106_n0012_easy_read":"Mbeturinat duhet të hidhen në shportat përkatëse, jo në tokë.","pg106_n0013_easy_read":"Dea: Uji është i çmueshëm. Prandaj, duhet ta ruajmë.","pg106_n0014_easy_read":"Mos hidhni mbeturina në lumenj!","pg106_n0015_easy_read":"Mos e lini çezmën hapur pa nevojë!","pg106_n0016_easy_read":"Të kujdesemi për kursimin e energjisë.","pg106_n0017_easy_read":"Mali: Ne mund të mbjellim drurë. Mund të mbjellim shumë drurë. Së paku, secili prej nesh mund të mbjellë 1 dru gjatë jetës.","pg106_n0018_easy_read":"Ne, së bashku, mund ta bëjmë ndryshimin për një ambient më të pastër dhe për një jetë të shëndetshme.","pg106_n0019_easy_read":"Mësuesi: Ju lumtë, nxënës!","pg106_n0020_easy_read":"Ne duhet të kujdesemi për ambientin, që edhe ne të jemi të shëndetshëm.","pg107_n0008_easy_read":"A është e rëndësishme që secili të ndihmojë për ruajtjen e mjedisit?","pg107_n0009_easy_read":"Pse?","pg107_n0011_easy_read":"Çfarë bën ti për ta mbajtur mjedisin të pastër?","pg107_n0013_easy_read":"Çfarë duhet të bëjmë për të mbrojtur:\n- tokën\n- ujin\n- ajrin","pg107_n0015_easy_read":"Krahasoje punimin tënd me punimin e shokut të bankës.\nPastaj diskutoni në klasë.","pg107_n0020_easy_read":"Toka","pg107_n0022_easy_read":"Uji","pg107_n0024_easy_read":"Ajri","pg107_n0032_easy_read":"Mjedisi jetësor është e gjithë hapësira e natyrës.\nNë të ne jetojmë, punojmë, lëvizim dhe veprojmë.","pg107_n0033_easy_read":"Njeriu ndikon në ndryshimet që ndodhin në natyrë.\nAi ndikon me sjelljen e tij.","pg107_n0034_easy_read":"Këto veprime mund të jenë të dëmshme për natyrën.\nAto mund të jenë edhe të dobishme për natyrën.","pg107_n0035_easy_read":"Mjedisi i pastër siguron shëndet të mirë për të gjitha qeniet e gjalla.\nKëto qenie të gjalla jetojnë në planetin tonë.","pg107_n0036_easy_read":"Çdo qytetar ka përgjegjësi.\nÇdo qytetar duhet të ndihmojë për ta ruajtur mjedisin nga ndotja.","pg107_n0038_easy_read":"Për një mjedis të pastër, ne duhet:\n- të kursejmë energjinë\n- të udhëtojmë me biçikletë ose me transport publik\n- t'i ndajmë mbeturinat sipas llojit\n- t'i hedhim mbeturinat në vendin e caktuar\n- ta kursejmë ujin\n- ta gjelbërojmë sa më shumë mjedisin\nKështu kemi ajër të pastër.","pg107_n0040_easy_read":"Njeriu duhet t'ia vërë vetes këtë detyrë:\nNëse nuk mund ta mbrojë natyrën, të paktën të mos e shkatërrojë atë.","pg107_n0042_easy_read":"Fjalët kyçe:","pg107_n0043_easy_read":"- mjedis\n- kujdes\n- mbrojtje\n- ujë\n- ajër\n- tokë","pg108_n0005_easy_read":"1.","pg108_n0007_easy_read":"Bëni në klasë një plan për një ekskursion nëpër Kosovë.","pg108_n0008_easy_read":"Përdorni njohuritë që keni marrë për pasuritë natyrore dhe për trashëgiminë kulturore të vendit tonë.\nPunoni me shokun ose shoqen e bankës.\nShkruani disa vende.\nPastaj vendosni bashkë se cilin vend do ta vizitoni.","pg108_n0012_easy_read":"Vendet ku ka pasuri natyrore","pg108_n0014_easy_read":"Vendet ku ka bukuri natyrore","pg108_n0016_easy_read":"Vendet ku ka trashëgimi kulturore","pg108_n0019_easy_read":"1.","pg108_n0021_easy_read":"1. Drini i Bardhë","pg108_n0023_easy_read":"1. Lidhja e Prizrenit","pg108_n0026_easy_read":"2.","pg108_n0028_easy_read":"2.","pg108_n0030_easy_read":"2.","pg108_n0033_easy_read":"3.","pg108_n0035_easy_read":"3.","pg108_n0037_easy_read":"3.","pg108_n0040_easy_read":"2.","pg108_n0041_easy_read":"Shkruani vendet që vendosët t’i vizitoni.\nPastaj tregoni arsyet pse.","pg109_n0005_easy_read":"3.","pg109_n0006_easy_read":"Planifikoni orarin e udhëtimit për 1 ditë ekskursioni!","pg110_n0006_easy_read":"Era po shfletonte fjalorin e gjuhës shqipe.\nAjo po shikonte sa fjalë i njihte.","pg110_n0007_easy_read":"Era u befasua kur lexoi një përkufizim për natyrën:\n\"Natyra është mjedisi ku jeton njeriu në Tokë, me të gjitha qeniet e gjalla dhe sendet pa jetë.\"","pg110_n0008_easy_read":"Era ndaloi dhe mendoi.\nAjo pyeti veten si njeriu mund ta dëmtojë jo vetëm mjedisin që e rrethon, por edhe mjedisin ku jetojnë gjallesat e tjera.","pg110_n0010_easy_read":"- Sa keq bëjmë kur e ndotim rrugën, pyjet dhe detin, - tha Era me zë të lartë.","pg110_n0011_easy_read":"- Ja, për shembull, kur hedhim mbeturina në det ose në breg, ne jo vetëm që ndotim një peizazh shumë të bukur, por edhe shkatërrojmë jetën e shumë gjallesave të detit.","pg110_n0012_easy_read":"Pse ne njerëzit i bëjmë këto veprime?","pg110_n0013_easy_read":"Pse të hedhim mbeturina në tokë,\nkur mund t'i mbajmë dhe t'i hedhim në shportën e mbeturinave?","pg110_n0014_easy_read":"Pse të mos mbjellim drurë për ta gjelbëruar mjedisin,\npor t'i presim ata?","pg110_n0015_easy_read":"Sa kushton t'i hedhim shishet e plastikës në shportën për riciklim?","pg110_n0017_easy_read":"Era mendoi:\n\"Dua të bëj një prezantim për mbrojtjen e natyrës para shoqeve dhe shokëve të klasës.\"\nAjo ishte e shqetësuar për gjendjen e natyrës në vendin tonë.","pg111_n0005_easy_read":"- Çfarë kupton me fjalën natyrë?","pg111_n0006_easy_read":"- Cilat veprime i sheh Era si të dëmshme?","pg111_n0007_easy_read":"- Shkruaj emrat e mbeturinave sipas ngjyrës së shportave për riciklim.","pg111_n0010_easy_read":"Ndotja e mjedisit natyror me ndotës të ndryshëm shkakton shumë ndryshime në tokë, ujë dhe ajër.\nKëto ndryshime ndikojnë drejtpërdrejt edhe në jetën e qenieve të gjalla.","pg111_n0011_easy_read":"Njeriu e ka për detyrë të mbrojë mjedisin ku jeton dhe vepron.","pg111_n0012_easy_read":"Kujdesi ndaj natyrës duhet të jetë i vazhdueshëm dhe i përhershëm.\nKy kujdes duhet të bëhet nga secili njeri dhe nga grupi.","pg111_n0013_easy_read":"Njeriu duhet ta mbrojë natyrën çdo ditë.","pg111_n0014_easy_read":"Ndotja e natyrës shkatërron edhe jetën e qenieve të gjalla në planetin tonë.","pg111_n0015_easy_read":"Për një jetë të shëndetshme, duhet të kemi mjedis të pastër.","pg111_n0016_easy_read":"Fjalët kyçe:\n- natyrë\n- gjelbërim\n- kujdes\n- riciklim\n- mjedis","pg112_n0005_easy_read":"Mali i vizitonte dajat e tij në çdo pushim pranveror.","pg112_n0006_easy_read":"Mali e donte shumë natyrën e fshatit.\nAi nuk pranonte t’i kalonte pushimet diku tjetër.","pg112_n0007_easy_read":"Në fshat, Malit i dukej çdo gjë e mrekullueshme:\n- relievi\n- harmonia mes njerëzve\n- lidhja e tyre me natyrën\n- mënyra si e punonin tokën\n- produktet që merrnin nga toka","pg112_n0008_easy_read":"E vetmja gjë që e shqetësonte Malin ishte lumi i fshatit.","pg112_n0009_easy_read":"Pse banorët hidhnin mbeturina në lumë?","pg112_n0010_easy_read":"Pse banorët nuk e pastronin lumin njëherë e përgjithmonë?","pg112_n0011_easy_read":"Pse fshatarët nuk shpëtonin nga era e keqe që shkaktonin mbeturinat?","pg112_n0012_easy_read":"Mali e kishte kuptuar se tani nuk ishte më i vogël për të bërë gjëra të mëdha.","pg112_n0013_easy_read":"Ai kishte shumë shokë në fshat.\nAi luante me ta.","pg112_n0014_easy_read":"Mali e dha i pari idenë.\nAi tha që të shkonin bashkë me shokët për t’i larguar të gjitha letrat afër lumit.","pg112_n0015_easy_read":"Po sikur të kërkojmë ndihmë nga të rriturit për këtë gjë?\nÇfarë do të na thoshin?","pg112_n0016_easy_read":"Fëmijët mezi prisnin ta kalonin kohën bashkë.\nTë gjithë thanë njëzëri: \"Le ta provojmë!\"","pg112_n0017_easy_read":"Mali dhe shoqja e tij, Era, po mblidhnin mbeturina bashkë me fshatarët.\nGjatë kësaj kohe, ata po bisedonin.\nAta po thoshin sa keq ishin ndier kur i kishin kaluar pushimet në det vitin e kaluar.","pg112_n0018_easy_read":"Ata kishin parë se deti ishte i mbushur me qeska najloni dhe me mbetje ushqimesh.","pg112_n0019_easy_read":"Ata nuk arrinin të gjenin përgjigje për këto veprime.","pg112_n0020_easy_read":"A mos po e ndot shumë njeriu ujin, që është element kyç për jetën e gjallesave?","pg112_n0021_easy_read":"Ylli i ndërpreu bisedën e Malit dhe të Erës.\nAi tha: \"Njeriu duhet të ndalojë së bëri këto veprime të dëmshme.\"","pg112_n0023_easy_read":"- Çfarë i bënte përshtypje Malit në fshat?","pg112_n0024_easy_read":"- Pse Mali thotë se uji është pjesë kyçe e jetës së gjallesave?","pg112_n0025_easy_read":"- Pse është e rëndësishme të kursejmë ujin?","pg112_n0026_easy_read":"Imagjino që ti je një pikë uji në lumë.","pg112_n0027_easy_read":"Çfarë do të dëshiroje nga njerëzit që ta mbajnë lumin të pastër?","pg112_n0030_easy_read":"Uji është i domosdoshëm për jetën e qenieve të gjalla.","pg112_n0031_easy_read":"Prandaj, njeriu duhet të kujdeset shumë për ujërat në mjedisin ku jeton.","pg112_n0032_easy_read":"Njeriu duhet të kujdeset që të mos e keqpërdorë ose ndotë ujin e pijshëm dhe ujërat e tjera.","pg112_n0033_easy_read":"Ndotja e ujit do të thotë ndotje e të gjitha ujërave:\n- në tokë\n- në liqene\n- në lumenj\n- në oqeane\n- në rrjedha të ujit\n- në ujërat nëntokësore","pg112_n0034_easy_read":"Ndotja e ujit ndodh kur ndotësit hidhen në ujë.\nKjo ndodh pa kujdes për të hequr përbërjet e dëmshme.","pg112_n0035_easy_read":"Ndotja e ujit i dëmton bimët dhe organizmat që jetojnë në këto ujëra.\nAjo shkakton efekte të dëmshme te to.","pg112_n0036_easy_read":"Ujërat e zeza janë ndotësit kryesorë.\nAto shkaktojnë shumë sëmundje infektive.","pg112_n0037_easy_read":"Secili vend duhet të kujdeset për ndërtimin e sistemit për derdhjen e ujërave të zeza.","pg112_n0040_easy_read":"Fjalët kyçe:","pg112_n0041_easy_read":"Fjalët kyçe janë:\n- ujë\n- lumë\n- ndotje\n- kursim\n- jetesë","pg114_n0005_easy_read":"Mësuesja u dha nxënësve detyrë.\nNxënësit duhej të përgatitnin një projekt me temë sipas dëshirës.","pg114_n0006_easy_read":"Disa nxënës zgjodhën si temë instrumentin që e pëlqenin më shumë.\nDisa përgatitën projekt për kafshën e dashur.\nDisa të tjerë zgjodhën bimët.","pg114_n0007_easy_read":"Hëna po mendonte se cilën temë të zgjidhte.","pg114_n0008_easy_read":"Ajo donte të hulumtonte një temë për të cilën kishte pak informata.\nTema duhej të ishte e dobishme për të.","pg114_n0009_easy_read":"Hëna po zgjidhte mes 3 temave:\n- kafshës më të pëlqyer\n- bimës më interesante\n- trupit të njeriut","pg114_n0010_easy_read":"Ndërsa po mendonte, Hëna u kujtua se këto 3 gjallesa kanë diçka të përbashkët.","pg114_n0011_easy_read":"Të 3 jetojnë në Tokë.\nPrandaj, Hëna mendoi të hulumtonte për Tokën.","pg114_n0013_easy_read":"Ndërsa po mblidhte informata për formën e Tokës, origjinën e emrit dhe karakteristika të tjera, një fjali i tërhoqi vëmendjen:","pg114_n0014_easy_read":"\"Në Sistemin Diellor ka 8 planetë dhe VETËM në planetin Tokë është e mundshme jeta për gjallesat\".","pg114_n0016_easy_read":"Hënës po i bënin përshtypje këto fakte:\n- sa ujë ka në Tokë\n- përbërja e ajrit\n- sateliti natyral i Tokës","pg114_n0017_easy_read":"Ajo mendoi ta ndryshonte temën e projektit.\nAjo do t'u tregonte shokëve dhe shoqeve të klasës për rëndësinë e planetit Tokë.","pg114_n0018_easy_read":"- Unë mund të bëj gjëra të vogla me dashuri të madhe për planetin tim, - mendoi ajo.","pg114_n0019_easy_read":"Hëna u përqendrua te veprimet e dëmshme që fëmijët mund t'i bëjnë ndaj Tokës.","pg114_n0020_easy_read":"Ne hedhim mbeturina në tokë.","pg114_n0021_easy_read":"Ne shpenzojmë shumë ujë pa nevojë.","pg114_n0022_easy_read":"Ne nuk riciklojmë.","pg114_n0023_easy_read":"Ne i dëmtojmë hapësirat e gjelbëruara kur ecim në bar dhe jo në rrugën e shtruar.","pg114_n0024_easy_read":"Ne i dëmtojmë lulet, edhe pse duhet të kujdesemi për to.","pg114_n0026_easy_read":"Në fund të prezantimit të projektit, Hëna u kërkoi shoqeve dhe shokëve të klasës të vizatonin diçka.\nKjo duhej të tregonte çfarë mund të bënin ata ndryshe për të mirën e planetit.","pg114_n0027_easy_read":"Hëna e mbylli prezantimin duke thënë me zë të lartë: \"Është e mira jonë e përbashkët, prandaj duhet ta ruajmë me çdo kusht!\"","pg115_n0007_easy_read":"Çfarë e bën Tokën të ndryshme nga planetët e tjerë?","pg115_n0009_easy_read":"Çfarë mund të mbjellim në tokë?","pg115_n0011_easy_read":"Cili mund të jetë kontributi ynë për Tokën?","pg115_n0013_easy_read":"Përmend 1 veprim që e ndot tokën.","pg115_n0015_easy_read":"Ndahuni në grupe.\nPastaj planifikoni pastrimin e oborrit të shkollës.","pg115_n0018_easy_read":"Toka është planeti i vetëm në Sistemin Diellor ku zhvillohet jeta.","pg115_n0019_easy_read":"Njeriu duhet të kujdeset vazhdimisht për tokën.\nNjeriu mund të:\n- mbjellë bimë dhe fidanë të ndryshëm\n- riciklojë\n- hedhë mbeturinat në vendin e duhur","pg115_n0020_easy_read":"Ndotja e vazhdueshme e tokës dëmton drejtpërdrejt:\n- mjedisin\n- pjesët e natyrës\n- qeniet e gjalla\n- shëndetin e njeriut","pg115_n0021_easy_read":"Ndotja duhet të parandalohet.\nKjo bëhet duke kontrolluar burimet e ndotësve.","pg115_n0022_easy_read":"Veprimet e papërgjegjshme të njeriut e rrezikojnë dhe e ndotin tokën.","pg115_n0023_easy_read":"Fjalët kyçe:\n- ujë\n- ndotje\n- kujdes\n- tokë\n- riciklim","pg116_n0005_easy_read":"Mësuesja po shpjegonte sa të dobishëm janë drurët në jetën e çdo njeriu.","pg116_n0006_easy_read":"Ajo kishte përgatitur një prezantim. Në të tregohej sa i dobishëm është procesi i fotosintezës. Mali nuk ishte shumë i përqendruar te fjalët e mësueses.","pg116_n0007_easy_read":"Malit po i kujtohej një ngjarje nga viti i kaluar.","pg116_n0009_easy_read":"Kur Mali po ecte me familjen e tij në një pyll, ata takuan një të njohur. Ai i njohur po priste drurë.","pg116_n0010_easy_read":"Mali e dinte që prerja e drurëve ishte e dëmshme. Prandaj, Mali e pyeti të njohurin:","pg116_n0012_easy_read":"\"O xhaxha, a e di që prerja e drurëve nuk është e mirë për ajrin dhe për jetën në Tokë!","pg116_n0013_easy_read":"Malit i kujtohej shumë mirë përgjigjja e xhaxhait.","pg116_n0014_easy_read":"Ai tha: \"Po unë me këtë punë jetoj dhe mbaj familjen\".","pg116_n0015_easy_read":"Mali e kishte pranuar mendimin e xhaxhait. Ai ishte ndier keq pse e kishte pyetur.","pg116_n0017_easy_read":"Tani Malit iu duk se ishte momenti i duhur për ta ndarë këtë përvojë me mësuesen e tij.","pg116_n0018_easy_read":"Përgjigjja e mësueses e habiti Malin. Mali priste që mësuesja ta kundërshtonte veprimin e xhaxhait.","pg116_n0019_easy_read":"Për çudi, mësuesja e pyeti: \"Çfarë duhet të bëjë xhaxhai yt që ta kompensojë dëmin që ka bërë?\".","pg116_n0021_easy_read":"Ishte një pyetje për të cilën Mali nuk kishte menduar.","pg116_n0022_easy_read":"Nëse xhaxhai do të mbillte 1 dru të ri për secilin dru të prerë, ai ndoshta do ta kompensonte dëmin e tij deri diku.","pg117_n0005_easy_read":"Diskutoni për veprimin e xhaxhait që e takoi Mali.","pg117_n0006_easy_read":"Si të është dukur mendimi i Malit për xhaxhanë?","pg117_n0007_easy_read":"Po ty, si të është dukur veprimi i xhaxhait?","pg117_n0008_easy_read":"Po përgjigjja e mësueses, si të është dukur?","pg117_n0009_easy_read":"Mendo një zgjidhje tjetër për këtë problem!","pg117_n0011_easy_read":"Pylli është një bashkësi e gjallë e pemëve dhe e shkurreve.","pg117_n0012_easy_read":"Pylli konsiderohet si një fabrikë ekologjike e përsosur.\nPylli e pastron ajrin.\nPylli është edhe vend i përshtatshëm për jetën e shumë kafshëve të egra.\nNjeriu përfiton prej pyllit.","pg117_n0014_easy_read":"Drurët janë shumë të dobishëm për jetën në Tokë.\nPrandaj, njeriu duhet të ketë kujdes.\nNjeriu nuk duhet t’i presë drurët dhe nuk duhet t’i shkatërrojë pyjet.","pg117_n0015_easy_read":"Njerëzit, me veprime të papërgjegjshme, i presin pyjet për:\n- të bërë rrugë\n- të krijuar vendbanime\n- nevoja të tjera personale","pg117_n0017_easy_read":"Gjatë verës, ka rrezik të zjarreve në pyje.\nKjo ndodh për shkak të temperaturave të larta.","pg117_n0018_easy_read":"Pyjet priten ose digjen.\nPor ne duhet të kujdesemi që pyjet të ripërtërihen.","pg117_n0020_easy_read":"Ne duhet të jemi të përgjegjshëm.\nNe duhet të mbjellim gjithmonë sa më shumë drurë.","pg117_n0021_easy_read":"Për çdo pyll duhet të kujdeset pylltari.\nPër çdo prerje druri duhet të kërkohet leje nga institucionet përkatëse.","pg118_n0005_easy_read":"Jona fliste vazhdimisht për rëndësinë e ruajtjes së ambientit.\nAjo fliste për këto gjëra:\n- hedhjen e mbeturinave në vendin e duhur\n- mbjelljen e bimëve\n- përdorimin sa më të pakët të makinave","pg118_n0006_easy_read":"Nëna dhe babai i Jonës e dëgjonin me vëmendje.\nAta krenoheshin me vajzën e tyre, sepse ajo donte ta ruante ambientin.","pg118_n0007_easy_read":"Një ditë, Jona po udhëtonte me prindërit për te gjyshërit në një qytet tjetër.\nAtëherë, asaj i tërhoqi vëmendjen një autobus i gjatë me ngjyrë të verdhë.","pg118_n0008_easy_read":"Disa njerëz po rrinin në këmbë.\nDisa të tjerë ishin ulur në autobus.","pg118_n0009_easy_read":"Jona i pyeti prindërit e saj:\n\"Përse njerëzit udhëtonin me autobus kur nuk kishin vend dhe duhej të rrinin në këmbë?\"","pg118_n0010_easy_read":"Babai buzëqeshi dhe e pyeti Jonën:\n\"A po i bënin mirë ambientit këta njerëz, apo po i bënin dëm?\"","pg118_n0011_easy_read":"Jona u mendua pak dhe u përgjigj:\n\"Natyrisht që po i bënin mirë ambientit.\"","pg118_n0012_easy_read":"Nëse secili nga këta njerëz do ta përdorte veturën, do të digjej më shumë lëndë djegëse.\nAtëherë ambienti do të ndotej më shumë.","pg118_n0013_easy_read":"Ajo shtoi:\n\"Përdorimi i autobusit qenka shumë i dobishëm.\"","pg118_n0014_easy_read":"Nëna u gëzua nga përgjigjet e Jonës.\nAjo shtoi:\n\"Ky lloj transporti quhet transport publik.\nAi është për të gjithë qytetarët.\"","pg118_n0015_easy_read":"Transporti publik funksionon sipas një orari.\nAi ndjek një rrugë të caktuar.\nPër ta përdorur atë, paguhet një çmim standard.","pg118_n0016_easy_read":"Jona tha:\n\"Mendoj që edhe ne duhet të udhëtojmë me transport publik tash e tutje.\"","pg118_n0017_easy_read":"Prindërve u pëlqeu ideja e Jonës.","pg119_n0007_easy_read":"Çfarë është transporti publik?","pg119_n0009_easy_read":"Si duhet të sillemi në transportin publik?","pg119_n0011_easy_read":"Pse është i rëndësishëm përdorimi i transportit ekologjik?","pg119_n0013_easy_read":"A ka transport ekologjik në qarkullim në vendin tonë?","pg119_n0016_easy_read":"Transporti publik është një mënyrë udhëtimi me autobus, tren ose mjete të tjera.\nTransporti publik është në shërbim të të gjithëve.","pg119_n0017_easy_read":"Llojet e transportit publik janë:\n- transporti urban\n- transporti ndërurban","pg119_n0018_easy_read":"Për t'i ofruar këto shërbime, përveç ndërmarrjes publike, ka edhe ndërmarrje private.\nKëto ndërmarrje punojnë në treg si biznese.","pg119_n0019_easy_read":"Edhe ndërmarrjet private përdorin afërsisht të njëjtat mjete transporti:\n- minibusë\n- autobusë\n- taksi","pg119_n0020_easy_read":"Në gjithë botën, transportit ekologjik i jepet rëndësi e veçantë.\nTransporti ekologjik, si metroja, e ul ndotjen e ajrit.\nAi e kryen të njëjtin funksion si transporti publik.","pg119_n0021_easy_read":"Ndotësit e mjedisit po shkaktojnë ngrohjen globale.\nNjë prej tyre është përdorimi i tepërt i makinave.\nPrandaj, përdorimi i transportit publik është i domosdoshëm.","pg119_n0023_easy_read":"Fjalët kyçe:","pg119_n0024_easy_read":"- transport publik\n- ndotje\n- ajër i pastër\n- ekologjik","pg120_n0006_easy_read":"Mali i shihte shpesh disa shenja në shportën e plehrave në oborrin e shkollës.","pg120_n0007_easy_read":"Ai kishte dëgjuar edhe për rregullën “R - ripërdor, riciklo dhe redukto”.","pg120_n0008_easy_read":"Ndoshta Mali nuk ishte shumë i interesuar në atë kohë.\nPrandaj, ai nuk e kishte kuptuar mirë këtë rregull.","pg120_n0009_easy_read":"Kur mësuesja filloi të fliste se mbeturinat nuk duhej të hidheshin të gjitha në të njëjtën shportë, por duhej të ndaheshin, Malit iu kujtua pse ekzistonte kjo rregull.","pg120_n0011_easy_read":"Qëllimi i kësaj rregulle ishte të përdoren produktet sa më shumë.","pg120_n0012_easy_read":"- Mësuese, a po flisni për riciklimin? - pyeti Mali.","pg120_n0013_easy_read":"- Pikërisht, Mali, të lumtë!","pg120_n0014_easy_read":"Por unë po flas edhe për ripërdorimin dhe reduktimin.","pg120_n0015_easy_read":"Për shembull, ti mund ta përdorësh të njëjtën çantë për shumë vjet në shkollë.","pg120_n0016_easy_read":"Ti mund të bësh një dekorim dhe ta zbukurosh çantën çdo vit, në vend që të kërkosh të blesh një të re.","pg120_n0017_easy_read":"Ose mund t’i dhurosh lodrat e tua.","pg120_n0018_easy_read":"Kështu, ne kemi ripërdorur materiale të ndryshme.","pg120_n0020_easy_read":"Ju lutem, kudo që e shihni shenjën e riciklimit, hidhni vetëm materiale që mund të riciklohen:\n- shishe plastike\n- letër të pastër\n- shishe qelqi\n- kanaçe pijesh","pg120_n0022_easy_read":"Ju duhet t’i ndani mbeturinat edhe në shtëpitë tuaja.","pg120_n0023_easy_read":"Rrobat dhe gjërat që mund të riciklohen, përdorini sa më gjatë që të mundeni.","pg120_n0024_easy_read":"Kur ato të mos ju hyjnë më në punë, mund t’ua dhuroni njerëzve në nevojë.","pg120_n0026_easy_read":"Mali dhe shokët e shoqet e klasës u gëzuan shumë, sepse menduan se kishin shumë mundësi për të ruajtur ambientin.","pg120_n0027_easy_read":"Ata mezi prisnin t’i sistemonin lodrat e vegjëlisë dhe rrobat e tyre, që t’ua dhuronin fëmijëve të tjerë.","pg120_n0029_easy_read":"Mali propozoi që të gjithë fëmijët ta vizatonin simbolin e riciklimit dhe ta vendosnin në njërën nga shportat e mbeturinave në shtëpi.","pg120_n0032_easy_read":"Riciklimi është ndarja e materialeve nga mbeturinat dhe ripërdorimi i tyre.","pg120_n0033_easy_read":"Riciklimi përfshin:\n- mbledhjen\n- ndarjen\n- përpunimin\n- prodhimin e produkteve të reja nga sendet ose materialet e përdorura","pg120_n0034_easy_read":"Shumë mbeturina mund të ripërdoren, nëse grumbullohen veçmas.","pg120_n0036_easy_read":"Është shumë e rëndësishme që së pari mbetjet të ndahen sipas llojit të mbeturinave.","pg120_n0037_easy_read":"Duhet të kemi kujdes kur i ndajmë mbeturinat, sepse mbeturinat që riciklohen duhet t’i hedhim në koshin e caktuar.","pg120_n0039_easy_read":"Materialet që mund të riciklohen janë:\n- letra\n- metalet, si alumini dhe çeliku\n- produktet e qelqit","pg120_n0040_easy_read":"Krijimi i plehut nga mbetjet organike është një shembull tjetër i mirë i riciklimit.","pg120_n0041_easy_read":"Nëse nuk e fusim riciklimin në jetën e përditshme, nuk mund të imagjinojmë një sistem të rregullt të mbeturinave.","pg120_n0044_easy_read":"Fjalët kyçe:","pg120_n0045_easy_read":"- kujdes\n- mbeturinë\n- riciklim\n- përfitim","pg120_n0047_easy_read":"Çfarë është riciklimi?","pg120_n0048_easy_read":"Cilat gjëra ose sende riciklohen?","pg120_n0049_easy_read":"Çfarë përfitojmë nga riciklimi i mbetjeve?","pg120_n0050_easy_read":"Trego 1 rast kur ke ricikluar.","pg120_n0051_easy_read":"Jep 1 ide se si mund ta përdorim përsëri 1 shishe plastike.","pg121_n0002_easy_read":"Mjedisi i vendit tim","pg121_n0003_easy_read":"Si riciklohen mbetjet?","pg122_n0005_easy_read":"Mira është shoqja e Lumit dhe e Norës.\nAjo shkon në shkollën e muzikës.\nAtje mëson pianon.","pg122_n0006_easy_read":"Shkolla e muzikës organizoi një koncert.\nNë koncert u ftuan të gjithë shokët dhe shoqet e Mirës.","pg122_n0007_easy_read":"Fëmijët nuk kishin marrë pjesë më parë në një ngjarje të tillë.","pg122_n0009_easy_read":"Mësuesja ua kujtoi fëmijëve këto rregulla:\n- Duhet të shkonin në koncert në kohën e duhur.\n- Duhet t'i zinin vendet pa bërë zhurmë.\n- Nuk duhej të flisnin gjatë pjesës muzikore.\n- Duhej të shikonin dhe të dëgjonin performancën e nxënësve.","pg122_n0011_easy_read":"Fëmijët po prisnin në korridorin e shkollës që të fillonte koncerti.\nYlli ishte ulur në një karrige.\nPasi e mbaroi ushqimin, Ylli e hodhi letrën në dysheme.","pg122_n0012_easy_read":"Edhe Diellza e hodhi në dysheme letrën e kekut të saj.","pg122_n0014_easy_read":"Mësuesja dhe shumë shokë e shoqe që ishin aty e vunë re këtë veprim.","pg122_n0015_easy_read":"Ata kujtuan se duhet të mbajnë pastër higjienën personale.\nAta duhet t'i ruajnë edhe ambientet publike.","pg122_n0016_easy_read":"Nëse të gjithë do t'i hidhnin mbeturinat vend e pa vend, ata nuk do të mund t'i shijonin bukuritë e mjediseve të ndryshme.","pg122_n0017_easy_read":"Lumi u tha shokëve: \"Le të kujdesemi për higjienën kudo.","pg122_n0018_easy_read":"Kjo higjienë do të na mbajë të shëndetshëm në trup dhe në mendje.\"","pg122_n0021_easy_read":"Njeriu ka përgjegjësi.\nPërveç higjienës personale, ai duhet të tregojë sjellje të mira si qytetar edhe në komunitet.","pg122_n0022_easy_read":"Njeriu e tregon këtë përgjegjësi me veprime të ndryshme:\n- duke mbjellë bimë të ndryshme\n- duke u kujdesur për ambientin\n- duke u kujdesur që të mos i dëmtojë gjërat që i përdorim të gjithë, si parqet, bankat dhe rrugët","pg122_n0024_easy_read":"Të gjitha shprehitë e jetës krijohen në fëmijëri.","pg122_n0025_easy_read":"Për çdo gjë që na rrethon, duhet të sillemi sikur është jona.","pg122_n0026_easy_read":"Nëse sillemi me përgjegjësi dhe tregojmë kujdes të plotë për higjienën e gjërave që na rrethojnë, do të kemi një jetë të mirë dhe të shëndetshme në komunitetin tonë.","pg122_n0028_easy_read":"Fjalët kyçe:\n- komunitet\n- higjienë\n- kujdes\n- ambient publik","pg122_n0030_easy_read":"Çfarë kupton me fjalën komunitet?","pg122_n0031_easy_read":"Si duhet të sillemi në vende publike?","pg122_n0032_easy_read":"Çfarë masa duhet të marrim për ta pastruar lagjen?","pg122_n0033_easy_read":"Përmend 3 veprime jo të mira që ndikojnë në higjienën e komunitetit.","pg122_n0034_easy_read":"Shkruaj 1 rregull që ndihmon për ta mbajtur komunitetin të pastër.","pg124_n0006_easy_read":"Ndahuni në 4 grupe pune.","pg124_n0007_easy_read":"Bëni një plan veprimi.\nShkruani si do ta pastroni lagjen ose hapësirën ku jetoni së bashku.","pg124_n0010_easy_read":"Mbillni fidanë në hapësirën e zgjedhur.","pg124_n0011_easy_read":"Plani i veprimit është:","pg124_n0018_easy_read":"Largoni mbeturinat nga hapësira e zgjedhur.","pg124_n0019_easy_read":"Plani i veprimit është:","pg125_n0009_easy_read":"Vendos mbeturinat në shportat e duhura për riciklim.","pg125_n0010_easy_read":"Plani i veprimit është:","pg125_n0018_easy_read":"Krijo abazhurë të ndryshëm me materiale të ndryshme për riciklim.","pg125_n0019_easy_read":"Plani i veprimit është:","pg126_n0009_easy_read":"Në këtë lojë marrin pjesë 2 nxënës.","pg126_n0011_easy_read":"Duhen etiketa me numrat 1 deri në 20.\nMësuesi ose mësuesja i përgatit ato.","pg126_n0013_easy_read":"Secili nxënës tërheq 1 etiketë.\nPastaj i përgjigjet pyetjes me numrin që ka etiketa.","pg126_n0015_easy_read":"Pasi përgjigjet nxënësi i parë, nxënësi i dytë tërheq 1 etiketë.\nPastaj ai i përgjigjet pyetjes përkatëse.","pg126_n0017_easy_read":"Secila përgjigje e saktë vlen 2 pikë.","pg126_n0018_easy_read":"Mësuesi ose mësuesja mban shënim për secilin nxënës.\nNë fund fiton nxënësi që ka më shumë pikë.","pg126_n0020_easy_read":"1. Çfarë kupton me fjalën bullizëm?","pg126_n0021_easy_read":"20. Përmend disa materiale që mund të riciklohen.","pg126_n0022_easy_read":"19. Çka do të thotë tolerancë?","pg126_n0023_easy_read":"18. Çfarë do të thotë pasuri njerëzore?","pg126_n0024_easy_read":"17. Cilat janë pasuritë nëntokësore të Kosovës?","pg126_n0025_easy_read":"16. Trego cilat janë institucionet kulturore të vendit tënd.","pg126_n0026_easy_read":"2","pg126_n0027_easy_read":"g","pg126_n0028_easy_read":"s","pg126_n0029_easy_read":"15","pg126_n0030_easy_read":"di","pg126_n0031_easy_read":"ko","pg126_n0032_easy_read":"so","pg126_n0033_easy_read":"të","pg126_n0034_easy_read":"ve","pg126_n0038_easy_read":"Unë","pg126_n0046_easy_read":"Ti","pg127_n0004_easy_read":"2. Cili është grupi shoqëror më i vogël?","pg127_n0006_easy_read":"3. Cilat janë arsyet pse njerëzit bëjnë punë vullnetare?","pg127_n0008_easy_read":"4. Përmend 2 të drejta dhe 2 përgjegjësi të fëmijëve.","pg127_n0010_easy_read":"5. Cilët janë hapat për ta zgjidhur një mosmarrëveshje?","pg127_n0012_easy_read":"6. Çfarë do të thotë llojllojshmëri kulturore?","pg127_n0014_easy_read":"7. Si e shpjegon kuptimin e fjalës mikpritje?","pg127_n0016_easy_read":"8. Cilat veti e tregojnë një njeri solidar?","pg127_n0018_easy_read":"9. Sa e rëndësishme është barazia gjinore në jetën e përditshme?","pg127_n0020_easy_read":"10. Unë jam tolerant, sepse","pg127_n0022_easy_read":"11. Numëro rajonet e Kosovës.","pg127_n0024_easy_read":"12. Kur u shpall Pavarësia e Kosovës?","pg127_n0026_easy_read":"13. Cilat komunitete i përfaqësojnë yjet në flamurin e Kosovës?","pg127_n0028_easy_read":"14. Cilat janë dallimet mes familjes tradicionale dhe familjes bashkëkohore?","pg127_n0030_easy_read":"15. Përmend disa sportistë kosovarë që sollën medalje të arta në vendin tonë.","pg128_n0005_easy_read":"Komunitet – Grup njerëzish që jetojnë ose punojnë bashkë dhe ndihmojnë njëri-tjetrin.","pg128_n0007_easy_read":"Grup shoqëror – Grup njerëzish që kanë interesa ose veprimtari të përbashkëta.","pg128_n0009_easy_read":"Përkrahje – Ndihmë dhe mbështetje për dikë.","pg128_n0011_easy_read":"Ndërveprim – Komunikim dhe bashkëpunim mes njerëzve.","pg128_n0013_easy_read":"Përgjegjësi – Detyrë që duhet ta kryejmë me kujdes.","pg128_n0015_easy_read":"Institucion – Vend ku njerëzit punojnë për t’u shërbyer qytetarëve.","pg128_n0017_easy_read":"Qendër shëndetësore – Vend ku njerëzit marrin ndihmë mjekësore.","pg128_n0019_easy_read":"Diversitet kulturor – Kur njerëz me kultura dhe zakone të ndryshme jetojnë bashkë.","pg128_n0021_easy_read":"Respekt – Sjellje e mirë dhe vlerësim për të tjerët.","pg128_n0023_easy_read":"Traditë – Zakone dhe mënyra jetese që kalojnë nga brezi në brez.","pg128_n0025_easy_read":"Paqe – Jetë pa luftë dhe pa dhunë.","pg128_n0027_easy_read":"Tolerancë – Pranim dhe respekt për mendimet ose dallimet e të tjerëve.","pg128_n0029_easy_read":"Solidaritet – Ndihmë dhe mbështetje për njerëzit që kanë nevojë.","pg128_n0031_easy_read":"Diskriminim – Trajtim i padrejtë i dikujt për shkak të dallimeve.","pg128_n0033_easy_read":"Individ – 1 person i vetëm.","pg128_n0035_easy_read":"Empati – Të kuptosh dhe të ndjesh emocionet e një personi tjetër.","pg128_n0037_easy_read":"Dhunë – Sjellje që lëndon ose dëmton dikë.","pg128_n0039_easy_read":"Vendimmarrje – Procesi i zgjedhjes ose i marrjes së 1 vendimi.","pg128_n0041_easy_read":"Komunë – Pjesë e qytetit ose e zonës që kujdeset për shërbimet e qytetarëve.","pg128_n0043_easy_read":"Prokuror – Person që heton shkeljet e ligjit.","pg128_n0045_easy_read":"Gjyqtar – Person që merr vendime në gjykatë sipas ligjit.","pg128_n0047_easy_read":"Avokat – Person që i ndihmon dhe i mbron njerëzit para ligjit.","pg128_n0049_easy_read":"Noter – Person që vërteton dokumente zyrtare.","pg128_n0051_easy_read":"Ligj – Rregulla që duhet t’i zbatojnë të gjithë.","pg128_n0053_easy_read":"Ekonomi – Menaxhimi i parave, i punës dhe i pasurive të 1 vendi ose të 1 familjeje.","pg128_n0055_easy_read":"Kontribut – Ndihmë ose pjesëmarrje për 1 punë të mirë.","pg128_n0057_easy_read":"Pasuri të paripërtëritshme – Pasuri natyrore që harxhohen dhe nuk zëvendësohen shpejt, si nafta dhe qymyri.","pg128_n0059_easy_read":"Pasuri të ripërtëritshme – Pasuri natyrore që mund të përdoren përsëri, si uji, era dhe dielli.","pg129_n0005_easy_read":"Mati Logoreci ishte mësues, poet dhe veprimtar shqiptar.\nAi lindi në Shkodër.\nAi punoi për arsimin dhe për kulturën shqiptare.","pg129_n0007_easy_read":"Sevasti Qiriazi ishte mësuese dhe veprimtare shqiptare.\nAjo punoi për arsimimin e vajzave shqiptare.\nSevasti Qiriazi ishte një nga gratë e para që ndihmoi shkollën shqipe.","pg129_n0009_easy_read":"Shkodra është një qytet në veri të Shqipërisë.\nQyteti njihet për histori, kulturë dhe natyrë.\nNë Shkodër ka vende të njohura për vizitë.","pg129_n0011_easy_read":"Majlinda Kelmendi është xhudiste nga Kosova.\nAjo ka fituar shumë medalje.\nMajlinda Kelmendi njihet si një nga sportistet më të suksesshme të Kosovës.","pg129_n0013_easy_read":"Ymer Riza ishte studiues shqiptar.\nAi njihet për punën e tij në gjuhë dhe në kulturë.","pg129_n0015_easy_read":"Nexhmije Pagarusha ishte këngëtare shqiptare.\nAjo ishte shumë e njohur.\nShumë njerëz e quajnë ikonë të muzikës shqiptare.","pg129_n0017_easy_read":"Ky është një turne 1-ditor në Prishtinë.\nTurneu i çon vizitorët në vende të njohura të qytetit.\nVizitorët e njohin historinë dhe kulturën e Prishtinës.","pg129_n0019_easy_read":"Kjo është Biblioteka Kombëtare e Kosovës.\nAjo gjendet në Prishtinë.\nBiblioteka është një ndërtesë e njohur e qytetit.","pg129_n0021_easy_read":"Teatri Kombëtar ka publikuar orarin e shfaqjeve për muajin janar.\nOrari tregon se kur do të jepen shfaqjet.","pg129_n0023_easy_read":"Galeria Kombëtare e Kosovës është institucion i artit në Kosovë.\nAjo merret me ekspozita dhe me veprimtari artistike.\nGaleria gjendet në Prishtinë.","pg129_n0025_easy_read":"Guesthouse Bjeshkët e Nemuna është vend për qëndrim në Lepushë, në qarkun e Shkodrës.\nKy vend lidhet me pushim dhe me natyrë.","pg129_n0027_easy_read":"Ulpiana ishte qytet i lashtë.\nAjo gjendet afër Prishtinës.\nUlpiana është vend i rëndësishëm arkeologjik.","pg129_n0029_easy_read":"Kjo është një foto e Ferizajt.\nFerizaj është qytet në Kosovë.","pg129_n0031_easy_read":"Kjo është një foto e Gjakovës.\nGjakova është qytet në Kosovë.","pg129_n0033_easy_read":"Kjo është një foto që lidhet me shpërndarjen e Kuvendit të Kosovës.","pg129_n0035_easy_read":"Kjo është një foto që lidhet me Ernest Koliqin.\nErnest Koliqi ishte bashkëthemelues i tregimit modern shqiptar."},"./content/i18n/sq-XK/speech_texts.json":{"pg001_n0002":"Dhurata Tara-Nixha, Miranda Stavileci, Lindita Lutaj","pg001_n0003":"SHOQËRIA DHE MJEDISI 4","pg001_n0004":"Për klasën e katërt të arsimit fillor","pg001_im002":"Glob tokësor pranë një libri të hapur, me peshore drejtësie dhe gjethe të mëdha në sfond.","pg003_n0002":"Përmbajtja","p