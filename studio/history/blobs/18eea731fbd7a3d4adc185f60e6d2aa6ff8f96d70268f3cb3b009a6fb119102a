49":"Kulturat janë të shumëllojshme","pg004_n0050":"91","pg004_n0053":"Resurset dhe trashëgimia e vendit tim","pg004_n0054":"92","pg004_n0057":"Shfrytëzimi i pasurive natyrore","pg004_n0058":"92","pg004_n0060":"Shfrytëzimi i pasurive nëntokësore","pg004_n0061":"94","pg004_n0063":"Shfrytëzimi i pasurive mbitokësore","pg004_n0064":"96","pg004_n0066":"Shfrytëzimi i arsyeshëm i pasurive natyrore","pg004_n0067":"98","pg004_n0069":"Pasuritë njerëzore","pg004_n0070":"100","pg004_n0072":"Ruajmë trashëgiminë kulturore","pg004_n0073":"102","pg004_n0075":"Kujdesi shëndetësor","pg004_n0076":"104","pg004_n0078":"Ndihmojmë për një mjedis të pastër","pg004_n0079":"106","pg004_n0081":"Ekskursion: “Pasuritë natyrore të vendit tim”","pg004_n0082":"108","pg004_n0085":"Mjedisi i vendit tim","pg004_n0086":"110","pg004_n0089":"Njeriu mbron natyrën","pg004_n0090":"110","pg004_n0092":"Ndotja e ujërave","pg004_n0093":"112","pg004_n0095":"Ndotja e tokës","pg004_n0096":"114","pg004_n0098":"T’i ruajmë tokën dhe pyjet","pg004_n0099":"116","pg004_n0101":"Transporti publik dhe ai ekologjik","pg004_n0102":"118","pg004_n0104":"Si riciklohen mbetjet?","pg004_n0105":"120","pg004_n0107":"Kujdesi për higjienën në komunitet","pg004_n0108":"122","pg004_n0110":"Projekti ynë: “Ndihmoj për një mjedis të pastër dhe të gjelbër”","pg004_n0111":"124","pg004_n0113":"Lojë: Unë dhe ti","pg004_n0114":"126","pg004_n0116":"Fjalorthi","pg004_n0117":"128","pg004_n0119":"Referencat","pg004_n0120":"129","pg005_n0002":"Titulli","pg005_n0004":"Parathënie","pg005_n0005":"Të dashur nxënës,","pg005_n0007":"Po takohemi sërish edhe këtë vit.","pg005_n0008":"Kemi punuar me shumë kujdes që të sjellim një libër të përshtatshëm për ju, pasi, tashmë, jeni një vit më të rritur dhe dëshironi të dini edhe më shumë.","pg005_n0009":"Ky libër, sikurse dhe librat tanë të mëparshëm, është i thjeshtë dhe do t'ju mësojë shumë gjëra të reja.","pg005_n0011":"Libri do t'ju ndihmojë që të mësoni më shumë për grupet shoqërore dhe si të krijoni marrëdhënie bashkëpunimi me të tjerët, t'i thelloni njohuritë tuaja për të drejtat dhe përgjegjësitë dhe, gjithashtu, do të merrni njohuri për institucionet që janë në shërbimin tuaj.","pg005_n0012":"Nëpërmjet situatave dhe ilustrimeve të ndryshme, do të mësoni ta respektoni diversitetin kulturor, ta vlerësoni mendimin ndryshe, t'i kultivoni tolerancën dhe miqësinë dhe t'i mbështetni të tjerët në rast nevoje.","pg005_n0014":"Në klasën e katërt, do të mësoni se cilët janë hapat që duhet t'i ndiqni gjatë vendimmarrjes në familje, klasë dhe komunitet.","pg005_n0015":"Gjithashtu, do të njiheni me shërbimet që ju ofrojnë disa prej institucioneve në komunitetin tuaj dhe më gjerë.","pg005_n0016":"Së bashku me mësuesin, do ta vizitoni një studio ligjore, ku, mes të tjerash, do të mësoni se si funksionojnë ato.","pg005_n0018":"Po ashtu, ju do të mësoni shumë gjëra për atdheun tonë, Kosovën.","pg005_n0019":"Do të njiheni me rajonet e saj, komunitetet dhe veçoritë e tyre, si dhe me fqinjët e Kosovës.","pg005_n0020":"Do të fitoni njohuri për familjen dikur dhe sot, për fshatin dhe qytetin, për degët e ekonomisë, si dhe për pasuritë tona kombëtare.","pg005_n0022":"Nëpërmjet aktiviteteve të ndryshme, që ju do të organizoni së bashku me mësuesen, do të mësoni si të jeni qytetarë të mirë të vendit.","pg005_n0023":"Organizimi i aktiviteteve të tilla, si “Festojmë Pavarësinë e Kosovës”, do të na bëjnë që të ndihemi krenarë për vendin tonë.","pg005_n0025":"Edhe ky libër ka situata të cilat do të nxisin fantazinë tuaj dhe do të kërkojnë që ju të mbani qëndrimin tuaj.","pg005_n0026":"Do të keni mundësi që të flisni rreth higjienës personale, higjienës në komunitet etj.","pg005_n0027":"Do të njiheni me pasuritë natyrore të Kosovës.","pg005_n0028":"Do të mësoni se si bëhet procesi i riciklimit të mbetjeve.","pg005_n0029":"Nëpërmjet projektit “Ndihmoj për një mjedis të pastër dhe të gjelbër”, do të punoni në grupe e do të ndihmoni për një mjedis të pastër, do të mësoni si t'i mbroni tokën, ujërat, pyjet etj.","pg005_n0031":"Njohuritë që ju kemi dhënë nga viti në vit kanë ardhur duke u shtuar, me qëllim që t'u përshtaten kërkesave tuaja, gjithnjë në rritje.","pg005_n0032":"Autoret","pg006_n0002":"Unë po rritem","pg006_n0004":"Situata 1.","pg006_n0006":"Unë jam Linda.","pg006_n0007":"Jam në klasën e katërt.","pg006_n0008":"Prindërit çdo ditë më thonë: “Linda, ti po rritesh dhe po bëhesh vajzë e mbarë!”.","pg006_n0009":"Po ju tregoj se pse ata mendojnë kështu.","pg006_n0010":"Më besoni, nuk po mburrem, vetëm dua të ndaj këtë kënaqësi me ju, moshatarët e mi.","pg006_n0011":"Tani unë kam krijuar shprehitë e mia.","pg006_n0012":"Çdo mëngjes pastrohem, rregulloj dhomën time, vishem dhe mbath këpucët e përshtatshme për stinën.","pg006_n0013":"Ushqehem me orar dhe me ushqime të shëndetshme.","pg006_n0014":"Shkoj në shkollë pasi t`i kem kryer të gjitha detyrat.","pg006_n0015":"Ushtroj balet, sepse është pasioni im.","pg006_n0016":"Po ashtu, vijoj kurse të gjuhëve të huaja, sepse, siç thonë poetët tanë: \"Sa gjuhë di, aq vlen\".","pg006_n0018":"Jashtë, në shkollë, në teatër, në kinema e kudo sillem mirë dhe respektoj rregullat.","pg006_n0019":"Përvojat ditore e sidomos ndonjë shqetësim ose problem i diskutoj me prindërit.","pg006_n0020":"Mos të harroj të përmend se u ndihmoj babait e nënës rreth punëve të shtëpisë.","pg006_n0021":"Më së shumti më pëlqen të gatuaj dhe ta shtroj tryezën e ngrënies.","pg006_n0023":"Në kohën e lirë luaj me shokët e shoqet e mia, argëtohemi me prindërit dhe nganjëherë këqyri televizor.","pg006_n0024":"Afër shtratit gjithmonë mbaj një libër dhe para gjumit lexoj, sepse leximi më qetëson dhe më bën të ëndërroj.","pg006_im001":"Linda duke lexuar një libër në tavolinën e dhomës së saj, pranë krevatit dhe dritares me perde blu.","pg007_n0002":"Unë po rritem","pg007_n0006":"Pse prindërit thonë se Linda është rritur?","pg007_n0008":"Cila sjellje jotja të pëlqen më shumë?","pg007_n0010":"Cila sjellje jotja nuk të pëlqen? Si mendon ta ndryshosh?","pg007_n0012":"Plotëso tabelën e mëposhtme, duke krahasuar veten me Lindën.","pg007_im001":"Linda duke lexuar në tavolinën e dhomës së saj, pranë shtratit dhe dritares.","pg007_n0018":"Unë","pg007_n0020":"Linda","pg007_n0023":"Shprehitë","pg007_n0028":"Ushqimet","pg007_n0033":"Veshjet","pg007_n0038":"Mbathjet","pg007_n0043":"Talenti","pg007_n0048":"Gjuha e huaj","pg007_n0053":"Punët e shtëpisë","pg007_n0058":"Leximi","pg007_n0063":"Sjellja","pg007_n0068":"Respektimi i rregullave","pg007_n0073":"Njeriu lind, zhvillohet, rritet dhe ndryshon vazhdimisht.","pg007_n0074":"Ai pëson ndryshime fizike dhe mendore apo psikike.","pg007_n0075":"Ndryshimi fizik përfshin ndryshimet në peshë dhe gjatësi.","pg007_n0076":"Ndryshimet mendore janë: formimi i shprehive të jetës, aftësia për t'i dalluar veprimet e mira nga ato jo të mira, interesimi për lojën, aftësia për t’u përshtatur në mjedisin ku jeton e zbatimi i rregullave në të, aftësia për të mësuar, përvetësuar dhe zbatuar ato njohuri në jetën e përditshme.","pg007_n0077":"Të gjitha këto arrihen kur fëmija është i rrethuar me njerëz që i ofrojnë dashuri, e udhëzojnë dhe e këshillojnë.","pg007_n0079":"Fjalët kyçe: rritem, shprehi, pasion, sjellje, rregull.","pg008_n0002":"Lidhjet dhe bashkëpunimi me të tjerët","pg008_n0003":"Komuniteti ynë","pg008_n0004":"Situata 1.","pg008_n0006":"Ne jetojmë brenda një komuniteti.","pg008_n0007":"Në lagjen ku jetojmë, kemi përgjegjësi për fqinjët tanë dhe të gjithë banorët e komunitetit.","pg008_n0008":"Që të funksionojë jeta në komunitet dhe të ketë harmoni, ne vendosim së bashku për ndryshimet që do të bëhen në lagjen tonë.","pg008_n0009":"Çdo ndryshim duhet të jetë për të mirën e të gjithëve.","pg008_n0010":"Secili anëtar i komunitetit e ndien veten si pjesëtar aktiv për të gjitha ndryshimet që ndodhin.","pg008_n0011":"Në lagje është një hapësirë e pandërtuar.","pg008_n0012":"Të gjithë po mendonin se për çfarë do ta shfrytëzonin atë hapësirë.","pg008_n0013":"Jepe edhe ti mendimin tënd.","pg008_n0016":"Fjalët kyçe:","pg008_n0017":"komunitet, grup njerëzish, bashkëpunim, mirëkuptim.","pg008_n0020":"Çfarë kupton me fjalën komunitet?","pg008_n0022":"Kush është pjesë e komunitetit?","pg008_n0024":"Cili është qëllimi i përbashkët i komunitetit?","pg008_n0026":"Çfarë ndryshime do të bëje ti në lagjen tënde?","pg008_n0028":"Komuniteti është një grup njerëzish që jetojnë në të njëjtin vend ose bëjnë gjëra të ngjashme.","pg008_n0030":"Njerëzit në një komunitet mund të kenë vlera, zakone, qëllime ose interesa të përbashkët.","pg008_n0032":"Disa komunitete formohen sepse njerëzit jetojnë në vend të njëjtë, lagje, fshat etj., ndërsa disa të tjera formohen, sepse njerëzit punojnë së bashku ose mësojnë në të njëjtën shkollë.","pg008_n0034":"Njerëzit në komunitet ndihmojnë njëri-tjetrin, komunikojnë dhe bashkëpunojnë për nevojat e tyre.","pg008_n0035":"Kështu, ata e lehtësojnë mënyrën e jetesës së tyre dhe ndihen të lumtur.","pg009_n0002":"Lidhjet dhe bashkëpunimi me të tjerët","pg009_n0004":"Komuniteti ynë","pg009_im001":"Banorë të një pallati dhe fëmijë në oborr duke përshëndetur, lexuar, ujitur bimët, u kujdesur për kafshët dhe duke luajtur së bashku në komunitet.","pg010_n0002":"Cilat janë grupet ku bën pjesë Bora?","pg010_n0003":"Po vëllai i Borës, në cilat grupe bën pjesë?","pg010_n0004":"Po ti, në çfarë grupe bën pjesë?","pg010_n0005":"Cili grup të pëlqen më së shumti ty?","pg010_n0006":"A keni krijuar ndonjëherë ndonjë grup? Nëse jo, mendoni tani se çfarë grupi të ri do të mund të krijonit në shkollë.","pg010_n0008":"Lidhjet dhe bashkëpunimi me të tjerët","pg010_n0009":"Grupet shoqërore","pg010_n0011":"Situata 1.","pg010_n0013":"Bora, së bashku me prindërit dhe vëllanë e madh, jeton në Prishtinë.","pg010_n0014":"Ajo është në klasën e katërt.","pg010_n0015":"Në shkollën e saj ka shumë grupe ku fëmijët bashkohen, sepse mendojnë njësoj, kanë dëshira e interesa të njëjtë dhe duan të arrijnë gjëra të përbashkëta.","pg010_n0016":"Këto grupe të shkollës u mundësojnë nxënësve që t'i shprehin aftësitë dhe talentet e tyre të ndryshme.","pg010_n0017":"Bora është pjesëtare e grupit të vallëzimit dhe atij të recitimit.","pg010_n0018":"Ndërsa, vëllai i saj është pjesëtar i grupit të futbollit dhe atij të pikturës.","pg010_n0019":"Në këto grupe, ata mësojnë shumë gjëra të reja, duke bashkëpunuar me njëri-tjetrin.","pg010_im002":"Fëmijë të veshur me kostume tradicionale vallëzojnë së bashku në rreth, të kapur për dore.","pg010_n0022":"Njeriu është qenie që jeton dhe punon me të tjerët.","pg010_n0023":"Ai është gjithmonë pjesë e ndonjë grupi shoqëror, si për shembull: familje, grup i shokëve e shoqeve në shkollë, grup i shokëve e shoqeve në vendin e punës etj.","pg010_n0025":"Grupi shoqëror përbëhet nga dy ose më shumë njerëz që bëjnë diçka së bashku, si për shembull: kanë qëllime të ngjashme, kanë nevoja dhe interesa të njëjtë, mendojnë njësoj, ose kanë të njëjtin profesion.","pg010_n0027":"Njeriu mund të jetë pjesë e shumë grupeve në të njëjtën kohë.","pg010_n0028":"Për shembull, ai është pjesë e familjes, i klasës në shkollë, i lagjes ku banon, i një grupi të sportit, të këndimit ose të vallëzimit etj.","pg010_n0030":"Në të kaluarën, njerëzit nuk kishin të njëjtat ide dhe grupe si sot.","pg010_n0031":"Sot ka shumë më shumë grupe, sepse janë zhvilluar teknologjia, ekonomia dhe mënyra se si jetojmë.","pg010_n0034":"Fjalët kyçe:","pg010_n0035":"grup shoqëror, dikur, sot, qëllim i përbashkët.","pg011_n0002":"Lidhjet dhe bashkëpunimi me të tjerët","pg011_n0004":"Grupet shoqërore","pg011_im001":"Tre fëmijë vallëzojnë të lumtur së bashku, me duart lart dhe nota muzikore përreth.","pg011_im002":"Një djalë me këmbën mbi topin e futbollit dhe një vajzë përballë tij në një fushë me bar.","pg012_n0002":"Lidhjet dhe bashkëpunimi me të tjerët","pg012_n0003":"E mira jonë e përbashkët","pg012_n0005":"Situata 1.","pg012_n0007":"Ishin festat e fundvitit.","pg012_n0008":"Moti i ftohtë i fundvitit nxiti fëmijët e shkollës që të mendonin për fëmijët në nevojë.","pg012_n0009":"Nën moton “Dhurojmë copëza lumturie”, nxënësit organizuan një aktivitet bamirësie.","pg012_n0010":"Secili fëmijë, sipas mundësive, do të sillte diçka që do t'u dhurohej fëmijëve në nevojë.","pg012_n0011":"Mund të ishin rroba që fëmijët nuk i përdornin më, mund të ishte ndonjë shall apo doreza, ndonjë fletore apo mjet tjetër shkollor, ndonjë produkt higjienik apo çfarëdo tjetër që do t'i lehtësonte ditët e ftohta të dimrit.","pg012_n0012":"Të gjithë kishin sjellë dhurata të bukura.","pg012_n0013":"Ata po diskutonin me njëri-tjetrin për dhuratat që i kishin përgatitur me shumë dashuri për fëmijët në nevojë.","pg012_im001_crop_v1":"Dy nxënëse në korridorin e shkollës po sjellin kuti me dhurata, ndërsa pako të tjera janë mbledhur për t’u dhuruar fëmijëve në nevojë.","pg012_n0015":"– Çfarë kuptoni me shprehjen “Dhurojmë copëza lumturie”?","pg012_n0016":"– Cili ishte motivi i fëmijëve për të organizuar një aktivitet bamirësie?","pg012_n0017":"– Çfarë të bën ty të lumtur?","pg012_n0018":"– A ke pasur mundësi ndonjëherë që ti ta bësh dikë të lumtur duke e ndihmuar?","pg012_n0021":"E mira jonë e përbashkët është fakti që ne kujdesemi dhe mendojmë për njëri-tjetrin.","pg012_n0022":"Këtë e quajmë humanizëm.","pg012_n0023":"Pra, humanizmi është kur mendojmë për nevojat e të tjerëve dhe duam t’i ndihmojmë, pa kërkuar shpërblim.","pg012_n0025":"Ne tregojmë humanizëm kur jemi të sjellshëm, të durueshëm dhe kur ndihmojmë dikë që ka nevojë.","pg012_n0026":"Humanizëm do të thotë të vëmë njeriun dhe ndjenjat e tij në rend të parë.","pg012_n0029":"Fjalët kyçe:","pg012_n0030":"dashuri, ndihmë, buzëqeshje, përkrahje.","pg013_n0002":"Lidhjet dhe bashkëpunimi me të tjerët","pg013_n0003":"Së bashku ia dalim","pg013_n0005":"Situata 1.","pg013_n0007":"Ishin ditët e fundit të gushtit, kur Lisi po rregullonte dhomën e tij të gjumit para fillimit të vitit shkollor.","pg013_n0008":"Do ta fillonte klasën e katërt dhe kjo e bënte më përgjegjës ndaj gjërave të tij.","pg013_n0009":"Lisi është idhtar i ripërdorimit dhe i riciklimit dhe ai çdo vit shikon se çfarë i ka mbetur nga viti i kaluar shkollor për t’i përdorur në vitin e ardhshëm.","pg013_n0010":"Mirëpo, diçka që nuk i duhej më, por që kishin shumë vlerë për të, ishin librat e tij të parë.","pg013_n0011":"Mendoi t’i vendoste diku në shtëpi për t’i ruajtur, por e dinte që kështu nuk bënte mirë për askënd.","pg013_n0012":"Kur bisedoi me prindërit për këtë çështje, ata i dhanë një ide të shkëlqyeshme.","pg013_n0013":"- Pse nuk mbledh libra edhe nga shokët e klasës dhe të krijoni bibliotekën e klasës? - ishte ideja e përbashkët e prindërve.","pg013_n0014":"Lisi u lumturua shumë nga kjo ide.","pg013_n0015":"E mendonte sa mirë do të bëhej kur të gjithë fëmijët e klasës do të mblidhnin librat e tyre dhe t’i shkëmbenin me njëri-tjetrin.","pg013_im002":"Lisi mban në duar një grumbull librash pranë rafteve të mbushura me libra, ndërsa prindërit e tij shihen në sfond në shtëpi.","pg013_n0019":"Sa e vlerëson bashkëpunimin me të tjerët për të bërë një veprim të mirë për komunitetin?","pg013_n0021":"Si përfiton komuniteti nga veprimi i Lisit me shokët?","pg013_n0023":"A ke bërë ndonjëherë ndonjë aktivitet/veprim për të mirën e të tjerëve?","pg013_n0025":"Si e vlerëson idenë e prindërve të Lisit për krijimin e bibliotekës së klasës?","pg013_n0027":"Sa është e rëndësishme që shkollat të kenë biblioteka?","pg013_n0030":"Njerëzit dallojnë nga njëri-tjetri.","pg013_n0031":"Ata jetojnë në familje, mjedise të ndryshme, kanë edukatë dhe kultura të ndryshme.","pg013_n0032":"Kështu që, secili njeri ka mendimet e veta.","pg013_n0033":"Nëse respektojmë kulturat dhe mendimet e të tjerëve dhe i shkëmbejmë ato në mes nesh, atëherë çdo punë bëhet më mirë dhe ne bëhemi më të ditur, pasi përfitojmë shumë nga të tjerët.","pg013_n0034":"Punë në ekip do të thotë kur disa persona punojnë së bashku për të arritur një qëllim të përbashkët ose për të kryer një detyrë sa më mirë.","pg013_n0035":"Puna në ekip nuk njeh moshë.","pg013_n0036":"Ajo është e njëjtë për të gjitha moshat.","pg013_n0037":"Anëtarët e grupit ndajnë në mënyrë të barabartë përgjegjësitë dhe detyrat e tyre.","pg013_n0038":"Fjalët kyçe: bashkëpunim, kujdes, ndërveprim, vlerësim.","pg014_n0002":"Lidhjet dhe bashkëpunimi me të tjerët","pg014_n0004":"Veprimtaria 1: “Puna vullnetare na bashkon”","pg014_n0006":"Nxënësit e klasës ndahen në dy grupe.","pg014_n0007":"Secilit grup i caktohet detyra që do të kryejë dhe përgjegjësitë që do të marrin nxënësit për të realizuar aktivitetin.","pg014_n0008":"Nxënësit udhëzohen se si do të veprojnë për të përmbushur sa më mirë detyrimet që kanë.","pg014_im001_seg001_v1":"Kek i vogël me krem rozë, spërkatëse shumëngjyrëshe dhe dy shkopinj dekorues.","pg014_n0010":"Grupi i parë:","pg014_n0011":"Do të përgatitë ëmbëlsira në shtëpi.","pg014_im001_seg002_v1":"Kartolinë e kaltër e zbukuruar me dy lule shumëngjyrëshe në ballinë.","pg014_n0013":"Grupi i dytë:","pg014_n0014":"Do të përgatitë kartolina të bukura (pa shkrim brenda), të dekoruara me materiale të ndryshme ricikluese.","pg014_n0017":"Ëmbëlsirat dhe kartolinat shitni në një kënd brenda shkollës.","pg014_n0018":"Paratë që do të mblidhen nga shitja e tyre, përdorini për t’u ardhur në ndihmë nxënësve të një shkolle tjetër, që kanë nevojë për pajisje dhe mjete të tjera ndihmëse.","pg015_n0002":"Secili ka të drejta dhe përgjegjësi","pg015_n0004":"Të drejtat dhe përgjegjësitë e mia","pg015_n0006":"Situata 1.","pg015_n0008":"Në klasë, gjatë pushimit midis orëve, mblidhemi dhe diskutojmë për probleme të ndryshme.","pg015_n0009":"Mësuesja na këshillon që të mos bëjmë zhurmë, pasi kështu shqetësojmë të tjerët.","pg015_n0010":"Po ashtu, ajo theksoi se duhet të tregohemi të kujdesshëm kur lëvizim në klasë, pasi mund të lëndojmë njëri-tjetrin.","pg015_n0011":"- Ne kemi të drejtën e arsimimit, por edhe përgjegjësinë për njohjen dhe respektimin e rregullave në shkollë, - tha mësuesja.","pg015_n0013":"Detyra juaj është të mësoni shumë, që të 