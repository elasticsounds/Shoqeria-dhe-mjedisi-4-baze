r and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"12\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"lesson-discussion\" id=\"content\" class=\"container opacity-0 bk\">\n  <section data-section-type=\"boxed_text\" data-section-id=\"pg007_sec002\" class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-8 bg-white\">\n    <div class=\"rounded-2xl border-2 border-purple-300 bg-purple-50 p-6 shadow-sm\">\n      <p class=\"adt-body italic text-gray-800 leading-relaxed\">\n        <span data-id=\"pg007_n0073\">Njeriu lind, zhvillohet, rritet dhe ndryshon vazhdimisht.</span>\n        <span data-id=\"pg007_n0074\">Ai pëson ndryshime fizike dhe mendore apo psikike.</span>\n        <span data-id=\"pg007_n0075\">Ndryshimi fizik përfshin ndryshimet në peshë dhe gjatësi.</span>\n        <span data-id=\"pg007_n0076\">Ndryshimet mendore janë: formimi i shprehive të jetës, aftësia për t'i dalluar veprimet e mira nga ato jo të mira, interesimi për lojën, aftësia për t’u përshtatur në mjedisin ku jeton e zbatimi i rregullave në të, aftësia për të mësuar, përvetësuar dhe zbatuar ato njohuri në jetën e përditshme.</span>\n        <span data-id=\"pg007_n0077\">Të gjitha këto arrihen kur fëmija është i rrethuar me njerëz që i ofrojnë dashuri, e udhëzojnë dhe e këshillojnë.</span>\n      </p>\n    </div>\n    <div class=\"mt-8 border-t-4 border-purple-400 pt-5\">\n      <h1 class=\"adt-h4 font-semibold text-gray-900\" data-id=\"pg007_n0079\">Fjalët kyçe: rritem, shprehi, pasion, s