" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"illustrated-reading\" id=\"content\" class=\"container opacity-0 bk\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg085_sec001\" class=\"w-full bg-white overflow-hidden\">\n    <div class=\"w-full pt-8\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5\">\n        <div class=\"relative mb-6\">\n          <div class=\"h-12 bg-purple-500\"></div>\n          <div class=\"absolute right-8 top-[-14px] h-28 w-36 rounded-md bg-purple-500 max-sm:hidden\"></div>\n        </div>\n        <h1 class=\"adt-h2 font-bold text-left text-neutral-900\" data-id=\"pg085_n0004\">Institucionet kulturore</h1>\n        <div aria-hidden=\"true\" class=\"mt-3 h-1 w-96 max-sm:w-44 bg-purple-400\"></div>\n      </div>\n    </div>\n\n    <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-8 space-y-6\">\n      <div class=\"border-2 border-purple-300 bg-white p-5 max-sm:p-4 shadow-sm\">\n        <p class=\"adt-body text-left italic leading-relaxed text-neutral-800\">\n          <span data-id=\"pg085_n0007\">Institucionet kulturore janë vende ku njerëzit mësojnë për kulturën, historinë, traditën, artin etj.</span>\n          <span data-id=\"pg085_n0008\">Në këto vende ruhen, prezantohen dhe shpjegohen gjërat e vlefshme, si: zakonet, veprat artistike, librat, filmat dhe shumë të tjera.</span><br>\n          <span data-id=\"pg085_n0009\">Ato përbëhen nga: muzetë, teatrot, kinematë, bibliotekat, galeritë etj.</span><br>\n          <span data-id=\"pg085_n0010\">Këto institucione u mundësojnë njerëzve të mësojnë dhe të njihen me kulturën e vendit të tyre.</span><br>\n          <span data-id=\"pg085_n0011\">Njerëzit që duan të mësojnë për historinë e një vendi vizitojnë muzetë.</span><br>\n          <span data-id=\"pg085_n0012\">Në teatro luhen shfaqjet, ku shikojmë aktorët në skenë, kurse në kinema shfaqen filma të ndryshëm.</span><br>\n          <span data-id=\"pg085_n0013\">Në biblioteka, lexuesit shfrytëzojnë libra të ndryshëm dhe në galeri shkojnë njerëzit të cilëve u pëlqejnë ekspozitat artistike (p.sh.: piktura).</span>\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-2 gap-4 max-sm:grid-cols-1\">\n        <figure class=\"bg-white\">\n          <img data-id=\"pg085_im002\" src=\"images/pg085_im002.png\" alt=\"Hyrja e Teatrit Kombëtar në Prishtinë, me shkallët dhe mbishkrimin e madh në ballinë.\" class=\"w-full h-auto border-2 border-purple-300 shadow-sm\">\n          <figcaption class=\"adt-caption text-center font-semibold text-neutral-800 mt-3\" data-id=\"pg085_n0015\">Teatri Kombëtar – Prishtinë</figcaption>\n        </figure>\n\n        <figure class=\"bg-white\">\n          <img data-id=\"pg085_im001\" src=\"images/pg085_im001.png\" alt=\"Ndërtesa e Galerisë së Arteve në Prishtinë, me hapësirë të gjelbër përpara dhe pallate në sfond.\" class=\"w-full h-auto border-2 border-purple-300 shadow-sm\">\n          <figcaption class=\"adt-caption text-center font-semibold text-neutral-800 mt-3\" data-id=\"pg085_n0017\">Galeria e Arteve – Prishtinë</figcaption>\n        </figure>\n      </div>\n\n      <figure class=\"max-w-3xl mx-auto w-full\">\n        <img data-id=\"pg085_im003\" src=\"images/pg085_im003.png\" alt=\"Biblioteka Kombëtare “Pjetër Bogdani” në Prishtinë, me arkitekturë karakteristike, kupola të bardha dhe fasadë rrjetëzuese.\" class=\"w-full h-auto border-2 border-purple-300 shadow-sm\">\n        <figcaption class=\"adt-caption text-center font-semibold text-neutral-800 mt-4\" data-id=\"pg085_n0019\">Biblioteka Kombëtare “Pjetër Bogdani“ – Prishtinë</figcaption>\n      </figure>\n\n      <p class=\"adt-body text-left text-neutral-800 pt-3 mt-4 border-t border-purple-200\">\n        <span data-id=\"pg085_n0020\">Fjalët kyçe: institucion kulturor, galeri, teatër, bibliotekë.</span>\n      </p>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg086_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg086_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"119\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"illustrated-reading\" id=\"content\" class=\"container opacity-0 bk\"><section data-section-type=\"text_and_single_image\" data-section-id=\"pg086_sec001\" class=\"w-full bg-white\"><div class=\"w-full bg-[#b06ab3]\"><div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-8\"><div class=\"flex items-center gap-6 max-sm:gap-4\"><div aria-hidden=\"true\" class=\"shrink-0 w-28 h-28 max-sm:w-20 max-sm:h-20 rounded-2xl bg-[#a665ab] border-4 border-white/20 flex items-center justify-center\"><div class=\"w-16 h-16 max-sm:w-12 max-sm:h-12 rounded-full border-4 border-white\"></div></div><div class=\"flex-1\"><h1 class=\"adt-h3 text-left font-bold text-white\" data-id=\"pg086_n0002\">Traditat dhe trashëgimia jonë</h1><div class=\"mt-4 inline-block bg-white px-4 py-3 rounded-r-2xl shadow-sm\"><h2 class=\"adt-h2 text-left font-semibold text-gray-900\" data-id=\"pg086_n0004\">Veshjet tradicionale</h2></div><div aria-hidden=\"true\" class=\"mt-3 h-1 w-64 max-sm:w-40 bg-white/80 rounded-full\"></div></div></div></div></div><div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-10\"><div class=\"mb-6\"><h3 class=\"adt-h3 inline-block text-left font-bold text-gray-900 bg-[#78c47f] px-4 py-2 rounded-md shadow-sm\" data-id=\"pg086_n0006\">Situata 1.</h3></div><p class=\"adt-body text-left text-gray-800 leading-relaxed mb-4\"><span data-id=\"pg086_n0008\">Klea me prindërit kishin vendosur të kalonin një fundjavë në Bjeshkët e Nemuna, në Bogë.</span> <span data-id=\"pg086_n0009\">Ai vend aq i bukur me natyrë mbresëlënëse, Kleas i ofronte qetësi e kënaqësi.</span> <span data-id=\"pg086_n0010\">Ndërkohë që po ktheheshin nga pushimi i shkurtër, Klea po u thoshte prindërve që këto male ishin shumë të bukura.</span></p><p class=\"adt-body text-left text-gray-800 leading-relaxed mb-4\"><span data-id=\"pg086_n0012\">Nëna e Kleas, që çmonte shumë traditën e popullit tonë, shtoi se ky vend, përveçqë kishte reliev të mrekullueshëm, kishte dhe shumë veçori të tjera që e bënin kaq të bukur.</span></p><p class=\"adt-body text-left text-gray-800 leading-relaxed mb-8\"><span data-id=\"pg086_n0014\">Nëna filloi të tregonte për veshjen tradicionale të Rugovës dhe, ndërkohë që po fliste për ngjyrat e kësaj veshjeje, punën e dorës e të tjera, Klea mrekullohej dhe vendosi që të kërkonte në internet këto veshje e të bënte një prezantim për to para klasës.</span> <span data-id=\"pg086_n0015\">Ajo donte që të nxiste dhe shokët e shoqet e klasës që të njihnin veshjet tradicionale të trevave të Kosovës, sepse pothuajse çdo vend ka veshjen e vet karakteristike.</span></p><figure class=\"clear-both\"><div class=\"rounded-none border-4 border-[#7dc97f] overflow-hidden shadow-lg bg-white\"><img data-id=\"pg086_im001\" src=\"images/pg086_im001.png\" alt=\"Pamje panoramike e Bjeshkëve e Nemuna në Rugovë, me maja të thepisura shkëmbore, lugina të thella dhe shpatet me gjelbërim nën qiell të kthjellët.\" class=\"w-full h-auto block\"></div><figcaption class=\"adt-caption text-center font-semibold text-gray-900 mt-4\" data-id=\"pg086_n0017\">Bjekshët e Nemuna - Rugovë</figcaption></figure></div></section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg087_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg087_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"120\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"lesson-discussion\" id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-2 py-8 bg-white opacity-0 bk\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg087_sec001\" class=\"w-full text-gray-900\">\n    <div class=\"mb-5 flex items-stretch\">\n      <div class=\"flex-1 bg-purple-500 px-6 py-4 flex items-center\">\n        <h1 class=\"adt-h3 text-left font-bold text-white\" data-id=\"pg087_n0002\">Traditat dhe trashëgimia jonë</h1>\n      </div>\n      <div class=\"w-28 bg-purple-500 ml-4 rounded-md max-sm:hidden\"></div>\n    </div>\n\n    <div class=\"mb-6 max-w-2xl\">\n      <h2 class=\"adt-h2 text-left font-bold text-gray-800 mb-2\" data-id=\"pg087_n0004\">Veshjet tradicionale</h2>\n      <div class=\"h-1 w-56 bg-purple-400 max-sm:w-36\"></div>\n    </div>\n\n    <aside class=\"mb-4 bg-purple-100 border border-purple-200 px-4 py-4 max-sm:px-2 max-sm:py-3\">\n      <div class=\"flex justify-end mb-2\">\n        <div class=\"bg-purple-500 text-white px-6 py-2 leading-none max-sm:px-3 max-sm:py-1\">\n          <span class=\"adt-h2 leading-none\" data-id=\"pg087_n0006\">?</span>\n        </div>\n      </div>\n      <div class=\"space-y-5 max-sm:space-y-4\">\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0009\">Çfarë rëndësie kanë veshjet tradicionale?</span></div>\n          <label for=\"item-1\" class=\"sr-only\">Çfarë rëndësie kanë veshjet tradicionale?</label>\n          <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Çfarë rëndësie kanë veshjet tradicionale?\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0011\">Përmend dy gjëra të veçanta që Klea i mësoi në këtë udhëtim.</span></div>\n          <label for=\"item-2\" class=\"sr-only\">Përmend dy gjëra të veçanta që Klea i mësoi në këtë udhëtim.</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Përmend dy gjëra të veçanta që Klea i mësoi në këtë udhëtim.\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0013\">A keni dëgjuar për ndonjë veshje tjetër tradicionale?</span> <span data-id=\"pg087_n0014\">Diskutoni së bashku.</span></div>\n          <label for=\"item-3\" class=\"sr-only\">A keni dëgjuar për ndonjë veshje tjetër tradicionale? Diskutoni së bashku.</label>\n          <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"A keni dëgjuar për ndonjë veshje tjetër tradicionale? Diskutoni së bashku.\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0016\">A keni ndonjë veshje tradicionale?</span></div>\n          <label for=\"item-4\" class=\"sr-only\">A keni ndonjë veshje tradicionale?</label>\n          <input id=\"item-4\" type=\"text\" data-activity-item=\"item-4\" aria-label=\"A keni ndonjë veshje tradicionale?\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\">\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0018\">Pse është e rëndësishme të njohim dhe të veshim rrobat tradicionale të vendit tonë?</span></div>\n          <label for=\"item-5\" class=\"sr-only\">Pse është e rëndësishme të njohim dhe të veshim rrobat tradicionale të vendit tonë?</label>\n          <textarea id=\"item-5\" data-activity-item=\"item-5\" aria-label=\"Pse është e rëndësishme të njohim dhe të veshim rrobat tradicionale të vendit tonë?\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n\n        <div>\n          <div class=\"adt-body text-gray-800\"><span data-id=\"pg087_n0020\">Vishuni me rroba tradicionale dhe bëni ekspozitë në shkollë.</span> <span data-id=\"pg087_n0021\">Tregoni si u ndiet.</span></div>\n          <label for=\"item-6\" class=\"sr-only\">Vishuni me rroba tradicionale dhe bëni ekspozitë në shkollë. Tregoni si u ndiet.</label>\n          <textarea id=\"item-6\" data-activity-item=\"item-6\" aria-label=\"Vishuni me rroba tradicionale dhe bëni ekspozitë në shkollë. Tregoni si u ndiet.\" class=\"mt-2 w-full min-h-11 rounded-xl border border-purple-300 px-4 py-3 bg-white text-gray-800\"></textarea>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"mb-8 border border-purple-400 px-4 py-4 bg-white\">\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0024\">Kostumet popullore janë veshje tradicionale që janë përdorur nga njerëzit në të kaluarën dhe që trashëgohen brez pas brezi.</span></p>\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0026\">Secili rajon i një vendi dhe secili shtet ka veshjet tradicionale të tij, p.sh.: veshja e Rugovës, e Hasit, e Tropojës etj.</span></p>\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0028\">Veshja popullore e grave të Hasit ka karakteristikë përdorimin e dërrasës, e cila mbulohet me veshje me motive dekorative, me ngjyra të ndryshme, ku mbizotëron e kuqja.</span> <span data-id=\"pg087_n0029\">Po ashtu, interesante është veshja e grave të Rugovës, e përbërë nga këmisha me mëngë të shkurtra prej pëlhure.</span></p>\n      <p class=\"adt-body text-left text-gray-800 mb-3 italic\"><span data-id=\"pg087_n0031\">Çdo veshje ka një histori dhe karakterizohet nga elemente të veçanta që e veçojnë nga veshjet e tjera të një treve, të një krahine apo të një rajoni.</span> <span data-id=\"pg087_n0032\">Veshjet popullore janë shumë të kërkuara për ditët e festave dhe për ahengje të ndryshme.</span></p>\n      <p class=\"adt-body text-left text-gray-800 italic\"><span data-id=\"pg087_n0034\">Veshjet e grave karakterizohen me qëndisje dhe ngjyra të ndryshme, kurse veshjet e burrave kryesisht janë punime leshi: tirq, këmishë, jelek dhe plisi që e karakterizon burrin tradicional shqiptar.</span></p>\n    </div>\n\n    <div class=\"mb-8 grid grid-cols-3 gap-x-10 gap-y-8 justify-items-center max-lg:grid-cols-2 max-sm:grid-cols-1 max-sm:gap-y-6\">\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center\">\n        <img src=\"images/pg087_im008_seg001_v1_crop_v1.png\" alt=\"Grua dhe burrë me veshje tradicionale të Rugovës, me qëndisje shumëngjyrëshe, përparëse të kuqe dhe plis të bardhë.\" data-id=\"pg087_im008_seg001_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0036\">Veshje e Rugovës</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center\">\n        <img src=\"images/pg087_im008_seg002_v1_crop_v1.png\" alt=\"Dy kostume tradicionale të Drenicës me xhamadan të errët, brez të kuq dhe tirq.\" data-id=\"pg087_im008_seg002_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0038\">Veshje e Drenicës</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center max-lg:col-span-2 max-lg:justify-self-center max-sm:col-span-1\">\n        <img src=\"images/pg087_im008_seg003_v1.png\" alt=\"Veshje tradicionale e Hasit, e zbukuruar me motive të dendura shumëngjyrëshe dhe stoli në pjesën e sipërme.\" data-id=\"pg087_im008_seg003_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0040\">Veshje e Hasit</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center max-lg:justify-self-end max-sm:justify-self-center\">\n        <img src=\"images/pg087_im008_seg004_v1_crop_v1.png\" alt=\"Xhubletë e zezë me brez dhe vija rozë, me fund të valëzuar tradicional.\" data-id=\"pg087_im008_seg004_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0042\">Xhubleta</figcaption>\n      </figure>\n\n      <figure class=\"w-full max-w-[260px] flex flex-col items-center max-lg:justify-self-start max-sm:justify-self-center\">\n        <img src=\"images/pg087_im008_seg005_v1_crop_v1.png\" alt=\"Dy veshje tradicionale të Tropojës me jelek të zi, këmishë të bardhë të qëndisur, fund të kuq dhe përparëse të bardhë.\" data-id=\"pg087_im008_seg005_v1_crop_v1\" class=\"w-full h-auto border-2 border-green-300 bg-white\">\n        <figcaption class=\"adt-caption text-center text-gray-800 mt-2\" data-id=\"pg087_n0044\">Veshje e Tropojës</figcaption>\n      </figure>\n    </div>\n\n    <p class=\"adt-body text-left text-gray-900\"><span class=\"font-bold\" data-id=\"pg087_n0046\">Fjalët kyçe:</span> <span data-id=\"pg087_n0047\">veshje tradicionale, traditë, kulturë, zakon.</span></p>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js