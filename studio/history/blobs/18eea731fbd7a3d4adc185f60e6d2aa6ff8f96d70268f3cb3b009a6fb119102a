purple-200 max-sm:ml-0 max-sm:px-5 max-sm:py-5\">\n    <div aria-hidden=\"true\" class=\"absolute right-0 top-5 flex h-16 w-20 items-center justify-center bg-purple-500 font-bold text-white max-sm:top-auto max-sm:bottom-5 max-sm:left-5 max-sm:right-auto max-sm:h-14 max-sm:w-16\">?</div>\n    <div class=\"space-y-6 pr-28 max-sm:pr-0 max-sm:pb-20\">\n      <div>\n        <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg089_n0010\">Pse është e rëndësishme të zbukurohet ambienti për një festë të caktuar?</span></p>\n        <label for=\"item-1\" class=\"sr-only\">Pse është e rëndësishme të zbukurohet ambienti për një festë të caktuar?</label>\n        <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Pse është e rëndësishme të zbukurohet ambienti për një festë të caktuar?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n      </div>\n\n      <div>\n        <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg089_n0012\">Si duhet të veprojmë gjatë festës, në të cilën jemi të ftuar?</span></p>\n        <label for=\"item-2\" class=\"sr-only\">Si duhet të veprojmë gjatë festës, në të cilën jemi të ftuar?</label>\n        <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Si duhet të veprojmë gjatë festës, në të cilën jemi të ftuar?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n      </div>\n\n      <div>\n        <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg089_n0015\">Si duhet të veprojmë gjatë një feste, në të cilën jemi mikpritësit?</span></p>\n        <label for=\"item-3\" class=\"sr-only\">Si duhet të veprojmë gjatë një feste, në të cilën jemi mikpritësit?</label>\n        <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Si duhet të veprojmë gjatë një feste, në të cilën jemi mikpritësit?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n      </div>\n\n      <div>\n        <p class=\"adt-body text-left text-gray-900\"><span data-id=\"pg089_n0017\">Cila festë ju pëlqen më shumë dhe pse?</span></p>\n        <label for=\"item-4\" class=\"sr-only\">Cila festë ju pëlqen më shumë dhe pse?</label>\n        <textarea id=\"item-4\" data-activity-item=\"item-4\" aria-label=\"Cila festë ju pëlqen më shumë dhe pse?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-purple-300 bg-white px-4 py-3 outline-none focus:border-purple-500\"></textarea>\n      </div>\n    </div>\n  </aside>\n</section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg089_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg089_sec002\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"123\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <h1 class=\"sr-only\" id=\"page-heading\">Shoqëria dhe Mjedisi 4</h1>\n      <div data-family=\"lesson-discussion\" id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 bk\">\n  <section data-section-type=\"text_only\" data-section-id=\"pg089_sec002\" class=\"bg-white py-8\">\n    <div class=\"rounded-sm border-2 border-purple-300 bg-white shadow-sm overflow-hidden\">\n      <div class=\"flex items-stretch max-lg:flex-col\">\n        <div class=\"flex-1 p-6 max-sm:p-4\">\n          <p class=\"adt-body italic leading-relaxed text-gray-800\">\n            <span data-id=\"pg089_n0021\">Festa është një ditë që veçohet nga të tjerat, sepse lidhet me një ngjarje të caktuar gazmore.</span>\n            <span data-id=\"pg089_n0022\">Dita e festës dallon nga ditët e tjera sepse përgatitet ushqim më i veçantë, veshjet dallojnë nga ato të përditshmet etj.</span>\n            <span data-id=\"pg089_n0023\">Gjatë ditëve të festave, jemi të lumtur dhe festojmë së bashku me prindërit, kushërinjtë, miqtë dhe shokët.</span>\n            <span data-id=\"pg089_n0024\">Zakonisht gjatë festave marrim dhe japim dhurata, vallëzojmë, këndojmë etj.</span>\n          </p>\n\n          <p class=\"adt-body italic leading-relaxed text-gray-800 mt-4\">\n            <span data-id=\"pg089_n0026\">Festat mund të jenë individuale, familjare, shtetërore, kombëtare, ndërkombëtare, fetare etj.</span>\n            <span data-id=\"pg089_n0027\">Festat individuale janë festa që i takojnë një individi, p.sh., festa e ditëlindjes.</span>\n            <span data-id=\"pg089_n0028\">Festat shtetërore janë festa që feston një shtet, p.sh., Pavarësia e Kosovës.</span>\n            <span data-id=\"pg089_n0029\">Festa kombëtare është festë që feston një komb, një popull kudo që ndodhet, p.sh., të gjithë shqiptarët që jetojnë nëpër vende të ndryshme të botës festojnë Pavarësinë e Shqipërisë.</span>\n          </p>\n\n          <p class=\"adt-body italic leading-relaxed text-gray-800 mt-4\">\n            <span data-id=\"pg089_n0031\">Festa ndërkombëtare është festë që festohet në të gjithë botën, p.sh. Dita e Gruas.</span>\n          </p>\n        </div>\n        <div class=\"w-28 bg-purple-500 flex items-start justify-center pt-4 max-lg:w-full max-lg:h-20 max-lg:pt-0 max-lg:items-center\" aria-hidden=\"true\">\n          <div class=\"h-14 w-10 rounded-sm border-2 border-white bg-white/90 shadow-md relative\">\n            <div class=\"absolute -right-1 top-2 h-0 w-0 border-y-[6px] border-l-[10px] border-y-transparent border-l-white\"></div>\n            <div class=\"absolute inset-x-1 bottom-1 h-1 rounded-full bg-purple-200\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg090_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg090_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"124\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"illustrated-reading\" id=\"content\" class=\"container opacity-0 bk\"><section data-section-type=\"text_and_images\" data-section-id=\"pg090_sec001\" class=\"mx-auto w-full max-w-5xl bg-white px-8 py-8 text-slate-800 max-sm:px-4\">\n  <div class=\"mb-10 overflow-hidden rounded-l-[2rem] bg-[#a868b0]\">\n    <div class=\"flex items-center gap-6 px-8 py-8 max-sm:items-start max-sm:gap-4 max-sm:px-4 max-sm:py-5\">\n      <div aria-hidden=\"true\" class=\"flex h-28 w-28 shrink-0 items-center justify-center rounded-sm bg-[#a868b0] max-sm:h-20 max-sm:w-20\">\n        <div class=\"h-24 w-16 rounded-[1.5rem] border-4 border-white max-sm:h-14 max-sm:w-12\"></div>\n      </div>\n      <div class=\"min-w-0 flex-1 pt-1\">\n        <h1 data-id=\"pg090_n0002\" class=\"adt-h3 mb-4 font-semibold text-white\">Traditat dhe trashëgimia jonë</h1>\n        <div class=\"inline-block bg-white px-4 py-2\">\n          <h2 data-id=\"pg090_n0003\" class=\"adt-h2 text-slate-900\">Kulturat janë të shumëllojshme</h2>\n        </div>\n        <div aria-hidden=\"true\" class=\"mt-3 h-1 w-72 bg-[#c58acc] max-sm:w-32\"></div>\n      </div>\n    </div>\n  </div>\n\n  <h3 data-id=\"pg090_n0004\" class=\"adt-h3 mb-5 inline-block bg-[#69bb78] px-5 py-2 text-slate-900\">Situata 1.</h3>\n\n  <p class=\"adt-body mb-4 text-left leading-relaxed\">\n    <span data-id=\"pg090_n0006\">Andrra i ftoi të gjithë shokët e shoqet për ditëlindje.</span>\n    <span data-id=\"pg090_n0007\">Jonit, që i pëlqente të ilustronte çdo ngjarje, po i bënte përshtypje fakti që në shtëpinë e Andrrës kishte shumë piktura në mur e shumë libra në bibliotekë.</span>\n    <span data-id=\"pg090_n0008\">Jonin po e mrekullonte fakti që në çdo pikturë burrat mbanin plis në kokë e gratë kishin veshje plot ngjyra.</span>\n    <span data-id=\"pg090_n0009\">Veshjet e tyre ishin të ndryshme nga veshjet e sotme.</span>\n    <span data-id=\"pg090_n0010\">Pikturat tregonin historinë e popullit tonë e librat mbanin emra të autorëve të mëdhenj shqiptarë, si: vëllezërit Frashëri, Gjergj Fishta, Asdreni, Ismail Kadare etj.</span>\n    <span data-id=\"pg090_n0011\">Aty kishte edhe fotografi të Motrës Tone dhe të motrave Qiriazi.</span>\n  </p>\n\n  <p class=\"adt-body mb-4 text-left leading-relaxed\">\n    <span data-id=\"pg090_n0013\">Kur prindërit e Andrrës erdhën për t’i përshëndetur fëmijët, Joni e pyeti mamanë e Andrrës: - A mund të huazoj një nga këta libra që ta lexoj gjatë pushimit të verës?</span>\n    <span data-id=\"pg090_n0014\">Zonjës iu bë qejfi, buzëqeshi lehtë e i tha se këta libra ishin për të rriturit.</span>\n    <span data-id=\"pg090_n0015\">Ajo i premtoi që kur të rritej, do t’ia huazonte të gjithë librat, sepse vetëm kështu do të mund të shikonte se çfarë shkrimesh me vlerë kanë shkruar këta shkrimtarë.</span>\n  </p>\n\n  <p class=\"adt-body mb-8 text-left leading-relaxed\">\n    <span data-id=\"pg090_n0017\">Joni, i mrekulluar, e pyeti: - A janë të gjithë shqiptarë?</span>\n    <span data-id=\"pg090_n0018\">- Po, - tha zonja, - mirëpo për të njohur se sa e bukur është bota dhe sa shumë kultura të ndryshme ekzistojnë, ne duhet t’i lexojmë edhe autorët e huaj.</span>\n    <span data-id=\"pg090_n0019\">Joni u pajtua me këtë mendim dhe iu bashkua shokëve.</span>\n  </p>\n\n  <div class=\"mb-10 grid grid-cols-9 gap-x-3 gap-y-4 max-lg:grid-cols-4 max-sm:grid-cols-2 max-sm:gap-3\">\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im002\" src=\"images/pg090_im002.png\" alt=\"Portret bardhezi i Aleksandër Stavre Drenovës, i veshur me kostum dhe kravatë.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0022\" class=\"adt-caption mt-1 text-center\">Aleksandër Stavre Drenova</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im003_seg001_v1_crop_v1\" src=\"images/pg090_im003_seg001_v1_crop_v1.png\" alt=\"Njëri nga Vëllezërit Frashëri, në portret bardhezi me mjekër të dendur dhe kostum.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0024\" class=\"adt-caption mt-1 text-center\">Vëllezërit Frashëri</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im003_seg002_v1_crop_v1\" src=\"images/pg090_im003_seg002_v1_crop_v1.png\" alt=\"Njëri nga Vëllezërit Frashëri, në portret bardhezi me mjekër dhe papion.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0026\" class=\"adt-caption mt-1 text-center\">Vëllezërit Frashëri</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im003_seg003_v1_crop_v1\" src=\"images/pg090_im003_seg003_v1_crop_v1.png\" alt=\"Njëri nga Vëllezërit Frashëri, në portret bardhezi me mjekër të shkurtër dhe jakë të bardhë.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0028\" class=\"adt-caption mt-1 text-center\">Vëllezërit Frashëri</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im004\" src=\"images/pg090_im004.png\" alt=\"Portret i Gjergj Fishtës i ulur, i veshur me petk fetar të errët.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0030\" class=\"adt-caption mt-1 text-center\">Gjergj Fishta</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im005\" src=\"images/pg090_im005.png\" alt=\"Portret bardhezi i Ismail Kadaresë me syze të mëdha.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0032\" class=\"adt-caption mt-1 text-center\">Ismail Kadare</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im006\" src=\"images/pg090_im006.png\" alt=\"Piktura “Motra Tone”, grua e ulur me veshje tradicionale të bardhë dhe dorën pranë fytyrës.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0034\" class=\"adt-caption mt-1 text-center\">Motra Tone</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im007_seg001_v1_crop_v1\" src=\"images/pg090_im007_seg001_v1_crop_v1.png\" alt=\"Portret bardhezi i njërës prej Motrave Qiriazi, me syze dhe varëse rreth qafës.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0036\" class=\"adt-caption mt-1 text-center\">Motrat Qiriazi</figcaption>\n    </figure>\n    <figure class=\"flex min-w-0 flex-col items-center\">\n      <img data-id=\"pg090_im007_seg002_v1_crop_v1\" src=\"images/pg090_im007_seg002_v1_crop_v1.png\" alt=\"Portret bardhezi i njërës prej Motrave Qiriazi, me flokë të mbledhura lart.\" class=\"h-auto w-full border border-slate-200 bg-slate-50 shadow-sm\">\n      <figcaption data-id=\"pg090_n0038\" class=\"adt-caption mt-1 text-center\">Motrat Qiriazi</figcaption>\n    </figure>\n  </div>\n\n  <aside class=\"mb-6 border-2 border-[#d7a4ea] bg-[#fbf5ff] p-5 italic shadow-sm\">\n    <p class=\"adt-body text-left leading-relaxed\">\n      <span data-id=\"pg090_n0041\">Kultura është gjithçka që një grup njerëzish e kanë të përbashkët, si: mënyra si mendojnë, si sillen, si jetojnë, besimet, zakonet dhe vlerat që ata ndjekin.</span>\n      <span data-id=\"pg090_n0042\">Kultura përfshin gjuhën, fenë, veshjen, ushqimin, muzikën, artin, festat etj.</span>\n      <span data-id=\"pg090_n0043\">Ajo tregon se si është ndërtuar jeta e një populli dhe çfarë gjërash të vlefshme ka krijuar ai me kalimin e kohës.</span>\n    </p>\n  </aside>\n\n  <div class=\"border-l-4 border-[#b46ce0] pl-4 py-1\">\n    <p class=\"adt-body text-left\">\n      <span data-id=\"pg090_n0046\">Fjalët kyçe:</span>\n      <span data-id=\"pg090_n0047\">kulturë, libër, pikturë.</span>\n    </p>\n  </div>\n</section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg090_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg090_sec002\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"125\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/