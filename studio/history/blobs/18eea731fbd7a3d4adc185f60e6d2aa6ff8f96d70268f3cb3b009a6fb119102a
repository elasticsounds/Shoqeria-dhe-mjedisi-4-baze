 max-sm:px-5 opacity-0 bk\">\n  <section data-section-type=\"text_and_single_image\" data-section-id=\"pg053_sec001\" class=\"bg-white text-zinc-800\">\n    <div class=\"mb-8\">\n      <div class=\"h-1.5 w-full bg-purple-300\"></div>\n      <div class=\"pt-4 pb-2\">\n        <h1 class=\"adt-h2 font-semibold text-zinc-800\" data-id=\"pg053_n0003\">Në komunitetin tonë</h1>\n        <div class=\"mt-3 h-1 w-64 bg-purple-400 max-sm:w-40\"></div>\n      </div>\n    </div>\n\n    <div class=\"mb-6 rounded-[2rem] bg-amber-50 px-6 py-5 ring-1 ring-amber-300 max-sm:px-5\">\n      <div class=\"mb-3 inline-block bg-amber-300 px-4 py-1\">\n        <h3 class=\"adt-h3 font-semibold text-zinc-900\" data-id=\"pg053_n0005\">Situata 2.</h3>\n      </div>\n      <p class=\"adt-body leading-relaxed text-left\">\n        <span data-id=\"pg053_n0007\">Në shkollat tona është shumë e vështirë ngrohja e klasave gjatë dimrit.</span>\n        <span data-id=\"pg053_n0008\">Menduam të përdornim ngrohëse, apo kondicionerë, por mësuesi na tha se kjo rrit shpenzimet e energjisë.</span>\n        <span data-id=\"pg053_n0009\">Menduam të bënim një takim me përfaqësuesit e komunës, të cilët ndoshta do të na ndihmonin ta gjenim një zgjidhje.</span>\n      </p>\n    </div>\n\n    <div class=\"mb-0 overflow-hidden rounded-[2.5rem] bg-amber-100/60 max-sm:rounded-[2rem]\">\n      <img data-id=\"pg053_im001_crop_v1\" src=\"images/pg053_im001_crop_v1.png\" alt=\"Dy nxënës bisedojnë me dy të rritur për të gjetur një zgjidhje të përbashkët për një problem në shkollë.\" class=\"block w-full h-auto\">\n    </div>\n\n    <aside class=\"mb-8 -mt-1 rounded-b-[1.75rem] rounded-t-none bg-purple-100 px-5 py-5 ring-1 ring-purple-200 max-sm:px-4\">\n      <ul class=\"space-y-5\">\n        <li class=\"adt-body text-left\">\n          <div data-id=\"pg053_n0013\">Shkruani një kërkesë dhe përpiquni t’i bindni drejtuesit për atë që kërkoni.</div>\n          <label for=\"item-1\" class=\"sr-only\">Shkruani një kërkesë dhe përpiquni t’i bindni drejtuesit për atë që kërkoni.</label>\n          <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Shkruani një kërkesë dhe përpiquni t’i bindni drejtuesit për atë që kërkoni.\" class=\"mt-3 min-h-11 w-full rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none ring-0 focus:border-purple-500\"></textarea>\n        </li>\n        <li class=\"adt-body text-left\">\n          <div data-id=\"pg053_n0015\">Si mendoni të përfshiheni në vendime që ju përkasin dhe juve?</div>\n          <label for=\"item-2\" class=\"sr-only\">Si mendoni të përfshiheni në vendime që ju përkasin dhe juve?</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Si mendoni të përfshiheni në vendime që ju përkasin dhe juve?\" class=\"mt-3 min-h-11 w-full rounded-xl border-2 border-purple-300 bg-white px-4 py-3 outline-none ring-0 focus:border-purple-500\"></textarea>\n        </li>\n      </ul>\n    </aside>\n\n    <div class=\"mb-8 border-2 border-purple-300 bg-white p-5 shadow-sm max-sm:p-4\">\n      <p class=\"adt-body leading-relaxed text-left italic\">\n        <span data-id=\"pg053_n0018\">Vendimmarrja është e rëndësishme në jetën e secilit prej nesh.</span>\n        <span data-id=\"pg053_n0019\">Çdo ditë ne marrim vendime të rëndësishme, të cilat ndikojnë në jetën tonë.</span>\n        <span data-id=\"pg053_n0020\">Vendimi është një proces që ka të bëjë me zgjedhjen mes dy apo më shumë mundësive.</span>\n        <span data-id=\"pg053_n0021\">Në shoqëri, të gjithë duhet t’i njohim dhe t’i zbatojmë rregullat që na ndihmojnë të kuptohemi dhe të sillemi mirë me njëri-tjetrin.</span>\n        <span data-id=\"pg053_n0022\">Vendimi që është më i mirë për një person, nuk do të thotë se është më i miri edhe për personat e tjerë.</span>\n        <span data-id=\"pg053_n0023\">Njerëzit e ndryshëm i shohin problemet në mënyra të ndryshme, që do të thotë se zgjidhjet që propozojnë janë të ndryshme.</span>\n        <span data-id=\"pg053_n0024\">Duhet të kemi parasysh pasojat që vijnë nga vendimet që marrim.</span>\n        <span data-id=\"pg053_n0025\">Ato nuk duhet të dëmtojnë të tjerët.</span>\n        <span data-id=\"pg053_n0026\">Çdo vendim që merret duhet të jetë në të mirë të të gjithëve.</span>\n        <span data-id=\"pg053_n0027\">Kur marrim vendime në grup, është e rëndësishme që të gjithë të shprehin mendimin e tyre dhe të dëgjohen me kujdes.</span>\n      </p>\n    </div>\n\n    <p class=\"adt-body text-left font-medium pb-2\">\n      <span data-id=\"pg053_n0028\">Fjalët kyçe: komunitet, problem, marr pjesë, rregull.</span>\n    </p>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg054_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg054_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"69\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.c