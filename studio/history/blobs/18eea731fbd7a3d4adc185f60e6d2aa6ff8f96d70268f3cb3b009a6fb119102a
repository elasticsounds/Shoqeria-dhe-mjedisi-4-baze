border border-emerald-300 bg-white/95 px-3 py-2\"></textarea>\n        </div>\n        <div>\n          <div class=\"adt-body text-neutral-800\" data-id=\"pg111_n0006\">- Cilat prej veprimeve i sheh si të dëmshme Era?</div>\n          <label for=\"activity-item-2\" class=\"sr-only\">- Cilat prej veprimeve i sheh si të dëmshme Era?</label>\n          <textarea id=\"activity-item-2\" data-activity-item=\"item-2\" aria-label=\"- Cilat prej veprimeve i sheh si të dëmshme Era?\" class=\"mt-2 w-full min-h-11 rounded-md border border-sky-300 bg-white/95 px-3 py-2\"></textarea>\n        </div>\n        <div>\n          <div class=\"adt-body text-neutral-800\" data-id=\"pg111_n0007\">- Shkruaj emrat e mbeturinave sipas ngjyrës së shportave ricikluese.</div>\n          <div class=\"mt-3 grid grid-cols-2 gap-4 max-sm:grid-cols-1\">\n            <div class=\"flex flex-col rounded-2xl border-2 border-red-300 bg-red-50/30 p-3\">\n              <div class=\"mx-auto mb-3 h-14 w-14 rounded-xl bg-red-500\" aria-hidden=\"true\"></div>\n              <label for=\"activity-item-3\" class=\"sr-only\">Shkruaj emrin e mbeturinave për shportën e kuqe</label>\n              <input id=\"activity-item-3\" type=\"text\" data-activity-item=\"item-3\" aria-label=\"Shkruaj emrin e mbeturinave për shportën e kuqe\" class=\"w-full min-h-11 rounded-md border border-red-300 bg-white px-3 py-2 text-center\">\n            </div>\n            <div class=\"flex flex-col rounded-2xl border-2 border-green-300 bg-green-50/30 p-3\">\n              <div class=\"mx-auto mb-3 h-14 w-14 rounded-xl bg-green-500\" aria-hidden=\"true\"></div>\n              <label for=\"activity-item-4\" class=\"sr-only\">Shkruaj emrin e mbeturinave për shportën e gjelbër</label>\n              <input id=\"activity-item-4\" type=\"text\" data-activity-item=\"item-4\" aria-label=\"Shkruaj emrin e mbeturinave për shportën e gjelbër\" class=\"w-full min-h-11 rounded-md border border-green-300 bg-white px-3 py-2 text-center\">\n        