for=\"field3\" class=\"sr-only\">Çfarë duhet të bëjmë për mbrojtjen e tokës, të ujit dhe të ajrit?</label>\n              <textarea id=\"field3\" data-activity-item=\"item-3\" aria-label=\"Çfarë duhet të bëjmë për mbrojtjen e tokës, të ujit dhe të ajrit?\" class=\"w-full min-h-11 h-24 rounded border border-zinc-300 bg-white px-3 py-2 resize-none max-sm:mt-3\"></textarea>\n            </div>\n          </div>\n        </li>\n      </ul>\n    </div>\n\n    <p class=\"mb-8 text-zinc-900\">\n      <span data-id=\"pg107_n0015\">Krahaso punimin tënd me të shokut të bankës e më pas diskutoni në klasë.</span>\n    </p>\n\n    <div class=\"mb-6 overflow-x-auto max-sm:overflow-x-visible\">\n      <table class=\"w-full border-collapse table-fixed max-sm:block\">\n        <caption class=\"sr-only\">Tabela për të shkruar mendime për tokën, ujin dhe ajrin</caption>\n        <thead class=\"max-sm:block\">\n          <tr class=\"max-sm:grid max-sm:grid-cols-3\">\n            <th scope=\"col\" class=\"bg-green-500 border-r-2 border-white px-4 py-3 text-center font-normal text-zinc-900 max-sm:block\">\n              <span data-id=\"pg107_n0020\">Toka</span>\n            </th>\n            <th scope=\"col\" class=\"bg-green-500 border-r-2 border-white px-4 py-3 text-center font-normal text-zinc-900 max-sm:block\">\n              <span data-id=\"pg107_n0022\">Uji</span>\n            </th>\n            <th scope=\"col\" class=\"bg-green-500 px-4 py-3 text-center font-normal text-zinc-900 max-sm:block\">\n              <span data-id=\"pg107_n0024\">Ajri</span>\n            </th>\n          </tr>\n        </thead>\n        <tbody class=\"max-sm:block\">\n          <tr class=\"max-sm:grid max-sm:grid-cols-3\">\n            <th class=\"align-top border-2 border-green-400 p-4 h-[24rem] max-sm:h-72 max-sm:block\" scope=\"row\">\n              <label for=\"field4\" class=\"sr-only\">Toka</label>\n              <textarea id=\"field4\" data-activity-item=\"item-4\" aria-label=\"Toka\" class=\"w-full min-h-11 h-full rounded border border-zinc-300 bg-white px-3 py-2 resize-none\"></textarea>\n            </th>\n            <td class=\"align-top border-2 border-green-400 p-4 h-[24rem] max-sm:h-72 max-sm:block\">\n              <label for=\"field5\" class=\"sr-only\">Uji</label>\n              <textarea id=\"field5\" data-activity-item=\"item-5\" aria-label=\"Uji\" class=\"w-full min-h-11 h-full rounded border border-zinc-300 bg-white px-3 py-2 resize-none\"></textarea>\n            </td>\n            <td class=\"align-top border-2 border-green-400 p-4 h-[24rem] max-sm:h-72 max-sm:block\">\n              <label for=\"field6\" class=\"sr-only\">Ajri</label>\n              <textarea id=\"field6\" data-activity-item=\"item-6\" aria-label=\"Ajri\" class=\"w-full min-h-11 h-full rounded border border-zinc-300 bg-white px-3 py-2 resize-none\"></textarea>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <script type=\"text/javascript\">\n        window.correctAnswers = JSON.parse('{\"item-1\":\"\",\"item-2\":\"\",\"item-3\":\"\",\"item-4\":\"\",\"item-5\":\"\",\"item-6\":\"\"}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg107_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg107_sec002\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"147\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <h1 class=\"sr-only\" id=\"page-heading\">Shoqëria dhe Mjedisi 4</h1>\n      <div data-family=\"lesson-discussion\" id=\"content\" class=\"container bg-white opacity-0 bk\">\n  <section data-section-type=\"boxed_text\" data-section-id=\"pg107_sec002\" class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-10\">\n    <div class=\"rounded-2xl border-2 border-fuchsia-300 bg-white shadow-sm overflow-hidden\">\n      <div class=\"flex justify-end bg-purple-500 px-4 py-2\" aria-hidden=\"true\">\n        <div class=\"h-14 w-14 rounded-lg border-2 border-white/70\"></div>\n      </div>\n      <div class=\"p-5 max-sm:p-4\">\n        <p class=\"adt-body text-left italic leading-relaxed text-gray-800\">\n          <span data-id=\"pg107_n0032\">Mjedisi jetësor është tërë hapësira e natyrës, në të cilën jetojmë, punojmë, lëvizim dhe veprojmë.</span>\n          <span data-id=\"pg107_n0033\">Njeriu, me sjelljen e tij, ndikon në ndryshimet që ndodhin në natyrë.</span>\n          <span data-id=\"pg107_n0034\">Ato veprime mund të jenë të dëmshme apo të dobishme për natyrën.</span>\n          <span data-id=\"pg107_n0035\">Mjedisi i pastër siguron shëndet të mirë për të gjitha qeniet e gjalla që jetojnë në planetin tonë.</span>\n          <span data-id=\"pg107_n0036\">Është përgjegjësi e çdo qytetari të kontribuojë për ruajtjen e mjedisit nga ndotja.</span>\n        </p>\n        <p class=\"adt-body mt-4 text-left italic leading-relaxed text-gray-800\">\n          <span data-id=\"pg107_n0038\">Për një mjedis të pastër, ne duhet të kursejmë energjinë, të udhëtojmë me biçikletë apo me transport publik, t'i klasifikojmë mbeturinat dhe t’i hedhim ato në vendin e caktuar, ta kursejmë ujin, ta gjelbërojmë sa më shumë mjedisin, që të kemi ajër të pastër.</span>\n        </p>\n        <p class=\"adt-body mt-4 text-left italic leading-relaxed text-gray-800\">\n          <span data-id=\"pg107_n0040\">Njeriu duhet t’i vërë detyrë vetes që, nëse nuk mund të mbrojë natyrën, së paku të mos e shkatërrojë atë!</span>\n        </p>\n      </div>\n    </div>\n    <div class=\"mt-6 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-left text-gray-900\">\n      <span data-id=\"pg107_n0042\" class=\"adt-body font-semibold\">Fjalët kyçe:</span>\n      <span data-id=\"pg107_n0043\" class=\"adt-body\">mjedis, kujdes, mbrojtje, ujë, ajër, tokë.</span>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg108_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg108_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and i