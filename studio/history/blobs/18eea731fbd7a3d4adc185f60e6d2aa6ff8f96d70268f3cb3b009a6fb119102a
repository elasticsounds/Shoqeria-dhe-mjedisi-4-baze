item=\"item-1\" aria-label=\"Përmend emrat e mjekëve dhe të infermierëve të qytetit apo të fshatit tënd, të cilët kanë dhënë kontribut në shëndetësi.\" class=\"w-full min-h-32 max-sm:min-h-28 min-h-11 rounded-md border border-purple-300 bg-white px-3 py-3 text-neutral-900 resize-none focus:outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n        </div>\n\n        <div class=\"space-y-2\">\n          <p class=\"adt-body leading-relaxed text-left text-neutral-900\">\n            <span aria-hidden=\"true\">– </span><span data-id=\"pg077_n0032\">Cili është mjeku i familjes sate?</span>\n          </p>\n          <label for=\"activity-answer-2\" class=\"sr-only\">Cili është mjeku i familjes sate?</label>\n          <input id=\"activity-answer-2\" data-activity-item=\"item-2\" type=\"text\" aria-label=\"Cili është mjeku i familjes sate?\" class=\"w-full min-h-11 rounded-md border border-purple-300 bg-white px-3 py-2 text-neutral-900 focus:outline-none focus:ring-2 focus:ring-purple-400\">\n        </div>\n\n        <div class=\"space-y-2\">\n          <p class=\"adt-body leading-relaxed text-left text-neutral-900\">\n            <span aria-hidden=\"true\">– </span><span data-id=\"pg077_n0033\">Çfarë mendon ti për punën e mjekëve?</span>\n          </p>\n          <label for=\"activity-answer-3\" class=\"sr-only\">Çfarë mendon ti për punën e mjekëve?</label>\n          <textarea id=\"activity-answer-3\" data-activity-item=\"item-3\" aria-label=\"Çfarë mendon ti për punën e mjekëve?\" class=\"w-full min-h-32 max-sm:min-h-28 min-h-11 rounded-md border border-purple-300 bg-white px-3 py-3 text-neutral-900 resize-none focus:outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg078_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg078_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"108\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"illustrated-reading\" id=\"content\" class=\"container opacity-0 bk\"><section data-section-type=\"text_and_images\" data-section-id=\"pg078_sec001\" class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-8 bg-white text-slate-800\">\n  <div class=\"mb-8 overflow-hidden rounded-3xl border-4 border-purple-200 bg-gradient-to-r from-purple-300 via-purple-200 to-white\">\n    <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 flex items-center gap-6 max-sm:flex-col max-sm:items-start py-6\">\n      <div aria-hidden=\"true\" class=\"flex h-28 w-28 shrink-0 items-center justify-center rounded-2xl bg-purple-500 text-white shadow-md\">\n        <div>⌛</div>\n      </div>\n      <div class=\"flex-1\">\n        <h1 class=\"adt-h2 font-bold text-left\" data-id=\"pg078_n0003\">Kultura - pasuri kombëtare</h1>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"mb-8\">\n    <h3 class=\"adt-h3 inline-block rounded-md bg-green-400 px-4 py-2 font-bold text-left shadow-sm\" data-id=\"pg078_n0005\">Situata 1.</h3>\n    <p class=\"adt-body mt-4 text-left leading-relaxed\">\n      <span data-id=\"pg078_n0007\">Një ditë, në klasën e Kleas, mësuesi kërkoi nga nxënësit të bënin një hulumtim për njerëzit që dhanë kontribut në fusha të ndryshme të artit, si: muzikë, sport, teatër, film e pikturë.</span>\n      <span data-id=\"pg078_n0008\">Ata vendosën që të punonin në grupe dhe pastaj të prezantonin para klasës.</span>\n    </p>\n  </div>\n\n  <div class=\"space-y-10\">\n    <div class=\"grid grid-cols-2 gap-0 rounded-2xl border-4 border-purple-300 bg-purple-50/30 overflow-hidden max-lg:grid-cols-1 shadow-sm\">\n      <div class=\"border-r-4 border-purple-300 p-5 max-lg:border-r-0 max-lg:border-b-4\">\n        <div class=\"adt-body text-left leading-relaxed\">\n          <h3 class=\"adt-h3 mb-2 font-bold text-left\" data-id=\"pg078_n0011\">Grupi i parë: Sportet kolektive</h3>\n          <span data-id=\"pg078_n0012\">Sportet më të njohura në Kosovë janë: futbolli, basketbolli, hendbolli dhe volejbolli.</span>\n          <span data-id=\"pg078_n0013\">Ne si grup mblodhëm shënime për futbollin.</span>\n          <span data-id=\"pg078_n0014\">Futbolli në Kosovë është një ndër sportet më të zhvilluara.</span>\n          <span data-id=\"pg078_n0015\">Në tërë Kosovën ka shkolla të futbollit në të cilat ushtrohen shumë fëmijë dhe nga aty kanë dalë shumë talentë.</span>\n        </div>\n      </div>\n      <div class=\"bg-white p-4\">\n        <div class=\"flex flex-col gap-4\">\n          <img data-id=\"pg078_im002\" src=\"images/pg078_im002.png\" alt=\"Fadil Vokrri duke luajtur futboll në fushë, me fanellë bardh e zi.\" class=\"w-full h-auto rounded-xl border-2 border-purple-200 object-cover\">\n          <p class=\"adt-caption text-left leading-relaxed\" data-id=\"pg078_n0017\">Në fotografi është paraqitur Fadil Vokrri, emër i njohur i futbollit kosovar.</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-2 gap-0 rounded-2xl border-4 border-purple-300 bg-purple-50/30 overflow-hidden max-lg:grid-cols-1 shadow-sm\">\n      <div class=\"border-r-4 border-purple-300 p-5 max-lg:border-r-0 max-lg:border-b-4\">\n        <div class=\"adt-body text-left leading-relaxed\">\n          <h3 class=\"adt-h3 mb-2 font-bold text-left\" data-id=\"pg078_n0020\">Grupi i dytë: Sportet individuale</h3>\n          <span data-id=\"pg078_n0021\">Sportet individuale janë ato që i sollën sukseset më të mëdha Kosovës.</span>\n          <span data-id=\"pg078_n0022\">Në fotografi është paraqitur njëra ndër sportistet më të njohura kosovare, e cila bëri që emri i Kosovës të përmendej kudo nëpër botë.</span>\n        </div>\n      </div>\n      <div class=\"bg-white p-4\">\n        <div class=\"flex flex-col gap-4\">\n          <img data-id=\"pg078_im001\" src=\"images/pg078_im001.png\" alt=\"Majlinda Kelmendi me veshje sportive blu, duke mbajtur dy medalje në duar.\" class=\"w-full h-auto rounded-xl border-2 border-purple-200 object-cover\">\n          <p class=\"adt-caption text-left leading-relaxed\" data-id=\"pg078_n0024\">Majlinda Kelmendi, xhudistja që i dha Kosovës titullin e parë botëror të xhudos dhe mori edhe shumë medalje të tjera të arta.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section></div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg079_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg079_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"109\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"illustrated-reading\" id=\"content\" class=\"container bg-white opacity-0 bk\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg079_sec001\" class=\"pb-12\">\n    <div class=\"w-full bg-[#b06ab3]\">\n      <div class=\"mx-auto flex w-full max-w-5xl items-center justify-between px-8 py-6 max-sm:px-5\">\n        <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg079_n0002\">Jeta në Kosovë dikur dhe sot</h1>\n        <div aria-hidden=\"true\" class=\"ml-6 flex h-24 w-24 items-center justify-center rounded-2xl bg-[#a261ab] text-white max-sm:h-20 max-sm:w-20\">\n          <div>⌛</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mx-auto w-full max-w-5xl px-8 pt-5 max-sm:px-5\">\n      <h2 class=\"adt-h2 border-b-4 border-[#b06ab3] pb-3 font-semibold text-neutral-800\" data-id=\"pg079_n0004\">Kultura – pasuri kombëtare</h2>\n\n      <div class=\"mt-10 grid grid-cols-12 gap-0 border-2 border-[#c78bc9] max-lg:grid-cols-1\">\n        <div class=\"col-span-6 border-r-2 border-[#c78bc9] p-5 max-lg:border-r-0 max-lg:border-b-2\">\n          <h3 class=\"adt-h3 mb-3 font-bold text-neutral-800\" data-id=\"pg079_n0007\">Grupi i tretë: Muzika në Kosovë</h3>\n          <p class=\"adt-body leading-relaxed text-neutral-800\">\n            <span data-id=\"pg079_n0009\">Muzika është pjesë e kulturës së një populli.</span> <span data-id=\"pg079_n0010\">Në Kosovë fillimisht ishte e zhvilluar muzika folklorike, popullore e më pas u zhvilluan edhe zhanret e tjera, si: muzika klasike, moderne e të tjera.</span>\n          </p>\n        </div>\n        <div class=\"col-span-6 flex gap-4 p-5 max-sm:flex-col\">\n          <img src=\"images/pg079_im008_seg001_v1_crop_v1.png\" alt=\"Ymer Riza i ulur me çifteli në duar, në një fotografi bardhë e zi.\" data-id=\"pg079_im008_seg001_v1_crop_v1\" class=\"h-56 w-48 flex-none border border-[#c78bc9] object-cover max-sm:h-auto max-sm:w-full\">\n          <p class=\"adt-body z-10 leading-relaxed text-neutral-800\">\n            <span data-id=\"pg079_n0013\">Ymer Riza ishte njëri prej këngëtarëve të parë shqiptarë të muzikës popullore me sharki e çifteli.</span> <span data-id=\"pg079_n0014\">Ai u konsiderua si legjenda e folklorit shqiptar.</span>\n          </p>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-12 gap-0 border-x-2 border-b-2 border-[#c78bc9] max-lg:grid-cols-1\">\n        <div class=\"col-span-7 border-r-2 border-[#c78bc9] p-5 max-lg:border-r-0 max-lg:border-b-2\">\n          <div class=\"flex gap-4 max-sm:flex-col\">\n            <img src=\"images/pg079_im008_seg002_v1_crop_v1.png\" alt=\"Nexhmije Pagarusha e buzëqeshur, e veshur me kostum tradicional, në një fotografi bardhë e zi.\" data-id=\"pg079_im008_seg002_v1_crop_v1\" class=\"h-72 w-52 flex-none border border-[#c78bc9] object-cover max-sm:h-auto max-sm:w-full\">\n            <p class=\"adt-body z-10 leading-relaxed text-neutral-800\">\n              <span data-id=\"pg079_n0017\">Nexhmije Pagarusha, këngëtare e muzikës popullore dhe e operës.</span> <span data-id=\"pg079_n0018\">Ajo ishte edhe aktore e suksesshme në film dhe në teatër.</span> <span data-id=\"pg079_n0019\">Njihet si Bilbili i Kosovës dhe Mbretëresha e muzikës shqiptare.</span>\n            </p>\n          </div>\n        </div>\n        <div class=\"col-span-5 p-5\">\n          <p class=\"adt-body mb-5 leading-relaxed text-neutral-800\">\n            <span data-id=\"pg079_n0022\">Këngëtaret me prejardhje nga vendi ynë, që janë bërë shumë të famshme dhe kanë arritur sukses të madh nëpër botë, janë Rita Ora dhe Dua Lipa.</span>\n          </p>\n          <div class=\"grid grid-cols-2 gap-3 max-sm:grid-cols-1\">\n            <div class=\"flex flex-col items-center border-2 border-[#c78bc9] p-2\">\n              <img src=\"images/pg079_im008_seg003_v1_crop_v1.png\" alt=\"Rita Ora duke buzëqeshur, me flokë të drejta bionde dhe xhaketë të kaltër të çelët.\" data-id=\"pg079_im008_seg003_v1_crop_v1\" class=\"h-44 w-full object-cover\">\n              <div class=\"adt-caption mt-3 text-center text-neutral-800\" data-id=\"pg079_n0024\">Rita Ora</div>\n            </div>\n            <div class=\"flex flex-col items-center border-2 border-[#c78bc9] p-2\">\n              <img src=\"images/pg079_im002.png\" alt=\"Dua Lipa në portret me sfond të zi, me flokë të lidhura lart dhe bluzë të gjelbër të ndezur.\" data-id=\"pg079_im002\" class=\"h-44 w-full object-cover\">\n              <div class=\"adt-caption mt-3 text-center text-neutral-800\" data-id=\"pg079_n0026\">Dua Lipa</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"mt-5 grid grid-cols-12 gap-0 border-2 border-[#c78bc9] max-lg:grid-cols-1\">\n        <div class=\"col-span-6 border-r-2 border-[#c78bc9] max-lg:border-r-0 max-lg:border-b-2\">\n          <div class=\"border-b-2 border-[#c78bc9] p-5\">\n            <h3 class=\"adt-h3 font-bold text-neutral-800\" data-id=\"pg079_n0029\">Grupi i katërt: Filmi, drama e piktura në Kosovë</h3>\n          </div>\n          <div class=\"flex gap-4 p-5 max-sm:flex-col\">\n            <img src=\"images/pg079_im009_seg001_v1_crop_v1.png\" alt=\"Bekim Fehmiu në portret bardhë e zi, i veshur me kostum dhe papijon.\" data-id=\"pg079_im009_seg001_v1_crop_v1\" class=\"h-64 w-52 flex-none border border-[#c78bc9] object-cover max-sm:h-auto max-sm:w-full\">\n            <p class=\"adt-body z-10 leading-relaxed text-neutral-800\">\n              <span data-id=\"pg079_n0032\">Bekim Fehmiu ishte aktori i parë kosovar i teatrit dhe i filmit.</span> <span data-id=\"pg079_n0033\">Ai luajti në më shumë se 40 filma.</span>\n            </p>\n          </div>\n        </div>\n        <div class=\"col-span-6 p-5\">\n          <div class=\"flex gap-4 max-sm:flex-col\">\n            <img src=\"images/pg079_im009_seg002_v1_crop_v1.png\" alt=\"Zake Prelvukaj me penela në dorë, para një pikture me ngjyra të gjalla.\" data-id=\"pg079_im009_seg002_v1_crop_v1\" class=\"h-52 w-44 flex-none border border-[#c78bc9] object-cover max-sm:h-auto max-sm:w-full\">\n            <p class=\"adt-body z-10 leading-relaxed text-neutral-800\">\n              <span data-id=\"pg079_n0036\">Zake Prelvukaj është piktore e njohur kosovare.</span> <span data-id=\"pg079_n0037\">Ajo njihet për:</span> <span data-id=\"pg079_n0038\">piktura me ngjyra të forta dhe të gjalla; trajtimin e figurës së gruas shqiptare; elemente nga tradita dhe kultura kombëtare.</span>\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloade