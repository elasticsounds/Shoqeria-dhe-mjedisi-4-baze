 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-white max-sm:h-20 max-sm:w-20\">✿</div>\n      </div>\n    </div>\n\n    <h2 data-id=\"pg101_n0004\" class=\"adt-h2 mb-6 inline-block border-b-4 border-purple-400 pb-2 font-semibold text-gray-900\">Pasuritë njerëzore</h2>\n\n    <div class=\"mb-8 overflow-hidden rounded-[1.5rem] border-4 border-green-400 bg-green-50 shadow-sm\">\n      <table class=\"w-full border-collapse\">\n        <tr class=\"max-sm:align-top\">\n          <th scope=\"col\" class=\"w-1/2 border-b-4 border-r-4 border-green-400 bg-white px-4 py-4 text-center align-top font-medium text-gray-900 max-sm:px-3 max-sm:text-left\">\n            <h3 data-id=\"pg101_n0008\" class=\"adt-h3 text-gray-900\">Pasuri natyrore</h3>\n          </th>\n          <th scope=\"col\" class=\"w-1/2 border-b-4 border-green-400 bg-white px-4 py-4 text-center align-top font-medium text-gray-900 max-sm:px-3 max-sm:text-left\">\n            <h3 data-id=\"pg101_n0010\" class=\"adt-h3 text-gray-900\">Pasuri njerëzore</h3>\n          </th>\n        </tr>\n        <tr>\n          <td class=\"border-r-4 border-green-400 px-4 py-4 align-top max-sm:px-3\">\n            <div class=\"adt-body text-gray-900\"><span data-id=\"pg101_n0013\">Dielli, ujërat, pyjet, bimët etj.</span></div>\n            <div class=\"mt-5 space-y-3\">\n              <label for=\"item-1\" class=\"sr-only\">Shto një pasuri natyrore</label>\n              <input id=\"item-1\" data-activity-item=\"item-1\" type=\"text\" aria-label=\"Shto një pasuri natyrore\" class=\"min-h-11 w-full rounded-xl border-2 border-green-300 bg-white px-4 py-3 text-gray-800 outline-none focus:border-green-500\">\n              <label for=\"item-2\" class=\"sr-only\">Shto një tjetër pasuri natyrore</label>\n              <input id=\"item-2\" data-activity-item=\"item-2\" type=\"text\" aria-label=\"Shto një tjetër pasuri natyrore\" class=\"min-h-11 w-full rounded-xl border-2 border-green-300 bg-white px-4 py-3 text-gray-800 outline-none focus:border-green-500\">\n            </div>\n          </td>\n          <td class=\"px-4 py-4 align-top max-sm:px-3\">\n            <div class=\"adt-body text-gray-900\"><span data-id=\"pg101_n0015\">Mjekët, mësuesit, policët, muratorët etj.</span></div>\n            <div class=\"mt-5 space-y-3\">\n              <label for=\"item-3\" class=\"sr-only\">Shto një pasuri njerëzore</label>\n              <input id=\"item-3\" data-activity-item=\"item-3\" type=\"text\" aria-label=\"Shto një pasuri njerëzore\" class=\"min-h-11 w-full rounded-xl border-2 border-green-300 bg-white px-4 py-3 text-gray-800 outline-none focus:border-green-500\">\n              <label for=\"item-4\" class=\"sr-only\">Shto një tjetër pasuri njerëzore</label>\n              <input id=\"item-4\" data-activity-item=\"item-4\" type=\"text\" aria-label=\"Shto një tjetër pasuri njerëzore\" class=\"min-h-11 w-full rounded-xl border-2 border-green-300 bg-white px-4 py-3 text-gray-800 outline-none focus:border-green-500\">\n            </div>\n          </td>\n        </tr>\n      </table>\n    </div>\n\n    <p class=\"adt-body mb-8 text-left leading-relaxed text-gray-900\">\n      <span data-id=\"pg101_n0017\">Në grupin e parë “Pasuri natyrore” bëjnë pjesë të gjitha pasuritë që gjenden në natyrë, pra ato që i shohim si pjesë përbërëse e natyrës.</span>\n      <span data-id=\"pg101_n0018\">Në grupin e dytë “Pasuri njerëzore” bëjnë pjesë njerëzit që përdorin aftësitë e tyre për të kryer një shërbim.</span>\n      <span data-id=\"pg101_n0019\">- Të dashur, moshatarë të mi! Në tabelën më lart, shtoni edhe të tjera në listën e pasurive natyrore dhe njerëzore, - tha Rona.</span>\n    </p>\n\n    <div class=\"mb-10 border-2 border-purple-300 bg-purple-50 px-6 py-5 shadow-sm max-sm:px-4\">\n      <div class=\"float-right ml-6 mb-4 flex h-16 w-16 items-center justify-center rounded-none bg-purple-500 text-white max-lg:float-none max-lg:ml-0 max-lg:mb-4\">\n        <span aria-hidden=\"true\">📖</span>\n      </div>\n      <p class=\"adt-body text-left italic leading-relaxed text-gray-800\">\n        <span data-id=\"pg101_n0022\">Vendi ynë është mjaft i pasur me pasuri natyrore.</span>\n        <span data-id=\"pg101_n0023\">Edhe më të pasur e bëjnë atë pasuritë njerëzore.</span>\n        <span data-id=\"pg101_n0024\">Nxënësit në vendin tonë shkollohen dhe përgatiten për t’i shërbyer shtetit.</span>\n        <span data-id=\"pg101_n0025\">Pasuri njerëzore, që ndryshe mund t'i quajmë edhe burime njerëzore, janë tërë fuqia punëtore e një vendi dhe njohuritë që kanë ata për të ushtruar një profesion.</span>\n        <span data-id=\"pg101_n0026\">Burimet njerëzore pa dyshim që janë shtytësi kryesor i zhvillimit ekonomik të vendit.</span>\n        <span data-id=\"pg101_n0027\">Sa më të ditur që të jenë njerëzit, aq më të aftë janë ata për shprehjen e aftësive të tyre për të kryer një shërbim.</span>\n      </p>\n      <div class=\"clear-both\"></div>\n    </div>\n\n    <p class=\"adt-body text-left text-gray-900\">\n      <span data-id=\"pg101_n0028\">Fjalët kyçe: pasuri njerëzore, aftësi, shërbim.</span>\n    </p>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg101_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg101_sec002\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and n