%] w-[28%] min-h-11 rounded-full border-2 border-green-300 bg-white/10 p-6 resize-none focus:outline-none focus:ring-2 focus:ring-green-500 max-sm:left-[36.5%] max-sm:top-[27%] max-sm:h-[38%] max-sm:w-[27%] max-sm:p-3\"></textarea>\n\n        <label for=\"activity-response-3\" class=\"sr-only\">Fshati sot</label>\n        <textarea id=\"activity-response-3\" data-activity-item=\"item-3\" aria-label=\"Fshati sot\" class=\"absolute right-[7%] top-[25%] z-10 h-[42%] w-[28%] min-h-11 rounded-full border-2 border-green-300 bg-white/10 p-6 resize-none focus:outline-none focus:ring-2 focus:ring-green-500 max-sm:right-[10%] max-sm:top-[27%] max-sm:h-[38%] max-sm:w-[27%] max-sm:p-3\"></textarea>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <script type=\"text/javascript\">\n        window.correctAnswers = JSON.parse('{\"item-1\":\"\",\"item-2\":\"\",\"item-3\":\"\"}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg070_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg070_sec002\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"92\">\n    <link href