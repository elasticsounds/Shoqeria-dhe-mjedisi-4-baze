s=\"block adt-body leading-relaxed mb-2\">\n                <span data-id=\"pg098_n0030\">Pse është e rëndësishme të shfrytëzohen burimet natyrore në mënyrë të arsyeshme?</span>\n              </label>\n              <textarea id=\"activity-answer-3\" data-activity-item=\"item-3\" aria-label=\"Pse është e rëndësishme të shfrytëzohen burimet natyrore në mënyrë të arsyeshme?\" class=\"w-full min-h-28 max-sm:min-h-32 rounded-lg border border-purple-300 bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n            </div>\n\n            <div>\n              <label for=\"activity-answer-4\" class=\"block adt-body leading-relaxed mb-2\">\n                <span data-id=\"pg098_n0031\">Pse duhet t'i përdorim më shumë energjinë e erës dhe atë diellore?</span>\n              </label>\n              <textarea id=\"activity-answer-4\" data-activity-item=\"item-4\" aria-label=\"Pse duhet t'i përdorim më shumë energjinë e erës dhe atë diellore?\" class=\"w-full min-h-28 max-sm:min-h-32 rounded-lg border border-purple-300 bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-400\"></textarea>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{\"item-1\":\"pg098_sec002_ans_item-1\",\"item-2\":\"pg098_sec002_ans_item-2\",\"item-3\":\"pg098_sec002_ans_item-3\",\"item-4\":\"pg098_sec002_ans_item-4\"}');\n    </script>\n    <script type=\"text/javascript\">\n        window.correctAnswers = JSON.parse('{\"item-1\":\"Mali e Era biseduan për ruajtjen e pasurive natyrore dhe shfrytëzimin e tyre në mënyrë të arsyeshme.\",\"item-2\":\"Pasuritë natyrore ndahen në burime të ripërtëritshme dhe të paripërtëritshme.\",\"item-3\":\"Është e rëndësishme të shfrytëzohen me arsye, sepse burimet e paripërtëritshme mund të harxhohen dhe të ndotin mjedisin, kështu që duhet të ruhen edhe për brezat e ardhshëm.\",\"item-4\":\"Duhet t’i përdorim më shumë energjinë e erës dhe atë diellore, sepse janë burime të ripërtëritshme dhe ndotin më pak mjedisin se nafta, qymyri dhe gazi natyror.\"}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg099_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg099_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"137\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"illustrated-reading\" id=\"content\" class=\"container mx-auto w-full max-w-6xl px-6 max-sm:px-4 opacity-0 bk\">\n  <section data-section-type=\"text_and_single_image\" data-section-id=\"pg099_sec001\" class=\"bg-white pb-4 text-slate-900\">\n    <div class=\"pt-6 max-sm:pt-4\">\n      <div class=\"flex items-stretch max-sm:items-start\">\n        <div class=\"flex min-h-[48px] flex-1 items-center bg-purple-500 px-8 max-sm:min-h-[64px] max-sm:px-5\">\n          <h1 data-id=\"pg099_n0002\" class=\"adt-h1 font-bold text-white\">Resurset dhe trashëgimia e vendit tim</h1>\n        </div>\n        <div aria-hidden=\"true\" class=\"flex w-36 shrink-0 items-center justify-center rounded-r-md bg-purple-500 max-sm:w-24\">\n          <svg viewBox=\"0 0 64 64\" class=\"h-16 w-16 fill-white max-sm:h-10 max-sm:w-10\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M31 56h2V8h-2v48Zm1-32c-6-1-10-5-12-10 6 0 11 2 12 10Zm0 0c1-8 6-10 12-10-2 5-6 9-12 10Zm0 10c-6-1-10-5-12-10 6 0 11 2 12 10Zm0 0c1-8 6-10 12-10-2 5-6 9-12 10Zm0 10c-6-1-10-5-12-10 6 0 11 2 12 10Zm0 0c1-8 6-10 12-10-2 5-6 9-12 10Z\" />\n          </svg>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"px-8 pt-5 max-sm:px-5 max-sm:pt-4\">\n      <h2 data-id=\"pg099_n0005\" class=\"adt-h2 inline-block border-b-4 border-purple-400 pb-2 font-medium text-slate-800\">Shfrytëzimi i arsyeshëm i pasurive natyrore</h2>\n    </div>\n\n    <div class=\"px-8 pt-10 max-sm:px-5 max-sm:pt-6\">\n      <div class=\"border-2 border-purple-300 bg-white\">\n        <div class=\"float-right ml-6 mb-3 flex h-20 w-40 items-start justify-end bg-purple-400 max-lg:h-20 max-lg:w-32 max-sm:h-16 max-sm:w-20 max-sm:ml-3 max-sm:mb-2 max-sm:float-right\">\n          <div class=\"mr-4 mt-3 h-14 w-10 rounded-sm bg-white shadow max-sm:mr-3 max-sm:mt-2 max-sm:h-11 max-sm:w-8\"></div>\n        </div>\n        <p class=\"adt-body p-6 italic leading-relaxed text-slate-700 max-lg:p-5 max-sm:p-4\">\n          <span data-id=\"pg099_n0008\">Pasuri natyrore ose burime natyrore janë të mirat materiale që gjenden në natyrë dhe që mund të përdoren nga njeriu.</span>\n          <span data-id=\"pg099_n0009\">Ato ndahen në burime të ripërtëritshme (që janë dielli e ajri) dhe të paripërtëritshme (lëndët djegëse, si qymyri, nafta dhe gazi natyror, si dhe uji).</span>\n          <span data-id=\"pg099_n0010\">Burimet natyrore duhet të shfrytëzohen në mënyrë të arsyeshme, sepse shfrytëzimi i pakontrolluar i tyre shkakton shterjen ose harxhimin e tyre, për shkak se ato janë të paripërtëritshme.</span>\n          <span data-id=\"pg099_n0011\">Po ashtu, shfrytëzimi i këtyre burimeve shkakton edhe ndotjen e ambientit.</span>\n          <span data-id=\"pg099_n0012\">Në botë, sot po punohet që të prodhohet energjia me shfrytëzimin e rrezeve të diellit dhe të erës, sepse janë burime të ripërtëritshme dhe ruajnë ambientin nga ndotja.</span>\n        </p>\n        <div class=\"clear-both\"></div>\n      </div>\n    </div>\n\n    <div class=\"px-8 pt-2 max-sm:px-5 max-sm:pt-6\">\n      <div class=\"overflow-hidden bg-sky-100\">\n        <img data-id=\"pg099_im001_crop_v1\" src=\"images/pg099_im001_crop_v1.png\" alt=\"Peizazh natyror me lumë që gjarpëron mes fushave të gjelbra, male në sfond dhe diell mbi horizont.\" class=\"block h-auto w-full\">\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg100_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg100_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives 