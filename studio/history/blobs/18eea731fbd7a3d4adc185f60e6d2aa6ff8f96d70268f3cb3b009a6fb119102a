" class=\"container mx-auto opacity-0 bk\">\n  <section data-section-type=\"text_and_single_image\" data-section-id=\"pg019_sec001\" class=\"bg-white text-slate-800\">\n    <div class=\"w-full bg-purple-500\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-6 flex items-center justify-between gap-6 max-lg:flex-col max-lg:items-start\">\n        <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg019_n0002\">Secili ka të drejta dhe përgjegjësi</h1>\n        <div aria-hidden=\"true\" class=\"shrink-0 w-24 h-24 rounded-2xl bg-purple-400 flex items-center justify-center text-white\">⚖</div>\n      </div>\n    </div>\n\n    <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-6 space-y-8\">\n      <div>\n        <h2 class=\"adt-h2 font-semibold text-slate-900\" data-id=\"pg019_n0004\">Institucionet që na mbrojnë</h2>\n        <div aria-hidden=\"true\" class=\"mt-2 h-1 w-72 bg-purple-400 rounded-full\"></div>\n      </div>\n\n      <div class=\"space-y-4\">\n        <div class=\"flex items-start gap-4 max-sm:flex-col max-sm:gap-3\">\n          <div class=\"bg-amber-300 px-4 py-2 rounded-sm shadow-sm\">\n            <span class=\"adt-body font-semibold text-slate-900\" data-id=\"pg019_n0006\">Situata 2.</span>\n          </div>\n          <p class=\"adt-body leading-relaxed text-left flex-1\">\n            <span data-id=\"pg019_n0008\">Në qytetin tonë të zhurmshëm, vijon tradita e bashkëpunimit me policinë rrugore.</span>\n            <span data-id=\"pg019_n0009\">Ka kohë që, në oraret kur ne hyjmë e dalim nga shkolla, polici bllokon qarkullimin dhe qëndron te vijat e bardha.</span>\n            <span data-id=\"pg019_n0010\">Kështu, ndihemi të sigurt ndaj çdo rreziku.</span>\n          </p>\n        </div>\n\n        <div class=\"rounded-3xl overflow-hidden bg-slate-100 border border-slate-200 shadow-sm\">\n          <img src=\"images/pg019_im001.png\" alt=\"Polici rrugor ndalon veturat te vijat e bardha, ndërsa dy nxënës me çanta kalojnë rrugën të sigurt.\" data-id=\"pg019_im001\" class=\"w-full h-auto block\">\n        </div>\n      </div>\n\n      <div class=\"bg-purple-100 border-l-8 border-purple-300 rounded-2xl p-5 max-sm:p-4\">\n        <div class=\"space-y-5\">\n          <div class=\"space-y-2\">\n            <p class=\"adt-body text-left\" data-id=\"pg019_n0014\">Për çfarë shërbejnë vijat e bardha?</p>\n            <label for=\"item-1\" class=\"sr-only\">Për çfarë shërbejnë vijat e bardha?</label>\n            <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Për çfarë shërbejnë vijat e bardha?\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-200 bg-white px-4 py-3 text-slate-800 outline-none focus:border-purple-400\"></textarea>\n          </div>\n          <div class=\"space-y-2\">\n            <p class=\"adt-body text-left\" data-id=\"pg019_n0016\">Pse polici bllokon qarkullimin e mjeteve në vijat e bardha?</p>\n            <label for=\"item-2\" class=\"sr-only\">Pse polici bllokon qarkullimin e mjeteve në vijat e bardha?</label>\n            <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Pse polici bllokon qarkullimin e mjeteve në vijat e bardha?\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-200 bg-white px-4 py-3 text-slate-800 outline-none focus:border-purple-400\"></textarea>\n          </div>\n          <div class=\"space-y-2\">\n            <p class=\"adt-body text-left\" data-id=\"pg019_n0018\">A ndiheni ju të sigurt? Pse?</p>\n            <label for=\"item-3\" class=\"sr-only\">A ndiheni ju të sigurt? Pse?</label>\n            <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"A ndiheni ju të sigurt? Pse?\" class=\"w-full min-h-11 rounded-xl border-2 border-purple-200 bg-white px-4 py-3 text-slate-800 outline-none focus:border-purple-400\"></textarea>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"border-2 border-purple-300 rounded-2xl p-5 max-sm:p-4 bg-white\">\n        <p class=\"adt-body leading-relaxed italic text-left\">\n          <span data-id=\"pg019_n0021\">Shteti ka për detyrë të mbrojë të drejtat e njerëzve.</span>\n          <span data-id=\"pg019_n0022\">Ai e bën këtë përmes ligjeve dhe institucioneve që kujdesen që të gjithë të sillen në mënyrë të drejtë dhe me respekt.</span>\n          <span data-id=\"pg019_n0023\">Institucioni është një organizatë ose vend ku njerëzit punojnë së bashku, për të kryer një punë në një fushë të caktuar, si p.sh.: në arsim, në shkencë, në shëndetësi, në kulturë, në ekonomi etj.</span>\n          <span data-id=\"pg019_n0024\">Ka shumë organizata ndërkombëtare që mbrojnë të drejtat e njeriut e të fëmijëve.</span>\n          <span data-id=\"pg019_n0025\">Organizata e Kombeve të Bashkuara (OKB), mbron liritë dhe të drejtat e njeriut, si dhe ka rol të rëndësishëm për sigurimin e paqes në botë.</span>\n          <span data-id=\"pg019_n0026\">Organizata për Sigurimin dhe Bashkëpunimin në Evropë (OSBE) ndihmon në mbrojtjen e të drejtave të njeriut dhe përfshin të gjitha shtetet evropiane.</span>\n          <span data-id=\"pg019_n0027\">Avokati i Popullit mbron të drejtat e njeriut, si dhe shqyrton ankesat e personave që mendojnë se u është shkelur një e drejtë.</span>\n        </p>\n      </div>\n\n      <div class=\"pt-2\">\n        <p class=\"adt-body text-left\">\n          <span class=\"font-semibold\" data-id=\"pg019_n0029\">Fjalët kyçe:</span>\n          <span data-id=\"pg019_n0030\">Institucion, ligj, polici rrugore.</span>\n        </p>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <script type=\"text/javascript\">\n        window.activityAnswerTextIds = JSON.parse('{}');\n    </script>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n</body>\n\n</html>","./pg020_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq-XK\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe Mjedisi 4</title>\n    <meta name=\"title-id\" content=\"pg020_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"30\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link href=\"./book-design/design-system.css?v=31b9b116916778a8\" data-book-style=\"plan\" rel=\"stylesheet\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div data-family=\"lesson-discussion\" class=\"container mx-auto max-w-5xl bg-white px-16 max-lg:px-10 max-sm:px-5 pt-8 pb-12 opacity-0 bk\" id=\"content\"><section data-section-type=\"activity_open_ended_answer\" data-section-id=\"pg020_sec001\" class=\"mx-auto max-w-5xl\">\n  <div class=\"mb-10\">\n    <div class=\"flex items-stretch max-sm:flex-col\">\n      <div class=\"w-36 shrink-0 rounded-2xl bg-purple-500 flex items-center justify-center max-sm:w-full max-sm:min-h-24 max-sm:rounded-b-none\" aria-hidden=\"true\">\n        <span class=\"text-white text-6xl leading-none\">⚖</span>\n      </div>\n      <div class=\"flex-1 self-center pl-0\">\n        <div class=\"bg-purple-500 px-6 py-3 text-white max-sm:rounded-none\">\n          <h1 class=\"adt-h1 font-bold leading-tight\"><span data-id=\"pg020_n0002\">Secili ka të drejta dhe përgjegjësi</span></h1>\n        </div>\n        <div class=\"bord