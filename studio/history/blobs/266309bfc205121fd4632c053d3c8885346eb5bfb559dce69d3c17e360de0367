    window.activityAnswerTextIds = JSON.parse('{}');
    (function () {
      var prefix = 'ShoqeriaDheMjedisi4:pg056_sec002:';
      document.querySelectorAll('#content textarea[data-activity-item]').forEach(function (field) {
        var status = document.getElementById(field.getAttribute('aria-describedby'));
        var retry = field.parentElement.querySelector('[data-action="retry-save"]');
        var key = prefix + field.dataset.activityItem;
        try { var saved = localStorage.getItem(key); if (saved !== null) field.value = saved; }
        catch (error) { status.hidden = false; status.textContent = '⚠ Nuk u lexuan shënimet e ruajtura.'; }
        function save() {
          try { localStorage.setItem(key, field.value); status.hidden = false; status.textContent = '✓ U ruajt.'; retry.hidden = true; }
          catch (error) { status.hidden = false; status.textContent = '⚠ Nuk u ruajt. Shënimi mbetet këtu; provo përsëri.'; retry.hidden = false; }
        }
        field.addEventListener('input', save);
        retry.addEventListener('click', save);
      });
    }());
