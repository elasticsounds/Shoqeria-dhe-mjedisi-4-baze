<script>
(function(){
var drafts=window.__pg023Drafts||(window.__pg023Drafts=new Map());
window.addEventListener('beforeunload',function(e){if(Array.from(drafts.values()).some(function(d){return d.pending&&!d.recovery;})){e.preventDefault();e.returnValue='';}});
function mount(){
var root=document.querySelector('[data-response-source="pg023_sec002"]');
if(!root||root.dataset.draftsMounted)return;
root.dataset.draftsMounted='true';
root.querySelectorAll('textarea[data-activity-item]').forEach(function(field){
var item=field.dataset.activityItem;
var key='shoqeria-dhe-mjedisi-4:pg023_sec002:'+item;
var status=field.parentElement.querySelector('[role="status"]');
var retry=field.parentElement.querySelector('[data-action="retry-save"]');
var dirty=false;
function feedback(ok){status.hidden=false;status.textContent=ok?'✓ U ruajt.':'! Nuk u ruajt.';retry.hidden=ok;}
try{var saved=localStorage.getItem(key);if(saved!==null)field.value=saved;}catch(e){feedback(false);}
try{var recovery=sessionStorage.getItem(key+':recovery');if(recovery!==null){field.value=recovery;dirty=true;}}catch(e){}
var prior=drafts.get(key);if(prior){field.value=prior.text;dirty=prior.pending;}
if(dirty)feedback(false);
function save(){
var draft={text:field.value,pending:true,recovery:false};drafts.set(key,draft);
try{sessionStorage.setItem(key+':recovery',field.value);draft.recovery=sessionStorage.getItem(key+':recovery')===field.value;}catch(e){}
try{localStorage.setItem(key,field.value);if(localStorage.getItem(key)!==field.value)throw Error('save');dirty=false;draft.pending=false;try{sessionStorage.removeItem(key+':recovery');}catch(e){}feedback(true);}catch(e){dirty=true;feedback(false);}
}
field.addEventListener('input',function(){dirty=true;save();});
field.addEventListener('change',function(){dirty=true;save();});
retry.addEventListener('click',save);
window.addEventListener('pagehide',function(){if(dirty)save();});
document.addEventListener('visibilitychange',function(){if(document.hidden&&dirty)save();});
});
}
mount();
new MutationObserver(mount).observe(document.querySelector('main'),{childList:true,subtree:true});
})();
</script>
