<script>
(function(){
'use strict';
const field=document.getElementById('activity-item-1');
const feedback=document.getElementById('opinion-save-status');
const retry=document.querySelector('[data-action="retry-save"]');
const key='shoqeria-mjedisi-4:pg008_sec001:discussion:item-1';
let dirty=false;
try{const draft=localStorage.getItem(key);if(draft!==null)field.value=draft;}catch(e){feedback.textContent='⚠ Nuk u ruajt. Shënimet mbeten këtu derisa faqja të jetë e hapur.';retry.hidden=false;}
function save(){try{localStorage.setItem(key,field.value);dirty=false;feedback.textContent='✓ U ruajt.';retry.hidden=true;}catch(e){dirty=true;feedback.textContent='⚠ Nuk u ruajt. Shënimet mbeten këtu derisa faqja të jetë e hapur.';retry.hidden=false;}}
field.addEventListener('input',function(){dirty=true;save();});
retry.addEventListener('click',save);
window.addEventListener('beforeunload',function(e){if(dirty){e.preventDefault();e.returnValue='';}});
})();
</script>
