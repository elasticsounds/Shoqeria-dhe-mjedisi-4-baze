    <script>
        window.activityAnswerTextIds = JSON.parse('{}');
        document.getElementById('pg009-inspect-close').addEventListener('click', function () {
            document.getElementById('pg009-inspect').open = false;
            document.getElementById('pg009-inspect-trigger').focus();
        });
        document.getElementById('pg009-inspect').addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && this.open) {
                event.preventDefault();
                this.open = false;
                document.getElementById('pg009-inspect-trigger').focus();
            }
        });
    </script>
