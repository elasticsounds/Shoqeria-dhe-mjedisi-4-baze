<script>
/* Trim only the uniform empty outer canvas of the original source image. */
(function(){
  var img=document.querySelector('[data-id="pg104_im001"]');
  function trim(){
    if(img.dataset.trimmed || !img.naturalWidth) return;
    img.dataset.trimmed='yes';
    try{
      var w=img.naturalWidth,h=img.naturalHeight,c=document.createElement('canvas');
      c.width=w;c.height=h;var ctx=c.getContext('2d',{willReadFrequently:true});ctx.drawImage(img,0,0);
      var d=ctx.getImageData(0,0,w,h).data,minX=w,minY=h,maxX=-1,maxY=-1;
      for(var y=0;y<h;y++) for(var x=0;x<w;x++){
        var i=(y*w+x)*4;
        if(d[i+3] && (d[i]<250 || d[i+1]<250 || d[i+2]<250)){
          if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y;
        }
      }
      if(maxX<minX || maxY<minY)return;
      minX=Math.max(0,minX-12);minY=Math.max(0,minY-12);maxX=Math.min(w-1,maxX+12);maxY=Math.min(h-1,maxY+12);
      var out=document.createElement('canvas');out.width=maxX-minX+1;out.height=maxY-minY+1;
      out.getContext('2d').drawImage(c,minX,minY,out.width,out.height,0,0,out.width,out.height);
      img.src=out.toDataURL('image/png');
    }catch(e){/* The original image remains available if canvas processing fails. */}
  }
  img.addEventListener('load',trim);if(img.complete)trim();
})();
</script>
