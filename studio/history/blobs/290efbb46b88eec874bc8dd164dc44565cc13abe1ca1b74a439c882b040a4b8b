<script>
window.activityAnswerTextIds=JSON.parse('{}');
window.correctAnswers=JSON.parse('{"item-1":"","item-2":"","item-3":"","item-4":"","item-5":""}');
(function(){
 if(window.__pg120Drafts)return; window.__pg120Drafts=true;
 var seen=new WeakSet(), prefix='Shoqeria-dhe-Mjedisi-4:pg120_sec002:';
 function status(field,ok){var card=field.closest('.bk-activity'), msg=card.querySelector('.bk-feedback'), retry=card.querySelector('[data-action="retry-save"]');msg.textContent=ok?'✓ U ruajt.':'! Nuk u ruajt.';retry.hidden=ok;}
 function save(field){try{localStorage.setItem(prefix+field.dataset.activityItem,field.value);if(localStorage.getItem(prefix+field.dataset.activityItem)!==field.value)throw Error('save');status(field,true);}catch(e){status(field,false);}}
 function bind(){document.querySelectorAll('[data-source-activity="pg120_sec002"] textarea[data-activity-item]').forEach(function(field){if(seen.has(field))return;seen.add(field);try{var draft=localStorage.getItem(prefix+field.dataset.activityItem);if(draft!==null)field.value=draft;}catch(e){status(field,false);}field.addEventListener('input',function(){save(field)});field.closest('.bk-activity').querySelector('[data-action="retry-save"]').addEventListener('click',function(){save(field)});});}
 bind();new MutationObserver(bind).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>
